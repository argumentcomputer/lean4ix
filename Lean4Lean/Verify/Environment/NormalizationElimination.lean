/-- The producer annotation spine stops at the same non-Pi result recorded by
the family normalization run. -/
theorem ProducedBlockRecursorShapeCandidate.SecondFamilyAnnotationSpine.terminal_notForall
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    (annotation : produced.SecondFamilyAnnotationSpine semantic) :
    annotation.secondCandidate.familyType.type.trace.terminalResult.isForall =
      false := by
  let normalization :=
    produced.execution.eliminationExecution.normalization
  have terminals := normalization.familyTerminals
  rw [← normalization.families.produced.familyTypes_eq] at terminals
  have candidatesEq := annotation.candidates_eq
  change normalization.families.candidates =
    .cons annotation.firstCandidate
      (.cons annotation.secondCandidate annotation.remainingCandidates)
    at candidatesEq
  rw [candidatesEq] at terminals
  simp only [AddInductive.CandidateList.familyTypes] at terminals
  cases terminals with
  | cons firstTerminal remainingTerminals =>
    cases remainingTerminals with
    | cons secondTerminal remainingTerminals =>
      rw [secondTerminal]
      rfl

/-- The first canonical family's index count occupies source ordinal zero in
the validator's final count array for every nonempty block.  The proof uses
only the generic first-family owner and its retained first continuation; no
second-family cursor is involved. -/
theorem
    ProducedBlockRecursorShapeCandidate.FirstFamilyAnnotationSpine.canonicalFirstIndexCount_getElem?
    {source : VInductDecl}
    {firstSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: remainingSources) numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    (owner : produced.FirstFamilyAnnotationSpine semantic)
    (context_lctx_eq : context.lctx = {})
    {params : List VExpr}
    (paramsLength : params.length = source.nparams) :
    produced.execution.eliminationExecution.normalization.stats.nindices[0]? =
      some
        (ctorFields
          (VExpr.dropN source.nparams
            (canonicalizeFamilyParams source.nparams params
              owner.position.semantic.view).type)).length := by
  let normalization :=
    produced.execution.eliminationExecution.normalization
  have normalizationProduced :=
    produced.execution.normalization_run produced.producedExecution
  have firstBound := owner.nparams_le_spineLength context_lctx_eq
  have familyTypeFuel :=
    normalization.firstFamilyType_spineLength_lt_inductiveFuel
      normalizationProduced context_lctx_eq
  have firstFuel :
      produced.candidate.families.head.familyType.type.trace.spineLength <
        context.fuel.inductiveFuel := by
    have candidateFuel :
        normalization.families.candidates.head.familyType.type.trace.spineLength <
          context.fuel.inductiveFuel := by
      rw [normalization.families.produced.head_familyType]
      exact familyTypeFuel
    exact candidateFuel
  have candidateContextEq : { context with lctx := {} } = context := by
    cases context
    simp_all
  have firstContextEq :
      produced.candidate.families.head.familyType.type.context = context :=
    owner.validationAnnotations.head_context_eq.trans candidateContextEq
  let firstTrace : AddInductive.CandidateExprTrace context firstSource.type :=
    firstContextEq ▸
      produced.candidate.families.head.familyType.type.trace
  have firstTraceSpine := candidateExprTrace_cast_context_spineLength
    firstContextEq produced.candidate.families.head.familyType.type.trace
  have firstTraceBound : source.nparams ≤ firstTrace.spineLength := by
    rw [firstTraceSpine]
    exact firstBound
  have firstTraceFuel : firstTrace.spineLength <
      context.fuel.inductiveFuel := by
    rw [firstTraceSpine]
    exact firstFuel
  have firstTraceAnnotations : firstTrace.validationAnnotations := by
    simpa only [firstTrace] using
      (candidateExprTrace_cast_context_validationAnnotations firstContextEq
        owner.validationAnnotations.head)
  obtain ⟨_firstLevel, firstTerminal⟩ :=
    owner.validationAnnotations.head_terminal
  have firstTraceTerminal :=
    candidateExprTrace_cast_context_terminalResult firstContextEq
      produced.candidate.families.head.familyType.type.trace
  have terminalForall : firstTrace.terminalResult.isForall = false := by
    rw [firstTraceTerminal, firstTerminal]
    rfl
  have canonical :=
    owner.position.semantic.canonicalIndexCount firstTerminal
      owner.shape.storedSpine paramsLength firstBound
  let comparisonTrace :=
    normalization.familyParameterComparisonTrace normalizationProduced
      produced.kernelSources_nonempty
  have comparisonResult : comparisonTrace.result =
      normalization.familyValidationResult :=
    AddInductive.FamilyValidationBlockRun.parameterComparisonTrace_result
      (normalization.familyValidationBlockRun normalizationProduced
        produced.kernelSources_nonempty)
  have blockSize :=
    normalization.validationNindicesSize_all normalizationProduced
  have resultSize : comparisonTrace.result.stats.nindices.size =
      (firstSource :: remainingSources).toArray.size := by
    rw [comparisonResult]
    change normalization.stats.nindices.size =
      (firstSource :: remainingSources).toArray.size
    simpa using blockSize
  obtain ⟨validation⟩ := owner.firstFamilyValidationState context_lctx_eq
  obtain ⟨continuation, firstSelected, _localState, _parameterSourcesEq,
      _paramsSize⟩ := validation
  have firstSize : continuation.stats.nindices.size =
      continuation.dIdx := by
    rw [
      AddInductive.FamilyParameterComparisonBlockTrace.headContinuation?_stats
        firstSelected,
      AddInductive.FamilyParameterComparisonBlockTrace.headContinuation?_dIdx
        firstSelected]
    rfl
  have installed :=
    AddInductive.FamilyParameterComparisonBlockTrace.headContinuation?_result_nindices
      firstSelected firstSize resultSize
  change comparisonTrace.headContinuation? =
    some continuation at firstSelected
  change comparisonTrace.result.stats.nindices[continuation.dIdx]? =
    some continuation.telescope.result.nindices at installed
  generalize comparisonTrace_eq : comparisonTrace = validationTrace at comparisonResult
  rw [comparisonTrace_eq] at firstSelected installed
  cases validationTrace with
  | firstFamily dIdx stats validationContext inBounds closed inferred root
      checkType rootWhnf telescope sorted ensureSort isFirst tail =>
    simp only [
      AddInductive.FamilyParameterComparisonBlockTrace.headContinuation?]
        at firstSelected
    cases Option.some.inj firstSelected
    have candidateWhnf := firstTrace.rootWhnf_valid
    have candidateWhnf' : AddInductive.CandidateWhnfStep.Valid
        ⟨context, firstSource.type, firstTrace.rootWhnf⟩ := candidateWhnf
    have rootWhnf' : AddInductive.CandidateWhnfStep.Valid
        ⟨context, firstSource.type, root⟩ := by
      simpa using rootWhnf
    have root_eq : root = firstTrace.rootWhnf :=
      Except.ok.inj (rootWhnf'.symm.trans candidateWhnf')
    subst root
    have resultEq :=
      AddInductive.FamilyTypeParameterComparisonTrace.result_eq_candidate
        (nparams := source.nparams) (i := 0) (nindices := 0)
        (fuel := context.fuel.inductiveFuel)
        (stats := AddInductive.InductiveStats.initial
          (context.lparams.map .param))
        (context := context)
        (candidate := firstTrace)
        (trace := telescope) (remaining := source.nparams)
        (hi := by simp) (hcount := firstTraceBound)
        (hfuel := firstTraceFuel) (hempty := rfl)
        (hannotations := firstTraceAnnotations)
        (hterminal := terminalForall)
    have countEq := congrArg
      AddInductive.FamilyTypeParameterComparisonTrace.Result.nindices
      resultEq
    have telescopeCount : telescope.result.nindices =
        produced.candidate.families.head.familyType.type.trace.spineLength -
          source.nparams := by
      calc
        telescope.result.nindices = firstTrace.spineLength - source.nparams := by
          simpa using countEq
        _ = produced.candidate.families.head.familyType.type.trace.spineLength -
              source.nparams := by rw [firstTraceSpine]
    rw [comparisonResult] at installed
    have installed' : normalization.stats.nindices[0]? =
        some telescope.result.nindices := by
      simpa only [normalization,
        AddInductive.NormalizationCandidateExecution.familyValidationResult]
        using installed
    rw [installed']
    exact congrArg some (canonical.trans telescopeCount.symm).symm
  | laterFamily dIdx stats validationContext inBounds closed inferred root
      checkType rootWhnf telescope sorted ensureSort isLater
      resultLevelCompatible tail =>
    have first : telescope.result.stats.indConsts.isEmpty = true := by
      rw [telescope.result_indConsts_eq]
      rfl
    rw [first] at isLater
    contradiction
  | terminal dIdx stats validationContext outOfBounds =>
    simp at outOfBounds

/-- Compatibility form recovered through the second-family staging.  Unlike
later families, this count is still produced by replaying the
parameter-creating first telescope against its exact producer candidate. -/
theorem
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.canonicalFirstIndexCount_getElem?
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    (staging : produced.SecondFamilyIndexStaging semantic)
    (context_lctx_eq : context.lctx = {})
    {params : List VExpr}
    (paramsLength : params.length = source.nparams) :
    produced.execution.eliminationExecution.normalization.stats.nindices[0]? =
      some
        (ctorFields
          (VExpr.dropN source.nparams
            (canonicalizeFamilyParams source.nparams params
              staging.annotation.firstSemantic.view).type)).length := by
  let normalization :=
    produced.execution.eliminationExecution.normalization
  have normalizationProduced :=
    produced.execution.normalization_run produced.producedExecution
  have firstBound :=
    staging.annotation.first_nparams_le_spineLength context_lctx_eq
  have familyTypeFuel :=
    normalization.firstFamilyType_spineLength_lt_inductiveFuel
      normalizationProduced context_lctx_eq
  have firstFuel :
      staging.annotation.firstCandidate.familyType.type.trace.spineLength <
        context.fuel.inductiveFuel := by
    have candidateFuel :
        normalization.families.candidates.head.familyType.type.trace.spineLength <
          context.fuel.inductiveFuel := by
      rw [normalization.families.produced.head_familyType]
      exact familyTypeFuel
    have candidatesEq := staging.annotation.candidates_eq
    change normalization.families.candidates =
      .cons staging.annotation.firstCandidate
        (.cons staging.annotation.secondCandidate
          staging.annotation.remainingCandidates) at candidatesEq
    rw [candidatesEq] at candidateFuel
    exact candidateFuel
  have familyTypesProduced := normalization.familyTypes.produced
  rw [← normalization.families.produced.familyTypes_eq] at familyTypesProduced
  have candidatesEq := staging.annotation.candidates_eq
  change normalization.families.candidates =
    .cons staging.annotation.firstCandidate
      (.cons staging.annotation.secondCandidate
        staging.annotation.remainingCandidates) at candidatesEq
  rw [candidatesEq] at familyTypesProduced
  simp only [AddInductive.CandidateList.familyTypes] at familyTypesProduced
  have firstProduced := familyTypesProduced.head
  have candidateContextEq : { context with lctx := {} } = context := by
    cases context
    simp_all
  rw [candidateContextEq] at firstProduced
  have annotations :=
    staging.annotation.firstCandidate.familyType
      |>.validationAnnotations_of_normalize firstProduced
  have firstContextEq :=
    staging.annotation.firstCandidate.familyType
      |>.context_eq_of_normalize firstProduced
  let firstTrace : AddInductive.CandidateExprTrace context firstSource.type :=
    firstContextEq ▸
      staging.annotation.firstCandidate.familyType.type.trace
  have firstTraceSpine := candidateExprTrace_cast_context_spineLength
    firstContextEq staging.annotation.firstCandidate.familyType.type.trace
  have firstTraceBound : source.nparams ≤ firstTrace.spineLength := by
    rw [firstTraceSpine]
    exact firstBound
  have firstTraceFuel : firstTrace.spineLength <
      context.fuel.inductiveFuel := by
    rw [firstTraceSpine]
    exact firstFuel
  have firstTraceAnnotations : firstTrace.validationAnnotations := by
    simpa only [firstTrace] using
      (candidateExprTrace_cast_context_validationAnnotations
        firstContextEq annotations)
  have terminals := normalization.familyTerminals
  rw [← normalization.families.produced.familyTypes_eq] at terminals
  rw [candidatesEq] at terminals
  simp only [AddInductive.CandidateList.familyTypes] at terminals
  cases terminals with
  | cons firstTerminal remainingTerminals =>
    have firstTraceTerminal :=
      candidateExprTrace_cast_context_terminalResult firstContextEq
        staging.annotation.firstCandidate.familyType.type.trace
    have terminalForall :
        firstTrace.terminalResult.isForall = false := by
      rw [firstTraceTerminal, firstTerminal]
      rfl
    have canonical :=
      staging.annotation.firstSemantic.canonicalIndexCount firstTerminal
        staging.annotation.first_stored_spine paramsLength firstBound
    let comparisonTrace :=
      normalization.familyParameterComparisonTrace normalizationProduced
        produced.kernelSources_nonempty
    have comparisonResult : comparisonTrace.result =
        normalization.familyValidationResult :=
      AddInductive.FamilyValidationBlockRun.parameterComparisonTrace_result
        (normalization.familyValidationBlockRun normalizationProduced
          produced.kernelSources_nonempty)
    have blockSize :=
      normalization.validationNindicesSize_all normalizationProduced
    have resultSize : comparisonTrace.result.stats.nindices.size =
        (firstSource :: secondSource :: remainingSources).toArray.size := by
      rw [comparisonResult]
      change normalization.stats.nindices.size =
        (firstSource :: secondSource :: remainingSources).toArray.size
      simpa using blockSize
    obtain ⟨validation⟩ := staging.validationContinuation
    have secondSelected := validation.selected
    change comparisonTrace.secondContinuation? =
      some validation.continuation at secondSelected
    obtain ⟨first, firstSelected, _secondHeadSelected⟩ :=
      AddInductive.FamilyParameterComparisonBlockTrace.exists_predecessor_of_secondContinuation?
        secondSelected
    have firstSize : first.stats.nindices.size = first.dIdx := by
      rw [
        AddInductive.FamilyParameterComparisonBlockTrace.headContinuation?_stats
          firstSelected,
        AddInductive.FamilyParameterComparisonBlockTrace.headContinuation?_dIdx
          firstSelected]
      rfl
    have installed :=
      AddInductive.FamilyParameterComparisonBlockTrace.headContinuation?_result_nindices
        firstSelected firstSize resultSize
    generalize comparisonTrace_eq : comparisonTrace = validationTrace at comparisonResult
    rw [comparisonTrace_eq] at firstSelected installed
    cases validationTrace with
    | firstFamily dIdx stats validationContext inBounds closed inferred root
        checkType rootWhnf telescope sorted ensureSort isFirst tail =>
      simp only [
        AddInductive.FamilyParameterComparisonBlockTrace.headContinuation?]
          at firstSelected
      cases Option.some.inj firstSelected
      have candidateWhnf := firstTrace.rootWhnf_valid
      have candidateWhnf' : AddInductive.CandidateWhnfStep.Valid
          ⟨context, firstSource.type, firstTrace.rootWhnf⟩ := candidateWhnf
      have rootWhnf' : AddInductive.CandidateWhnfStep.Valid
          ⟨context, firstSource.type, root⟩ := by
        simpa using rootWhnf
      have root_eq : root = firstTrace.rootWhnf :=
        Except.ok.inj (rootWhnf'.symm.trans candidateWhnf')
      subst root
      have resultEq :=
        AddInductive.FamilyTypeParameterComparisonTrace.result_eq_candidate
          (nparams := source.nparams) (i := 0) (nindices := 0)
          (fuel := context.fuel.inductiveFuel)
          (stats := AddInductive.InductiveStats.initial
            (context.lparams.map .param))
          (context := context)
          (candidate := firstTrace)
          (trace := telescope) (remaining := source.nparams)
          (hi := by simp) (hcount := firstTraceBound)
          (hfuel := firstTraceFuel) (hempty := rfl)
          (hannotations := firstTraceAnnotations)
          (hterminal := terminalForall)
      have countEq := congrArg
        AddInductive.FamilyTypeParameterComparisonTrace.Result.nindices
        resultEq
      have telescopeCount : telescope.result.nindices =
          staging.annotation.firstCandidate.familyType.type.trace.spineLength -
            source.nparams := by
        calc
          telescope.result.nindices =
              firstTrace.spineLength - source.nparams := by
            simpa using countEq
          _ = staging.annotation.firstCandidate.familyType.type.trace.spineLength -
                source.nparams := by rw [firstTraceSpine]
      rw [comparisonResult] at installed
      have installed' : normalization.stats.nindices[0]? =
          some telescope.result.nindices := by
        simpa only [normalization,
          AddInductive.NormalizationCandidateExecution.familyValidationResult]
          using installed
      rw [installed']
      exact congrArg some (canonical.trans telescopeCount.symm).symm
    | laterFamily dIdx stats validationContext inBounds closed inferred root
        checkType rootWhnf telescope sorted ensureSort isLater
        resultLevelCompatible tail =>
      have first : telescope.result.stats.indConsts.isEmpty = true := by
        rw [telescope.result_indConsts_eq]
        rfl
      rw [first] at isLater
      contradiction
    | terminal dIdx stats validationContext outOfBounds =>
      simp at outOfBounds

/-- Exact producer-owned endpoint package for the second-family index suffix.
The retained prefix context is the original shared-parameter base, while the
alignment records its embedding through every first- and second-family index
local present at the final validator boundary. -/
structure
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.IndexDomainCompletion
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    (staging : produced.SecondFamilyIndexStaging semantic)
    (seed : Option staging.annotation.RawFirstIndexDomain) where
  prefixes : staging.FirstParameterAnchor
  exactTargets : List VExpr
  exactTargets_eq : exactTargets =
    staging.annotation.storedBinders.drop source.nparams
  exactFinal : VLCtx
  exactTrace : staging.boundary.ExactIndexDomainTrace env Us
    prefixes.firstParameterΔ exactTargets exactFinal
  chain : staging.boundary.IndexDomainChain
  exactTrace_chain : exactTrace.chain = chain
  chain_length : chain.length =
    (staging.annotation.storedBinders.drop source.nparams).length
  alignment : chain.EndpointAlignment env Us
    staging.annotation.terminalRun.context.vlctx prefixes.firstParameterΔ
      staging.annotation.firstTerminalRun.context.vlctx
  alignment_base : alignment.base = exactFinal
  alignment_sort_translation : ∃ resultLevel,
    staging.annotation.secondCandidate.familyType.type.trace.terminalResult =
        .sort resultLevel ∧
      VLevel.ofLevel Us resultLevel = some alignment.sort

/-- A completed index chain whose retained endpoint is also the validator's
exact terminal node.  This is the source-order handoff consumed by the next
family. -/
structure
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    (staging : produced.SecondFamilyIndexStaging semantic)
    (seed : Option staging.annotation.RawFirstIndexDomain)
    extends staging.IndexDomainCompletion seed where
  terminal : toIndexDomainCompletion.chain.endpoint.boundary.Terminal

/-- The exact verified context at the second family validator's continuation
point. -/
def
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion.terminalRun
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {staging : produced.SecondFamilyIndexStaging semantic}
    {raw : Option staging.annotation.RawFirstIndexDomain}
    (completion : staging.TerminalIndexDomainCompletion raw) :
    TypeChecker.CandidateContextRun staging.position.trace.result.context :=
  completion.chain.endpointContextRun completion.terminal

/-- The second family's retained validator count is exactly the number of
post-parameter binders in its normalized annotation telescope. -/
theorem
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion.result_nindices_eq
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {staging : produced.SecondFamilyIndexStaging semantic}
    {raw : Option staging.annotation.RawFirstIndexDomain}
    (completion : staging.TerminalIndexDomainCompletion raw) :
    staging.position.trace.result.nindices =
      (staging.annotation.storedBinders.drop source.nparams).length := by
  calc
    staging.position.trace.result.nindices =
        completion.chain.endpoint.boundary.trace.result.nindices :=
      congrArg AddInductive.FamilyTypeParameterComparisonTrace.Result.nindices
        completion.chain.endpoint_result_eq.symm
    _ = completion.chain.endpoint.nindices :=
      completion.terminal.result_nindices_eq
    _ = staging.position.nindices + completion.chain.length :=
      completion.chain.endpoint_nindices
    _ = 0 + completion.chain.length :=
      congrArg (fun count => count + completion.chain.length)
        staging.position_nindices_eq
    _ = completion.chain.length := Nat.zero_add _
    _ = (staging.annotation.storedBinders.drop source.nparams).length :=
      completion.chain_length

/-- The exact validator count for the second family is the index count stored
in that family's canonical Theory header. -/
theorem
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion.canonicalSecondIndexCount
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {staging : produced.SecondFamilyIndexStaging semantic}
    {raw : Option staging.annotation.RawFirstIndexDomain}
    (completion : staging.TerminalIndexDomainCompletion raw)
    {params : List VExpr}
    (paramsLength : params.length = source.nparams) :
    (ctorFields
      (VExpr.dropN source.nparams
        (canonicalizeFamilyParams source.nparams params
          staging.annotation.secondSemantic.view).type)).length =
      staging.position.trace.result.nindices := by
  obtain ⟨kernelLevel, terminal⟩ := staging.annotation.terminal_sort
  have canonical :=
    staging.annotation.secondSemantic.canonicalIndexCount terminal
      staging.annotation.secondShape.storedSpine paramsLength
      staging.annotation.second_nparams_le_spineLength
  have storedLength : staging.annotation.storedBinders.length =
      staging.annotation.secondCandidate.familyType.type.trace.spineLength :=
    staging.annotation.stored_length.trans
      staging.annotation.spineLength_eq.symm
  have suffixLength :
      (staging.annotation.storedBinders.drop source.nparams).length =
        staging.annotation.secondCandidate.familyType.type.trace.spineLength -
          source.nparams := by
    simp only [List.length_drop, storedLength]
  calc
    (ctorFields
      (VExpr.dropN source.nparams
        (canonicalizeFamilyParams source.nparams params
          staging.annotation.secondSemantic.view).type)).length =
        staging.annotation.secondCandidate.familyType.type.trace.spineLength -
          source.nparams := canonical
    _ = (staging.annotation.storedBinders.drop source.nparams).length :=
      suffixLength.symm
    _ = staging.position.trace.result.nindices :=
      completion.result_nindices_eq.symm

/-- The terminal validator statistics store the second canonical family's
header count at source ordinal one. -/
theorem
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion.canonicalSecondIndexCount_getElem?
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {staging : produced.SecondFamilyIndexStaging semantic}
    {raw : Option staging.annotation.RawFirstIndexDomain}
    (completion : staging.TerminalIndexDomainCompletion raw)
    {params : List VExpr}
    (paramsLength : params.length = source.nparams) :
    produced.execution.eliminationExecution.normalization.stats.nindices[1]? =
      some
        (ctorFields
          (VExpr.dropN source.nparams
            (canonicalizeFamilyParams source.nparams params
              staging.annotation.secondSemantic.view).type)).length := by
  let normalization :=
    produced.execution.eliminationExecution.normalization
  let blockRun := normalization.familyValidationBlockRun
    (produced.execution.normalization_run produced.producedExecution)
    produced.kernelSources_nonempty
  let comparisonTrace := normalization.familyParameterComparisonTrace
    (produced.execution.normalization_run produced.producedExecution)
    produced.kernelSources_nonempty
  obtain ⟨validation⟩ := staging.validationContinuation
  have comparisonResult : comparisonTrace.result =
      normalization.familyValidationResult :=
    AddInductive.FamilyValidationBlockRun.parameterComparisonTrace_result _
  have blockSize := blockRun.nindices_size
  change normalization.stats.nindices.size =
    (firstSource :: secondSource :: remainingSources).length at blockSize
  have resultSize : comparisonTrace.result.stats.nindices.size =
      (firstSource :: secondSource :: remainingSources).toArray.size := by
    rw [comparisonResult]
    change normalization.stats.nindices.size =
      (firstSource :: secondSource :: remainingSources).toArray.size
    simpa using blockSize
  have installed := comparisonTrace.secondContinuation?_result_nindices
    validation.selected (by rfl) resultSize
  have telescopeCount :
      validation.continuation.telescope.result.nindices =
        staging.position.trace.result.nindices := by
    change validation.continuation.position.trace.result.nindices =
      staging.position.trace.result.nindices
    exact congrArg
      (fun position :
        AddInductive.FamilyParameterComparisonBlockTrace.FamilyTelescopePosition
          source.nparams => position.trace.result.nindices)
      validation.position_eq
  rw [comparisonResult] at installed
  have installed' :
      normalization.stats.nindices[1]? =
        some staging.position.trace.result.nindices := by
    simpa only [normalization,
      AddInductive.NormalizationCandidateExecution.familyValidationResult,
      Nat.zero_add, telescopeCount]
      using installed
  rw [installed']
  exact congrArg some (completion.canonicalSecondIndexCount paramsLength).symm

/-- Source-ordered reconstruction of the first family's exact shared
parameter context.  This turns the stored reverse `VLCtx` inventory back into
the forward parameter/type pairing consumed by constructor-prefix folding. -/
theorem
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion.firstParameterContext
    {source : VInductDecl}
