    List.All (fun resultLevel => resultLevel ≈
        produced.canonicalResultLevel semantic context_lctx_eq)
      (support.canonicalCheckedFamiliesOfEvidence stagingInput safetyEq
        evidence).resultLevels := by
  rw [CheckedFamilies.resultLevels_eq_map_sortLevel]
