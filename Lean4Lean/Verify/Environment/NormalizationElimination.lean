/-- The support-selected canonical block has passed the complete executable
mixed raw/view generation gate. -/
noncomputable def
    ProducedBlockRecursorShapeCandidate.CanonicalFamilyAssemblySupport.canonicalBlockGenerationChecked
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {context_lctx_eq : context.lctx = {}}
    (support : produced.CanonicalFamilyAssemblySupport semantic
      context_lctx_eq)
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (safetyEq :
      produced.execution.eliminationExecution.normalization.validationContext.safety =
        context.safety)
    (audit : ProducedBlockRecursorStage3AuditRun produced Us) :
    BlockGenerationChecked source where
  validated := support.canonicalValidatedBlock stagingInput safetyEq audit
  shape_eq := support.canonicalBlockGenerationShape stagingInput safetyEq audit
  fieldSorts? :=
    let validation :=
      produced.execution.eliminationExecution.normalization
        |>.constructorValidation.traces
    let success :=
      (support.canonicalCheckedBlockConstructorRuns stagingInput safetyEq
        audit).2.1
    some ((validation.fieldSorts? Us).get success)
  eliminationResult? :=
    some produced.execution.eliminationExecution.elimination.large.result
  kTargetResult? :=
    some produced.execution.eliminationExecution.kTarget.result
  generatedParams := support.basis.storedTypes
  generatedParams_length := support.basis.storedCanonical.length_eq.trans
    (produced.semanticViewParams_length semantic context_lctx_eq)
  generatedIndices := fun family =>
    (support.annotations.generatedIndexSurfaces[family.view.ordinal]?).getD
      (family.rawIndices source.nparams)

/-- Interpret every family and constructor of the support-owned canonical
layout, yielding the ordinary block-generation semantic run. -/
noncomputable def
    ProducedBlockRecursorShapeCandidate.CanonicalFamilyAssemblySupport.canonicalBlockGenerationRun
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {context_lctx_eq : context.lctx = {}}
    (support : produced.CanonicalFamilyAssemblySupport semantic
      context_lctx_eq)
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (safetyEq :
      produced.execution.eliminationExecution.normalization.validationContext.safety =
        context.safety)
    (audit : ProducedBlockRecursorStage3AuditRun produced Us) :
    BlockGenerationRun
      (support.canonicalBlockGenerationChecked stagingInput safetyEq audit)
      env blockEnv := by
  let generation :=
    support.canonicalBlockGenerationChecked stagingInput safetyEq audit
  let checked := support.canonicalCheckedFamilies stagingInput safetyEq audit
  have henv : env.WF := by
    simpa only [support.basis.contextRun.venv_eq] using
      support.basis.contextRun.candidate.context.Ewf
  have commonResultLevelWF :=
    produced.canonicalResultLevel_wf semantic context_lctx_eq
  have normalizationRun := support.basis.canonicalNormalizationBlockRun
    stagingInput safetyEq support.familyTypes
      (produced.semanticViewParams_length semantic context_lctx_eq)
  let constructorRuns := Classical.choice
    ((support.canonicalCheckedBlockConstructorRuns stagingInput safetyEq
      audit).1)
  let checkedRuns := support.canonicalCheckedFamilyRuns stagingInput safetyEq
    audit constructorRuns
  have checkedWF :
      (support.canonicalCheckedBlock stagingInput safetyEq audit).WF env
        (produced.canonicalResultLevel semantic context_lctx_eq) :=
    support.canonicalCheckedBlockWF_of_constructorRuns stagingInput safetyEq
      audit constructorRuns
  have shapes := semantic.generationShapes produced.shape
  have familyParameters := support.parameterDefEqs
  let inventory := Classical.choice
    (ConstructorRawPreFamilyParameterAuditBasis.constructorValidationSemanticState
      (produced := produced) (semantic := semantic) support.basis stagingInput
        safetyEq audit.alignmentRun)
  have hblockEnv : blockEnv.WF := by
    simpa only [inventory.semantic.contextRun.venv_eq] using
      inventory.semantic.contextRun.candidate.context.Ewf
  have storedConstructors := inventory.storedParameterDefEqLists
    support.basis.params
  have canonicalStored :=
    (support.basis.storedCanonical.symm henv trivial).mono
      (VEnv.stageInductiveTypes_le stagingInput.stage)
  have constructorParameters :=
    storedConstructors.precompose canonicalStored hblockEnv
  have firstParams : generation.block.checked.params =
      VExpr.telN source.nparams support.firstView := by
    exact support.params_eq
  have generationFamilies :
      pairNormalizedFamilies source.types checked.data =
        generation.families := by
    rfl
  let aligned :=
    CandidateCanonicalBlockNormalizedFamilyRunList.ofCheckedAux
      (generation := generation) shapes familyParameters constructorParameters
      checked checkedRuns firstParams semantic.uvars_eq
      (fun family member => by
        rw [← generationFamilies]
        exact member)
  have aligned' : CandidateCanonicalBlockNormalizedFamilyRunList generation
      env blockEnv Us semantic.families generation.families := by
    rw [← generationFamilies]
    exact aligned
  have checkedWF' : generation.block.checked.WF env
      generation.validated.resultLevel := by
    simpa only [generation, canonicalBlockGenerationChecked,
      canonicalValidatedBlock, canonicalNormalizedCheckedBlock] using checkedWF
  have normalizationRun' : NormalizationBlockRun
      generation.block.normalization env blockEnv := by
    simpa only [generation, canonicalBlockGenerationChecked,
      canonicalValidatedBlock, canonicalNormalizedCheckedBlock] using
      normalizationRun
  have commonResultLevelWF' : generation.validated.resultLevel.WF
      source.uvars := by
    simpa only [generation, canonicalBlockGenerationChecked,
      canonicalValidatedBlock] using commonResultLevelWF
  have generatedParamsTel' : TypeChecker.TelDefEqEvidence env source.uvars []
      generation.generatedParams generation.block.checked.params := by
    rw [firstParams, ← support.params_eq]
    simpa only [generation, canonicalBlockGenerationChecked,
      semantic.uvars_eq] using support.basis.storedCanonical
  have generatedIndexTelescopes :=
    support.annotations.generatedIndicesTel aligned' henv
      commonResultLevelWF' generatedParamsTel' (fun _ member => member)
  have generatedIndicesTel' : ∀ family ∈ generation.families,
      TypeChecker.TelDefEqEvidence env source.uvars
        generation.generatedParams.reverse
        (family.rawIndices source.nparams)
        (generation.generatedIndices family) := by
    intro family member
    obtain ⟨indices, indicesAt, indicesTel⟩ :=
      Lean4Lean.List.Forall₂.getElem?_left generatedIndexTelescopes
        (generation.family_getElem?_ordinal member)
    change TypeChecker.TelDefEqEvidence env source.uvars
      generation.generatedParams.reverse
      (family.rawIndices source.nparams)
      ((support.annotations.generatedIndexSurfaces[
        family.view.ordinal]?).getD (family.rawIndices source.nparams))
    rw [indicesAt]
    exact indicesTel
  let paramsTel := aligned'.paramsTel henv commonResultLevelWF'
  let constructorRuns := aligned'.constructorRuns normalizationRun'
    commonResultLevelWF' paramsTel
  have generatedParamsTelBlock := generatedParamsTel'.mono
    (VEnv.stageInductiveTypes_le normalizationRun'.stage)
  have generatedFieldsTel' : ∀ constructor ∈ generation.flatCtors,
      TypeChecker.TelDefEqEvidence blockEnv source.uvars
        generation.generatedParams.reverse
        (constructor.ctor.rawFields source.nparams)
        (generation.generatedFields constructor) := by
    intro constructor member
    simpa only [generation, canonicalBlockGenerationChecked] using
      (constructorRuns.get constructor member).rawFieldsTel_refl hblockEnv
        generatedParamsTelBlock
  simpa only [generation] using aligned'.blockGenerationRun normalizationRun'
    checkedWF' henv commonResultLevelWF' generatedParamsTel'
      generatedIndicesTel' generatedFieldsTel'

/-- The exact singleton decisions retained by semantic generation and the
structural mutual fallback both agree with the producer's ordinary
elimination execution. -/
noncomputable def
    ProducedBlockRecursorShapeCandidate.CanonicalFamilyAssemblySupport.canonicalBlockEliminationRun
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {context_lctx_eq : context.lctx = {}}
    (support : produced.CanonicalFamilyAssemblySupport semantic
      context_lctx_eq)
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (safetyEq :
      produced.execution.eliminationExecution.normalization.validationContext.safety =
        context.safety)
    (audit : ProducedBlockRecursorStage3AuditRun produced Us) :
    AddInductive.CheckerBlockEliminationRun
      (support.canonicalBlockGenerationChecked stagingInput safetyEq audit)
      produced.execution.eliminationExecution := by
  let generation :=
    support.canonicalBlockGenerationChecked stagingInput safetyEq audit
  let execution := produced.execution.eliminationExecution
  let normalization := execution.normalization
  have sourceLength : source.types.length = kernelSources.length := by
    have namesLength := congrArg List.length
      semantic.families.rawHeaderNames.1
    simpa using namesLength
  have familyLength : generation.families.length = source.types.length :=
    generation.shape.2.2.1
  have canonicalNonzero : generation.validated.resultLevel.isNeverZero =
      normalization.stats.isNotZero := by
    simpa only [generation, canonicalBlockGenerationChecked,
      canonicalValidatedBlock] using
      produced.canonicalResultLevel_isNeverZero_eq semantic context_lctx_eq
  have mode : generation.elimination =
      ElimMode.ofBool execution.elimination.large.result := by
    obtain ⟨firstSource, remainingSources, sources_eq⟩ :=
      list_eq_cons_of_isEmpty_false kernelSources
        produced.kernelSources_nonempty
    subst kernelSources
    cases remainingSources with
    | nil =>
        have one : generation.families.length = 1 := by
          rw [familyLength, sourceLength]
          rfl
        obtain ⟨family, families_eq⟩ := List.length_eq_one_iff.mp one
        have retained : generation.eliminationResult? =
            some execution.elimination.large.result := by
          rfl
        unfold BlockGenerationChecked.elimination
        rw [canonicalNonzero]
        cases nonzero : normalization.stats.isNotZero with
        | false =>
            simp only [nonzero, Bool.false_eq_true, if_false, families_eq,
              retained, Option.some.injEq]
        | true =>
            have resultTrue : execution.elimination.large.result = true := by
              have run := execution.elimination.large.run_eq
              unfold AddInductive.isLargeEliminator at run
              rw [nonzero] at run
              change Except.ok true =
                Except.ok execution.elimination.large.result at run
              exact Except.ok.inj run.symm
            simp only [nonzero, if_true, resultTrue, ElimMode.ofBool_true]
    | cons secondSource rest =>
        have two : 2 ≤ generation.families.length := by
          rw [familyLength, sourceLength]
          simp
        have largeResult : execution.elimination.large.result =
            normalization.stats.isNotZero :=
          execution.elimination.large.result_eq_isNotZero_of_two
        calc
          generation.elimination =
              ElimMode.ofBool generation.validated.resultLevel.isNeverZero :=
            generation.elimination_eq_ofBool_isNeverZero_of_two two
          _ = ElimMode.ofBool execution.elimination.large.result := by
            rw [largeResult, canonicalNonzero]
  have kMode : generation.kTarget = execution.kTarget.result := by
    obtain ⟨firstSource, remainingSources, sources_eq⟩ :=
      list_eq_cons_of_isEmpty_false kernelSources
        produced.kernelSources_nonempty
    subst kernelSources
    cases remainingSources with
    | nil =>
        have one : generation.families.length = 1 := by
          rw [familyLength, sourceLength]
          rfl
        obtain ⟨family, families_eq⟩ := List.length_eq_one_iff.mp one
        have retained : generation.kTargetResult? =
            some execution.kTarget.result := by
          rfl
        unfold BlockGenerationChecked.kTarget
        rw [families_eq, retained]
        rfl
    | cons secondSource rest =>
        have two : 2 ≤ generation.families.length := by
          rw [familyLength, sourceLength]
          simp
        have kKernel : execution.kTarget.result = false :=
          execution.kTarget.result_eq_false_of_two
        have kTheory : generation.kTarget = false :=
          generation.kTarget_eq_false_of_two two
        exact kTheory.trans kKernel.symm
  have recAudit :=
    AddInductive.checkBlockRecursorUniverseSemantics_of_run
      audit.recUniverseRun
  refine {
    nparams_eq := rfl
    sourceUvars_eq := ?_
    mode_eq := mode
    kTarget_eq := kMode
    recUvars_eq := ?_
    recLevels_eq := ?_ }
  · calc
      source.uvars = Us.length := stagingInput.uvars_eq
      _ = normalization.validationContext.lparams.length := by
        rw [stagingInput.validation_lparams_eq]
  · cases large : execution.elimination.large.result with
    | false =>
        have modeSmall : generation.elimination = ElimMode.small := by
          simpa [large] using mode
        change generation.elimination.recUvars source.uvars =
          execution.recLevelParams.length
        rw [modeSmall]
        change source.uvars = execution.recLevelParams.length
        have recArity := recAudit.1
        simpa only [execution, large, Bool.false_eq_true, if_false,
          Nat.add_zero] using recArity.symm
    | true =>
        have modeLarge : generation.elimination = ElimMode.large := by
          simpa [large] using mode
        change generation.elimination.recUvars source.uvars =
          execution.recLevelParams.length
        rw [modeLarge]
        change source.uvars + 1 = execution.recLevelParams.length
        have recArity := recAudit.1
        simpa only [execution, large, if_true] using recArity.symm
  · cases large : execution.elimination.large.result with
    | false =>
        have modeSmall : generation.elimination = ElimMode.small := by
          simpa [large] using mode
        change execution.recLevels.mapM
            (VLevel.ofLevel execution.recLevelParams) =
          some (generation.elimination.recLevels source.uvars)
        rw [modeSmall]
        change execution.recLevels.mapM
            (VLevel.ofLevel execution.recLevelParams) =
          some (VLevel.params source.uvars)
        have recLevels := recAudit.2
        simpa only [execution, large, Bool.false_eq_true, if_false,
          Nat.add_zero] using recLevels
    | true =>
        have modeLarge : generation.elimination = ElimMode.large := by
          simpa [large] using mode
        change execution.recLevels.mapM
            (VLevel.ofLevel execution.recLevelParams) =
          some (generation.elimination.recLevels source.uvars)
        rw [modeLarge]
        change execution.recLevels.mapM
            (VLevel.ofLevel execution.recLevelParams) =
          some (VLevel.params (source.uvars + 1))
        have recLevels := recAudit.2
        simpa only [execution, large, if_true] using recLevels

/-- Package shape-neutral canonical generation, constructor universes, and
ordinary elimination alignment at the public semantic boundary. -/
noncomputable def
    ProducedBlockRecursorShapeCandidate.CanonicalFamilyAssemblySupport.canonicalProducedBlockEliminationRun
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {context_lctx_eq : context.lctx = {}}
    (support : produced.CanonicalFamilyAssemblySupport semantic
      context_lctx_eq)
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (safetyEq :
      produced.execution.eliminationExecution.normalization.validationContext.safety =
        context.safety)
    (audit : ProducedBlockRecursorStage3AuditRun produced Us) :
    ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic
      (support.canonicalBlockGenerationChecked stagingInput safetyEq audit) where
  blockEnv_wf := by
    let inventory := Classical.choice
      (ConstructorRawPreFamilyParameterAuditBasis.constructorValidationSemanticState
        (produced := produced) (semantic := semantic) support.basis
          stagingInput safetyEq audit.alignmentRun)
    simpa only [inventory.semantic.contextRun.venv_eq] using
      inventory.semantic.contextRun.candidate.context.Ewf
  block := support.canonicalBlockGenerationRun stagingInput safetyEq audit
  elimination := support.canonicalBlockEliminationRun stagingInput safetyEq
    audit
  isUnsafe_eq := by
    calc
      isUnsafe = (context.safety != .safe) := produced.execution.isUnsafe_eq
      _ = false := by rw [stagingInput.context_safety_eq]; rfl
  validation_lparams_eq := stagingInput.validation_lparams_eq
  validation_safety_eq := safetyEq.trans stagingInput.context_safety_eq
  rawIndexCounts := by
    let normalization :=
      produced.execution.eliminationExecution.normalization
    let params := blockParams source.nparams semantic.families.views
    have paramsLength : params.length = source.nparams :=
      produced.semanticViewParams_length semantic context_lctx_eq
    have shapes := semantic.generationShapes produced.shape
    have headersEq := semantic.families.familyHeaders_canonicalize shapes
      normalization.familyParameterSpines normalization.familyTerminalSorts
      paramsLength
    exact support.indexCounts.of_familyHeaders_eq headersEq
  fieldSorts_isSome :=
    (support.canonicalCheckedBlockConstructorRuns stagingInput safetyEq
      audit).2.1
  fieldSortTelescopes :=
    (support.canonicalCheckedBlockConstructorRuns stagingInput safetyEq
      audit).2.2 _

/-- Select the support-owned canonical generation and semantic elimination
run as one dependent recursor result. -/
noncomputable def
    ProducedBlockRecursorShapeCandidate.CanonicalFamilyAssemblySupport.canonicalProducedBlockSemanticRecursorRun
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {context_lctx_eq : context.lctx = {}}
    (support : produced.CanonicalFamilyAssemblySupport semantic
      context_lctx_eq)
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (safetyEq :
      produced.execution.eliminationExecution.normalization.validationContext.safety =
        context.safety)
    (audit : ProducedBlockRecursorStage3AuditRun produced Us) :
    ProducedBlockSemanticRecursorRun env blockEnv Us produced semantic where
  generation := support.canonicalBlockGenerationChecked stagingInput safetyEq
    audit
  run := support.canonicalProducedBlockEliminationRun stagingInput safetyEq
    audit

/-- A completed mutual traversal constructs the same shape-neutral family
assembly contract as the singleton first-family owner. -/
noncomputable def
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion.canonicalFamilyAssemblySupport
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {staging : produced.SecondFamilyIndexStaging semantic}
    {raw : Option staging.annotation.RawFirstIndexDomain}
    (completion : staging.TerminalIndexDomainCompletion raw)
    (context_lctx_eq : context.lctx = {}) :
    produced.CanonicalFamilyAssemblySupport semantic context_lctx_eq := by
  have paramsLength :=
    produced.semanticViewParams_length semantic context_lctx_eq
  have paramsEq : blockParams source.nparams semantic.families.views =
      VExpr.telN source.nparams
        staging.annotation.firstSemantic.type.view := by
    unfold blockParams
    rw [staging.annotation.semantic_views_eq]
    rfl
  let basis := Classical.choice
    (completion.rawParameterAuditBasis_nonempty context_lctx_eq)
  let owner := Classical.choice
    (produced.semanticFirstFamilyAnnotationSpine semantic)
  exact {
    generationShapes := owner.generationShapes
    annotations := owner.annotations
    firstView := staging.annotation.firstSemantic.type.view
    params_eq := paramsEq
    parameterDefEqs :=
      completion.viewParameterTelescopeDefEqList context_lctx_eq
    validation_safety := completion.blockValidationContext_safety
    basis := by simpa only [paramsEq] using basis
    familyTypes := completion.canonicalFamilyTypeDefEqs context_lctx_eq
    indexCounts :=
      completion.canonicalFamilyIndexCounts context_lctx_eq paramsLength
    resultLevels :=
      completion.canonicalFamilyResultLevelsCanonical context_lctx_eq
        paramsLength }

/-- Every nonempty retained producer owns a shape-neutral canonical family
assembly package, selected internally from its singleton or mutual traversal. -/
theorem
    ProducedBlockRecursorShapeCandidate.canonicalFamilyAssemblySupport_nonempty
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    {env blockEnv : VEnv} {Us : List Name}
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source)
    (context_lctx_eq : context.lctx = {}) :
    Nonempty (produced.CanonicalFamilyAssemblySupport semantic
      context_lctx_eq) := by
  cases kernelSources with
  | nil =>
      have nonempty := produced.kernelSources_nonempty
      simp at nonempty
  | cons firstSource laterSources =>
      cases laterSources with
      | nil =>
          obtain ⟨owner⟩ :=
            produced.semanticFirstFamilyAnnotationSpine semantic
          exact ⟨owner.singletonCanonicalFamilyAssemblySupport
            context_lctx_eq⟩
      | cons secondSource remainingSources =>
          obtain ⟨staging⟩ :=
            produced.semanticSecondFamilyIndexStaging semantic context_lctx_eq
          let completed := Classical.choice
            (staging.anyTerminalIndexDomainCompletion context_lctx_eq)
          exact ⟨completed.completion.canonicalFamilyAssemblySupport
            context_lctx_eq⟩

/-- Canonical family assembly selected without exposing the source-list case
split or a family/index traversal witness. -/
noncomputable def
    ProducedBlockRecursorShapeCandidate.canonicalFamilyAssemblySupport
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    {env blockEnv : VEnv} {Us : List Name}
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source)
    (context_lctx_eq : context.lctx = {}) :
    produced.CanonicalFamilyAssemblySupport semantic context_lctx_eq :=
  Classical.choice
    (produced.canonicalFamilyAssemblySupport_nonempty semantic context_lctx_eq)

/-- Total canonical semantic recursor assembly for every retained nonempty
ordinary producer. -/
noncomputable def
    ProducedBlockRecursorShapeCandidate.canonicalProducedBlockSemanticRecursorRunOfAudit
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    {env blockEnv : VEnv} {Us : List Name}
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source)
    (context_lctx_eq : context.lctx = {})
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (audit : ProducedBlockRecursorStage3AuditRun produced Us) :
    ProducedBlockSemanticRecursorRun env blockEnv Us produced semantic :=
  let support := produced.canonicalFamilyAssemblySupport semantic
    context_lctx_eq
  support.canonicalProducedBlockSemanticRecursorRun stagingInput
    support.validation_safety audit

/-- Total projection-aware semantic recursor selection for every retained
nonempty producer.  The input semantic supplies family-side staging; the
resolved construction trace owns the selected constructor interpretation. -/
noncomputable def
    ProducedBlockRecursorShapeCandidate.canonicalProducedBlockSemanticRecursorSelectionOfResolvedAudit
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    {env blockEnv : VEnv} {Us : List Name}
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source)
    (context_lctx_eq : context.lctx = {})
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (audit : ProducedBlockRecursorResolvedCoreAuditRun produced Us) :
    Σ selected : NormalizationCandidateBlockSemanticRun env blockEnv Us
        produced.candidate source,
      ProducedBlockSemanticRecursorRun env blockEnv Us produced selected :=
  let support := produced.canonicalFamilyAssemblySupport semantic
    context_lctx_eq
  support.canonicalProducedBlockSemanticRecursorSelectionOfResolvedAudit
    stagingInput support.validation_safety audit

