  indexCounts := owner.singletonCanonicalFamilyIndexCounts context_lctx_eq
    (produced.semanticViewParams_length semantic context_lctx_eq)
  resultLevels := owner.singletonCanonicalFamilyResultLevels context_lctx_eq
    (produced.semanticViewParams_length semantic context_lctx_eq)

