    (suffixDrop : globalSuffixes.drop owner = suffixes.values)
    (indicesDrop : globalIndices.drop owner = checked.indices)
    (sourceUvars : source.uvars = Us.length)
    (sourceNparams : source.nparams = stats.params.size)
    (resultLevelTr : VLevel.ofLevel Us stats.resultLevel = some resultLevel)
    (familyFresh : ∀ name, name ∈ familyNames source.types →
      env.constants name = none)
    (familyNodup : (familyNames source.types).Nodup)
    (universeSemantics : validation.universeSemantics = true) :
    Nonempty (CheckedBlockConstructorRunList env resultLevel globalIndices
        checked) ∧
      CheckedBlockFieldSortTelescopes blockEnv Us.length params checked
        d2Runs.fieldSorts := by
  induction translations with
  | nil =>
      cases d3Runs
      cases stage
      cases d2Runs
      cases constructorParameters
      cases canonicalStage
      exact ⟨⟨.nil⟩, .nil⟩
  | @cons ordinal kernelSource kernelSources candidate candidates raw raws
      semantic semanticTail translationUnique ownerSuffix parameters
      suffixTail checkedHead checkedTail headDefEq tailDefEq suffixUnique
      suffixTranslation tailTranslations ih =>
      cases d3Runs with
      | @cons _ _ _ _ _ _ _ _ _ d3OwnerSuffix d3Parameters d3HeadTrace
          d3TailTrace d3Head d3Tail =>
        have ownerSuffixEq : d3OwnerSuffix = ownerSuffix :=
          Except.ok.inj (d3Parameters.symm.trans parameters)
        subst d3OwnerSuffix
        cases stage with
        | cons stageHead stageTail =>
          cases d2Runs with
          | cons d2Head d2Tail =>
            cases constructorParameters with
            | cons headParameters tailParameters =>
              cases canonicalStage with
              | cons canonicalHead canonicalTail =>
                simp only [
                  AddInductive.ConstructorBlockValidationTraces.universeSemantics,
                  Bool.and_eq_true] at universeSemantics
                have ownerAt : globalSuffixes[ordinal]? = some ownerSuffix :=
                  list_getElem?_eq_some_of_drop_eq_cons suffixDrop
                have ownerIndicesAt : globalIndices[ordinal]? =
                    some checkedHead.indices :=
                  list_getElem?_eq_some_of_drop_eq_cons indicesDrop
                have stageAccepted : List.All (fun constructor =>
                    blockStage3Ctor source.uvars source.nparams
                      (familyHeaders source.nparams source.types)
                      (familyNames source.types) ordinal 0
                      (VExpr.dropN source.nparams constructor.type) = true)
                    (semantic.constructors.roots.views.map
                      (canonicalizeConstructorParams source.nparams params)) := by
                  apply list_all_of_mem
                  intro constructor member
                  apply canonicalHead constructor
                  simpa only [canonicalizeFamilyParams,
                    CandidateBlockFamilySemanticRun.view] using member
                have headRuns :=
                  semantic.constructors.checkedBlockConstructorsWF d3Head
                    stageHead d2Head headParameters henv hblockEnv addType
                    parameterContext parameterWF d3State analyzerState ngenEq
                    targets ownerAt ownerIndicesAt sourceUvars sourceNparams
                    resultLevelTr familyFresh familyNodup universeSemantics.1
                    stageAccepted
                have constructorsEq : checkedHead.constructors =
                    ((semantic.constructors.roots.views.map
                      (canonicalizeConstructorParams source.nparams params)).map
                        (CheckedCtor.ofBlock source)) := by
                  simpa only [CheckedFamily.constructors_eq,
                    canonicalizeFamilyParams,
                    CandidateBlockFamilySemanticRun.view] using
                    checkedHead.constructors_eq
                have headProof : ∀ constructor ∈ checkedHead.constructors,
                    checkedBlockFieldsWF env source.uvars resultLevel
                        globalIndices constructor.fields constructor.recursiveAt
                        params.reverse 0 ∧
                      env.SpineWF source.uvars
                        (constructor.fields.reverse ++ params.reverse)
                        (VExpr.forallN
                          (VExpr.liftTelN constructor.fields.length
                            checkedHead.indices 0)
                          (.sort resultLevel))
                        constructor.resultIndices (.sort resultLevel) := by
                  intro constructor member
                  rw [constructorsEq] at member
                  exact list_all_mem_stage3 headRuns.1 constructor member
                have headFieldSorts : List.Forall₂
                    (fun constructor sorts =>
                      blockEnv.OnSortTel Us.length params.reverse
                        constructor.fields sorts)
                    checkedHead.constructors d2Head.fieldSorts := by
                  rw [constructorsEq]
                  exact headRuns.2
                obtain ⟨⟨tailRuns⟩, tailFieldSorts⟩ :=
                  ih d3Tail stageTail d2Tail tailParameters canonicalTail
                    (list_drop_succ_eq_of_drop_eq_cons suffixDrop)
                    (list_drop_succ_eq_of_drop_eq_cons indicesDrop)
                    universeSemantics.2
                exact ⟨⟨.cons headProof tailRuns⟩,
                  .cons headFieldSorts tailFieldSorts⟩

/-- Family-major erasure of resolved structural traces to their exact
constructor suffix inventories. -/
def _root_.Lean4Lean.AddInductive.ConstructorBlockStage3ResolvedTraces.suffixes
    {stats : AddInductive.InductiveStats} {owner : Nat}
    {kernelSources : List InductiveType}
    {candidates : AddInductive.CandidateList AddInductive.CandidateFamily
      kernelSources} :
    AddInductive.ConstructorBlockStage3ResolvedTraces stats
        (owner := owner) candidates →
      List (List Expr)
  | .nil => []
  | .cons head tail => head.suffixes :: tail.suffixes

/-- Family-indexed block replay over construction-owned constructor
endpoints.  The checked-family index contributes only its canonical family
indices; constructor syntax is retained separately in `endpoints`. -/
inductive ResolvedCheckedBlockConstructorRunList
    {source : VInductDecl} {params : List VExpr}
    (env blockEnv : VEnv) (Us : List Name) (resultLevel : VLevel)
    (familyIndices : List (List VExpr)) (parameterΔ : VLCtx) :
    {ordinal : Nat} → {types : List VInductiveType} →
      CheckedFamilies source params ordinal types →
      List (List Expr) → List (List (List VLevel)) → Type where
  | nil {ordinal : Nat} :
      ResolvedCheckedBlockConstructorRunList env blockEnv Us resultLevel
        familyIndices parameterΔ (CheckedFamilies.nil (ordinal := ordinal))
        [] []
  | cons
      {ordinal : Nat} {type : VInductiveType}
      {types : List VInductiveType}
      {family : CheckedFamily source params ordinal type}
      {families : CheckedFamilies source params (ordinal + 1) types}
      {headSuffixes : List Expr} {tailSuffixes : List (List Expr)}
      {headFieldSorts : List (List VLevel)}
      {tailFieldSorts : List (List (List VLevel))}
      (endpoints : List VExpr)
      (translations : List.Forall₂ (TrExprS blockEnv Us parameterΔ)
        headSuffixes endpoints)
      (runs : List.Forall₂
        (ResolvedBlockConstructorEndpointWF source env blockEnv Us
          resultLevel familyIndices ordinal params family.indices)
        endpoints headFieldSorts)
      (tail : ResolvedCheckedBlockConstructorRunList env blockEnv Us
        resultLevel familyIndices parameterΔ families tailSuffixes
        tailFieldSorts) :
      ResolvedCheckedBlockConstructorRunList env blockEnv Us resultLevel
        familyIndices parameterΔ (.cons family families)
        (headSuffixes :: tailSuffixes)
        (headFieldSorts :: tailFieldSorts)

/-- Checked constructor endpoints indexed only by the family ordinal and the
family-only index inventory.  This is the pre-`CheckedFamilies` form used to
break the old Stage-3 construction cycle. -/
inductive ResolvedBlockConstructorEndpointRunList
    (source : VInductDecl) (env blockEnv : VEnv) (Us : List Name)
    (resultLevel : VLevel) (familyIndices : List (List VExpr))
    (params : List VExpr) (parameterΔ : VLCtx) :
    Nat → List (List Expr) → List (List (List VLevel)) → Type where
  | nil {ordinal : Nat} :
      ResolvedBlockConstructorEndpointRunList source env blockEnv Us
        resultLevel familyIndices params parameterΔ ordinal [] []
  | cons
      {ordinal : Nat}
      {headSuffixes : List Expr} {tailSuffixes : List (List Expr)}
      {headFieldSorts : List (List VLevel)}
      {tailFieldSorts : List (List (List VLevel))}
      (ownerIndices : List VExpr)
      (ownerIndicesAt : familyIndices[ordinal]? = some ownerIndices)
      (endpoints : List VExpr)
      (translations : List.Forall₂ (TrExprS blockEnv Us parameterΔ)
        headSuffixes endpoints)
      (runs : List.Forall₂
        (ResolvedBlockConstructorEndpointWF source env blockEnv Us
          resultLevel familyIndices ordinal params ownerIndices)
        endpoints headFieldSorts)
      (tail : ResolvedBlockConstructorEndpointRunList source env blockEnv Us
        resultLevel familyIndices params parameterΔ (ordinal + 1)
        tailSuffixes tailFieldSorts) :
      ResolvedBlockConstructorEndpointRunList source env blockEnv Us
        resultLevel familyIndices params parameterΔ ordinal
        (headSuffixes :: tailSuffixes)
        (headFieldSorts :: tailFieldSorts)

/-- Erase a family-major endpoint replay to the exact endpoint matrix chosen
by its construction-owned strict translations. -/
def ResolvedBlockConstructorEndpointRunList.endpoints :
    ResolvedBlockConstructorEndpointRunList source env blockEnv Us
      resultLevel familyIndices params parameterΔ ordinal suffixes fieldSorts →
      List (List VExpr)
  | .nil => []
  | .cons _ _ endpoints _ _ tail => endpoints :: tail.endpoints

/-- Reindex a construction-owned endpoint matrix along equality of precisely
the source shape observed by endpoint well-formedness. -/
noncomputable def ResolvedBlockConstructorEndpointRunList.ofSourceShapeEq
    {source target : VInductDecl} {env blockEnv : VEnv} {Us : List Name}
    {resultLevel : VLevel} {familyIndices : List (List VExpr)}
    {params : List VExpr} {parameterΔ : VLCtx} {ordinal : Nat}
    {suffixes : List (List Expr)} {fieldSorts : List (List (List VLevel))}
    (runs : ResolvedBlockConstructorEndpointRunList source env blockEnv Us
      resultLevel familyIndices params parameterΔ ordinal suffixes fieldSorts)
    (uvarsEq : source.uvars = target.uvars)
    (nparamsEq : source.nparams = target.nparams)
    (headersEq : familyHeaders source.nparams source.types =
      familyHeaders target.nparams target.types)
    (namesEq : familyNames source.types = familyNames target.types) :
    ResolvedBlockConstructorEndpointRunList target env blockEnv Us
      resultLevel familyIndices params parameterΔ ordinal suffixes
      fieldSorts := by
  induction runs with
  | nil => exact .nil
  | cons ownerIndices ownerIndicesAt endpoints translations endpointRuns
      tail ih =>
      exact .cons ownerIndices ownerIndicesAt endpoints translations
        (Lean4Lean.List.Forall₂.imp (h := endpointRuns) fun _ _ endpointWF =>
          resolvedBlockConstructorEndpointWF_of_source_shape_eq endpointWF
            uvarsEq nparamsEq headersEq namesEq)
        ih

@[simp] theorem ResolvedBlockConstructorEndpointRunList.endpoints_ofSourceShapeEq
    {source target : VInductDecl} {env blockEnv : VEnv} {Us : List Name}
    {resultLevel : VLevel} {familyIndices : List (List VExpr)}
    {params : List VExpr} {parameterΔ : VLCtx} {ordinal : Nat}
    {suffixes : List (List Expr)} {fieldSorts : List (List (List VLevel))}
    (runs : ResolvedBlockConstructorEndpointRunList source env blockEnv Us
      resultLevel familyIndices params parameterΔ ordinal suffixes fieldSorts)
    (uvarsEq : source.uvars = target.uvars)
    (nparamsEq : source.nparams = target.nparams)
    (headersEq : familyHeaders source.nparams source.types =
      familyHeaders target.nparams target.types)
    (namesEq : familyNames source.types = familyNames target.types) :
    (runs.ofSourceShapeEq uvarsEq nparamsEq headersEq namesEq).endpoints =
      runs.endpoints := by
  induction runs with
  | nil => rfl
  | cons ownerIndices ownerIndicesAt endpoints translations endpointRuns
      tail ih =>
      simp only [ofSourceShapeEq,
        ResolvedBlockConstructorEndpointRunList.endpoints, List.cons.injEq,
        true_and]
      exact ih

private theorem CheckedFamilies.indices_eq_type_fields
    {source : VInductDecl} {params : List VExpr} {ordinal : Nat}
    {types : List VInductiveType}
    (checked : CheckedFamilies source params ordinal types) :
    checked.indices = types.map (fun family =>
      ctorFields (VExpr.dropN source.nparams family.type)) := by
  induction checked with
  | nil => rfl
  | cons head tail ih =>
      simp only [CheckedFamilies.indices, List.map_cons, List.cons.injEq]
      exact ⟨head.indices_eq, ih⟩

private theorem CheckedFamilies.indices_eq_canonicalFamilyIndexLists
    {source : VInductDecl} {params : List VExpr} {ordinal : Nat}
    {families : List VInductiveType}
    (checked : CheckedFamilies source params ordinal
      (canonicalizeFamilyParamsList source.nparams params families)) :
    checked.indices = canonicalFamilyIndexLists source.nparams params
      families := by
  simpa only [canonicalFamilyIndexLists] using checked.indices_eq_type_fields

/-- Extract canonical Stage-3 directly from construction-owned endpoints,
before selecting the dependent checked-family spine.  This is the acyclic
first phase of resolved replay. -/
theorem ResolvedBlockConstructorEndpointRunList.canonicalStage3
    {source : VInductDecl} {env blockEnv : VEnv} {Us : List Name}
    {resultLevel : VLevel} {familyIndices : List (List VExpr)}
    {params : List VExpr} {parameterΔ : VLCtx} {ordinal : Nat}
    {suffixes : List (List Expr)}
    {fieldSorts : List (List (List VLevel))}
    (runs : ResolvedBlockConstructorEndpointRunList source env blockEnv Us
      resultLevel familyIndices params parameterΔ ordinal suffixes fieldSorts)
    (paramsLength : params.length = source.nparams)
    {families : List VInductiveType}
    (alignment : List.Forall₂ (fun family endpoints =>
      List.Forall₂ (fun constructor endpoint =>
        constructor.type = VExpr.forallN params endpoint)
        family.ctors endpoints) families runs.endpoints) :
    CanonicalConstructorStage3List source ordinal families := by
  induction runs generalizing families with
  | nil =>
      cases alignment
      exact .nil
  | cons ownerIndices ownerIndicesAt endpoints translations endpointRuns
      tail ih =>
      cases alignment with
      | cons headAlignment tailAlignment =>
          obtain ⟨headStage, _headWF, _headSorts⟩ :=
            resolvedBlockConstructorEndpointListConsequences paramsLength
              headAlignment endpointRuns
          exact .cons (fun constructor member =>
            list_all_mem_stage3 headStage constructor member)
            (ih tailAlignment)

/-- Assemble the three downstream constructor inventories directly from the
construction-owned endpoint matrix: canonical Stage-3, checked constructor
well-formedness, and field-sort telescopes. -/
theorem ResolvedBlockConstructorEndpointRunList.canonicalReplay
    {source : VInductDecl} {env blockEnv : VEnv} {Us : List Name}
    {resultLevel : VLevel} {familyIndices : List (List VExpr)}
    {params : List VExpr} {parameterΔ : VLCtx} {ordinal : Nat}
    {suffixes : List (List Expr)}
    {fieldSorts : List (List (List VLevel))}
    (runs : ResolvedBlockConstructorEndpointRunList source env blockEnv Us
      resultLevel familyIndices params parameterΔ ordinal suffixes fieldSorts)
    (paramsLength : params.length = source.nparams)
    {families : List VInductiveType}
    (checked : CheckedFamilies source params ordinal families)
    (alignment : List.Forall₂ (fun family endpoints =>
      List.Forall₂ (fun constructor endpoint =>
        constructor.type = VExpr.forallN params endpoint)
        family.ctors endpoints) families runs.endpoints)
    (indicesDrop : familyIndices.drop ordinal = checked.indices) :
    CanonicalConstructorStage3List source ordinal families ∧
      Nonempty (CheckedBlockConstructorRunList env resultLevel familyIndices
        checked) ∧
      CheckedBlockFieldSortTelescopes blockEnv Us.length params checked
        fieldSorts := by
  induction runs generalizing families with
  | nil =>
      cases alignment
      cases checked
      exact ⟨.nil, ⟨.nil⟩, .nil⟩
  | @cons ordinal headSuffixes tailSuffixes headFieldSorts tailFieldSorts
      ownerIndices ownerIndicesAt endpoints translations endpointRuns tail ih =>
      cases alignment with
      | cons headAlignment tailAlignment =>
          cases checked with
          | cons checkedHead checkedTail =>
              have indicesAt : familyIndices[ordinal]? =
                  some checkedHead.indices := by
                apply list_getElem?_eq_some_of_drop_eq_cons
                simpa only [CheckedFamilies.indices] using indicesDrop
              have ownerIndicesEq : ownerIndices = checkedHead.indices :=
                Option.some.inj (ownerIndicesAt.symm.trans indicesAt)
              subst ownerIndices
              obtain ⟨headStage, headWF, headSorts⟩ :=
                resolvedBlockConstructorEndpointListConsequences paramsLength
                  headAlignment endpointRuns
              have constructorsEq : checkedHead.constructors =
                  _ := checkedHead.constructors_eq
              have checkedHeadWF : ∀ constructor ∈ checkedHead.constructors,
                  checkedBlockFieldsWF env source.uvars resultLevel
                      familyIndices constructor.fields constructor.recursiveAt
                      params.reverse 0 ∧
                    env.SpineWF source.uvars
                      (constructor.fields.reverse ++ params.reverse)
                      (VExpr.forallN
                        (VExpr.liftTelN constructor.fields.length
                          checkedHead.indices 0)
                        (.sort resultLevel))
                      constructor.resultIndices (.sort resultLevel) := by
                intro constructor member
                rw [constructorsEq] at member
                exact list_all_mem_stage3 headWF constructor member
              have checkedHeadSorts : List.Forall₂
                  (fun constructor sorts => blockEnv.OnSortTel Us.length
                    params.reverse constructor.fields sorts)
                  checkedHead.constructors headFieldSorts := by
                rw [constructorsEq]
                exact headSorts
              obtain ⟨tailStage, ⟨tailWF⟩, tailSorts⟩ :=
                ih checkedTail tailAlignment
                  (list_drop_succ_eq_of_drop_eq_cons (by
                    simpa only [CheckedFamilies.indices] using indicesDrop))
              exact ⟨.cons (fun constructor member =>
                  list_all_mem_stage3 headStage constructor member) tailStage,
                ⟨.cons checkedHeadWF tailWF⟩,
                .cons checkedHeadSorts tailSorts⟩

/-- Lift construction-owned constructor replay through the complete
family-major audit.  Every family retains its own endpoint list, executable
suffix alignment, owner indices, and D2 sort alignment. -/
theorem CandidateBlockFamilySemanticListRun.resolvedBlockConstructorRuns
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {source : VInductDecl} {params : List VExpr} {firstView : VExpr}
    {resultLevel : VLevel}
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    (semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws)
    {owner : Nat}
    {globalSuffixes : List Expr} {globalIndices : List (List VExpr)}
    {d3Context : AddInductive.Context}
    {d3ContextRun : AddInductive.ConstructorContextRun env Us d3Context}
    {d3Trace : AddInductive.ConstructorMutualBlockPreFamilyTraces stats
      globalSuffixes d3Context (owner := owner) candidates}
    (d3Runs : AddInductive.ConstructorMutualBlockPreFamilySemanticRuns env
      blockEnv Us stats globalSuffixes d3Context d3ContextRun semantics
      d3Trace)
    (constructorSuffixes :
      AddInductive.ConstructorBlockCandidateParameterSuffixes stats candidates)
    {isUnsafe : Bool} {d2Context : AddInductive.Context}
    {d2ContextRun : AddInductive.ConstructorContextRun blockEnv Us d2Context}
    {validation : AddInductive.ConstructorBlockValidationTraces stats
      isUnsafe d2Context owner sources}
    {alignment : AddInductive.ConstructorBlockCandidateAlignmentTrace stats
      isUnsafe d2Context validation candidates}
    (d2Runs : CandidateBlockConstructorPostFamilySemanticRuns env blockEnv Us
      stats isUnsafe d2Context d2ContextRun validation alignment semantics)
    {suffixes :
      AddInductive.ConstructorBlockResolvedFamilyParameterSuffixes stats
        candidates}
    {checked : CheckedFamilies source params owner
      (canonicalizeFamilyParamsList source.nparams params semantics.views)}
    {familyParameterDefEqs : CandidateBlockFamilyViewParameterDefEqList env
      blockEnv Us source.nparams firstView semantics}
    (translations : CandidateBlockResolvedFamilySuffixTranslationList env
      blockEnv Us stats source.nparams firstView params source parameterΔ
      semantics suffixes checked familyParameterDefEqs)
    (constructorParameters : CandidateBlockConstructorViewParameterDefEqLists
      env blockEnv Us source.nparams params semantics)
    (henv : VEnv.WF env) (hblockEnv : VEnv.WF blockEnv)
    (addType : env ≤ blockEnv)
    (parameterContext : TypeChecker.CandidateParameterContext []
      stats.params.toList params parameterΔ)
    (parameterWF : VLCtx.WF env Us.length parameterΔ)
    {d3ViewContext analyzerViewContext : VLCtx}
    {d3ViewLift analyzerViewLift : Lift}
    (d3State : ConstructorValidation.D3FullContextState env blockEnv Us
      d3Context parameterΔ parameterΔ
      d3ContextRun.candidate.context.vlctx d3ViewContext .refl d3ViewLift)
    (analyzerState : ConstructorValidation.AnalyzerPostContextState blockEnv Us
      parameterΔ d2ContextRun.candidate.context.vlctx analyzerViewContext
      analyzerViewLift)
    (ngenEq : d3Context.ngen = d2Context.ngen)
    (targets : ConstructorValidation.ResolvedMutualFamilyTargetState env
      blockEnv Us stats (familyHeaders source.nparams source.types)
      globalSuffixes globalIndices parameterΔ parameterΔ 0 .refl)
    (suffixDrop : globalSuffixes.drop owner = suffixes.values)
    (indicesDrop : globalIndices.drop owner = checked.indices)
    (sourceUvars : source.uvars = Us.length)
    (sourceNparams : source.nparams = stats.params.size)
    (resultLevelTr : VLevel.ofLevel Us stats.resultLevel = some resultLevel)
    (levelsTr : stats.levels.mapM (VLevel.ofLevel Us) =
      some (VLevel.params Us.length))
    (familyFresh : ∀ name, name ∈ familyNames source.types →
      env.constants name = none)
    (familyNodup : (familyNames source.types).Nodup)
    (universeSemantics : validation.universeSemantics = true) :
    Nonempty (ResolvedCheckedBlockConstructorRunList env blockEnv Us
      resultLevel globalIndices parameterΔ checked constructorSuffixes.values
      d2Runs.fieldSorts) := by
  induction translations with
  | nil =>
      cases d3Runs
      cases constructorSuffixes
      cases d2Runs
      cases constructorParameters
      exact ⟨.nil⟩
  | @cons ordinal kernelSource kernelSources candidate candidates raw raws
      semantic semanticTail ownerSuffix parameters suffixTail checkedHead
      checkedTail headDefEq tailDefEq suffixTranslation tailTranslations ih =>
      cases d3Runs with
      | @cons _ _ _ _ _ _ _ _ _ d3OwnerSuffix d3Parameters d3HeadTrace
          d3TailTrace d3Head d3Tail =>
        have ownerSuffixEq : d3OwnerSuffix = ownerSuffix :=
          Except.ok.inj (d3Parameters.symm.trans parameters)
        subst d3OwnerSuffix
        cases constructorSuffixes with
        | cons headSuffixes tailSuffixes =>
          cases d2Runs with
          | cons d2Head d2Tail =>
            cases constructorParameters with
            | cons headParameters tailParameters =>
              simp only [
                AddInductive.ConstructorBlockValidationTraces.universeSemantics,
                Bool.and_eq_true] at universeSemantics
              have ownerAt : globalSuffixes[ordinal]? = some ownerSuffix :=
                list_getElem?_eq_some_of_drop_eq_cons suffixDrop
              have ownerIndicesAt : globalIndices[ordinal]? =
                  some checkedHead.indices :=
                list_getElem?_eq_some_of_drop_eq_cons indicesDrop
              obtain ⟨headEndpoints, _selected, headTranslations, headRuns,
                  _selectedTypes⟩ :=
                semantic.constructors.resolvedBlockConstructorsWF d3Head
                  headSuffixes d2Head headParameters henv hblockEnv addType
                  parameterContext parameterWF d3State analyzerState ngenEq
                  targets ownerAt ownerIndicesAt sourceUvars sourceNparams
                  resultLevelTr levelsTr familyFresh familyNodup
                  universeSemantics.1
              obtain ⟨tailRuns⟩ :=
                ih d3Tail tailSuffixes d2Tail tailParameters
                  (list_drop_succ_eq_of_drop_eq_cons suffixDrop)
                  (list_drop_succ_eq_of_drop_eq_cons indicesDrop)
                  universeSemantics.2
              exact ⟨.cons headEndpoints headTranslations headRuns tailRuns⟩

/-- Family-major resolved replay before construction of a dependent checked
family spine.  Family suffixes and canonical index telescopes are consumed
directly, so the theorem has no Stage-3 or checked-family premise. -/
theorem CandidateBlockFamilySemanticListRun.resolvedBlockConstructorEndpoints
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {source : VInductDecl} {params : List VExpr} {firstView : VExpr}
    {resultLevel : VLevel}
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    (semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws)
    {owner : Nat}
    {globalSuffixes : List Expr} {globalIndices : List (List VExpr)}
    {d3Context : AddInductive.Context}
    {d3ContextRun : AddInductive.ConstructorContextRun env Us d3Context}
    {d3Trace : AddInductive.ConstructorMutualBlockPreFamilyTraces stats
      globalSuffixes d3Context (owner := owner) candidates}
    (d3Runs : AddInductive.ConstructorMutualBlockPreFamilySemanticRuns env
      blockEnv Us stats globalSuffixes d3Context d3ContextRun semantics
      d3Trace)
    (constructorSuffixes :
      AddInductive.ConstructorBlockCandidateParameterSuffixes stats candidates)
    {isUnsafe : Bool} {d2Context : AddInductive.Context}
    {d2ContextRun : AddInductive.ConstructorContextRun blockEnv Us d2Context}
    {validation : AddInductive.ConstructorBlockValidationTraces stats
      isUnsafe d2Context owner sources}
    {alignment : AddInductive.ConstructorBlockCandidateAlignmentTrace stats
      isUnsafe d2Context validation candidates}
    (d2Runs : CandidateBlockConstructorPostFamilySemanticRuns env blockEnv Us
      stats isUnsafe d2Context d2ContextRun validation alignment semantics)
    (suffixes : AddInductive.ConstructorBlockResolvedFamilyParameterSuffixes
      stats candidates)
    (constructorParameters : CandidateBlockConstructorViewParameterDefEqLists
      env blockEnv Us source.nparams params semantics)
    (familyParameters : CandidateBlockFamilyViewParameterDefEqList env
      blockEnv Us source.nparams firstView semantics)
    (henv : VEnv.WF env) (hblockEnv : VEnv.WF blockEnv)
    (addType : env ≤ blockEnv)
    (parameterContext : TypeChecker.CandidateParameterContext []
      stats.params.toList params parameterΔ)
    (parameterWF : VLCtx.WF env Us.length parameterΔ)
    {d3ViewContext analyzerViewContext : VLCtx}
    {d3ViewLift analyzerViewLift : Lift}
    (d3State : ConstructorValidation.D3FullContextState env blockEnv Us
      d3Context parameterΔ parameterΔ
      d3ContextRun.candidate.context.vlctx d3ViewContext .refl d3ViewLift)
    (analyzerState : ConstructorValidation.AnalyzerPostContextState blockEnv Us
      parameterΔ d2ContextRun.candidate.context.vlctx analyzerViewContext
      analyzerViewLift)
    (ngenEq : d3Context.ngen = d2Context.ngen)
    (targets : ConstructorValidation.ResolvedMutualFamilyTargetState env
      blockEnv Us stats (familyHeaders source.nparams source.types)
      globalSuffixes globalIndices parameterΔ parameterΔ 0 .refl)
    (suffixDrop : globalSuffixes.drop owner = suffixes.values)
    (indicesDrop : globalIndices.drop owner =
      canonicalFamilyIndexLists source.nparams params semantics.views)
    (sourceUvars : source.uvars = Us.length)
    (sourceNparams : source.nparams = stats.params.size)
    (resultLevelTr : VLevel.ofLevel Us stats.resultLevel = some resultLevel)
    (levelsTr : stats.levels.mapM (VLevel.ofLevel Us) =
      some (VLevel.params Us.length))
    (familyFresh : ∀ name, name ∈ familyNames source.types →
      env.constants name = none)
    (familyNodup : (familyNames source.types).Nodup)
    (universeSemantics : validation.universeSemantics = true) :
    ∃ selected : CandidateBlockFamilySemanticListRun env blockEnv Us
        candidates raws,
      ∃ runs : ResolvedBlockConstructorEndpointRunList source env blockEnv Us
          resultLevel globalIndices params parameterΔ owner
          constructorSuffixes.values d2Runs.fieldSorts,
        List.Forall₂ (fun family endpoints =>
          List.Forall₂ (fun constructor endpoint =>
            constructor.type = VExpr.forallN params endpoint)
            family.ctors endpoints)
          (canonicalizeFamilyParamsList source.nparams params selected.views)
          runs.endpoints ∧
        List.Forall₂ (fun original selectedFamily =>
          original.name = selectedFamily.name ∧
            original.type = selectedFamily.type)
          semantics.views selected.views ∧
        CandidateBlockFamilyViewParameterDefEqList env blockEnv Us
          source.nparams firstView selected ∧
        CandidateBlockConstructorViewParameterDefEqLists env blockEnv Us
          source.nparams params selected ∧
        CandidateBlockConstructorCanonicalFieldCountLists source.nparams
          selected := by
  induction suffixes generalizing raws owner with
  | nil =>
      cases semantics
      cases d3Runs
      cases constructorSuffixes
      cases d2Runs
      cases constructorParameters
      cases familyParameters
      exact ⟨.nil, .nil, .nil, .nil, .nil, .nil, .nil⟩
  | @cons kernelSource kernelSources candidate candidates ownerSuffix
      parameters suffixTail ih =>
      cases semantics with
      | cons semantic semanticTail =>
        cases d3Runs with
        | @cons _ _ _ _ _ _ _ _ _ d3OwnerSuffix d3Parameters d3HeadTrace
            d3TailTrace d3Head d3Tail =>
          have ownerSuffixEq : d3OwnerSuffix = ownerSuffix :=
            Except.ok.inj (d3Parameters.symm.trans parameters)
          subst d3OwnerSuffix
          cases constructorSuffixes with
          | cons headSuffixes tailSuffixes =>
            cases d2Runs with
            | cons d2Head d2Tail =>
              cases constructorParameters with
              | cons headParameters tailParameters =>
                cases familyParameters with
                | cons headFamilyParameters tailFamilyParameters =>
                  simp only [
                    AddInductive.ConstructorBlockValidationTraces.universeSemantics,
                    Bool.and_eq_true] at universeSemantics
                  have ownerAt : globalSuffixes[owner]? = some ownerSuffix :=
                    list_getElem?_eq_some_of_drop_eq_cons suffixDrop
                  let ownerIndices := ctorFields
                    (VExpr.dropN source.nparams
                      (canonicalizeFamilyParams source.nparams params
                        semantic.view).type)
                  have ownerIndicesAt : globalIndices[owner]? =
                      some ownerIndices :=
                    list_getElem?_eq_some_of_drop_eq_cons indicesDrop
                  obtain ⟨headEndpoints, selectedHeadConstructors,
                      headTranslations, headRuns, selectedHeadTypes,
                      selectedHeadParameters, selectedHeadCounts⟩ :=
                    semantic.constructors.resolvedBlockConstructorsWF d3Head
                      headSuffixes d2Head headParameters henv hblockEnv addType
                      parameterContext parameterWF d3State analyzerState ngenEq
                      targets ownerAt ownerIndicesAt sourceUvars sourceNparams
                      resultLevelTr levelsTr familyFresh familyNodup
                      universeSemantics.1
                  obtain ⟨selectedTail, tailRuns, selectedTailTypes,
                      selectedTailFamilyTypes, selectedTailFamilyParameters,
                      selectedTailConstructorParameters, selectedTailCounts⟩ :=
                    ih semanticTail d3Tail tailSuffixes d2Tail tailParameters
                      tailFamilyParameters
                      (list_drop_succ_eq_of_drop_eq_cons suffixDrop)
                      (list_drop_succ_eq_of_drop_eq_cons indicesDrop)
                      universeSemantics.2
                  let selectedHead : CandidateBlockFamilySemanticRun env
                      blockEnv Us candidate _ := {
                    name_eq := semantic.name_eq
                    uvars_eq := semantic.uvars_eq
                    type := semantic.type
                    constructors := selectedHeadConstructors }
                  let selected := CandidateBlockFamilySemanticListRun.cons
                    selectedHead selectedTail
                  let runs := ResolvedBlockConstructorEndpointRunList.cons
                    ownerIndices ownerIndicesAt headEndpoints headTranslations
                    headRuns tailRuns
                  refine ⟨selected, runs, ?_, ?_, ?_, ?_, ?_⟩
                  · simp only [selected, selectedHead,
                      canonicalizeFamilyParamsList,
                      CandidateBlockFamilySemanticListRun.views, List.map_cons,
                      canonicalizeFamilyParams,
                      CandidateBlockFamilySemanticRun.view]
                    exact .cons selectedHeadTypes selectedTailTypes
                  · simp only [selected, selectedHead,
                      CandidateBlockFamilySemanticListRun.views,
                      CandidateBlockFamilySemanticRun.view]
                    exact .cons ⟨rfl, rfl⟩ selectedTailFamilyTypes
                  · exact .cons headFamilyParameters
                      selectedTailFamilyParameters
                  · exact .cons selectedHeadParameters
                      selectedTailConstructorParameters
                  · exact .cons selectedHeadCounts selectedTailCounts

namespace CandidateBlockMutualPreFamilyTranslationState

/-- Specialize the source-order fold to the two producer-owned block states.
Both initial context states and both global list alignments are derived here,
so downstream validation certificates consume only executable audit outputs
and block-wide semantic facts. -/
theorem checkedBlockConstructorRuns
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {source : VInductDecl} {params : List VExpr} {firstView : VExpr}
    {resultLevel : VLevel}
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType} {rawParameterΔ : VLCtx}
    {postFamilyContext : AddInductive.Context}
    {semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws}
    {checked : CheckedFamilies source params 0
      (canonicalizeFamilyParamsList source.nparams params semantics.views)}
    {familyParameterDefEqs : CandidateBlockFamilyViewParameterDefEqList env
      blockEnv Us source.nparams firstView semantics}
    (state : CandidateBlockMutualPreFamilyTranslationState env blockEnv Us
      stats source.nparams firstView params source rawParameterΔ
      postFamilyContext semantics checked familyParameterDefEqs)
    {isUnsafe : Bool}
    {validation : AddInductive.ConstructorBlockValidationTraces stats
      isUnsafe postFamilyContext 0 sources}
    {parameterSources : List Expr}
    (inventory : CandidateBlockConstructorPostFamilySemanticInventoryState
      env blockEnv Us stats isUnsafe postFamilyContext rawParameterΔ
      source.nparams parameterSources validation semantics)
    (stage : AddInductive.ConstructorBlockStage3SafetyTraces stats
      (owner := 0) candidates)
    (constructorParameters : CandidateBlockConstructorViewParameterDefEqLists
      env blockEnv Us source.nparams params semantics)
    (canonicalStage : CanonicalConstructorStage3List source 0
      (canonicalizeFamilyParamsList source.nparams params semantics.views))
    (henv : VEnv.WF env) (hblockEnv : VEnv.WF blockEnv)
    (addType : env ≤ blockEnv)
    (targets : ConstructorValidation.MutualFamilyTargetState env blockEnv Us
      stats (familyHeaders source.nparams source.types)
      state.preFamily.trace.suffixes.values checked.indices state.parameterΔ
      state.parameterΔ 0)
    (sourceUvars : source.uvars = Us.length)
    (sourceNparams : source.nparams = stats.params.size)
    (resultLevelTr : VLevel.ofLevel Us stats.resultLevel = some resultLevel)
    (familyFresh : ∀ name, name ∈ familyNames source.types →
      env.constants name = none)
    (familyNodup : (familyNames source.types).Nodup)
    (universeSemantics : validation.universeSemantics = true) :
    Nonempty (CheckedBlockConstructorRunList env resultLevel checked.indices
        checked) ∧
      CheckedBlockFieldSortTelescopes blockEnv Us.length params checked
        inventory.semantic.constructors.fieldSorts := by
  obtain ⟨d3ViewContext, d3State⟩ := state.d3FullContextState henv addType
  obtain ⟨analyzerViewContext, analyzerState⟩ :=
    state.analyzerPostContextState inventory hblockEnv addType
  have canonicalParameterContext := state.parameterContext
  rw [← state.params_eq] at canonicalParameterContext
  exact semantics.checkedBlockConstructorRuns state.preFamily.runs stage
    inventory.semantic.constructors state.translations constructorParameters
    canonicalStage henv hblockEnv addType canonicalParameterContext
    state.parameterWF d3State analyzerState state.preFamily_ngen_eq targets
      rfl rfl sourceUvars
    sourceNparams resultLevelTr familyFresh familyNodup universeSemantics

end CandidateBlockMutualPreFamilyTranslationState

namespace CandidateBlockResolvedMutualPreFamilyTranslationState

/-- Specialize the resolved family fold to the producer-owned pre- and
post-family states.  The result is a block-wide matrix of exact constructor
endpoints, not a proof about the analyzer's independently chosen syntax. -/
theorem resolvedBlockConstructorRuns
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {source : VInductDecl} {params : List VExpr} {firstView : VExpr}
    {resultLevel : VLevel}
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType} {rawParameterΔ : VLCtx}
    {postFamilyContext : AddInductive.Context}
    {semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws}
    {checked : CheckedFamilies source params 0
      (canonicalizeFamilyParamsList source.nparams params semantics.views)}
    {familyParameterDefEqs : CandidateBlockFamilyViewParameterDefEqList env
      blockEnv Us source.nparams firstView semantics}
    (state : CandidateBlockResolvedMutualPreFamilyTranslationState env
      blockEnv Us stats source.nparams firstView params source rawParameterΔ
      postFamilyContext semantics checked familyParameterDefEqs)
    {isUnsafe : Bool}
    {validation : AddInductive.ConstructorBlockValidationTraces stats
      isUnsafe postFamilyContext 0 sources}
    {parameterSources : List Expr}
    (inventory : CandidateBlockConstructorPostFamilySemanticInventoryState
      env blockEnv Us stats isUnsafe postFamilyContext rawParameterΔ
      source.nparams parameterSources validation semantics)
    (constructorSuffixes :
      AddInductive.ConstructorBlockCandidateParameterSuffixes stats candidates)
    (constructorParameters : CandidateBlockConstructorViewParameterDefEqLists
      env blockEnv Us source.nparams params semantics)
    (henv : VEnv.WF env) (hblockEnv : VEnv.WF blockEnv)
    (addType : env ≤ blockEnv)
    (targets : ConstructorValidation.ResolvedMutualFamilyTargetState env
      blockEnv Us stats (familyHeaders source.nparams source.types)
      state.preFamily.trace.suffixes.values checked.indices state.parameterΔ
      state.parameterΔ 0 .refl)
    (sourceUvars : source.uvars = Us.length)
    (sourceNparams : source.nparams = stats.params.size)
    (resultLevelTr : VLevel.ofLevel Us stats.resultLevel = some resultLevel)
    (levelsTr : stats.levels.mapM (VLevel.ofLevel Us) =
      some (VLevel.params Us.length))
    (familyFresh : ∀ name, name ∈ familyNames source.types →
      env.constants name = none)
    (familyNodup : (familyNames source.types).Nodup)
    (universeSemantics : validation.universeSemantics = true) :
    Nonempty (ResolvedCheckedBlockConstructorRunList env blockEnv Us
      resultLevel checked.indices state.parameterΔ checked
      constructorSuffixes.values inventory.semantic.constructors.fieldSorts) := by
  obtain ⟨d3ViewContext, d3State⟩ := state.d3FullContextState henv addType
  obtain ⟨analyzerViewContext, analyzerState⟩ :=
    state.analyzerPostContextState inventory hblockEnv addType
  have canonicalParameterContext := state.parameterContext
  rw [← state.params_eq] at canonicalParameterContext
  exact semantics.resolvedBlockConstructorRuns state.preFamily.runs
    constructorSuffixes inventory.semantic.constructors state.translations
    constructorParameters henv hblockEnv addType canonicalParameterContext
    state.parameterWF d3State analyzerState state.preFamily_ngen_eq targets rfl
    rfl sourceUvars sourceNparams resultLevelTr levelsTr familyFresh
    familyNodup universeSemantics

end CandidateBlockResolvedMutualPreFamilyTranslationState

/-- Interpret the complete family-major structural audit as the exact
canonical constructor stage-3 certificate consumed by Theory.  The dependent
trace advances the owner ordinal in lockstep with the semantic family list;
canonicalization changes only the shared prefix removed by `dropN`. -/
theorem _root_.Lean4Lean.AddInductive.ConstructorBlockStage3SafetyTraces.canonicalStage3
    {inputEnv constructorEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {owner : Nat}
    {kernelSources : List InductiveType}
    {candidates : AddInductive.CandidateList AddInductive.CandidateFamily
      kernelSources}
    {raws : List VInductiveType}
    (traces : AddInductive.ConstructorBlockStage3SafetyTraces stats
      (owner := owner) candidates)
    (semantics : VInductDecl.CandidateBlockFamilySemanticListRun inputEnv
      constructorEnv Us candidates raws)
    {source : VInductDecl} {parameterTypes : List VExpr}
    {parameterΔ : VLCtx}
    (parameters : VInductDecl.CandidateBlockConstructorViewParameterDefEqLists
      inputEnv constructorEnv Us source.nparams parameterTypes semantics)
    (parameterContext : TypeChecker.CandidateParameterContext []
      stats.params.toList parameterTypes parameterΔ)
    (henv : VEnv.WF constructorEnv)
    (parameterWF : VLCtx.WF constructorEnv Us.length parameterΔ)
    (paramsSize : stats.params.size = source.nparams)
    (familyCount : owner + kernelSources.length ≤ stats.indConsts.size)
    (familyData : ∀ familyIdx, familyIdx < stats.indConsts.size →
      ∃ header,
        (VInductDecl.familyHeaders source.nparams source.types)[familyIdx]? =
          some header ∧
        stats.nindices[familyIdx]! = header.indices ∧
        stats.indConsts[familyIdx]! =
          .const header.name stats.levels)
    (levelsTr : stats.levels.mapM (VLevel.ofLevel Us) =
      some (VLevel.params source.uvars))
    (before : ∀ (familyIdx : Nat) (header : VInductDecl.FamilyHeader),
      (VInductDecl.familyHeaders source.nparams source.types)[familyIdx]? =
          some header →
      ∀ (k : Nat), k < familyIdx →
        ∀ (earlier : VInductDecl.FamilyHeader),
        (VInductDecl.familyHeaders source.nparams source.types)[k]? =
            some earlier →
          earlier.name ≠ header.name)
    (covered : ∀ name, name ∈ VInductDecl.familyNames source.types →
      stats.indConsts.any (fun constant =>
        constant.constName! == name) = true)
    (literalSafe : ∀ literal name,
      name ∈ VInductDecl.familyNames source.types →
      (VExpr.trLiteral literal).hasConst name = false) :
    VInductDecl.CanonicalConstructorStage3List source owner
      (VInductDecl.canonicalizeFamilyParamsList source.nparams parameterTypes
        semantics.views) := by
  have parameterLength : parameterTypes.length = source.nparams := by
    rw [← parameterContext.length_eq]
    simpa using paramsSize
  induction traces generalizing raws with
  | nil =>
      cases semantics
      cases parameters
      exact .nil
  | @cons currentOwner kernelSources candidates kernelSource candidate
      head tail ih =>
      cases semantics with
      | cons semantic semantics =>
          cases parameters with
          | cons headParameters tailParameters =>
              have ownerLt : currentOwner < stats.indConsts.size := by
                simp only [List.length_cons] at familyCount
                omega
              have tailCount : currentOwner + 1 + kernelSources.length ≤
                  stats.indConsts.size := by
                simp only [List.length_cons] at familyCount
                omega
              have headStage := head.blockStage3_all semantic.constructors
                headParameters parameterContext henv parameterWF paramsSize
                ownerLt familyData levelsTr before covered literalSafe
              apply VInductDecl.CanonicalConstructorStage3List.cons
              · intro constructor member
                simp only [VInductDecl.canonicalizeFamilyParams,
                  VInductDecl.CandidateBlockFamilySemanticRun.view] at member
                obtain ⟨viewConstructor, viewMember, rfl⟩ :=
                  List.mem_map.1 member
                have stage := list_all_mem_stage3 headStage viewConstructor
                  viewMember
                simp only [VInductDecl.canonicalizeConstructorParams]
                have canonicalDrop : VExpr.dropN source.nparams
                    (VExpr.forallN parameterTypes
                      (VExpr.dropN source.nparams viewConstructor.type)) =
                    VExpr.dropN source.nparams viewConstructor.type := by
                  rw [← parameterLength, VExpr.dropN_forallN_length]
                rw [canonicalDrop]
                exact stage
              · exact ih semantics tailParameters tailCount

/-- Interpret the same family-major stage-3 audit together with the retained
post-family validation semantics as exact residual field counts for every
constructor view. -/
theorem _root_.Lean4Lean.AddInductive.ConstructorBlockStage3SafetyTraces.canonicalFieldCounts
    {inputEnv constructorEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {owner np : Nat}
    {kernelSources : List InductiveType}
    {candidates : AddInductive.CandidateList AddInductive.CandidateFamily
      kernelSources}
    {raws : List VInductiveType}
    (traces : AddInductive.ConstructorBlockStage3SafetyTraces stats
      (owner := owner) candidates)
    {isUnsafe : Bool} {context : AddInductive.Context}
    {contextRun : AddInductive.ConstructorContextRun constructorEnv Us context}
    {validation : AddInductive.ConstructorBlockValidationTraces stats
      isUnsafe context owner kernelSources}
    {alignment : AddInductive.ConstructorBlockCandidateAlignmentTrace stats
      isUnsafe context validation candidates}
    {semantics : VInductDecl.CandidateBlockFamilySemanticListRun inputEnv
      constructorEnv Us candidates raws}
    (post : VInductDecl.CandidateBlockConstructorPostFamilySemanticRuns
      inputEnv constructorEnv Us stats isUnsafe context contextRun validation
      alignment semantics)
    {parameterTypes : List VExpr} {parameterΔ : VLCtx}
    (parameters : VInductDecl.CandidateBlockConstructorViewParameterDefEqLists
      inputEnv constructorEnv Us np parameterTypes semantics)
    (parameterContext : TypeChecker.CandidateParameterContext []
      stats.params.toList parameterTypes parameterΔ)
    (henv : VEnv.WF constructorEnv)
    (parameterWF : VLCtx.WF constructorEnv Us.length parameterΔ)
    {U : Nat} {headers : List VInductDecl.FamilyHeader}
    {names : List Name}
    (paramsSize : stats.params.size = np)
    (familyCount : owner + kernelSources.length ≤ stats.indConsts.size)
    (familyData : ∀ familyIdx, familyIdx < stats.indConsts.size →
      ∃ header,
        headers[familyIdx]? = some header ∧
        stats.nindices[familyIdx]! = header.indices ∧
        stats.indConsts[familyIdx]! =
          .const header.name stats.levels)
    (levelsTr : stats.levels.mapM (VLevel.ofLevel Us) =
      some (VLevel.params U))
    (before : ∀ (familyIdx : Nat) (header : VInductDecl.FamilyHeader),
      headers[familyIdx]? = some header →
      ∀ (k : Nat), k < familyIdx →
        ∀ (earlier : VInductDecl.FamilyHeader),
        headers[k]? = some earlier → earlier.name ≠ header.name)
    (covered : ∀ name, name ∈ names →
      stats.indConsts.any (fun constant =>
        constant.constName! == name) = true)
    (literalSafe : ∀ literal name, name ∈ names →
      (VExpr.trLiteral literal).hasConst name = false) :
    VInductDecl.CandidateBlockConstructorCanonicalFieldCountLists np
      semantics := by
  induction traces generalizing raws with
  | nil =>
      cases post
      cases parameters
      exact .nil
  | @cons currentOwner kernelSources candidates kernelSource candidate
      head tail ih =>
      cases post with
      | cons postHead postTail =>
          cases parameters with
          | cons headParameters tailParameters =>
              have ownerLt : currentOwner < stats.indConsts.size := by
                simp only [List.length_cons] at familyCount
                omega
              have tailCount : currentOwner + 1 + kernelSources.length ≤
                  stats.indConsts.size := by
                simp only [List.length_cons] at familyCount
                omega
              exact .cons
                (head.canonicalFieldCounts postHead headParameters
                  parameterContext henv parameterWF paramsSize ownerLt
                  familyData levelsTr before covered literalSafe)
                (ih postTail tailParameters tailCount)

