/-- A singleton block reaches its final constructor-validation context
immediately after the first family telescope.  Reindex that exact endpoint,
transport the terminal parameter inventory through the validator assertion,
and retain the first annotation prefix as a constructor-audit basis. -/
theorem
    ProducedBlockRecursorShapeCandidate.FirstFamilyAnnotationSpine.singletonRawParameterAuditBasis_nonempty
    {source : VInductDecl}
    {firstSource : InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source [firstSource]
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    (owner : produced.FirstFamilyAnnotationSpine semantic)
    (context_lctx_eq : context.lctx = {}) :
    Nonempty (ConstructorRawPreFamilyParameterAuditBasis env Us
      produced.execution.eliminationExecution.normalization.stats
      produced.execution.eliminationExecution.normalization.validationContext
      source.nparams
      (VExpr.telN source.nparams owner.position.semantic.type.view)) := by
  let normalization :=
    produced.execution.eliminationExecution.normalization
  have normalizationProduced :=
    produced.execution.normalization_run produced.producedExecution
  let comparisonTrace :=
    normalization.familyParameterComparisonTrace normalizationProduced
      produced.kernelSources_nonempty
  let blockRun := normalization.familyValidationBlockRun
    normalizationProduced produced.kernelSources_nonempty
  obtain ⟨validation⟩ :=
    owner.firstFamilyValidationState context_lctx_eq
  have selectedFirstContext : comparisonTrace.firstContext =
      validation.continuation.telescope.result.context := by
    exact
      familyParameterComparisonBlockTrace_headContinuation_firstContext
        validation.selected
  have firstComparisonContext :=
    normalization.firstFamilyComparisonContext_eq normalizationProduced
      context_lctx_eq
  have candidateTerminalContext :
      produced.candidate.families.head.familyType.type.trace.terminalContext =
        validation.continuation.telescope.result.context :=
    calc
      produced.candidate.families.head.familyType.type.trace.terminalContext =
          normalization.familyTypes.candidates.head.type.trace.terminalContext :=
        congrArg
          (fun candidate : AddInductive.CandidateFamilyType firstSource =>
            candidate.type.trace.terminalContext)
          normalization.families.produced.head_familyType
      _ = comparisonTrace.firstContext := firstComparisonContext.symm
      _ = validation.continuation.telescope.result.context :=
        selectedFirstContext
  have comparisonResult : comparisonTrace.result =
      normalization.familyValidationResult :=
    AddInductive.FamilyValidationBlockRun.parameterComparisonTrace_result
      blockRun
  have tailResultEq : validation.continuation.tail.result =
      normalization.familyValidationResult :=
    (AddInductive.FamilyParameterComparisonBlockTrace.headContinuation?_result
      validation.selected).trans comparisonResult
  have continuationOrdinal : validation.continuation.dIdx = 0 :=
    AddInductive.FamilyParameterComparisonBlockTrace.headContinuation?_dIdx
      validation.selected
  have tailLengthLe : [firstSource].toArray.size ≤
      validation.continuation.dIdx + 1 := by
    rw [continuationOrdinal]
    simp
  have tailContextEq : validation.continuation.tail.result.validationContext =
      validation.continuation.telescope.result.context :=
    AddInductive.FamilyParameterComparisonBlockTrace.result_validationContext_of_length_le
      validation.continuation.tail tailLengthLe
  have telescopeFinalContext :
      validation.continuation.telescope.result.context =
        normalization.validationContext := by
    calc
      validation.continuation.telescope.result.context =
          validation.continuation.tail.result.validationContext :=
        tailContextEq.symm
      _ = normalization.familyValidationResult.validationContext :=
        congrArg AddInductive.FamilyValidationBlockResult.validationContext
          tailResultEq
      _ = normalization.validationContext := rfl
  have candidateTerminalFinal :
      produced.candidate.families.head.familyType.type.trace.terminalContext =
        normalization.validationContext :=
    candidateTerminalContext.trans telescopeFinalContext
  let terminalRun : TypeChecker.CandidateContextRun
      normalization.validationContext :=
    candidateTerminalFinal ▸ owner.annotation.terminalRun
  have terminalRunContext : terminalRun.context =
      owner.annotation.terminalRun.context :=
    candidateContextRun_cast_context candidateTerminalFinal
      owner.annotation.terminalRun
  have terminalVenv : terminalRun.context.venv = env := by
    rw [terminalRunContext]
    exact owner.annotation.terminal_venv
  have terminalLparams : terminalRun.context.lparams = Us := by
    rw [terminalRunContext]
    exact owner.annotation.terminal_lparams
  let contextRun : AddInductive.ConstructorContextRun env Us
      normalization.validationContext :=
    ⟨terminalRun, terminalVenv, terminalLparams⟩
  obtain ⟨parameterΔ, parameterCtx, parameterFVars, parameterLift,
      parameterShape⟩ := owner.parameterContext context_lctx_eq
  let params : TypeChecker.CandidateParameterContext []
      (produced.candidate.families.head.familyType.type.trace.parameterList
        source.nparams)
      (owner.annotation.storedBinders.take source.nparams) parameterΔ :=
    TypeChecker.CandidateParameterContext.of_fvarLamOnly parameterShape
      parameterCtx parameterFVars
  have henv : VEnv.WF env := by
    simpa only [owner.annotation.terminal_venv] using
      owner.annotation.terminalRun.context.Ewf
  have terminalWF : VLCtx.WF env Us.length
      owner.annotation.terminalRun.context.vlctx := by
    simpa only [owner.annotation.terminal_venv,
      owner.annotation.terminal_lparams] using
      owner.annotation.terminalRun.context.Δwf
  have currentReference : VLCtx.IsDefEq env Us.length
      terminalRun.context.vlctx
      owner.annotation.terminalRun.context.vlctx := by
    rw [terminalRunContext]
    exact VLCtx.IsDefEq.refl henv.ordered terminalWF
  have terminalShape :
      owner.annotation.terminalRun.context.vlctx.FVarLamOnly :=
    owner.annotation.annotation_spine.terminalShape .nil
  have currentUnique : TrExprS.IsUniqueCtx terminalRun.context.vlctx
      owner.annotation.terminalRun.context.vlctx :=
    ((currentReference.symm henv.ordered).isUniqueCtx terminalShape).symm
  let alignment : ConstructorSharedParameterContextAlignment env Us
      parameterΔ contextRun := {
    reference := owner.annotation.terminalRun.context.vlctx
    rootLift := .skipN .refl
      (owner.annotation.storedBinders.drop source.nparams).length
    root_reference_lift := parameterLift
    current_reference := currentReference
    current_unique := currentUnique }
  have nextParamsEq : validation.continuation.nextStats.params =
      validation.continuation.telescope.result.stats.params :=
    familyParameterComparisonBlockTrace_headContinuation_nextParams
      validation.selected
  have nextLocalState : TypeChecker.FamilyParameterLocalState
      validation.continuation.nextStats
      validation.continuation.telescope.result.context :=
    validation.localState.of_params_eq nextParamsEq
  have nextParameterSourcesEq :
      validation.continuation.nextStats.params.toList =
        produced.candidate.families.head.familyType.type.trace.parameterList
          source.nparams :=
    (congrArg Array.toList nextParamsEq).trans
      validation.parameterSources_eq
  have nextParamsSize : validation.continuation.nextStats.params.size =
      source.nparams := by
    calc
      validation.continuation.nextStats.params.size =
          validation.continuation.telescope.result.stats.params.size :=
        congrArg Array.size nextParamsEq
      _ = source.nparams := validation.params_size
  have familyRun := normalization.familyValidationResult_run
    normalizationProduced
  have finalParamsSize : normalization.stats.params.size = source.nparams := by
    have sizes := normalization.familyValidationResult.sizes_of_run
      produced.kernelSources_nonempty familyRun
    simpa only [normalization,
      AddInductive.NormalizationCandidateExecution.familyValidationResult]
      using sizes.1
  have tailParamsSize :
      validation.continuation.tail.result.stats.params.size =
        source.nparams := by
    rw [tailResultEq]
    simpa only [
      AddInductive.NormalizationCandidateExecution.familyValidationResult]
      using finalParamsSize
  have terminalLocal :=
    familyParameterComparisonBlockTrace_terminalLocalStateExact
      validation.continuation.tail tailLengthLe nextLocalState nextParamsSize
        nextParameterSourcesEq tailParamsSize
  rw [tailResultEq] at terminalLocal
  change TypeChecker.FamilyParameterLocalState normalization.stats
      normalization.validationContext ∧
    normalization.stats.params.toList =
      produced.candidate.families.head.familyType.type.trace.parameterList
        source.nparams ∧
    normalization.stats.params.size = source.nparams at terminalLocal
  have firstRootLctx :
      produced.candidate.families.head.familyType.type.context.lctx =
        ({} : LocalContext) := by
    calc
      produced.candidate.families.head.familyType.type.context.lctx =
          ({ context with lctx := {} } : AddInductive.Context).lctx :=
        congrArg AddInductive.Context.lctx
          owner.validationAnnotations.head_context_eq
      _ = {} := rfl
  obtain ⟨parameterFinal, parameterRun⟩ :=
    candidateAnnotationSpine_selectedForallPrefixRun
      owner.annotation.annotation_spine
      (TypeChecker.CandidateLocalContextRun.empty _ firstRootLctx)
      owner.annotation.validation_annotations source.nparams
      (by
        rw [owner.annotation.stored_length,
          ← owner.shape.spineLength_eq_ctorFields]
        exact owner.nparams_le_spineLength context_lctx_eq)
  let parameterRun' := selectedForallArrayRun_retargetImplementation
    parameterRun (targetLCtx := normalization.validationContext.lctx) (by
      intro fv decl found
      rw [← candidateTerminalFinal]
      exact found)
  have parameterSourcesArray : normalization.stats.params =
      (produced.candidate.families.head.familyType.type.trace.parameterList
        source.nparams).toArray := by
    rw [← Array.toList_inj]
    simpa using terminalLocal.2.1
  exact ⟨{
    contextRun := contextRun
    parameterDelta := parameterΔ
    parameterSources :=
      produced.candidate.families.head.familyType.type.trace.parameterList
        source.nparams
    storedTypes := owner.annotation.storedBinders.take source.nparams
    params := params
    parameterSelection := by
      rw [parameterSourcesArray]
      exact ⟨⟨parameterFinal, parameterRun'⟩⟩
    localState := terminalLocal.1
    alignment := alignment
    parameterSources_eq := terminalLocal.2.1
    params_size := terminalLocal.2.2
    storedCanonical :=
      owner.storedViewParameterTelescopeDefEq context_lctx_eq }⟩

private theorem candidateBlockFamilySemanticListRun_views_eq_nil
    {candidates : AddInductive.CandidateList AddInductive.CandidateFamily []}
    {raws : List VInductiveType}
    (run : CandidateBlockFamilySemanticListRun env blockEnv Us candidates
      raws) : run.views = [] := by
  cases run
  rfl

/-- Retarget the singleton first-family audit basis to the exact checked
parameter telescope selected by the analyzer result. -/
theorem
    ProducedBlockRecursorShapeCandidate.FirstFamilyAnnotationSpine.singletonRawParameterAuditBasisForGeneration_nonempty
    {source : VInductDecl}
    {firstSource : InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source [firstSource]
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {generation : BlockGenerationChecked source}
    (run : ExactProducedBlockGenerationRun env blockEnv Us
      produced.eliminationBase.base generation)
    (owner : produced.FirstFamilyAnnotationSpine
      run.producedSemantic.semantic)
    (context_lctx_eq : context.lctx = {}) :
    Nonempty (ConstructorRawPreFamilyParameterAuditBasis env Us
      produced.execution.eliminationExecution.normalization.stats
      produced.execution.eliminationExecution.normalization.validationContext
      source.nparams generation.block.checked.params) := by
  have basis :=
    owner.singletonRawParameterAuditBasis_nonempty context_lctx_eq
  have tailViews : owner.position.tail.views = [] :=
    candidateBlockFamilySemanticListRun_views_eq_nil owner.position.tail
  have semanticViews : run.producedSemantic.semantic.families.views =
      owner.position.semantic.view :: owner.position.tail.views := by
    simpa only [ProducedBlockRecursorShapeCandidate.eliminationBase,
      ProducedBlockEliminationShapeCandidate.base,
      ProducedBlockGenerationShapeCandidate.candidate,
      ProducedBlockRecursorShapeCandidate.candidate,
      AddInductive.NormalizationRecursorExecution.candidate,
      AddInductive.NormalizationEliminationExecution.candidate,
      AddInductive.NormalizationCandidateExecution.candidate] using
      owner.semantic_views_eq
  have singletonViews : run.producedSemantic.semantic.families.views =
      [owner.position.semantic.view] := by
    rw [semanticViews, tailViews]
  have firstParams : generation.block.checked.params =
      VExpr.telN source.nparams owner.position.semantic.type.view := by
    calc
      generation.block.checked.params = blockParams source.nparams
          run.producedSemantic.semantic.families.views :=
        run.checkedParams_eq_semanticBlockParams
      _ = VExpr.telN source.nparams owner.position.semantic.type.view := by
        exact (congrArg (blockParams source.nparams) singletonViews).trans rfl
  simpa only [firstParams] using basis

/-- Retain the exact dependency-stage parameter context behind the completed
mutual producer as a reusable target-fold basis.  The existential packaging
is necessary because the alignment theorem itself exposes its verifier run
and reference context propositionally. -/
theorem
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion.rawParameterAuditBasis_nonempty
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {staging : produced.SecondFamilyIndexStaging semantic}
    {raw : Option staging.annotation.RawFirstIndexDomain}
    (completion : staging.TerminalIndexDomainCompletion raw)
    (context_lctx_eq : context.lctx = {}) :
    Nonempty (ConstructorRawPreFamilyParameterAuditBasis env Us
      produced.execution.eliminationExecution.normalization.stats
      produced.execution.eliminationExecution.normalization.validationContext
      source.nparams
      (VExpr.telN source.nparams
        staging.annotation.firstSemantic.type.view)) := by
  obtain ⟨terminalRun, terminalVenv, terminalLparams, reference, rootLift,
      rootReferenceLift, currentReference, currentUnique⟩ :=
    completion.blockValidationParameterContextAlignment context_lctx_eq
  let contextRun : AddInductive.ConstructorContextRun env Us
      produced.execution.eliminationExecution.normalization.validationContext :=
    ⟨terminalRun, terminalVenv, terminalLparams⟩
  let alignment : ConstructorSharedParameterContextAlignment env Us
      completion.prefixes.firstParameterΔ contextRun := {
    reference := reference
    rootLift := rootLift
    root_reference_lift := rootReferenceLift
    current_reference := currentReference
    current_unique := currentUnique }
  obtain ⟨localState, parameterSourcesEq, paramsSize⟩ :=
    completion.blockValidationLocalStateExact context_lctx_eq
  obtain ⟨cursor⟩ :=
    completion.remainingFamilyValidationCursor context_lctx_eq
  obtain ⟨annotations⟩ := cursor.annotationSpines
  obtain ⟨spine⟩ :=
    (cursor.iterationCursorExact annotations).completionSpine context_lctx_eq
  have firstTerminalFind : ∀ {fv : FVarId} {decl : LocalDecl},
      staging.annotation.firstCandidate.familyType.type.trace.terminalContext.lctx.find?
          fv = some decl →
        produced.execution.eliminationExecution.normalization.validationContext.lctx.find?
          fv = some decl := by
    intro fv decl found
    have endpoint := spine.terminalFirstTerminalFind found
    rw [AddInductive.FamilyParameterComparisonBlockTrace.secondContinuation?_result
      cursor.validation.selected] at endpoint
    have canonicalEq :
        ((produced.execution.eliminationExecution.normalization
          ).familyParameterComparisonTrace
            (produced.execution.normalization_run produced.producedExecution)
            produced.kernelSources_nonempty).result =
          (produced.execution.eliminationExecution.normalization
            ).familyValidationResult :=
      AddInductive.FamilyValidationBlockRun.parameterComparisonTrace_result _
    rw [canonicalEq] at endpoint
    exact endpoint
  have firstRootLctx :
      staging.annotation.firstCandidate.familyType.type.context.lctx =
        ({} : LocalContext) := by
    calc
      staging.annotation.firstCandidate.familyType.type.context.lctx =
          staging.annotation.secondCandidate.familyType.type.context.lctx :=
        congrArg AddInductive.Context.lctx
          staging.annotation.candidate_context_eq
      _ = ({ context with lctx := {} } : AddInductive.Context).lctx :=
        congrArg AddInductive.Context.lctx
          staging.annotation.second_candidate_context_eq
      _ = {} := rfl
  obtain ⟨parameterFinal, parameterRun⟩ :=
    candidateAnnotationSpine_selectedForallPrefixRun
      staging.annotation.first_annotation_spine
      (TypeChecker.CandidateLocalContextRun.empty _ firstRootLctx)
      staging.annotation.first_validation_annotations source.nparams
      (by
        rw [staging.annotation.firstStoredLength,
          ← staging.annotation.firstSpineLength_eq]
        exact staging.annotation.first_nparams_le_spineLength context_lctx_eq)
  let parameterRun' := selectedForallArrayRun_retargetImplementation
    parameterRun
      (targetLCtx := produced.execution.eliminationExecution.normalization
        |>.validationContext.lctx)
      firstTerminalFind
  have parameterSourcesArray :
      produced.execution.eliminationExecution.normalization.stats.params =
        (staging.annotation.firstCandidate.familyType.type.trace.parameterList
          source.nparams).toArray := by
    rw [← Array.toList_inj]
    simpa using parameterSourcesEq
  exact ⟨{
    contextRun := contextRun
    parameterDelta := completion.prefixes.firstParameterΔ
    parameterSources :=
      staging.annotation.firstCandidate.familyType.type.trace.parameterList
        source.nparams
    storedTypes := staging.annotation.firstStoredBinders.take source.nparams
    params := completion.firstParameterContext
    parameterSelection := by
      rw [parameterSourcesArray]
      exact ⟨⟨parameterFinal, parameterRun'⟩⟩
    localState := localState
    alignment := alignment
    parameterSources_eq := parameterSourcesEq
    params_size := paramsSize
    storedCanonical :=
      staging.firstStoredViewParameterTelescopeDefEq context_lctx_eq }⟩

/-- Retarget the completed raw-parameter audit basis to the checked telescope
owned by an exact analyzer result.  The analyzer provenance identifies its
stored parameters with the semantic block's first family, while the staging
annotation identifies that family with the completion's canonical view. -/
theorem
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion.rawParameterAuditBasisForGeneration_nonempty
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {generation : BlockGenerationChecked source}
    (run : ExactProducedBlockGenerationRun env blockEnv Us
      produced.eliminationBase.base generation)
    {staging : produced.SecondFamilyIndexStaging
      run.producedSemantic.semantic}
    {raw : Option staging.annotation.RawFirstIndexDomain}
    (completion : staging.TerminalIndexDomainCompletion raw)
    (context_lctx_eq : context.lctx = {}) :
    Nonempty (ConstructorRawPreFamilyParameterAuditBasis env Us
      produced.execution.eliminationExecution.normalization.stats
      produced.execution.eliminationExecution.normalization.validationContext
      source.nparams generation.block.checked.params) := by
  have basis := completion.rawParameterAuditBasis_nonempty context_lctx_eq
  have semanticViews := staging.annotation.semantic_views_eq
  change run.producedSemantic.semantic.families.views =
    staging.annotation.firstSemantic.view ::
      staging.annotation.secondSemantic.view ::
        staging.annotation.remainingSemantics.views at semanticViews
  have firstParams : generation.block.checked.params =
      VExpr.telN source.nparams
        staging.annotation.firstSemantic.type.view := by
    calc
      generation.block.checked.params = blockParams source.nparams
          run.producedSemantic.semantic.families.views :=
        run.checkedParams_eq_semanticBlockParams
      _ = VExpr.telN source.nparams
          staging.annotation.firstSemantic.type.view := by
        rw [semanticViews]
        rfl
  simpa only [firstParams] using basis

