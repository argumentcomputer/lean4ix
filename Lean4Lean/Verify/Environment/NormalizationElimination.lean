/-- The canonical checked-family spine retains the exact mixed raw/view
layout selected by the producer, including every residual constructor field
count and universe arity. -/
theorem
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion.canonicalCheckedFamiliesGenerationLayout
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
