/-- Fold the shared-parameter prefix of one retained constructor-validation
trace into telescope definitional equality against the stored parameter
binders.  Parameter branches instantiate their free variables before the
recursive step, so the public telescope remains in the original raw context. -/
theorem ConstructorSharedParameterContextAlignment.rawParameterTelescopeDefEq
    {env : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {isUnsafe : Bool}
    {familyIdx : Nat} {ctor : Name}
    {context : AddInductive.Context}
    {contextRun : AddInductive.ConstructorContextRun env Us context}
    {source view : Expr} {argIdx fuel whnfFuel : Nat}
    {trace : AddInductive.ConstructorTypeValidationTrace stats isUnsafe
      familyIdx ctor context source argIdx fuel}
    {rawΔ base final : VLCtx} {rawType : VExpr}
    {parameters : List Expr} {types : List VExpr}
    (params : TypeChecker.CandidateParameterContext base parameters types final)
    (localState : TypeChecker.FamilyParameterLocalState stats context)
    (alignment : ConstructorSharedParameterContextAlignment env Us final
      contextRun)
    (rawStored : VLCtx.IsDefEq env Us.length rawΔ base)
    (paramsEq : stats.params.toList.drop argIdx = parameters)
    (sourceTr : TrExprS env Us rawΔ source rawType)
    (semantic : AddInductive.ConstructorViewSemanticRun env Us whnfFuel
      contextRun trace view) :
    TypeChecker.TelDefEqEvidence env Us.length rawΔ.toCtx
      (VExpr.telN parameters.length rawType) types :=
  (constructorRawParameterTelescopeDefEqAux params localState alignment
    rawStored paramsEq sourceTr semantic).1

/-! The supplemental raw-parameter audit runs before flattened family
constants are inserted.  Folding that trace here is deliberately parallel to
`rawParameterTelescopeDefEq`, but its resulting judgment lives in the
dependency environment and can therefore be weakened directly to a restored
nested-block endpoint. -/

private theorem constructorRawParameterPreFamilyTelescopeDefEqAux
    {env postEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {context : AddInductive.Context}
    {contextRun : AddInductive.ConstructorContextRun env Us context}
    {source : Expr} {argIdx fuel : Nat}
    {trace : AddInductive.ConstructorRawParameterPreFamilyTrace stats context
      source argIdx fuel}
    {rawΔ base final : VLCtx} {rawType : VExpr}
    {parameters : List Expr} {types : List VExpr}
    (params : TypeChecker.CandidateParameterContext base parameters types final)
    (localState : TypeChecker.FamilyParameterLocalState stats context)
    (alignment : ConstructorSharedParameterContextAlignment env Us final
      contextRun)
    (rawStored : VLCtx.IsDefEq env Us.length rawΔ base)
    (rawUnique : TrExprS.IsUniqueCtx rawΔ base)
    (paramsEq : stats.params.toList.drop argIdx = parameters)
    (sourceUnique : TrExprS.IsUnique source)
    (envLE : env ≤ postEnv)
    (postWF : postEnv.WF)
    (sourceTr : TrExprS postEnv Us rawΔ source rawType)
    (semantic : AddInductive.ConstructorRawParameterPreFamilySemanticRun env
      Us stats context contextRun trace) :
    TypeChecker.TelDefEqEvidence env Us.length rawΔ.toCtx
      (VExpr.telN parameters.length rawType) types := by
  induction params generalizing rawΔ rawType source argIdx fuel trace with
  | nil => exact .nil
  | @cons fv deps A base parameters types final tail ih =>
      cases semantic with
      | done =>
          rename_i traceSource traceArgIdx traceFuel noParameter
          have parameterExpected :=
            array_getElem?_eq_some_of_drop_eq_cons paramsEq
          rw [noParameter] at parameterExpected
          contradiction
      | parameter domainRun parameterTypeSemantic validationRun tailSemantic =>
          rename_i traceFuel binderName domain body binderInfo param
            parameterType parameterTypeGet domainCheck parameterTypeCheck
            comparison parameterAt tailTrace
          have parameterExpected :=
            array_getElem?_eq_some_of_drop_eq_cons paramsEq
          have paramEq : param = .fvar fv :=
            Option.some.inj (parameterAt.symm.trans parameterExpected)
          subst param
          have tailParamsEq : stats.params.toList.drop (argIdx + 1) =
              parameters := by
            have tails := congrArg List.tail paramsEq
            simpa only [List.tail_drop, List.tail_cons] using tails
          obtain ⟨rawDomain, rawBody, rawTypeEq, rawDomainType,
              rawBodyType, rawDomainTr, rawBodyTr⟩ :=
            TypeChecker.TrExprS.forallE_components sourceTr
          subst rawType
          have henv : VEnv.WF env := by
            simpa only [contextRun.venv_eq] using
              contextRun.candidate.context.Ewf
          have currentWF : VLCtx.WF env Us.length
              contextRun.candidate.context.vlctx := by
            simpa only [contextRun.venv_eq, contextRun.lparams_eq] using
              contextRun.candidate.context.Δwf
          have referenceWF : VLCtx.WF env Us.length alignment.reference :=
            (alignment.current_reference.symm henv.ordered).wf
          have finalWF : VLCtx.WF env Us.length final :=
            alignment.root_reference_lift.wf henv referenceWF
          obtain ⟨tailLift, tailExtension⟩ :=
            TypeChecker.CandidateParameterContext.extension tail
          let tailReferenceLift :=
            tailExtension.comp alignment.root_reference_lift
          let headExtension : VLCtx.FVLift' base
              ((some (fv, deps), .vlam A) :: base) 0
                (Lift.skipN Lift.refl 1) 0 :=
            .skip_fvar _ _ .refl
          let baseReferenceLift :=
            headExtension.comp tailReferenceLift
          have domainScope : domain.FVarsIn (· ∈ VLCtx.fvars base) := by
            simpa only [rawStored.fvars] using rawDomainTr.fvarsIn
          have currentNoBV : contextRun.candidate.context.vlctx.NoBV :=
            contextRun.candidate.context.mlctx.noBV
          have currentDomainTr : TrExprS env Us
              contextRun.candidate.context.vlctx domain domainRun.source' := by
            simpa only [TypeChecker.VContext.TrExprS,
              contextRun.venv_eq, contextRun.lparams_eq] using
                domainRun.check.expr_tr
          have domainClosed : Closed domain 0 := by
            simpa only [currentNoBV] using currentDomainTr.closed
          obtain ⟨baseDomain, baseDomainTr⟩ :=
            currentDomainTr.weakFV'_inv henv baseReferenceLift
              alignment.current_reference domainClosed domainScope
          have rawDomainEq : rawDomain = baseDomain :=
            rawDomainTr.unique' rawUnique sourceUnique.1
              (baseDomainTr.mono envLE)
          subst rawDomain
          have baseDomainAtReference :=
            baseDomainTr.weakFV' henv.ordered baseReferenceLift referenceWF
          have currentBaseDomain :=
            currentDomainTr.uniq henv alignment.current_reference
              baseDomainAtReference
          have parameterMember : (.fvar fv : Expr) ∈ stats.params.toList :=
            List.mem_of_mem_drop (by rw [paramsEq]; simp)
          obtain ⟨localFv, decl, localEq, parameterFind⟩ :=
            localState.parameters parameterMember
          have localFvEq : localFv = fv :=
            Expr.fvar.inj localEq.symm
          subst localFv
          obtain ⟨fvValue, lookupType, fvFind, lookupTypeTr⟩ :=
            contextRun.candidate.getTypeTranslation parameterFind
              parameterTypeGet
          have parameterTypeTr : TrExprS env Us
              contextRun.candidate.context.vlctx parameterType
              parameterTypeSemantic.source' := by
            simpa only [TypeChecker.VContext.TrExprS,
              contextRun.venv_eq, contextRun.lparams_eq] using
                parameterTypeSemantic.check.expr_tr
          have lookupTypeTr' : TrExprS env Us
              contextRun.candidate.context.vlctx parameterType lookupType := by
            simpa only [TypeChecker.VContext.TrExprS,
              contextRun.venv_eq, contextRun.lparams_eq] using lookupTypeTr
          have parameterLookup : env.IsDefEqU Us.length
              contextRun.candidate.context.vlctx.toCtx
              parameterTypeSemantic.source' lookupType :=
            parameterTypeTr.uniq henv (.refl henv currentWF) lookupTypeTr'
          have validationEq : env.IsDefEqU Us.length
              contextRun.candidate.context.vlctx.toCtx domainRun.source'
              parameterTypeSemantic.source' := by
            simpa only [contextRun.venv_eq, contextRun.lparams_eq] using
              validationRun.isDefEqU
          have domainLookup : env.IsDefEqU Us.length
              contextRun.candidate.context.vlctx.toCtx domainRun.source'
              lookupType :=
            validationEq.trans henv currentWF.toCtx parameterLookup
          have nextFind :
              VLCtx.find? ((some (fv, deps), .vlam A) :: base : VLCtx)
                (Sum.inr fv : Nat ⊕ FVarId) =
                  some (VExpr.bvar 0, A.lift) := by
            simp [VLCtx.find?, VLCtx.next, VLocalDecl.value,
              VLocalDecl.type]
          have referenceFind :=
            tailReferenceLift.find? referenceWF nextFind
          have lookupReference :=
            (alignment.current_reference.find?_uniq henv fvFind
              referenceFind).1
          have referenceTypeEq :
              A.lift.lift' ((tailLift.comp alignment.rootLift).consN 0) =
                A.lift' (((Lift.skipN Lift.refl 1).comp
                  (tailLift.comp alignment.rootLift)).consN 0) := by
            simp only [Lift.consN, Lift.skipN_one, VExpr.lift_eq_lift',
              VExpr.lift'_comp]
          rw [referenceTypeEq] at lookupReference
          have domainReference : env.IsDefEqU Us.length
              contextRun.candidate.context.vlctx.toCtx domainRun.source'
              (A.lift' (((Lift.skipN Lift.refl 1).comp
                (tailLift.comp alignment.rootLift)).consN 0)) :=
            domainLookup.trans henv currentWF.toCtx lookupReference
          have liftedBaseStored : env.IsDefEqU Us.length
              contextRun.candidate.context.vlctx.toCtx
              (baseDomain.lift' (((Lift.skipN Lift.refl 1).comp
                (tailLift.comp alignment.rootLift)).consN 0))
              (A.lift' (((Lift.skipN Lift.refl 1).comp
                (tailLift.comp alignment.rootLift)).consN 0)) :=
            currentBaseDomain.symm.trans henv currentWF.toCtx domainReference
          have liftedAtReference : env.IsDefEqU Us.length
              alignment.reference.toCtx
              (baseDomain.lift' (((Lift.skipN Lift.refl 1).comp
                (tailLift.comp alignment.rootLift)).consN 0))
              (A.lift' (((Lift.skipN Lift.refl 1).comp
                (tailLift.comp alignment.rootLift)).consN 0)) :=
            liftedBaseStored.defeqDFC henv.ordered
              alignment.current_reference.defeqCtx
          have baseStored : env.IsDefEqU Us.length (VLCtx.toCtx base)
              baseDomain A :=
            (VEnv.IsDefEqU.weak'_iff henv referenceWF.toCtx
              baseReferenceLift.toCtx).1 liftedAtReference
          have baseStoredAtRaw : env.IsDefEqU Us.length rawΔ.toCtx
              baseDomain A :=
            baseStored.defeqDFC henv.ordered
              (rawStored.defeqCtx.symm henv.ordered)
          have storedType : env.IsType Us.length (VLCtx.toCtx base) A :=
            (tail.initialWF finalWF).2.2
          obtain ⟨domainLevel, storedHasType⟩ := storedType
          have rawStoredDef : env.IsDefEq Us.length rawΔ.toCtx baseDomain A
              (.sort domainLevel) :=
            baseStoredAtRaw.of_r henv rawStored.wf.toCtx
              (storedHasType.defeqDFC henv.ordered
                (rawStored.defeqCtx.symm henv.ordered))
          have pushedFVars :
              ∀ currentFv currentDeps,
                some (fv, deps) = some (currentFv, currentDeps) →
                  currentFv ∉ rawΔ.fvars ∧ currentDeps ⊆ rawΔ.fvars := by
            intro currentFv currentDeps equality
            have pairEq : (fv, deps) = (currentFv, currentDeps) :=
              Option.some.inj equality
            injection pairEq with currentFvEq currentDepsEq
            subst currentFv
            subst currentDeps
            simpa only [rawStored.fvars] using
              (tail.initialWF finalWF).2.1 fv deps rfl
          have rawNextStored : VLCtx.IsDefEq env Us.length
              ((some (fv, deps), .vlam baseDomain) :: rawΔ)
              ((some (fv, deps), .vlam A) :: base) :=
            .cons rawStored pushedFVars (.vlam rawStoredDef)
          have bodyInstTr : TrExprS postEnv Us
              ((some (fv, deps), .vlam baseDomain) :: rawΔ)
              (body.instantiate1 (.fvar fv)) rawBody := by
            simpa only [Expr.instantiate1_eq] using
              rawBodyTr.inst_fvar postWF.ordered
                (rawNextStored.mono envLE).wf
          have rawNextUnique : TrExprS.IsUniqueCtx
              ((some (fv, deps), .vlam baseDomain) :: rawΔ)
              ((some (fv, deps), .vlam A) :: base) :=
            rawUnique.cons .vlam
          have tailSourceUnique :
              TrExprS.IsUnique (body.instantiate1 (.fvar fv)) :=
            ConstructorValidation.TrExprS.IsUnique.instantiate1
              sourceUnique.2 (by trivial)
          have tailResult := ih alignment rawNextStored rawNextUnique
            tailParamsEq tailSourceUnique bodyInstTr tailSemantic
          have combined : TypeChecker.TelDefEqEvidence env Us.length
              rawΔ.toCtx (baseDomain :: VExpr.telN parameters.length rawBody)
              (A :: types) :=
            .cons (.ofDefEq rawStoredDef) tailResult
          simpa only [List.length_cons, VExpr.telN] using combined

/-- The exact raw constructor prefix is definitionally equal to the stored
shared-parameter telescope in the pre-family dependency environment. -/
theorem ConstructorSharedParameterContextAlignment.rawParameterPreFamilyTelescopeDefEq
    {env postEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {context : AddInductive.Context}
    {contextRun : AddInductive.ConstructorContextRun env Us context}
    {source : Expr} {argIdx fuel : Nat}
    {trace : AddInductive.ConstructorRawParameterPreFamilyTrace stats context
      source argIdx fuel}
    {rawΔ base final : VLCtx} {rawType : VExpr}
    {parameters : List Expr} {types : List VExpr}
    (params : TypeChecker.CandidateParameterContext base parameters types final)
    (localState : TypeChecker.FamilyParameterLocalState stats context)
    (alignment : ConstructorSharedParameterContextAlignment env Us final
      contextRun)
    (rawStored : VLCtx.IsDefEq env Us.length rawΔ base)
    (rawUnique : TrExprS.IsUniqueCtx rawΔ base)
    (paramsEq : stats.params.toList.drop argIdx = parameters)
    (sourceUnique : TrExprS.IsUnique source)
    (envLE : env ≤ postEnv)
    (postWF : postEnv.WF)
    (sourceTr : TrExprS postEnv Us rawΔ source rawType)
    (semantic : AddInductive.ConstructorRawParameterPreFamilySemanticRun env
      Us stats context contextRun trace) :
    TypeChecker.TelDefEqEvidence env Us.length rawΔ.toCtx
      (VExpr.telN parameters.length rawType) types :=
  constructorRawParameterPreFamilyTelescopeDefEqAux params localState
    alignment rawStored rawUnique paramsEq sourceUnique envLE postWF sourceTr
      semantic

/-! The target-environment form below does not require a syntactically unique
strict translation.  The dependency-stage audit chooses one translation of
each parameter domain; after weakening that translation to `postEnv`, the
general `TrExprS.uniq` theorem compares it definitionally with the exact
translation retained by the target producer.  This is the form needed by
nested restoration, whose public constructor type is selected only at the
completed restored endpoint and may contain projections. -/

private theorem constructorRawParameterPreFamilyTelescopeDefEqInTargetAux
    {env postEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {context : AddInductive.Context}
    {contextRun : AddInductive.ConstructorContextRun env Us context}
    {source : Expr} {argIdx fuel : Nat}
    {trace : AddInductive.ConstructorRawParameterPreFamilyTrace stats context
      source argIdx fuel}
    {rawΔ base final : VLCtx} {rawType : VExpr}
    {parameters : List Expr} {types : List VExpr}
    (params : TypeChecker.CandidateParameterContext base parameters types final)
    (localState : TypeChecker.FamilyParameterLocalState stats context)
    (alignment : ConstructorSharedParameterContextAlignment env Us final
      contextRun)
    (rawStored : VLCtx.IsDefEq postEnv Us.length rawΔ base)
    (paramsEq : stats.params.toList.drop argIdx = parameters)
    (envLE : env ≤ postEnv)
    (postWF : postEnv.WF)
    (sourceTr : TrExprS postEnv Us rawΔ source rawType)
    (semantic : AddInductive.ConstructorRawParameterPreFamilySemanticRun env
      Us stats context contextRun trace) :
    TypeChecker.TelDefEqEvidence postEnv Us.length rawΔ.toCtx
      (VExpr.telN parameters.length rawType) types := by
  induction params generalizing rawΔ rawType source argIdx fuel trace with
  | nil => exact .nil
  | @cons fv deps A base parameters types final tail ih =>
      cases semantic with
      | done =>
          rename_i traceSource traceArgIdx traceFuel noParameter
          have parameterExpected :=
            array_getElem?_eq_some_of_drop_eq_cons paramsEq
          rw [noParameter] at parameterExpected
          contradiction
      | parameter domainRun parameterTypeSemantic validationRun tailSemantic =>
          rename_i traceFuel binderName domain body binderInfo param
            parameterType parameterTypeGet domainCheck parameterTypeCheck
            comparison parameterAt tailTrace
          have parameterExpected :=
            array_getElem?_eq_some_of_drop_eq_cons paramsEq
          have paramEq : param = .fvar fv :=
            Option.some.inj (parameterAt.symm.trans parameterExpected)
          subst param
          have tailParamsEq : stats.params.toList.drop (argIdx + 1) =
              parameters := by
            have tails := congrArg List.tail paramsEq
            simpa only [List.tail_drop, List.tail_cons] using tails
          obtain ⟨rawDomain, rawBody, rawTypeEq, rawDomainType,
              rawBodyType, rawDomainTr, rawBodyTr⟩ :=
            TypeChecker.TrExprS.forallE_components sourceTr
          subst rawType
          have henv : VEnv.WF env := by
            simpa only [contextRun.venv_eq] using
              contextRun.candidate.context.Ewf
          have currentWF : VLCtx.WF env Us.length
              contextRun.candidate.context.vlctx := by
            simpa only [contextRun.venv_eq, contextRun.lparams_eq] using
              contextRun.candidate.context.Δwf
          have referenceWF : VLCtx.WF env Us.length alignment.reference :=
            (alignment.current_reference.symm henv.ordered).wf
          have finalWF : VLCtx.WF env Us.length final :=
            alignment.root_reference_lift.wf henv referenceWF
          obtain ⟨tailLift, tailExtension⟩ :=
            TypeChecker.CandidateParameterContext.extension tail
          let tailReferenceLift :=
            tailExtension.comp alignment.root_reference_lift
          let headExtension : VLCtx.FVLift' base
              ((some (fv, deps), .vlam A) :: base) 0
                (Lift.skipN Lift.refl 1) 0 :=
            .skip_fvar _ _ .refl
          let baseReferenceLift :=
            headExtension.comp tailReferenceLift
          have domainScope : domain.FVarsIn (· ∈ VLCtx.fvars base) := by
            simpa only [rawStored.fvars] using rawDomainTr.fvarsIn
          have currentNoBV : contextRun.candidate.context.vlctx.NoBV :=
            contextRun.candidate.context.mlctx.noBV
          have currentDomainTr : TrExprS env Us
              contextRun.candidate.context.vlctx domain domainRun.source' := by
            simpa only [TypeChecker.VContext.TrExprS,
              contextRun.venv_eq, contextRun.lparams_eq] using
                domainRun.check.expr_tr
          have domainClosed : Closed domain 0 := by
            simpa only [currentNoBV] using currentDomainTr.closed
          obtain ⟨baseDomain, baseDomainTr⟩ :=
            currentDomainTr.weakFV'_inv henv baseReferenceLift
              alignment.current_reference domainClosed domainScope
          have rawBaseDomain : postEnv.IsDefEqU Us.length rawΔ.toCtx
              rawDomain baseDomain :=
            rawDomainTr.uniq postWF rawStored (baseDomainTr.mono envLE)
          have baseDomainAtReference :=
            baseDomainTr.weakFV' henv.ordered baseReferenceLift referenceWF
          have currentBaseDomain :=
            currentDomainTr.uniq henv alignment.current_reference
              baseDomainAtReference
          have parameterMember : (.fvar fv : Expr) ∈ stats.params.toList :=
            List.mem_of_mem_drop (by rw [paramsEq]; simp)
          obtain ⟨localFv, decl, localEq, parameterFind⟩ :=
            localState.parameters parameterMember
          have localFvEq : localFv = fv :=
            Expr.fvar.inj localEq.symm
          subst localFv
          obtain ⟨fvValue, lookupType, fvFind, lookupTypeTr⟩ :=
            contextRun.candidate.getTypeTranslation parameterFind
              parameterTypeGet
          have parameterTypeTr : TrExprS env Us
              contextRun.candidate.context.vlctx parameterType
              parameterTypeSemantic.source' := by
            simpa only [TypeChecker.VContext.TrExprS,
              contextRun.venv_eq, contextRun.lparams_eq] using
                parameterTypeSemantic.check.expr_tr
          have lookupTypeTr' : TrExprS env Us
              contextRun.candidate.context.vlctx parameterType lookupType := by
            simpa only [TypeChecker.VContext.TrExprS,
              contextRun.venv_eq, contextRun.lparams_eq] using lookupTypeTr
          have parameterLookup : env.IsDefEqU Us.length
              contextRun.candidate.context.vlctx.toCtx
              parameterTypeSemantic.source' lookupType :=
            parameterTypeTr.uniq henv (.refl henv currentWF) lookupTypeTr'
          have validationEq : env.IsDefEqU Us.length
              contextRun.candidate.context.vlctx.toCtx domainRun.source'
              parameterTypeSemantic.source' := by
            simpa only [contextRun.venv_eq, contextRun.lparams_eq] using
              validationRun.isDefEqU
          have domainLookup : env.IsDefEqU Us.length
              contextRun.candidate.context.vlctx.toCtx domainRun.source'
              lookupType :=
            validationEq.trans henv currentWF.toCtx parameterLookup
          have nextFind :
              VLCtx.find? ((some (fv, deps), .vlam A) :: base : VLCtx)
                (Sum.inr fv : Nat ⊕ FVarId) =
                  some (VExpr.bvar 0, A.lift) := by
            simp [VLCtx.find?, VLCtx.next, VLocalDecl.value,
              VLocalDecl.type]
          have referenceFind :=
            tailReferenceLift.find? referenceWF nextFind
          have lookupReference :=
            (alignment.current_reference.find?_uniq henv fvFind
              referenceFind).1
          have referenceTypeEq :
              A.lift.lift' ((tailLift.comp alignment.rootLift).consN 0) =
                A.lift' (((Lift.skipN Lift.refl 1).comp
                  (tailLift.comp alignment.rootLift)).consN 0) := by
            simp only [Lift.consN, Lift.skipN_one, VExpr.lift_eq_lift',
              VExpr.lift'_comp]
          rw [referenceTypeEq] at lookupReference
          have domainReference : env.IsDefEqU Us.length
              contextRun.candidate.context.vlctx.toCtx domainRun.source'
              (A.lift' (((Lift.skipN Lift.refl 1).comp
                (tailLift.comp alignment.rootLift)).consN 0)) :=
            domainLookup.trans henv currentWF.toCtx lookupReference
          have liftedBaseStored : env.IsDefEqU Us.length
              contextRun.candidate.context.vlctx.toCtx
              (baseDomain.lift' (((Lift.skipN Lift.refl 1).comp
                (tailLift.comp alignment.rootLift)).consN 0))
              (A.lift' (((Lift.skipN Lift.refl 1).comp
                (tailLift.comp alignment.rootLift)).consN 0)) :=
            currentBaseDomain.symm.trans henv currentWF.toCtx domainReference
          have liftedAtReference : env.IsDefEqU Us.length
              alignment.reference.toCtx
              (baseDomain.lift' (((Lift.skipN Lift.refl 1).comp
                (tailLift.comp alignment.rootLift)).consN 0))
              (A.lift' (((Lift.skipN Lift.refl 1).comp
                (tailLift.comp alignment.rootLift)).consN 0)) :=
            liftedBaseStored.defeqDFC henv.ordered
              alignment.current_reference.defeqCtx
          have baseStored : env.IsDefEqU Us.length (VLCtx.toCtx base)
              baseDomain A :=
            (VEnv.IsDefEqU.weak'_iff henv referenceWF.toCtx
              baseReferenceLift.toCtx).1 liftedAtReference
          have baseStoredPost : postEnv.IsDefEqU Us.length
              (VLCtx.toCtx base) baseDomain A :=
            baseStored.mono envLE
          have baseStoredAtRaw : postEnv.IsDefEqU Us.length rawΔ.toCtx
              baseDomain A :=
            baseStoredPost.defeqDFC postWF.ordered
              (rawStored.defeqCtx.symm postWF.ordered)
          have rawStoredAtRaw : postEnv.IsDefEqU Us.length rawΔ.toCtx
              rawDomain A :=
            rawBaseDomain.trans postWF rawStored.wf.toCtx baseStoredAtRaw
          have storedType : env.IsType Us.length (VLCtx.toCtx base) A :=
            (tail.initialWF finalWF).2.2
          obtain ⟨domainLevel, storedHasType⟩ := storedType
          have storedHasTypeAtRaw : postEnv.HasType Us.length rawΔ.toCtx A
              (.sort domainLevel) :=
            (storedHasType.mono envLE).defeqDFC postWF.ordered
              (rawStored.defeqCtx.symm postWF.ordered)
          have rawStoredDef : postEnv.IsDefEq Us.length rawΔ.toCtx
              rawDomain A (.sort domainLevel) :=
            rawStoredAtRaw.of_r postWF rawStored.wf.toCtx storedHasTypeAtRaw
          have pushedFVars :
              ∀ currentFv currentDeps,
                some (fv, deps) = some (currentFv, currentDeps) →
                  currentFv ∉ rawΔ.fvars ∧ currentDeps ⊆ rawΔ.fvars := by
            intro currentFv currentDeps equality
            have pairEq : (fv, deps) = (currentFv, currentDeps) :=
              Option.some.inj equality
            injection pairEq with currentFvEq currentDepsEq
            subst currentFv
            subst currentDeps
            simpa only [rawStored.fvars] using
              (tail.initialWF finalWF).2.1 fv deps rfl
          have rawNextStored : VLCtx.IsDefEq postEnv Us.length
              ((some (fv, deps), .vlam rawDomain) :: rawΔ)
              ((some (fv, deps), .vlam A) :: base) :=
            .cons rawStored pushedFVars (.vlam rawStoredDef)
          have bodyInstTr : TrExprS postEnv Us
              ((some (fv, deps), .vlam rawDomain) :: rawΔ)
              (body.instantiate1 (.fvar fv)) rawBody := by
            simpa only [Expr.instantiate1_eq] using
              rawBodyTr.inst_fvar postWF.ordered rawNextStored.wf
          have tailResult := ih alignment rawNextStored tailParamsEq
            bodyInstTr tailSemantic
          have combined : TypeChecker.TelDefEqEvidence postEnv Us.length
              rawΔ.toCtx
              (rawDomain :: VExpr.telN parameters.length rawBody)
              (A :: types) :=
            .cons (.ofDefEq rawStoredDef) tailResult
          simpa only [List.length_cons, VExpr.telN] using combined

/-- Fold a raw constructor's shared-parameter audit directly in a larger
target environment.  Unlike `rawParameterPreFamilyTelescopeDefEq`, the exact
target translation need not be projection-free or syntactically unique. -/
theorem ConstructorSharedParameterContextAlignment.rawParameterPreFamilyTelescopeDefEqInTarget
    {env postEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {context : AddInductive.Context}
    {contextRun : AddInductive.ConstructorContextRun env Us context}
    {source : Expr} {argIdx fuel : Nat}
    {trace : AddInductive.ConstructorRawParameterPreFamilyTrace stats context
      source argIdx fuel}
    {rawΔ base final : VLCtx} {rawType : VExpr}
    {parameters : List Expr} {types : List VExpr}
    (params : TypeChecker.CandidateParameterContext base parameters types final)
    (localState : TypeChecker.FamilyParameterLocalState stats context)
    (alignment : ConstructorSharedParameterContextAlignment env Us final
      contextRun)
    (rawStored : VLCtx.IsDefEq postEnv Us.length rawΔ base)
    (paramsEq : stats.params.toList.drop argIdx = parameters)
    (envLE : env ≤ postEnv)
    (postWF : postEnv.WF)
    (sourceTr : TrExprS postEnv Us rawΔ source rawType)
    (semantic : AddInductive.ConstructorRawParameterPreFamilySemanticRun env
      Us stats context contextRun trace) :
    TypeChecker.TelDefEqEvidence postEnv Us.length rawΔ.toCtx
      (VExpr.telN parameters.length rawType) types :=
  constructorRawParameterPreFamilyTelescopeDefEqInTargetAux params localState
    alignment rawStored paramsEq envLE postWF sourceTr semantic

/-- Reusable producer-owned basis for folding exact raw shared-parameter
audits.  It retains the dependency context and alignment once, together with
the canonical stored telescope, while leaving the eventual constructor and
target environment open. -/
structure ConstructorRawPreFamilyParameterAuditBasis
    (env : VEnv) (Us : List Name)
    (stats : AddInductive.InductiveStats)
    (context : AddInductive.Context)
    (nparams : Nat) (canonicalTypes : List VExpr) where
  contextRun : AddInductive.ConstructorContextRun env Us context
  parameterDelta : VLCtx
  parameterSources : List Expr
  storedTypes : List VExpr
  params : TypeChecker.CandidateParameterContext [] parameterSources
    storedTypes parameterDelta
  parameterSelection : Nonempty (Sigma fun final =>
    TypeChecker.MLCtx.SelectedForall.ArrayRun env Us context.lctx []
      stats.params storedTypes final)
  localState : TypeChecker.FamilyParameterLocalState stats context
  alignment : ConstructorSharedParameterContextAlignment env Us parameterDelta
    contextRun
  parameterSources_eq : stats.params.toList = parameterSources
  params_size : stats.params.size = nparams
  storedCanonical : TypeChecker.TelDefEqEvidence env Us.length [] storedTypes
    canonicalTypes

namespace ConstructorRawPreFamilyParameterAuditBasis

/-- Fold one reindexed raw constructor audit directly at an arbitrary larger
target endpoint and postcompose it with the producer's canonical checked
parameter telescope. -/
theorem foldInTarget
    {env : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {context : AddInductive.Context}
    {sharedCount : Nat} {canonicalTypes : List VExpr}
    (basis : ConstructorRawPreFamilyParameterAuditBasis env Us stats context
      sharedCount canonicalTypes)
    {postEnv : VEnv} (envLE : env ≤ postEnv) (postWF : postEnv.WF)
    {source : Expr} {rawType : VExpr} {fuel : Nat}
    {auditTrace : AddInductive.ConstructorRawParameterPreFamilyTrace stats
      context source 0 fuel}
    (sourceTr : TrExprS postEnv Us [] source rawType)
    (audit : AddInductive.ConstructorRawParameterPreFamilySemanticRun env Us
      stats context basis.contextRun auditTrace) :
    TypeChecker.TelDefEqEvidence postEnv Us.length []
      (VExpr.telN sharedCount rawType) canonicalTypes := by
  have paramsLength : basis.parameterSources.length = sharedCount := by
    calc
      basis.parameterSources.length = stats.params.toList.length :=
        congrArg List.length basis.parameterSources_eq.symm
      _ = stats.params.size := by simp
      _ = sharedCount := basis.params_size
  have paramsEq : stats.params.toList.drop 0 = basis.parameterSources := by
    simpa only [List.drop_zero] using basis.parameterSources_eq
  have evidence := basis.alignment.rawParameterPreFamilyTelescopeDefEqInTarget
    basis.params basis.localState (.refl postWF (by trivial)) paramsEq envLE
      postWF sourceTr audit
  rw [paramsLength] at evidence
  exact evidence.trans postWF trivial (basis.storedCanonical.mono envLE)

end ConstructorRawPreFamilyParameterAuditBasis

/-! Exact raw-source inventories.  These run in lockstep with the
candidate-independent constructor translations selected by the ordinary
producer, rather than with normalized candidate views. -/

/-- Target-environment shared-parameter equality for every exact raw
constructor translation in one host family. -/
inductive ConstructorRawPreFamilyParameterDefEqList
    (env postEnv : VEnv) (Us : List Name) (nparams : Nat)
    (storedTypes : List VExpr) :
    {sources : List Constructor} → {raws : List VConstVal} →
      CandidateConstructorSourceListInput postEnv Us sources raws →
      {trace : AddInductive.ConstructorRawParameterPreFamilyListTrace
        stats context sources} →
      AddInductive.ConstructorRawParameterPreFamilyListSemanticRun env Us
        stats context contextRun trace → Prop where
  | nil : ConstructorRawPreFamilyParameterDefEqList env postEnv Us nparams
      storedTypes .nil .nil
  | cons {source : Constructor} {sources : List Constructor}
      {raw : VConstVal} {raws : List VConstVal}
      {sourceInput : CandidateConstructorSourceInput postEnv Us source raw}
      {sourcesInput : CandidateConstructorSourceListInput postEnv Us
        sources raws}
      {headTrace : AddInductive.ConstructorRawParameterPreFamilyTrace stats
        context source.type 0 context.fuel.inductiveFuel}
      {tailTrace : AddInductive.ConstructorRawParameterPreFamilyListTrace
        stats context sources}
      {headSemantic :
        AddInductive.ConstructorRawParameterPreFamilySemanticRun env Us stats
          context contextRun headTrace}
      {tailSemantic :
        AddInductive.ConstructorRawParameterPreFamilyListSemanticRun env Us
          stats context contextRun tailTrace}
      (head : TypeChecker.TelDefEqEvidence postEnv Us.length []
        (VExpr.telN nparams raw.type) storedTypes)
      (tail : ConstructorRawPreFamilyParameterDefEqList env postEnv Us
        nparams storedTypes sourcesInput tailSemantic) :
      ConstructorRawPreFamilyParameterDefEqList env postEnv Us nparams
        storedTypes (.cons sourceInput sourcesInput)
          (.cons headSemantic tailSemantic)

/-- Family-major target-environment equality for every exact raw constructor
translation in a block. -/
inductive BlockConstructorRawPreFamilyParameterDefEqLists
    (env postEnv : VEnv) (Us : List Name) (nparams : Nat)
    (storedTypes : List VExpr) :
    {sources : List InductiveType} → {raws : List VInductiveType} →
      CandidateBlockConstructorSourceListInput postEnv Us sources raws →
      {trace : AddInductive.ConstructorRawParameterPreFamilyBlockTrace
        stats context sources} →
      AddInductive.ConstructorRawParameterPreFamilyBlockSemanticRun env Us
        stats context contextRun trace → Prop where
  | nil : BlockConstructorRawPreFamilyParameterDefEqLists env postEnv Us
      nparams storedTypes .nil .nil
  | cons {source : InductiveType} {sources : List InductiveType}
      {raw : VInductiveType} {raws : List VInductiveType}
      {sourceInput : CandidateConstructorSourceListInput postEnv Us
        source.ctors raw.ctors}
      {sourcesInput : CandidateBlockConstructorSourceListInput postEnv Us
        sources raws}
      {headTrace : AddInductive.ConstructorRawParameterPreFamilyListTrace
        stats context source.ctors}
      {tailTrace : AddInductive.ConstructorRawParameterPreFamilyBlockTrace
        stats context sources}
      {headSemantic :
        AddInductive.ConstructorRawParameterPreFamilyListSemanticRun env Us
          stats context contextRun headTrace}
      {tailSemantic :
        AddInductive.ConstructorRawParameterPreFamilyBlockSemanticRun env Us
          stats context contextRun tailTrace}
      (head : ConstructorRawPreFamilyParameterDefEqList env postEnv Us
        nparams storedTypes sourceInput headSemantic)
      (tail : BlockConstructorRawPreFamilyParameterDefEqLists env postEnv Us
        nparams storedTypes sourcesInput tailSemantic) :
      BlockConstructorRawPreFamilyParameterDefEqLists env postEnv Us nparams
        storedTypes (.cons sourceInput sourcesInput)
          (.cons headSemantic tailSemantic)

/-- Postcompose every exact raw-constructor prefix with one rewrite of the
common stored telescope in the producer-selected target environment. -/
theorem ConstructorRawPreFamilyParameterDefEqList.postcompose
    {env postEnv : VEnv} {Us : List Name} {nparams : Nat}
    {stats : AddInductive.InductiveStats}
    {context : AddInductive.Context}
    {contextRun : AddInductive.ConstructorContextRun env Us context}
    {storedTypes canonicalTypes : List VExpr}
    {sources : List Constructor} {raws : List VConstVal}
    {sourceInput : CandidateConstructorSourceListInput postEnv Us sources raws}
    {trace : AddInductive.ConstructorRawParameterPreFamilyListTrace
      stats context sources}
    {semantic : AddInductive.ConstructorRawParameterPreFamilyListSemanticRun
      env Us stats context contextRun trace}
    (run : ConstructorRawPreFamilyParameterDefEqList env postEnv Us nparams
      storedTypes sourceInput semantic)
    (storedCanonical : TypeChecker.TelDefEqEvidence postEnv Us.length []
      storedTypes canonicalTypes)
    (postWF : postEnv.WF) :
    ConstructorRawPreFamilyParameterDefEqList env postEnv Us nparams
      canonicalTypes sourceInput semantic := by
  induction run with
  | nil => exact .nil
  | cons head tail ih =>
      exact .cons (head.trans postWF trivial storedCanonical) ih

/-- Family-major form of
`ConstructorRawPreFamilyParameterDefEqList.postcompose`. -/
theorem BlockConstructorRawPreFamilyParameterDefEqLists.postcompose
    {env postEnv : VEnv} {Us : List Name} {nparams : Nat}
    {stats : AddInductive.InductiveStats}
    {context : AddInductive.Context}
    {contextRun : AddInductive.ConstructorContextRun env Us context}
    {storedTypes canonicalTypes : List VExpr}
    {sources : List InductiveType} {raws : List VInductiveType}
    {sourceInput : CandidateBlockConstructorSourceListInput postEnv Us
      sources raws}
    {trace : AddInductive.ConstructorRawParameterPreFamilyBlockTrace
      stats context sources}
    {semantic : AddInductive.ConstructorRawParameterPreFamilyBlockSemanticRun
      env Us stats context contextRun trace}
    (run : BlockConstructorRawPreFamilyParameterDefEqLists env postEnv Us
      nparams storedTypes sourceInput semantic)
    (storedCanonical : TypeChecker.TelDefEqEvidence postEnv Us.length []
      storedTypes canonicalTypes)
    (postWF : postEnv.WF) :
    BlockConstructorRawPreFamilyParameterDefEqLists env postEnv Us nparams
      canonicalTypes sourceInput semantic := by
  induction run with
  | nil => exact .nil
  | cons head tail ih =>
      exact .cons (head.postcompose storedCanonical postWF) ih

/-- Fold one exact raw constructor list against the dependency-stage audit,
retaining all equalities in the producer-selected target environment. -/
theorem CandidateConstructorSourceListInput.rawPreFamilyParameterDefEqList
    {env postEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {context : AddInductive.Context}
    {contextRun : AddInductive.ConstructorContextRun env Us context}
    {sources : List Constructor} {raws : List VConstVal}
    (sourceInput : CandidateConstructorSourceListInput postEnv Us sources raws)
    {auditTrace : AddInductive.ConstructorRawParameterPreFamilyListTrace
      stats context sources}
    (audit : AddInductive.ConstructorRawParameterPreFamilyListSemanticRun env
      Us stats context contextRun auditTrace)
    {parameterΔ : VLCtx} {parameterSources : List Expr}
    {storedTypes : List VExpr} {nparams : Nat}
    (params : TypeChecker.CandidateParameterContext [] parameterSources
      storedTypes parameterΔ)
    (localState : TypeChecker.FamilyParameterLocalState stats context)
    (alignment : ConstructorSharedParameterContextAlignment env Us parameterΔ
      contextRun)
    (parameterSources_eq : stats.params.toList = parameterSources)
    (params_size : stats.params.size = nparams)
    (envLE : env ≤ postEnv)
    (postWF : postEnv.WF) :
    ConstructorRawPreFamilyParameterDefEqList env postEnv Us nparams
      storedTypes sourceInput audit := by
  have paramsLength : parameterSources.length = nparams := by
    calc
      parameterSources.length = stats.params.toList.length :=
        congrArg List.length parameterSources_eq.symm
      _ = stats.params.size := by simp
      _ = nparams := params_size
  have paramsEq : stats.params.toList.drop 0 = parameterSources := by
    simpa only [List.drop_zero] using parameterSources_eq
  induction sourceInput with
  | nil =>
      cases audit
      exact .nil
  | cons sourceHead sourceTail ih =>
      cases audit with
      | cons auditHead auditTail =>
          have evidence := alignment.rawParameterPreFamilyTelescopeDefEqInTarget
            params localState (.refl postWF (by trivial)) paramsEq envLE
              postWF sourceHead.source_tr auditHead
          rw [paramsLength] at evidence
          exact .cons evidence (ih auditTail)

/-- Family-major form of `rawPreFamilyParameterDefEqList`. -/
theorem CandidateBlockConstructorSourceListInput.rawPreFamilyParameterDefEqLists
    {env postEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {context : AddInductive.Context}
    {contextRun : AddInductive.ConstructorContextRun env Us context}
    {sources : List InductiveType} {raws : List VInductiveType}
    (sourceInput : CandidateBlockConstructorSourceListInput postEnv Us
      sources raws)
    {auditTrace : AddInductive.ConstructorRawParameterPreFamilyBlockTrace
      stats context sources}
    (audit : AddInductive.ConstructorRawParameterPreFamilyBlockSemanticRun env
      Us stats context contextRun auditTrace)
    {parameterΔ : VLCtx} {parameterSources : List Expr}
    {storedTypes : List VExpr} {nparams : Nat}
    (params : TypeChecker.CandidateParameterContext [] parameterSources
      storedTypes parameterΔ)
    (localState : TypeChecker.FamilyParameterLocalState stats context)
    (alignment : ConstructorSharedParameterContextAlignment env Us parameterΔ
      contextRun)
    (parameterSources_eq : stats.params.toList = parameterSources)
    (params_size : stats.params.size = nparams)
    (envLE : env ≤ postEnv)
    (postWF : postEnv.WF) :
    BlockConstructorRawPreFamilyParameterDefEqLists env postEnv Us nparams
      storedTypes sourceInput audit := by
  induction sourceInput with
  | nil =>
      cases audit
      exact .nil
  | cons sourceHead sourceTail ih =>
      cases audit with
      | cons auditHead auditTail =>
          exact .cons
            (sourceHead.rawPreFamilyParameterDefEqList auditHead params
              localState alignment parameterSources_eq params_size envLE
                postWF)
            (ih auditTail)

/-! Candidate constructor semantics live after the flattened family block has
been staged, but the supplemental raw-parameter replay above deliberately
checks the same candidate views in the dependency environment.  The following
inventories retain that split explicitly: their semantic indices live in
`postEnv`, while every telescope equality lives in `env`. -/

/-- Dependency-stage shared-parameter equality for every candidate constructor
view in one source family. -/
inductive CandidateConstructorPreFamilyParameterDefEqList
    (env postEnv : VEnv) (Us : List Name) (nparams : Nat)
    (storedTypes : List VExpr) :
    {sources : List Constructor} →
      {candidates : AddInductive.CandidateList
        AddInductive.CandidateConstructor sources} →
      {raws : List VConstVal} →
      CandidateConstructorSemanticListRun postEnv Us candidates raws →
        Prop where
  | nil : CandidateConstructorPreFamilyParameterDefEqList env postEnv Us
      nparams storedTypes .nil
  | cons
      (head : TypeChecker.TelDefEqEvidence env Us.length []
        (VExpr.telN nparams semantic.type.view) storedTypes)
      (tail : CandidateConstructorPreFamilyParameterDefEqList env postEnv Us
        nparams storedTypes semantics) :
      CandidateConstructorPreFamilyParameterDefEqList env postEnv Us nparams
        storedTypes (.cons semantic semantics)

/-- Dependency-stage shared-parameter equality across a complete family-major
candidate hierarchy. -/
inductive CandidateBlockConstructorPreFamilyParameterDefEqLists
    (env postEnv : VEnv) (Us : List Name) (nparams : Nat)
    (storedTypes : List VExpr) :
    {sources : List InductiveType} →
      {candidates : AddInductive.CandidateList
        AddInductive.CandidateFamily sources} →
      {raws : List VInductiveType} →
      CandidateBlockFamilySemanticListRun env postEnv Us candidates raws →
        Prop where
  | nil : CandidateBlockConstructorPreFamilyParameterDefEqLists env postEnv Us
      nparams storedTypes .nil
  | cons
      (head : CandidateConstructorPreFamilyParameterDefEqList env postEnv Us
        nparams storedTypes semantic.constructors)
      (tail : CandidateBlockConstructorPreFamilyParameterDefEqLists env
        postEnv Us nparams storedTypes semantics) :
      CandidateBlockConstructorPreFamilyParameterDefEqLists env postEnv Us
        nparams storedTypes (.cons semantic semantics)

/-- Postcompose every constructor prefix with one dependency-stage rewrite of
the common stored telescope. -/
theorem CandidateConstructorPreFamilyParameterDefEqList.postcompose
    {env postEnv : VEnv} {Us : List Name} {nparams : Nat}
    {storedTypes canonicalTypes : List VExpr}
    {sources : List Constructor}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateConstructor sources}
    {raws : List VConstVal}
    {semantics : CandidateConstructorSemanticListRun postEnv Us candidates raws}
    (run : CandidateConstructorPreFamilyParameterDefEqList env postEnv Us
      nparams storedTypes semantics)
    (storedCanonical : TypeChecker.TelDefEqEvidence env Us.length []
      storedTypes canonicalTypes)
    (henv : VEnv.WF env) :
    CandidateConstructorPreFamilyParameterDefEqList env postEnv Us nparams
      canonicalTypes semantics := by
  induction run with
  | nil => exact .nil
  | cons head tail ih =>
      exact .cons (head.trans henv trivial storedCanonical) ih

/-- Family-major form of `postcompose`. -/
theorem CandidateBlockConstructorPreFamilyParameterDefEqLists.postcompose
    {env postEnv : VEnv} {Us : List Name} {nparams : Nat}
    {storedTypes canonicalTypes : List VExpr}
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    {semantics : CandidateBlockFamilySemanticListRun env postEnv Us candidates
      raws}
    (run : CandidateBlockConstructorPreFamilyParameterDefEqLists env postEnv Us
      nparams storedTypes semantics)
    (storedCanonical : TypeChecker.TelDefEqEvidence env Us.length []
      storedTypes canonicalTypes)
    (henv : VEnv.WF env) :
    CandidateBlockConstructorPreFamilyParameterDefEqLists env postEnv Us
      nparams canonicalTypes semantics := by
  induction run with
  | nil => exact .nil
  | cons head tail ih =>
      exact .cons (head.postcompose storedCanonical henv) ih

/-- Fold the candidate-view audit for one family in lockstep with its exact
Stage-3 uniqueness trace and post-family semantic hierarchy.  Strict
translation into `postEnv` is used only to identify the candidate view's
literal Theory endpoint; all telescope equality remains in `env`. -/
theorem CandidateConstructorSemanticListRun.preFamilyParameterDefEqList
    {env postEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {context : AddInductive.Context}
    {contextRun : AddInductive.ConstructorContextRun env Us context}
    {sources : List Constructor}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateConstructor sources}
    {raws : List VConstVal}
    (semantics : CandidateConstructorSemanticListRun postEnv Us candidates raws)
    {owner : Nat}
    (stage : AddInductive.ConstructorStage3CandidateListTrace stats owner
      candidates)
    {auditTrace :
      AddInductive.ConstructorCandidateRawParameterPreFamilyListTrace stats
        context candidates}
    (audit :
      AddInductive.ConstructorCandidateRawParameterPreFamilyListSemanticRun
        env Us stats context contextRun auditTrace)
    {parameterΔ : VLCtx} {parameterSources : List Expr}
    {storedTypes : List VExpr} {nparams : Nat}
    (params : TypeChecker.CandidateParameterContext [] parameterSources
      storedTypes parameterΔ)
    (localState : TypeChecker.FamilyParameterLocalState stats context)
    (alignment : ConstructorSharedParameterContextAlignment env Us parameterΔ
      contextRun)
    (parameterSources_eq : stats.params.toList = parameterSources)
    (params_size : stats.params.size = nparams)
    (envLE : env ≤ postEnv)
    (postWF : postEnv.WF) :
    CandidateConstructorPreFamilyParameterDefEqList env postEnv Us nparams
      storedTypes semantics := by
  have henv : VEnv.WF env := by
    simpa only [contextRun.venv_eq] using
      contextRun.candidate.context.Ewf
  have paramsLength : parameterSources.length = nparams := by
    calc
      parameterSources.length = stats.params.toList.length :=
        congrArg List.length parameterSources_eq.symm
      _ = stats.params.size := by simp
      _ = nparams := params_size
  have paramsEq : stats.params.toList.drop 0 = parameterSources := by
    simpa only [List.drop_zero] using parameterSources_eq
  induction semantics with
  | nil =>
      cases audit
      cases stage
      exact .nil
  | cons semantic semantics ih =>
      cases audit with
      | cons headAudit tailAudit =>
          cases stage with
          | cons stageHead stageTail =>
              obtain ⟨inferred, recursive⟩ := semantic.type.recursive
              have sourceTr := recursive.view_tr_strict
                stageHead.candidateViewTranslationUnique
              have prefixEvidence :=
                alignment.rawParameterPreFamilyTelescopeDefEq params
                  localState (.refl henv (by trivial)) .base paramsEq
                  stageHead.viewTranslationUnique envLE postWF sourceTr
                  headAudit
              rw [paramsLength] at prefixEvidence
              exact .cons prefixEvidence (ih stageTail tailAudit)

