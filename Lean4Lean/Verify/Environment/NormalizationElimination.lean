    (stage3Run :
      AddInductive.ConstructorBlockStage3SafetyTraces.check
        produced.execution.eliminationExecution.normalization.stats
        Us source.uvars produced.candidate.families = .ok ()) :
    BlockGenerationChecked source where
  validated := completion.canonicalValidatedBlock context_lctx_eq
    stagingInput alignmentRun stage3Run
  shape_eq := completion.canonicalBlockGenerationShape context_lctx_eq
    stagingInput alignmentRun stage3Run
  generatedParams :=
    staging.annotation.firstStoredBinders.take source.nparams
  generatedParams_length := by
    rw [List.length_take]
    apply Nat.min_eq_left
    rw [staging.annotation.firstStoredLength,
      ← staging.annotation.firstSpineLength_eq]
    exact staging.annotation.first_nparams_le_spineLength context_lctx_eq

/-- Interpret the canonical mixed raw/view layout at every exact family and
constructor position, yielding the ordinary block-generation run consumed by
artifact preservation. -/
noncomputable def
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion.canonicalBlockGenerationRun
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {staging : produced.SecondFamilyIndexStaging semantic}
    {raw : Option staging.annotation.RawFirstIndexDomain}
    (completion : staging.TerminalIndexDomainCompletion raw)
    (context_lctx_eq : context.lctx = {})
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (alignmentRun :
      AddInductive.ConstructorBlockCandidateAlignmentTrace.check
        (produced.execution.eliminationExecution.normalization
          |>.constructorValidation.traces)
        produced.candidate.families = .ok ())
    (stage3Run :
      AddInductive.ConstructorBlockStage3SafetyTraces.check
        produced.execution.eliminationExecution.normalization.stats
        Us source.uvars produced.candidate.families = .ok ())
    (preFamilyRun :
      AddInductive.checkConstructorMutualBlockPreFamilySafety
        produced.execution.eliminationExecution.normalization.stats
        produced.execution.eliminationExecution.normalization.validationContext
        produced.candidate.families = .ok ())
    (universeRun :
      AddInductive.checkConstructorBlockUniverseSemantics
        produced.execution.eliminationExecution.normalization.stats
        (firstSource :: secondSource :: remainingSources)
        { produced.execution.eliminationExecution.normalization.validationContext
          with env :=
            produced.execution.eliminationExecution.normalization.familyEnv } =
          .ok ()) :
    BlockGenerationRun
      (completion.canonicalBlockGenerationChecked context_lctx_eq stagingInput
        alignmentRun stage3Run) env blockEnv := by
  let generation := completion.canonicalBlockGenerationChecked context_lctx_eq
    stagingInput alignmentRun stage3Run
  let checked := completion.canonicalCheckedFamilies context_lctx_eq
    stagingInput alignmentRun stage3Run
  have henv : VEnv.WF env := by
    simpa only [staging.annotation.firstSemantic.type.venv_eq] using
      staging.annotation.firstSemantic.type.contextRun.context.Ewf
  have commonResultLevelWF :=
    produced.canonicalResultLevel_wf semantic context_lctx_eq
  have normalizationRun := completion.canonicalNormalizationBlockRun
    context_lctx_eq stagingInput alignmentRun
  let constructorRuns := Classical.choice
    ((completion.canonicalCheckedBlockConstructorRuns context_lctx_eq
      stagingInput alignmentRun stage3Run preFamilyRun universeRun).1)
  let checkedRuns := completion.canonicalCheckedFamilyRuns context_lctx_eq
    stagingInput alignmentRun stage3Run constructorRuns
  have checkedWF :
      (completion.canonicalCheckedBlock context_lctx_eq stagingInput
        alignmentRun stage3Run).WF env
          (produced.canonicalResultLevel semantic context_lctx_eq) :=
    completion.canonicalCheckedBlockWF_of_constructorRuns context_lctx_eq
      stagingInput alignmentRun stage3Run constructorRuns
  have shapes := semantic.generationShapes produced.shape
  have familyParameters :=
    completion.viewParameterTelescopeDefEqList context_lctx_eq
  let inventory := Classical.choice
    (completion.constructorValidationSemanticState context_lctx_eq stagingInput
      alignmentRun)
  have hblockEnv : VEnv.WF blockEnv := by
    simpa only [inventory.semantic.contextRun.venv_eq] using
      inventory.semantic.contextRun.candidate.context.Ewf
  have storedConstructors := inventory.storedParameterDefEqLists
    completion.firstParameterContext
  have firstStoredView :=
    staging.firstStoredViewParameterTelescopeDefEq context_lctx_eq
  have firstViewStored :=
    (firstStoredView.symm henv trivial).mono
      (VEnv.stageInductiveTypes_le stagingInput.stage)
  have firstViewConstructors :=
    storedConstructors.precompose firstViewStored hblockEnv
  have blockParams_eq : blockParams source.nparams semantic.families.views =
      VExpr.telN source.nparams
        staging.annotation.firstSemantic.type.view := by
    rw [staging.annotation.semantic_views_eq]
    rfl
  have generationParams : generation.block.checked.params =
      blockParams source.nparams semantic.families.views := by
    rfl
  have constructorParameters :
      CandidateBlockConstructorViewParameterDefEqLists env blockEnv Us
        source.nparams generation.block.checked.params semantic.families := by
    rw [generationParams, blockParams_eq]
    exact firstViewConstructors
  have firstParams : generation.block.checked.params =
      VExpr.telN source.nparams
        staging.annotation.firstSemantic.type.view :=
    generationParams.trans blockParams_eq
  have generationFamilies :
      pairNormalizedFamilies source.types checked.data =
        generation.families := by
    rfl
  let aligned :=
    CandidateCanonicalBlockNormalizedFamilyRunList.ofCheckedAux
      (generation := generation) shapes familyParameters constructorParameters
      checked checkedRuns firstParams semantic.uvars_eq
      (fun family member => by
        rw [← generationFamilies]
        exact member)
  have aligned' : CandidateCanonicalBlockNormalizedFamilyRunList generation
      env blockEnv Us semantic.families generation.families := by
    rw [← generationFamilies]
    exact aligned
  have checkedWF' : generation.block.checked.WF env
      generation.validated.resultLevel := by
    simpa only [generation, canonicalBlockGenerationChecked,
      canonicalValidatedBlock, canonicalNormalizedCheckedBlock] using checkedWF
  have normalizationRun' : NormalizationBlockRun
      generation.block.normalization env blockEnv := by
    simpa only [generation, canonicalBlockGenerationChecked,
      canonicalValidatedBlock, canonicalNormalizedCheckedBlock] using
      normalizationRun
  have commonResultLevelWF' : generation.validated.resultLevel.WF
      source.uvars := by
    simpa only [generation, canonicalBlockGenerationChecked,
      canonicalValidatedBlock] using commonResultLevelWF
  have generatedParamsTel' : TypeChecker.TelDefEqEvidence env source.uvars []
      generation.generatedParams generation.block.checked.params := by
    rw [firstParams]
    simpa only [generation, canonicalBlockGenerationChecked,
      semantic.uvars_eq] using
      staging.firstStoredViewParameterTelescopeDefEq context_lctx_eq
  let familyRuns := aligned'.normalizedFamilyRuns henv commonResultLevelWF'
  have generatedIndicesTel' : ∀ family ∈ generation.families,
      TypeChecker.TelDefEqEvidence env source.uvars
        generation.generatedParams.reverse
        (family.rawIndices source.nparams)
        (generation.generatedIndices family) := by
    intro family member
    simpa only [generation, canonicalBlockGenerationChecked] using
      (familyRuns.get family member).rawIndicesTel_refl member henv
        generatedParamsTel'
  let paramsTel := aligned'.paramsTel henv commonResultLevelWF'
  let constructorRuns := aligned'.constructorRuns normalizationRun'
    commonResultLevelWF' paramsTel
  have generatedParamsTelBlock := generatedParamsTel'.mono
    (VEnv.stageInductiveTypes_le normalizationRun'.stage)
  have generatedFieldsTel' : ∀ constructor ∈ generation.flatCtors,
      TypeChecker.TelDefEqEvidence blockEnv source.uvars
        generation.generatedParams.reverse
        (constructor.ctor.rawFields source.nparams)
        (generation.generatedFields constructor) := by
    intro constructor member
    simpa only [generation, canonicalBlockGenerationChecked] using
      (constructorRuns.get constructor member).rawFieldsTel_refl hblockEnv
        generatedParamsTelBlock
  simpa only [generation] using aligned'.blockGenerationRun normalizationRun'
    checkedWF' henv commonResultLevelWF' generatedParamsTel'
      generatedIndicesTel' generatedFieldsTel'

/-- Erase the complete retained producer semantics at the public
generation-certificate boundary. -/
noncomputable def
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion.canonicalBlockGenerationCertificate
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {staging : produced.SecondFamilyIndexStaging semantic}
    {raw : Option staging.annotation.RawFirstIndexDomain}
    (completion : staging.TerminalIndexDomainCompletion raw)
    (context_lctx_eq : context.lctx = {})
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (alignmentRun :
      AddInductive.ConstructorBlockCandidateAlignmentTrace.check
        (produced.execution.eliminationExecution.normalization
          |>.constructorValidation.traces)
        produced.candidate.families = .ok ())
    (stage3Run :
      AddInductive.ConstructorBlockStage3SafetyTraces.check
        produced.execution.eliminationExecution.normalization.stats
        Us source.uvars produced.candidate.families = .ok ())
    (preFamilyRun :
      AddInductive.checkConstructorMutualBlockPreFamilySafety
        produced.execution.eliminationExecution.normalization.stats
        produced.execution.eliminationExecution.normalization.validationContext
        produced.candidate.families = .ok ())
    (universeRun :
      AddInductive.checkConstructorBlockUniverseSemantics
        produced.execution.eliminationExecution.normalization.stats
        (firstSource :: secondSource :: remainingSources)
        { produced.execution.eliminationExecution.normalization.validationContext
          with env :=
            produced.execution.eliminationExecution.normalization.familyEnv } =
          .ok ()) :
    BlockGenerationCertificate source env where
  generation := completion.canonicalBlockGenerationChecked context_lctx_eq
    stagingInput alignmentRun stage3Run
  blockEnv := blockEnv
  wf := (completion.canonicalBlockGenerationRun context_lctx_eq stagingInput
    alignmentRun stage3Run preFamilyRun universeRun).wf

/-- In a genuinely mutual checked block the singleton Prop exception is
unreachable, so Theory's elimination mode is governed solely by the common
result universe's syntactic nonzero decision. -/
theorem BlockGenerationChecked.elimination_eq_ofBool_isNeverZero_of_two
    {source : VInductDecl} (generation : BlockGenerationChecked source)
    (two : 2 ≤ generation.families.length) :
    generation.elimination =
      ElimMode.ofBool generation.validated.resultLevel.isNeverZero := by
  unfold BlockGenerationChecked.elimination
  cases nonzero : generation.validated.resultLevel.isNeverZero with
  | true => simp
  | false =>
      simp only [Bool.false_eq_true, if_false,
        ElimMode.ofBool_false]
      cases familiesEq : generation.families with
      | nil => simp [familiesEq] at two
      | cons first tail =>
          cases tailEq : tail with
          | nil => simp [familiesEq, tailEq] at two
          | cons second rest => simp

/-- K-like reduction is likewise impossible for a genuinely mutual checked
block. -/
theorem BlockGenerationChecked.kTarget_eq_false_of_two
    {source : VInductDecl} (generation : BlockGenerationChecked source)
    (two : 2 ≤ generation.families.length) :
    generation.kTarget = false := by
  unfold BlockGenerationChecked.kTarget
  cases familiesEq : generation.families with
  | nil => simp [familiesEq] at two
  | cons first tail =>
      cases tailEq : tail with
      | nil => simp [familiesEq, tailEq] at two
      | cons second rest => simp

/-- The canonical mixed raw/view generation and the retained ordinary
post-constructor execution make exactly the same elimination, K-target, and
recursor-universe decisions.  Every field is derived from producer state;
the sole fresh-name-sensitive fact is supplied by the executable universe
audit retained by the stronger producer. -/
noncomputable def
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion.canonicalBlockEliminationRun
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {staging : produced.SecondFamilyIndexStaging semantic}
    {raw : Option staging.annotation.RawFirstIndexDomain}
    (completion : staging.TerminalIndexDomainCompletion raw)
    (context_lctx_eq : context.lctx = {})
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (alignmentRun :
      AddInductive.ConstructorBlockCandidateAlignmentTrace.check
        (produced.execution.eliminationExecution.normalization
          |>.constructorValidation.traces)
        produced.candidate.families = .ok ())
    (stage3Run :
      AddInductive.ConstructorBlockStage3SafetyTraces.check
        produced.execution.eliminationExecution.normalization.stats
        Us source.uvars produced.candidate.families = .ok ())
    (recUniverseRun :
      AddInductive.checkBlockRecursorUniverseSemantics source.uvars
        produced.execution.eliminationExecution = .ok ()) :
    AddInductive.CheckerBlockEliminationRun
      (completion.canonicalBlockGenerationChecked context_lctx_eq stagingInput
        alignmentRun stage3Run)
      produced.execution.eliminationExecution := by
  let generation := completion.canonicalBlockGenerationChecked
    context_lctx_eq stagingInput alignmentRun stage3Run
  let execution := produced.execution.eliminationExecution
  let normalization := execution.normalization
  have sourceLength : source.types.length =
      (firstSource :: secondSource :: remainingSources).length := by
    have namesLength := congrArg List.length
      semantic.families.rawHeaderNames.1
    simpa using namesLength
  have familyLength : generation.families.length = source.types.length :=
    generation.shape.2.2.1
  have two : 2 ≤ generation.families.length := by
    rw [familyLength, sourceLength]
    simp
  have largeResult : execution.elimination.large.result =
      normalization.stats.isNotZero :=
    execution.elimination.large.result_eq_isNotZero_of_two
  have canonicalNonzero : generation.validated.resultLevel.isNeverZero =
      normalization.stats.isNotZero := by
    simpa only [generation, canonicalBlockGenerationChecked,
      canonicalValidatedBlock] using
      produced.canonicalResultLevel_isNeverZero_eq semantic context_lctx_eq
  have mode : generation.elimination =
      ElimMode.ofBool execution.elimination.large.result := by
    calc
      generation.elimination =
          ElimMode.ofBool generation.validated.resultLevel.isNeverZero :=
        generation.elimination_eq_ofBool_isNeverZero_of_two two
      _ = ElimMode.ofBool execution.elimination.large.result := by
        rw [largeResult, canonicalNonzero]
  have kKernel : execution.kTarget.result = false :=
    execution.kTarget.result_eq_false_of_two
  have kTheory : generation.kTarget = false :=
    generation.kTarget_eq_false_of_two two
  have recAudit :=
    AddInductive.checkBlockRecursorUniverseSemantics_of_run recUniverseRun
  refine {
    nparams_eq := rfl
    sourceUvars_eq := ?_
    mode_eq := mode
    kTarget_eq := kTheory.trans kKernel.symm
    recUvars_eq := ?_
    recLevels_eq := ?_ }
  · calc
      source.uvars = Us.length := stagingInput.uvars_eq
      _ = normalization.validationContext.lparams.length := by
        rw [stagingInput.validation_lparams_eq]
  · cases large : execution.elimination.large.result with
    | false =>
        have modeSmall : generation.elimination = ElimMode.small := by
          simpa [large] using mode
        change generation.elimination.recUvars source.uvars =
          execution.recLevelParams.length
        rw [modeSmall]
        change source.uvars = execution.recLevelParams.length
        have recArity := recAudit.1
        simpa only [execution, large, Bool.false_eq_true, if_false,
          Nat.add_zero] using recArity.symm
    | true =>
        have modeLarge : generation.elimination = ElimMode.large := by
          simpa [large] using mode
        change generation.elimination.recUvars source.uvars =
          execution.recLevelParams.length
        rw [modeLarge]
        change source.uvars + 1 = execution.recLevelParams.length
        have recArity := recAudit.1
        simpa only [execution, large, if_true] using recArity.symm
  · cases large : execution.elimination.large.result with
    | false =>
        have modeSmall : generation.elimination = ElimMode.small := by
          simpa [large] using mode
        change execution.recLevels.mapM
            (VLevel.ofLevel execution.recLevelParams) =
          some (generation.elimination.recLevels source.uvars)
        rw [modeSmall]
        change execution.recLevels.mapM
            (VLevel.ofLevel execution.recLevelParams) =
          some (VLevel.params source.uvars)
        have recLevels := recAudit.2
        simpa only [execution, large, Bool.false_eq_true, if_false,
          Nat.add_zero] using recLevels
    | true =>
        have modeLarge : generation.elimination = ElimMode.large := by
          simpa [large] using mode
        change execution.recLevels.mapM
            (VLevel.ofLevel execution.recLevelParams) =
          some (generation.elimination.recLevels source.uvars)
        rw [modeLarge]
        change execution.recLevels.mapM
            (VLevel.ofLevel execution.recLevelParams) =
          some (VLevel.params (source.uvars + 1))
        have recLevels := recAudit.2
        simpa only [execution, large, if_true] using recLevels

/-- A generation run and elimination alignment indexed by the same retained
ordinary execution and semantic block.  Unlike the legacy exact package,
this boundary does not require the analyzer to preserve the candidate's raw
shared-parameter syntax: a canonicalized mixed raw/view generation may supply
its independently proved `BlockGenerationRun`. -/
structure ProducedBlockSemanticEliminationRun
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (env blockEnv : VEnv) (Us : List Name)
    (produced : ProducedBlockEliminationShapeCandidate source kernelSources
      numNested isUnsafe context)
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source)
    (generation : BlockGenerationChecked source) where
  blockEnv_wf : blockEnv.WF
  block : BlockGenerationRun generation env blockEnv
  elimination : AddInductive.CheckerBlockEliminationRun generation
    produced.execution
  isUnsafe_eq : isUnsafe = false
  validation_lparams_eq :
    produced.execution.normalization.validationContext.lparams = Us
  validation_safety_eq :
    produced.execution.normalization.validationContext.safety = .safe
  /-- The validator's positional index counts, transported back from the
  canonical family views to the exact raw Theory declaration retained by
  this run. -/
  rawIndexCounts : CanonicalFamilyIndexCountList
    produced.execution.normalization.stats source.nparams 0 source.types
  /-- The retained validation trace computes a complete family/constructor/
  field universe matrix.  Only successful computation is stored here; the
  matrix itself remains executable data selected by `Option.get`. -/
  fieldSorts_isSome :
    (produced.execution.normalization.constructorValidation.traces
      |>.fieldSorts? Us).isSome
  /-- The computed universe matrix types the exact checked field telescopes
  which drove this generation. -/
  fieldSortTelescopes : CheckedBlockFieldSortTelescopes blockEnv Us.length
    generation.block.checked.params generation.block.checked.families
    ((produced.execution.normalization.constructorValidation.traces
      |>.fieldSorts? Us).get fieldSorts_isSome)

/-- Executable family/constructor/field universe matrix selected by the exact
retained validation trace. -/
def ProducedBlockSemanticEliminationRun.fieldSorts
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    {produced : ProducedBlockEliminationShapeCandidate source kernelSources
      numNested isUnsafe context}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    (run : ProducedBlockSemanticEliminationRun env blockEnv Us produced
      semantic generation) : List (List (List VLevel)) :=
  (produced.execution.normalization.constructorValidation.traces
    |>.fieldSorts? Us).get run.fieldSorts_isSome

/-- The stored telescope certificate stated through the public executable
matrix accessor. -/
theorem ProducedBlockSemanticEliminationRun.fieldSorts_telescopes
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    {produced : ProducedBlockEliminationShapeCandidate source kernelSources
      numNested isUnsafe context}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    (run : ProducedBlockSemanticEliminationRun env blockEnv Us produced
      semantic generation) :
    CheckedBlockFieldSortTelescopes blockEnv Us.length
      generation.block.checked.params generation.block.checked.families
      run.fieldSorts := by
  simpa only [ProducedBlockSemanticEliminationRun.fieldSorts] using
    run.fieldSortTelescopes

/-- A semantic recursor result whose generation is selected by the retained
producer itself.  Keeping the generation as a field indexed by the exact
semantic owner prevents outer transaction code from pairing a canonical
elimination proof with a parallel analyzer result. -/
structure ProducedBlockSemanticRecursorRun
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (env blockEnv : VEnv) (Us : List Name)
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source) where
  generation : BlockGenerationChecked source
  run : ProducedBlockSemanticEliminationRun env blockEnv Us
    produced.eliminationBase semantic generation

/-- Erase producer provenance at the public generation-certificate boundary. -/
def ProducedBlockSemanticEliminationRun.certificate
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    {produced : ProducedBlockEliminationShapeCandidate source kernelSources
      numNested isUnsafe context}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    (run : ProducedBlockSemanticEliminationRun env blockEnv Us produced
      semantic generation) : BlockGenerationCertificate source env where
  generation := generation
  blockEnv := blockEnv
  wf := run.block.wf

/-- Translate the exact constructor records installed after the semantic
family block to the canonical generation's raw Theory constructor inventory. -/
theorem ProducedBlockSemanticEliminationRun.constructorDeclarationEvidence
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    {produced : ProducedBlockEliminationShapeCandidate source kernelSources
      numNested isUnsafe context}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    (run : ProducedBlockSemanticEliminationRun env blockEnv Us produced
      semantic generation) :
    List.Forall₂
      (fun info raw => TrConstVal .safe blockEnv (.ctorInfo info) raw)
      produced.execution.declaredConstructorInfos
      source.blockConstructorConstants := by
  have evidence := semantic.families.constructorDeclarationEvidence
    produced.execution.normalization.stats isUnsafe
    produced.execution.constructorContext run.isUnsafe_eq (by
      simpa only [AddInductive.NormalizationEliminationExecution.constructorContext]
        using run.validation_lparams_eq)
  simpa only [AddInductive.NormalizationEliminationExecution.declaredConstructorInfos,
    AddInductive.declaredConstructorInfos_toArray,
    VInductDecl.blockConstructorConstants] using evidence

/-- Interpret the exact constructor insertion phase for a semantic
elimination run, constructing its post-constructor Theory environment. -/
noncomputable def
    ProducedBlockSemanticEliminationRun.constructorDeclarationStaging
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    {produced : ProducedBlockEliminationShapeCandidate source kernelSources
      numNested isUnsafe context}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    (run : ProducedBlockSemanticEliminationRun env blockEnv Us produced
      semantic generation)
    {Q : Bool}
    (pre : TrEnv' .safe produced.execution.normalization.familyEnv.constants
      Q blockEnv) :
    ConstructorDeclarationStagingRun
      produced.execution.constructorContext.allowPrimitive
      produced.execution.normalization.familyEnv
      produced.execution.constructorEnv
      produced.execution.declaredConstructorInfos
      blockEnv source.blockConstructorConstants Q := by
  apply _root_.Lean4Lean.VInductDecl.constructorDeclarationStaging
    (evidence := run.constructorDeclarationEvidence)
    (rawsWF := run.block.constructorConstantsWF)
    (pre := pre)
  simpa only [AddInductive.declareConstructors,
    AddInductive.NormalizationEliminationExecution.constructorContext,
    AddInductive.NormalizationEliminationExecution.declaredConstructorInfos]
    using produced.execution.declareConstructorsRun

/-- Exact family-and-constructor declaration prefix for the generalized
semantic elimination package. -/
structure ProducedBlockSemanticDeclarationRun
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    {produced : ProducedBlockEliminationShapeCandidate source kernelSources
      numNested isUnsafe context}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    (run : ProducedBlockSemanticEliminationRun env blockEnv Us produced
      semantic generation) where
  families : FamilyDeclarationStagingRun
    produced.execution.normalization.validationContext.allowPrimitive
    produced.execution.normalization.validationContext.env
    produced.execution.normalization.familyEnv
    produced.execution.normalization.declaredInfos
    env blockEnv source.blockTypeConstants
    produced.execution.normalization.validationContext.env.quotInit
  constructors : ConstructorDeclarationStagingRun
    produced.execution.constructorContext.allowPrimitive
    produced.execution.normalization.familyEnv
    produced.execution.constructorEnv
    produced.execution.declaredConstructorInfos
    blockEnv source.blockConstructorConstants
    produced.execution.normalization.validationContext.env.quotInit

/-- Assemble both declaration folds at the producer's exact family and
constructor endpoints. -/
noncomputable def ProducedBlockSemanticEliminationRun.declarationRun
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    {produced : ProducedBlockEliminationShapeCandidate source kernelSources
      numNested isUnsafe context}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    (run : ProducedBlockSemanticEliminationRun env blockEnv Us produced
      semantic generation)
    (staging : NormalizationCandidateBlockStagingInput context
      produced.execution.normalization env blockEnv Us source) :
    ProducedBlockSemanticDeclarationRun run :=
  let families := staging.familyDeclaration
  let constructors := run.constructorDeclarationStaging families.trenv
  { families, constructors }

/-- The Theory environment at the exact end of the retained constructor
declaration phase carries the complete mutual-generation invariant.  This is
the reusable V3.5 endpoint: recursor typing is derived from the canonical
generation run and the actual family/constructor folds, rather than supplied
by a replay fixture. -/
theorem ProducedBlockSemanticDeclarationRun.generationEnv
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    {produced : ProducedBlockEliminationShapeCandidate source kernelSources
      numNested isUnsafe context}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    {run : ProducedBlockSemanticEliminationRun env blockEnv Us produced
      semantic generation}
    (declarations : ProducedBlockSemanticDeclarationRun run) :
    BlockGenerationEnv generation declarations.constructors.ctorEnv := by
  have hleEnv : env ≤ declarations.constructors.ctorEnv :=
    declarations.families.addTypes.le.trans
      declarations.constructors.addCtors.le
  have hleBlock : blockEnv ≤ declarations.constructors.ctorEnv :=
    declarations.constructors.addCtors.le
  have hfamilies : ∀ family ∈ generation.families,
      declarations.constructors.ctorEnv.constants family.raw.name =
        some family.raw.toVConstant := by
    intro family hfamily
    apply declarations.constructors.addCtors.le.constants
    apply declarations.families.addTypes.lookup family.raw.toVConstVal
    simp only [VInductDecl.blockTypeConstants, List.mem_map]
    refine ⟨family.raw, ?_, rfl⟩
    rw [← generation.families_map_raw]
    exact List.mem_map.2 ⟨family, hfamily, rfl⟩
  have hconstructors : ∀ constructor ∈ generation.flatCtors,
      declarations.constructors.ctorEnv.constants constructor.ctor.raw.name =
        some constructor.ctor.raw.toVConstant := by
    intro constructor hconstructor
    apply declarations.constructors.addCtors.lookup constructor.ctor.raw
    rw [← generation.flatCtors_map_raw]
    exact List.mem_map.2 ⟨constructor, hconstructor, rfl⟩
  exact run.block.wf.toBlockGenerationEnv hleEnv hleBlock
    declarations.constructors.trenv.wf.ordered hfamilies hconstructors

/-- Every generated Theory recursor is well formed at the constructor
endpoint constructed by the retained ordinary declaration trace. -/
theorem ProducedBlockSemanticDeclarationRun.recursorConstantsWF
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    {produced : ProducedBlockEliminationShapeCandidate source kernelSources
      numNested isUnsafe context}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    {run : ProducedBlockSemanticEliminationRun env blockEnv Us produced
      semantic generation}
    (declarations : ProducedBlockSemanticDeclarationRun run) :
    ∀ raw ∈ generation.recursors,
      raw.toVConstant.WF declarations.constructors.ctorEnv := by
  intro raw member
  simp only [BlockGenerationChecked.recursors, List.mem_map] at member
  obtain ⟨family, hfamily, rfl⟩ := member
  exact declarations.generationEnv.generatedRecursor_wf hfamily

/-- The ordinary recursor producer and the semantic Theory generation use
the same source-ordered canonical recursor names.  This is derived from the
two producer-owned family inventories, so later type translation never needs
to recheck names alongside expression syntax. -/
theorem ProducedBlockSemanticEliminationRun.recursorNames
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    (_run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation) :
    List.Forall₂ (fun info raw => info.name = raw.name)
      produced.execution.recursors.infos generation.recursors := by
  have kernelNames : produced.execution.recursors.infos.map (fun info =>
      info.name) =
      kernelSources.map (fun family => (.str family.name "rec" : Name)) := by
    simpa only [List.toList_toArray, mkRecName] using
      AddInductive.declareRecursors_infos_names
        produced.execution.recursorsRun
  have semanticNames : source.types.map (fun family =>
      (.str family.name "rec" : Name)) =
      kernelSources.map (fun family => (.str family.name "rec" : Name)) := by
    have names := congrArg
      (List.map (fun name => (.str name "rec" : Name)))
      semantic.families.rawHeaderNames.1
    simpa only [List.map_map, Function.comp_def] using names
  have generationNames : generation.recursors.map (fun raw => raw.name) =
      source.types.map (fun family => (.str family.name "rec" : Name)) := by
    have names := congrArg
      (List.map (fun family : VInductiveType =>
        (.str family.name "rec" : Name))) generation.families_map_raw
    simpa only [BlockGenerationChecked.recursors, List.map_map,
      Function.comp_def] using names
  have namesEq : produced.execution.recursors.infos.map (fun info =>
      info.name) = generation.recursors.map (fun raw => raw.name) :=
    kernelNames.trans (semanticNames.symm.trans generationNames.symm)
  rw [← List.forall₂_eq, List.forall₂_map_left_iff,
    List.forall₂_map_right_iff] at namesEq
  exact namesEq

/-- The actual `mkRecInfos` callback retained by the ordinary recursor
producer, together with the exact generated type inventory it emitted.  This
is the operational half of recursor-type correspondence; semantic comparison
with `BlockGenerationChecked.recType` is deliberately a separate layer. -/
structure ProducedBlockRecursorSynthesisRun
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context) where
  synthesis : AddInductive.RecursorDeclarationSynthesis
    produced.execution.eliminationExecution.normalization.stats
    kernelSources.toArray produced.execution.eliminationExecution.elimination.level
    produced.execution.eliminationExecution.kTarget.result
    produced.execution.recursorContext
  detailedRun : AddInductive.declareRecursorsDetailedAt
    produced.execution.eliminationExecution.normalization.stats
    kernelSources.toArray produced.execution.eliminationExecution.elimination.level
    produced.execution.eliminationExecution.kTarget.result
    produced.execution.recursorContext = .ok synthesis
  infosTypes : produced.execution.recursors.infos.map (fun info => info.type) =
    AddInductive.declareRecursors.generatedRecursorTypes
      produced.execution.eliminationExecution.normalization.stats
      kernelSources.toArray synthesis.recInfos
      (synthesis.recInfos.map (·.motive))
      (synthesis.recInfos.flatMap (·.minors))
      synthesis.synthesisContext.lctx 0

/-- Recover synthesis provenance from the exact public recursor equation
already stored in the produced execution. -/
theorem ProducedBlockRecursorShapeCandidate.recursorSynthesisRun
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context) :
    Nonempty (ProducedBlockRecursorSynthesisRun produced) := by
  obtain ⟨synthesis, detailedRun, infosTypes⟩ :=
    AddInductive.declareRecursors_infos_types produced.execution.recursorsRun
  exact ⟨{ synthesis, detailedRun, infosTypes }⟩

/-- The exact universe-parameter inventory stored by the ordinary recursor
producer has no duplicates.  In the large-elimination branch this is the
semantic freshness certificate for the prepended motive universe.  It is
derived from the retained positional translation audit rather than from the
opaque implementation of `Name.appendIndexAfter`. -/
theorem ProducedBlockSemanticEliminationRun.recursorLevelParams_nodup
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    (run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation) :
    produced.execution.recursors.levelParams.Nodup := by
  let execution := produced.execution.eliminationExecution
  let normalization := execution.normalization
  have normalizationProduced :=
    produced.execution.normalization_run produced.producedExecution
  have familyRun := normalization.familyValidationResult_run
    normalizationProduced
  have validationParams : normalization.validationContext.lparams =
      context.lparams :=
    normalization.validationContext_lparams_all normalizationProduced
  have statsLevels : normalization.stats.levels =
      normalization.validationContext.lparams.map Level.param := by
    calc
      normalization.stats.levels = context.lparams.map Level.param := by
        simpa only [normalization,
          AddInductive.NormalizationCandidateExecution.familyValidationResult]
          using normalization.familyValidationResult.stats_levels_of_run
            produced.kernelSources_nonempty familyRun
      _ = normalization.validationContext.lparams.map Level.param := by
        rw [validationParams]
  have recLevelsSource : execution.recLevels =
      execution.recLevelParams.map Level.param := by
    unfold AddInductive.NormalizationEliminationExecution.recLevels
      AddInductive.NormalizationEliminationExecution.recLevelParams
    cases large : execution.elimination.large.result with
    | false =>
        rw [execution.elimination.recLevels_eq_small large,
          execution.elimination.recLevelParams_eq_small large]
        exact statsLevels
    | true =>
        rw [execution.elimination.recLevels_eq_large large,
          execution.elimination.recLevelParams_eq_large large, statsLevels]
        rfl
  have recUvarsEq : generation.recUvars =
      execution.recLevelParams.length := by
    simpa only [execution,
      ProducedBlockRecursorShapeCandidate.eliminationBase]
      using run.elimination.recUvars_eq
  have translated :
      (execution.recLevelParams.map Level.param).mapM
          (VLevel.ofLevel execution.recLevelParams) =
        some (VLevel.params execution.recLevelParams.length) := by
    rw [← recLevelsSource]
    calc
      execution.recLevels.mapM (VLevel.ofLevel execution.recLevelParams) =
          some generation.recLevels := by
            simpa only [execution,
              ProducedBlockRecursorShapeCandidate.eliminationBase]
              using run.elimination.recLevels_eq
      _ = some (VLevel.params generation.recUvars) := rfl
      _ = some (VLevel.params execution.recLevelParams.length) := by
        rw [recUvarsEq]
  have levelParamsNodup : execution.recLevelParams.Nodup :=
    recLevelParams_nodup_of_translation _ translated
  have levelParamsEq : produced.execution.recursors.levelParams =
      execution.recLevelParams := by
    simpa only [execution,
      AddInductive.NormalizationEliminationExecution.recLevelParams,
      AddInductive.NormalizationRecursorExecution.recursorContext]
      using AddInductive.declareRecursors_levelParams_eq
        produced.execution.recursorsRun
  rwa [levelParamsEq]

/-- Reindex every declaration-universe translation into the exact universe
inventory stored by the ordinary recursor producer.  Small elimination is
the identity reindexing; large elimination shifts the declaration slots past
the fresh motive universe proved fresh by `recursorLevelParams_nodup`. -/
theorem ProducedBlockSemanticEliminationRun.sourceLevels_relevel
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    (run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation) :
    (∀ level ∈ generation.sourceLevels,
      level.WF produced.execution.recursors.levelParams.length) ∧
    (∀ {sourceLevel target},
      VLevel.ofLevel Us sourceLevel = some target →
      VLevel.ofLevel produced.execution.recursors.levelParams sourceLevel =
        some (target.inst generation.sourceLevels)) := by
  let execution := produced.execution.eliminationExecution
  have levelParamsEq : produced.execution.recursors.levelParams =
      execution.recLevelParams := by
    simpa only [execution,
      AddInductive.NormalizationEliminationExecution.recLevelParams,
      AddInductive.NormalizationRecursorExecution.recursorContext]
      using AddInductive.declareRecursors_levelParams_eq
        produced.execution.recursorsRun
  have sourceUvars : source.uvars = Us.length := by
    calc
      source.uvars = execution.normalization.validationContext.lparams.length := by
        simpa only [execution,
          ProducedBlockRecursorShapeCandidate.eliminationBase]
          using run.elimination.sourceUvars_eq
      _ = Us.length := congrArg List.length run.validation_lparams_eq
  cases large : execution.elimination.large.result with
  | false =>
      have modeSmall : generation.elimination = ElimMode.small := by
        simpa only [execution,
          ProducedBlockRecursorShapeCandidate.eliminationBase, large,
          ElimMode.ofBool_false] using run.elimination.mode_eq
      have sourceLevelsEq : generation.sourceLevels =
          VLevel.params source.uvars := by
        change generation.elimination.sourceLevels source.uvars = _
        rw [modeSmall]
        rfl
      have paramsEq : produced.execution.recursors.levelParams = Us := by
        calc
          produced.execution.recursors.levelParams = execution.recLevelParams :=
            levelParamsEq
          _ = execution.normalization.validationContext.lparams := by
            unfold AddInductive.NormalizationEliminationExecution.recLevelParams
            exact execution.elimination.recLevelParams_eq_small large _
          _ = Us := run.validation_lparams_eq
      constructor
      · intro level member
        rw [sourceLevelsEq] at member
        have wf : level.WF source.uvars := VLevel.params_wf member
        simpa only [paramsEq, sourceUvars] using wf
      · intro sourceLevel target translated
        have targetWF := VLevel.WF.of_ofLevel translated
        have instantiated : target.inst generation.sourceLevels = target := by
          rw [sourceLevelsEq, sourceUvars]
          exact VLevel.inst_id targetWF
        simpa only [paramsEq, instantiated] using translated
  | true =>
      have modeLarge : generation.elimination = ElimMode.large := by
        simpa only [execution,
          ProducedBlockRecursorShapeCandidate.eliminationBase, large,
          ElimMode.ofBool_true] using run.elimination.mode_eq
      have sourceLevelsEq : generation.sourceLevels =
          VLevel.params' source.uvars 1 := by
        change generation.elimination.sourceLevels source.uvars = _
        rw [modeLarge]
        rfl
      let fresh := AddInductive.getFreshElimParam
        execution.normalization.validationContext.lparams
      have paramsEq : produced.execution.recursors.levelParams = fresh :: Us := by
        calc
          produced.execution.recursors.levelParams = execution.recLevelParams :=
            levelParamsEq
          _ = fresh :: execution.normalization.validationContext.lparams := by
            unfold AddInductive.NormalizationEliminationExecution.recLevelParams
            exact execution.elimination.recLevelParams_eq_large large _
          _ = fresh :: Us := congrArg (List.cons fresh)
            run.validation_lparams_eq
      have freshAbsent : fresh ∉ Us := by
        have nodup := run.recursorLevelParams_nodup
        rw [paramsEq] at nodup
        exact (List.nodup_cons.mp nodup).1
      constructor
      · intro level member
        rw [sourceLevelsEq] at member
        have wf : level.WF (source.uvars + 1) :=
          VLevel.params'_one_wf level member
        simpa only [paramsEq, List.length_cons, sourceUvars] using wf
      · intro sourceLevel target translated
        have shifted := VLevel.ofLevel_cons_fresh freshAbsent translated
        rw [sourceLevelsEq, sourceUvars]
        simpa only [paramsEq] using shifted

/-- Translate the ordinary producer's elimination level in the exact
recursor universe inventory.  Small elimination contributes `0`; large
elimination contributes the freshly prepended universe slot. -/
theorem ProducedBlockSemanticEliminationRun.motiveLevel_relevel
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    (run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation) :
    VLevel.ofLevel produced.execution.recursors.levelParams
        produced.execution.eliminationExecution.elimination.level =
      some generation.motiveLevel := by
  let execution := produced.execution.eliminationExecution
  have levelParamsEq : produced.execution.recursors.levelParams =
      execution.recLevelParams := by
    simpa only [execution,
      AddInductive.NormalizationEliminationExecution.recLevelParams,
      AddInductive.NormalizationRecursorExecution.recursorContext] using
      AddInductive.declareRecursors_levelParams_eq
        produced.execution.recursorsRun
  cases large : execution.elimination.large.result with
  | false =>
      have modeSmall : generation.elimination = ElimMode.small := by
        simpa only [execution,
          ProducedBlockRecursorShapeCandidate.eliminationBase, large,
          ElimMode.ofBool_false] using run.elimination.mode_eq
      have levelZero : execution.elimination.level = .zero :=
        execution.elimination.level_eq_zero large
      rw [levelParamsEq, levelZero]
      change some (.zero : VLevel) = some generation.elimination.motiveLevel
      rw [modeSmall]
      rfl
  | true =>
      have modeLarge : generation.elimination = ElimMode.large := by
        simpa only [execution,
          ProducedBlockRecursorShapeCandidate.eliminationBase, large,
          ElimMode.ofBool_true] using run.elimination.mode_eq
      let fresh := AddInductive.getFreshElimParam
        execution.normalization.validationContext.lparams
      have paramsEq : execution.recLevelParams =
          fresh :: execution.normalization.validationContext.lparams := by
        unfold AddInductive.NormalizationEliminationExecution.recLevelParams
        exact execution.elimination.recLevelParams_eq_large large _
      have levelParam : execution.elimination.level = .param fresh := by
        exact execution.elimination.level_eq_param large
      rw [levelParamsEq, paramsEq, levelParam]
      change VLevel.ofLevel
          (fresh :: execution.normalization.validationContext.lparams)
          (.param fresh) = some generation.elimination.motiveLevel
      rw [modeLarge]
      simp [VLevel.ofLevel]

private theorem recursorInferImplicit_eqv (e : Expr) (numParams : Nat)
    (considerRange : Bool) :
    e.inferImplicit numParams considerRange == e := by
  induction numParams generalizing e with
  | zero =>
      cases e <;> exact Expr.eqv_refl _
  | succ numParams ih =>
      cases e <;> try exact Expr.eqv_refl _
      rename_i name domain body binderInfo
      unfold Expr.inferImplicit
      have bodyEqv := ih body
      have domainEqv := Expr.eqv_refl domain
      cases condition :
          (binderInfo.isExplicit &&
            Expr.hasLooseBVarInExplicitDomain
              (body.inferImplicit numParams considerRange) 0 considerRange) <;>
        simpa [condition, (· == ·), Expr.eqv_eq, Expr.eqv'] using
          And.intro domainEqv bodyEqv

/-- The emitted recursor type is expression-equivalent to its explicit raw
parameter/motive/minor/index/major telescope.  Consequently semantic proofs
may work on the telescope and transport through `TrExprS.eqv` only once. -/
theorem AddInductive.declareRecursors.generatedRecursorType_eqv_raw
    (stats : AddInductive.InductiveStats)
    (motives minors : Array Expr) (lctx : LocalContext)
    (info : AddInductive.RecInfo) :
    AddInductive.declareRecursors.generatedRecursorType stats motives minors
        lctx info ==
      (lctx.mkForall stats.params <|
        lctx.mkForall motives <|
        lctx.mkForall minors <|
        lctx.mkForall info.indices <|
        lctx.mkForall #[info.major] <|
        .app (mkAppN info.motive info.indices) info.major) := by
  unfold AddInductive.declareRecursors.generatedRecursorType
  exact recursorInferImplicit_eqv _ 1000 false

/-!
The family candidate already records the exact annotation-consumed domains
used to allocate the validator's shared parameter FVars.  Recursor synthesis
reuses those FVars verbatim in `stats.params`, so expose any source-ordered
prefix as a selected `LocalContext.mkForall` telescope.  The implementation
context is the candidate's terminal context: later family/index declarations
are harmless because `SelectedForall` consults only the listed identifiers.
-/
private theorem selectedForall_retargetImplementation
    {env : VEnv} {Us : List Name}
    {sourceLCtx targetLCtx : LocalContext}
    {base final : VLCtx} {fvars : List FVarId} {types : List VExpr}
    (selection : TypeChecker.MLCtx.SelectedForall env Us sourceLCtx base
      fvars types final)
    (preserved : ∀ {fv : FVarId} {decl : LocalDecl},
      sourceLCtx.find? fv = some decl → targetLCtx.find? fv = some decl) :
    TypeChecker.MLCtx.SelectedForall env Us targetLCtx base fvars types
      final := by
  induction selection with
  | nil => exact .nil
  | cons find domainTr domainType tail ih =>
      exact .cons (preserved find) domainTr domainType ih

/-- Selected implementation telescopes are monotone in the Theory
environment; their implementation lookups and compressed contexts are
unchanged. -/
private theorem selectedForall_mono
    {env postEnv : VEnv} (envLE : env ≤ postEnv) {Us : List Name}
    {implementationLCtx : LocalContext}
    {base final : VLCtx} {fvars : List FVarId} {types : List VExpr}
    (selection : TypeChecker.MLCtx.SelectedForall env Us
      implementationLCtx base fvars types final) :
    TypeChecker.MLCtx.SelectedForall postEnv Us implementationLCtx base
      fvars types final := by
  induction selection with
  | nil => exact .nil
  | cons find domainTr domainType tail ih =>
      exact .cons find (domainTr.mono envLE) (domainType.mono envLE) ih

private def selectedForallArrayRun_retargetImplementation
    {env : VEnv} {Us : List Name}
    {sourceLCtx targetLCtx : LocalContext}
    {base final : VLCtx} {sources : Array Expr} {types : List VExpr}
    (run : TypeChecker.MLCtx.SelectedForall.ArrayRun env Us sourceLCtx base
      sources types final)
    (preserved : ∀ {fv : FVarId} {decl : LocalDecl},
      sourceLCtx.find? fv = some decl → targetLCtx.find? fv = some decl) :
    TypeChecker.MLCtx.SelectedForall.ArrayRun env Us targetLCtx base sources
      types final where
  fvars := run.fvars
  selection := selectedForall_retargetImplementation run.selection preserved
  sources_eq := run.sources_eq
  nodup := run.nodup

private def selectedForallArrayRun_mono
    {env postEnv : VEnv} (envLE : env ≤ postEnv) {Us : List Name}
    {implementationLCtx : LocalContext}
    {base final : VLCtx} {sources : Array Expr} {types : List VExpr}
    (run : TypeChecker.MLCtx.SelectedForall.ArrayRun env Us
      implementationLCtx base sources types final) :
    TypeChecker.MLCtx.SelectedForall.ArrayRun postEnv Us
      implementationLCtx base sources types final where
  fvars := run.fvars
  selection := selectedForall_mono envLE run.selection
  sources_eq := run.sources_eq
  nodup := run.nodup

/-- Forget the implementation lookup and typing payload of a selected
telescope, retaining the exact source-ordered free-variable context used by
the parameter-instantiation lemmas. -/
private def selectedForall_toCandidateParameterContext
    {env : VEnv} {Us : List Name} {implementationLCtx : LocalContext}
    {base final : VLCtx} {fvars : List FVarId} {types : List VExpr}
    (selection : TypeChecker.MLCtx.SelectedForall env Us
      implementationLCtx base fvars types final) :
    TypeChecker.CandidateParameterContext base (fvars.map Expr.fvar) types
      final := by
  induction selection with
  | nil => exact .nil
  | cons find domainTr domainType tail ih => exact .cons ih

/-- Array-indexed form of `selectedForall_toCandidateParameterContext`.
This is the bridge from a synthesis-selected local array to the semantic
parameter-instantiation API. -/
private def selectedForallArrayRun_candidateParameterContext
    {env : VEnv} {Us : List Name} {implementationLCtx : LocalContext}
    {base final : VLCtx} {sources : Array Expr} {types : List VExpr}
    (run : TypeChecker.MLCtx.SelectedForall.ArrayRun env Us
      implementationLCtx base sources types final) :
    TypeChecker.CandidateParameterContext base sources.toList types final := by
  rw [run.sources_eq]
  exact selectedForall_toCandidateParameterContext run.selection

private theorem candidateAnnotationSpine_selectedForallPrefix
    {env : VEnv} {Us : List Name}
    {candidateContext : AddInductive.Context} {source : Expr}
    {trace : AddInductive.CandidateExprTrace candidateContext source}
    {base terminal : VLCtx} {domains : List VExpr}
    (spine : TypeChecker.CandidateAnnotationSpine env Us trace base terminal
      domains)
    (localRun : TypeChecker.CandidateLocalContextRun candidateContext)
    (validation : trace.validationAnnotations)
    (count : Nat) (bound : count ≤ domains.length) :
    ∃ fvars final,
      TypeChecker.MLCtx.SelectedForall env Us trace.terminalContext.lctx base
        fvars (domains.take count) final ∧
      (trace.parameterList count).toArray.toList = fvars.map Expr.fvar ∧
      fvars.Nodup ∧
      ∀ fv ∈ fvars, candidateContext.lctx.find? fv = none := by
  induction spine generalizing count with
  | @terminal currentBase context source inferred result source' result'
      inferred' checked normalized node =>
      have countEq : count = 0 := by simpa using bound
      subst count
      refine ⟨[], currentBase, ?_, rfl, .nil, by simp⟩
      simp only [List.take_zero]
      exact .nil
  | @forallE context domain name binderInfo body currentBase terminal
      root inferred fresh annotations annotationsEq checked normalized
      domainCandidate bodyCandidate storedDomain domains head tail ih =>
      cases count with
      | zero =>
          refine ⟨[], currentBase, ?_, rfl, .nil, by simp⟩
          simp only [List.take_zero]
          exact .nil
      | succ count =>
          have tailBound : count ≤ domains.length := by
            simpa only [List.length_cons, Nat.succ_le_succ_iff] using bound
          obtain ⟨tailFVars, final, tailSelection, tailSources, tailNodup,
              tailFresh⟩ :=
            ih (localRun.push name binderInfo annotations.consumed)
              validation.2 count tailBound
          obtain ⟨snapshot, snapshotBase, snapshotDomain⟩ :=
            head validation.1
          have snapshotDomainEq : snapshot.domain = domain := by
            injection snapshot.root_eq
            symm
            assumption
          have consumedEq : snapshot.consumed = annotations.consumed := by
            rw [snapshot.annotation_match, validation.1, snapshotDomainEq]
          have domainTr : TrExprS env Us currentBase annotations.consumed
              storedDomain := by
            simpa only [snapshotBase, snapshotDomain, consumedEq] using
              snapshot.consumed_tr
          have henv : VEnv.WF env := by
            simpa only [snapshot.annotation_run.venv_eq] using
              snapshot.annotation_run.context.Ewf
          have consumedType : env.IsType Us.length currentBase.toCtx
              storedDomain := by
            have annotated := snapshot.annotation_run.isDefEqU.of_l henv
              snapshot.context_wf.toCtx snapshot.domain_type
            exact ⟨snapshot.sort, by
              simpa only [snapshotBase, snapshotDomain] using
                annotated.hasType.2⟩
          have selectedFind :=
            TypeChecker.CandidateExprTrace.head_find_terminal name binderInfo
              annotations bodyCandidate localRun
          have headNotTail : context.freshFVarId ∉ tailFVars := by
            intro member
            have absent := tailFresh context.freshFVarId member
            have present := localRun.push_findNew name binderInfo
              annotations.consumed
            rw [absent] at present
            contradiction
          have currentFresh : ∀ fv ∈ tailFVars,
              context.lctx.find? fv = none := by
            intro fv member
            have absent := tailFresh fv member
            cases found : context.lctx.find? fv with
            | none => rfl
            | some decl =>
                have preserved := localRun.push_findOld name binderInfo
                  annotations.consumed found
                rw [absent] at preserved
                contradiction
          refine ⟨context.freshFVarId :: tailFVars, final,
            .cons selectedFind domainTr consumedType tailSelection, ?_,
            List.nodup_cons.2 ⟨headNotTail, tailNodup⟩, ?_⟩
          · simpa [AddInductive.CandidateExprTrace.parameterList,
              AddInductive.Context.freshExpr] using congrArg
                (List.cons (Expr.fvar context.freshFVarId)) tailSources
          · intro fv member
            rcases List.mem_cons.mp member with rfl | member
            · exact localRun.fresh
            · exact currentFresh fv member

/-- Array-packaged form of `CandidateAnnotationSpine.selectedForallPrefix`. -/
private theorem candidateAnnotationSpine_selectedForallPrefixRun
    {env : VEnv} {Us : List Name}
    {candidateContext : AddInductive.Context} {source : Expr}
    {trace : AddInductive.CandidateExprTrace candidateContext source}
    {base terminal : VLCtx} {domains : List VExpr}
    (spine : TypeChecker.CandidateAnnotationSpine env Us trace base terminal
      domains)
    (localRun : TypeChecker.CandidateLocalContextRun candidateContext)
    (annotations : trace.validationAnnotations)
    (count : Nat) (bound : count ≤ domains.length) :
    Nonempty (Sigma fun final =>
      TypeChecker.MLCtx.SelectedForall.ArrayRun env Us
        trace.terminalContext.lctx base
        (trace.parameterList count).toArray (domains.take count) final) := by
  obtain ⟨fvars, final, selection, sources, nodup, _fresh⟩ :=
    candidateAnnotationSpine_selectedForallPrefix spine localRun annotations
      count bound
  exact ⟨⟨final, { fvars, selection, sources_eq := sources, nodup }⟩⟩

/-- Five-phase semantic layout of one host-generated recursor telescope.

The synthesis local context may contain arbitrary scratch declarations from
constructor fields and recursive-argument analysis.  Each `ArrayRun` selects
only the declarations abstracted by the corresponding emitted `mkForall`:
shared parameters, motives, minors, family indices, and the major premise.
The contexts are deliberately compressed, so no semantic representation of
the interspersed scratch locals is required. -/
structure GeneratedRecursorTelescopeTranslationRun
    (env : VEnv) (Us : List Name)
    (stats : AddInductive.InductiveStats)
    (motives minors : Array Expr) (lctx : LocalContext)
    (info : AddInductive.RecInfo)
    (parameterTypes motiveTypes minorTypes indexTypes majorTypes : List VExpr)
    (result : VExpr) : Type where
  parameterContext : VLCtx
  parameters : _root_.Lean4Lean.TypeChecker.MLCtx.SelectedForall.ArrayRun env Us lctx [] stats.params
    parameterTypes parameterContext
  motiveContext : VLCtx
  motives : _root_.Lean4Lean.TypeChecker.MLCtx.SelectedForall.ArrayRun env Us lctx parameterContext motives
    motiveTypes motiveContext
  minorContext : VLCtx
  minors : _root_.Lean4Lean.TypeChecker.MLCtx.SelectedForall.ArrayRun env Us lctx motiveContext minors
    minorTypes minorContext
  indexContext : VLCtx
  indices : _root_.Lean4Lean.TypeChecker.MLCtx.SelectedForall.ArrayRun env Us lctx minorContext info.indices
    indexTypes indexContext
  finalContext : VLCtx
  major : _root_.Lean4Lean.TypeChecker.MLCtx.SelectedForall.ArrayRun env Us lctx indexContext #[info.major]
    majorTypes finalContext
  result_tr : TrExprS env Us finalContext
    (.app (mkAppN info.motive info.indices) info.major) result
  result_type : env.IsType Us.length finalContext.toCtx result

/-- Discharge all implementation mechanics of a generated recursor type from
its five selected semantic telescope phases.  In particular, the theorem
handles the nested `LocalContext.mkForall` calls and the final
`inferImplicit` representation transport once and for all. -/
theorem GeneratedRecursorTelescopeTranslationRun.translation
    {env : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {motives minors : Array Expr} {lctx : LocalContext}
    {info : AddInductive.RecInfo}
    {parameterTypes motiveTypes minorTypes indexTypes majorTypes : List VExpr}
    {result : VExpr}
    (layout : GeneratedRecursorTelescopeTranslationRun env Us stats motives
      minors lctx info parameterTypes motiveTypes minorTypes indexTypes
      majorTypes result) :
    TrExprS env Us []
      (AddInductive.declareRecursors.generatedRecursorType stats motives minors
        lctx info)
      (VExpr.forallN parameterTypes <|
        VExpr.forallN motiveTypes <|
          VExpr.forallN minorTypes <|
            VExpr.forallN indexTypes <|
              VExpr.forallN majorTypes result) ∧
    env.IsType Us.length []
      (VExpr.forallN parameterTypes <|
        VExpr.forallN motiveTypes <|
          VExpr.forallN minorTypes <|
            VExpr.forallN indexTypes <|
              VExpr.forallN majorTypes result) := by
  have emptyNoBV : VLCtx.NoBV ([] : VLCtx) := rfl
  have parameterNoBV := layout.parameters.final_noBV emptyNoBV
  have motiveNoBV := layout.motives.final_noBV parameterNoBV
  have minorNoBV := layout.minors.final_noBV motiveNoBV
  have indexNoBV := layout.indices.final_noBV minorNoBV
  obtain ⟨majorTr, majorType⟩ :=
    layout.major.mkForall_trS indexNoBV layout.result_tr layout.result_type
  obtain ⟨indexTr, indexType⟩ :=
    layout.indices.mkForall_trS minorNoBV majorTr majorType
  obtain ⟨minorTr, minorType⟩ :=
    layout.minors.mkForall_trS motiveNoBV indexTr indexType
  obtain ⟨motiveTr, motiveType⟩ :=
    layout.motives.mkForall_trS parameterNoBV minorTr minorType
  obtain ⟨parameterTr, parameterType⟩ :=
    layout.parameters.mkForall_trS emptyNoBV motiveTr motiveType
  exact ⟨parameterTr.eqv (BEq.symm
    (AddInductive.declareRecursors.generatedRecursorType_eqv_raw stats motives
      minors lctx info)), parameterType⟩

/-! ### Family-indexed generated recursor telescopes -/

/-- The index telescope appearing after the common parameter, motive, and
minor prefixes of one block recursor. -/
private def generatedRecursorIndexTypes
    {source : VInductDecl} (generation : BlockGenerationChecked source)
    (family : NormalizedFamily) : List VExpr :=
  VExpr.liftTelN (generation.familyCount + generation.minorCount)
    (generation.generatedIdxTel family) 0

/-- Expose the head of the generated motive inventory after it has been
weakened past the motives of all preceding families.  The family indices stay
below the lifting cutoff; only the shared parameter range moves outward. -/
private theorem generatedMotiveType_liftN
    {source : VInductDecl} (generation : BlockGenerationChecked source)
    (family : NormalizedFamily) (d : Nat) :
    (generation.generatedMotiveType family).liftN d =
      VExpr.forallN
        (VExpr.liftTelN d (generation.generatedIdxTel family) 0)
        (.forallE
          (VExpr.appN (.const family.raw.name generation.sourceLevels)
            (VExpr.bvarRevRange
                (d + (generation.generatedIdxTel family).length)
                source.nparams ++
              VExpr.bvarRevRange 0
                (generation.generatedIdxTel family).length))
          (.sort generation.motiveLevel)) := by
  simp [BlockGenerationChecked.generatedMotiveType,
    VExpr.liftN_forallN, VExpr.liftN_appN, List.map_append,
    bvarRevRange_liftN_ge, VExpr.bvarRevRange_liftN_high,
    VExpr.liftN]

/-- The major-premise domain of one block recursor after all preceding
binders have been introduced. -/
private def generatedRecursorMajorType
    {source : VInductDecl} (generation : BlockGenerationChecked source)
    (family : NormalizedFamily) : VExpr :=
  let d := generation.familyCount
  let k := generation.minorCount
  let indices := generation.generatedIdxTel family
  let ni := indices.length
  VExpr.appN (.const family.raw.name generation.sourceLevels)
    (VExpr.bvarRevRange (ni + d + k) source.nparams ++
      VExpr.bvarRevRange 0 ni)

/-- The motive application concluding one block recursor telescope. -/
private def generatedRecursorResult
    {source : VInductDecl} (generation : BlockGenerationChecked source)
    (family : NormalizedFamily) : VExpr :=
  let d := generation.familyCount
  let k := generation.minorCount
  let ni := (generation.generatedIdxTel family).length
  .app
    (VExpr.appN
      (.bvar (d - 1 - family.view.ordinal + k + ni + 1))
      (VExpr.bvarRevRange 1 ni))
    (.bvar 0)

/-- Expose `BlockGenerationChecked.generatedRecType` in exactly the five telescope
phases consumed by `GeneratedRecursorTelescopeTranslationRun`. -/
private theorem blockGeneratedRecursorType_eq_telescope
    {source : VInductDecl} (generation : BlockGenerationChecked source)
    (family : NormalizedFamily) :
    generation.generatedRecType family =
      (VExpr.forallN generation.paramsTel <|
        VExpr.forallN generation.generatedMotiveTypes <|
          VExpr.forallN generation.generatedMinorTypes <|
            VExpr.forallN (generatedRecursorIndexTypes generation family) <|
              VExpr.forallN [generatedRecursorMajorType generation family]
                (generatedRecursorResult generation family)) := by
  rfl

/-- Producer-facing specialization of the generic five-phase telescope run.

The Theory endpoints are fixed definitionally by the selected generated
family. A producer therefore supplies only the corresponding `RecInfo`, its
host generated-type equation, and the five selected-local-context phases. -/
structure GeneratedFamilyRecursorTelescopeTranslationRun
    (env : VEnv) (Us : List Name)
    (stats : AddInductive.InductiveStats)
    (motives minors : Array Expr) (lctx : LocalContext)
    {source : VInductDecl} (generation : BlockGenerationChecked source)
    (family : NormalizedFamily) (hostType : Expr) : Type where
  info : AddInductive.RecInfo
  host_eq : hostType =
    AddInductive.declareRecursors.generatedRecursorType stats motives minors
      lctx info
  layout : GeneratedRecursorTelescopeTranslationRun env Us stats motives
    minors lctx info generation.paramsTel generation.generatedMotiveTypes
      generation.generatedMinorTypes
      (generatedRecursorIndexTypes generation family)
      [generatedRecursorMajorType generation family]
      (generatedRecursorResult generation family)

/-- Existential family-indexed wrapper around the five-phase telescope run.
This is the convenient relation for `List.Forall₂`: the host generated-type
list and the Theory recursor list determine only the two endpoints, while the
corresponding `RecInfo`, compressed contexts, and intermediate telescopes are
producer-owned witnesses. -/
structure GeneratedRecursorTypeTranslationEvidence
    (env : VEnv) (Us : List Name)
    (stats : AddInductive.InductiveStats)
    (motives minors : Array Expr) (lctx : LocalContext)
    (hostType : Expr) (target : VExpr) : Type where
  info : AddInductive.RecInfo
  parameterTypes : List VExpr
  motiveTypes : List VExpr
  minorTypes : List VExpr
  indexTypes : List VExpr
  majorTypes : List VExpr
  result : VExpr
  host_eq : hostType =
    AddInductive.declareRecursors.generatedRecursorType stats motives minors
      lctx info
  target_eq : target =
    (VExpr.forallN parameterTypes <|
      VExpr.forallN motiveTypes <|
        VExpr.forallN minorTypes <|
          VExpr.forallN indexTypes <|
            VExpr.forallN majorTypes result)
  layout : GeneratedRecursorTelescopeTranslationRun env Us stats motives
    minors lctx info parameterTypes motiveTypes minorTypes indexTypes
      majorTypes result

/-- Forget the family-indexed endpoint calculation and recover the generic
one-recursor evidence package. -/
def GeneratedFamilyRecursorTelescopeTranslationRun.evidence
    {env : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {motives minors : Array Expr} {lctx : LocalContext}
    {source : VInductDecl} {generation : BlockGenerationChecked source}
    {family : NormalizedFamily} {hostType : Expr}
    (run : GeneratedFamilyRecursorTelescopeTranslationRun env Us stats
      motives minors lctx generation family hostType) :
    GeneratedRecursorTypeTranslationEvidence env Us stats motives minors lctx
      hostType (generation.generatedRecType family) where
  info := run.info
  parameterTypes := generation.paramsTel
  motiveTypes := generation.generatedMotiveTypes
  minorTypes := generation.generatedMinorTypes
  indexTypes := generatedRecursorIndexTypes generation family
  majorTypes := [generatedRecursorMajorType generation family]
  result := generatedRecursorResult generation family
  host_eq := run.host_eq
  target_eq := blockGeneratedRecursorType_eq_telescope generation family
  layout := run.layout

/-- Erase the producer witnesses of one family-indexed telescope package to
the strict endpoint translation needed by constant insertion. -/
theorem GeneratedRecursorTypeTranslationEvidence.translation
    (evidence : GeneratedRecursorTypeTranslationEvidence env Us stats motives
      minors lctx hostType target) :
    TrExprS env Us [] hostType target := by
  rcases evidence with
    ⟨info, parameterTypes, motiveTypes, minorTypes, indexTypes, majorTypes,
      result, host_eq, target_eq, layout⟩
  subst hostType
  subst target
  exact layout.translation.1

private theorem generatedRecursorTypeTranslations_of_evidence
    {env : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {motives minors : Array Expr} {lctx : LocalContext}
    {hostTypes : List Expr} {raws : List VConstVal}
    (evidence : List.Forall₂
      (fun hostType (raw : VConstVal) => Nonempty <|
        GeneratedRecursorTypeTranslationEvidence env Us stats motives minors
          lctx hostType raw.toVConstant.type)
      hostTypes raws) :
    List.Forall₂
      (fun hostType raw =>
        TrExprS env Us [] hostType raw.toVConstant.type)
      hostTypes raws := by
  induction evidence with
  | nil => exact .nil
  | cons head tail ih =>
    rcases head with ⟨head⟩
    exact .cons head.translation ih

/-- Semantic correspondence stated directly on the type list assembled by
the retained synthesis callback.  This is the phase-local obligation: public
recursor records, names, safety, and universe arities are absent. -/
structure ProducedBlockGeneratedRecursorTypeTranslationRun
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source)
    (generation : BlockGenerationChecked source)
    (run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation)
    (staging : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (synthesis : ProducedBlockRecursorSynthesisRun produced) : Type where
  types : List.Forall₂
    (fun hostType raw => TrExprS
      (run.declarationRun staging).constructors.ctorEnv
      produced.execution.recursors.levelParams [] hostType
      raw.toVConstant.type)
    (AddInductive.declareRecursors.generatedRecursorTypes
      produced.execution.eliminationExecution.normalization.stats
      kernelSources.toArray synthesis.synthesis.recInfos
      (synthesis.synthesis.recInfos.map (·.motive))
      (synthesis.synthesis.recInfos.flatMap (·.minors))
      synthesis.synthesis.synthesisContext.lctx 0)
    generation.recursors

/-- Construct the phase-local translation package from one producer-owned
five-phase telescope witness per generated recursor. -/
def ProducedBlockGeneratedRecursorTypeTranslationRun.ofTelescopeEvidence
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    {run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation}
    {staging : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source}
    {synthesis : ProducedBlockRecursorSynthesisRun produced}
    (evidence : List.Forall₂
      (fun hostType raw => Nonempty <|
        GeneratedRecursorTypeTranslationEvidence
          (run.declarationRun staging).constructors.ctorEnv
          produced.execution.recursors.levelParams
          produced.execution.eliminationExecution.normalization.stats
          (synthesis.synthesis.recInfos.map (·.motive))
          (synthesis.synthesis.recInfos.flatMap (·.minors))
          synthesis.synthesis.synthesisContext.lctx hostType
          raw.toVConstant.type)
      (AddInductive.declareRecursors.generatedRecursorTypes
        produced.execution.eliminationExecution.normalization.stats
        kernelSources.toArray synthesis.synthesis.recInfos
        (synthesis.synthesis.recInfos.map (·.motive))
        (synthesis.synthesis.recInfos.flatMap (·.minors))
        synthesis.synthesis.synthesisContext.lctx 0)
      generation.recursors) :
    ProducedBlockGeneratedRecursorTypeTranslationRun produced semantic
      generation run staging synthesis where
  types := generatedRecursorTypeTranslations_of_evidence evidence

/-- Family-indexed form of the remaining producer correspondence.

Unlike `ProducedBlockGeneratedRecursorTypeTranslationRun`, the right-hand
inventory contains bare normalized families.  This is the natural induction
domain of `mkRecInfos.loopInd1`; recursor names and `VConstVal` wrappers are
introduced only when this package is erased below. -/
structure ProducedBlockGeneratedRecursorFamilyTelescopeRun
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source)
    (generation : BlockGenerationChecked source)
    (run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation)
    (staging : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (synthesis : ProducedBlockRecursorSynthesisRun produced) : Type where
  types : List.Forall₂
    (fun hostType family => Nonempty <|
      GeneratedFamilyRecursorTelescopeTranslationRun
        (run.declarationRun staging).constructors.ctorEnv
        produced.execution.recursors.levelParams
        produced.execution.eliminationExecution.normalization.stats
        (synthesis.synthesis.recInfos.map (·.motive))
        (synthesis.synthesis.recInfos.flatMap (·.minors))
        synthesis.synthesis.synthesisContext.lctx generation family hostType)
    (AddInductive.declareRecursors.generatedRecursorTypes
      produced.execution.eliminationExecution.normalization.stats
      kernelSources.toArray synthesis.synthesis.recInfos
      (synthesis.synthesis.recInfos.map (·.motive))
      (synthesis.synthesis.recInfos.flatMap (·.minors))
      synthesis.synthesis.synthesisContext.lctx 0)
    generation.families

/-- Attach the generated recursor wrapper to every family-indexed telescope
run. -/
private theorem generatedRecursorTelescopeEvidence_of_familyRuns
    {env : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {motives minors : Array Expr} {lctx : LocalContext}
    {source : VInductDecl} {generation : BlockGenerationChecked source}
    {hostTypes : List Expr} {families : List NormalizedFamily}
    (runs : List.Forall₂
      (fun hostType family => Nonempty <|
        GeneratedFamilyRecursorTelescopeTranslationRun env Us stats motives
          minors lctx generation family hostType)
      hostTypes families) :
    List.Forall₂
      (fun hostType (raw : VConstVal) => Nonempty <|
        GeneratedRecursorTypeTranslationEvidence env Us stats motives minors
          lctx hostType raw.toVConstant.type)
      hostTypes (families.map fun family =>
        ⟨generation.generatedRecursor family,
          .str family.raw.name "rec"⟩) := by
  induction runs with
  | nil => exact .nil
  | cons head tail ih =>
    rcases head with ⟨head⟩
    refine .cons ?_ ih
    exact ⟨head.evidence⟩

/-- Erase family indexing and obtain the exact generated-type translation
package consumed by metadata insertion. -/
def ProducedBlockGeneratedRecursorFamilyTelescopeRun.toTypeTranslation
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    {run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation}
    {staging : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source}
    {synthesis : ProducedBlockRecursorSynthesisRun produced}
    (familyRuns : ProducedBlockGeneratedRecursorFamilyTelescopeRun produced
      semantic generation run staging synthesis) :
    ProducedBlockGeneratedRecursorTypeTranslationRun produced semantic
      generation run staging synthesis :=
  .ofTelescopeEvidence <|
    generatedRecursorTelescopeEvidence_of_familyRuns familyRuns.types

private theorem recursorTypeTranslations_of_mappedTypes
    {ctorEnv : VEnv} {commonLevels : List Name}
    {infos : List RecursorVal} {raws : List VConstVal}
    (types : List.Forall₂
      (fun hostType raw => TrExprS ctorEnv commonLevels [] hostType
        raw.toVConstant.type) (infos.map (fun info => info.type)) raws)
    (levels : ∀ info ∈ infos, info.levelParams = commonLevels) :
    List.Forall₂
      (fun info raw => TrExprS ctorEnv info.levelParams [] info.type
        raw.toVConstant.type) infos raws := by
  induction infos generalizing raws with
  | nil =>
      cases types
      exact .nil
  | cons info infos ih =>
      cases types with
      | cons type types =>
          refine .cons ?_ (ih types (by
            intro other member
            exact levels other (.tail info member)))
          rw [levels info List.mem_cons_self]
          exact type

/-- Projection-aware recursor-type translation at the exact constructor
endpoint.  Unlike `ProducedBlockRecursorTypeShapeRun`, this package records
the semantic `TrExprS` judgment directly and therefore permits resolved
projection syntax and definitional transports in generated binder types. -/
structure ProducedBlockRecursorTypeTranslationRun
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source)
    (generation : BlockGenerationChecked source)
    (run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation)
    (staging : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source) : Type where
  types : List.Forall₂
    (fun info raw => TrExprS
      (run.declarationRun staging).constructors.ctorEnv
      info.levelParams [] info.type raw.toVConstant.type)
    produced.execution.recursors.infos generation.recursors

/-- Reattach the actual public recursor records to a semantic proof over the
producer's generated type list. -/
def ProducedBlockGeneratedRecursorTypeTranslationRun.toTypeTranslation
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    {run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation}
    {staging : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source}
    {synthesis : ProducedBlockRecursorSynthesisRun produced}
    (translation : ProducedBlockGeneratedRecursorTypeTranslationRun produced
      semantic generation run staging synthesis) :
    ProducedBlockRecursorTypeTranslationRun produced semantic generation run
      staging where
  types := by
    apply recursorTypeTranslations_of_mappedTypes
    · rw [synthesis.infosTypes]
      exact translation.types
    · exact produced.execution.recursors.infos_levelParams

/-- Header facts owned by the producer turn semantic recursor-type
translation into complete constant translation. -/
private theorem recursorTranslationEvidence_of_semanticTypes
    {ctorEnv : VEnv} {infos : List RecursorVal} {raws : List VConstVal}
    (types : List.Forall₂
      (fun info raw => TrExprS ctorEnv info.levelParams [] info.type
        raw.toVConstant.type) infos raws)
    (names : List.Forall₂ (fun info raw => info.name = raw.name)
      infos raws)
    (infosSafe : ∀ info ∈ infos,
      .safe ≤ (.recInfo info : ConstantInfo).safety)
    (infosUvars : ∀ info ∈ infos,
      info.levelParams.length = recUvars)
    (rawsUvars : ∀ raw ∈ raws,
      raw.toVConstant.uvars = recUvars) :
    List.Forall₂
      (fun info raw => TrConstVal .safe ctorEnv (.recInfo info) raw)
      infos raws := by
  induction types with
  | nil =>
      cases names
      exact .nil
  | @cons info raw infos raws type types ih =>
      cases names with
      | cons name names =>
          have infoMember : info ∈ info :: infos := List.mem_cons_self
          have rawMember : raw ∈ raw :: raws := List.mem_cons_self
          refine .cons ⟨⟨infosSafe info infoMember, ?_, type⟩, name⟩
            (ih names
              (fun other member => infosSafe other (.tail info member))
              (fun other member => infosUvars other (.tail info member))
              (fun other member => rawsUvars other (.tail raw member)))
          exact (infosUvars info infoMember).trans
            (rawsUvars raw rawMember).symm

/-- Complete recursor constant translation from a projection-aware semantic
type run.  Safety, names, and universe arities are consequences of the same
retained producer and generation. -/
theorem ProducedBlockRecursorTypeTranslationRun.evidence
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    {run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation}
    {staging : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source}
    (translation : ProducedBlockRecursorTypeTranslationRun produced semantic
      generation run staging) :
    List.Forall₂
      (fun info raw => TrConstVal .safe
        (run.declarationRun staging).constructors.ctorEnv
        (.recInfo info) raw)
      produced.execution.recursors.infos generation.recursors := by
  apply recursorTranslationEvidence_of_semanticTypes translation.types
    run.recursorNames
  · intro info member
    have unsafeRun := AddInductive.declareRecursors_infos_isUnsafe
      produced.execution.recursorsRun member
    have unsafeFalse : info.isUnsafe = false := by
      calc
        info.isUnsafe =
            ((produced.execution.eliminationExecution.normalization
              |>.validationContext).safety != DefinitionSafety.safe) := by
          simpa using unsafeRun
        _ = false := by
          have validationSafe :
              produced.execution.eliminationExecution.normalization.validationContext.safety =
                DefinitionSafety.safe := by
            simpa only [ProducedBlockRecursorShapeCandidate.eliminationBase]
              using run.validation_safety_eq
          rw [validationSafe]
          rfl
    change DefinitionSafety.safe ≤
      (if info.isUnsafe then DefinitionSafety.unsafe else DefinitionSafety.safe)
    rw [unsafeFalse]
    decide
  · intro info member
    have levels := AddInductive.declareRecursors_infos_levelParams
      produced.execution.recursorsRun member
    have levelsEq : info.levelParams =
        produced.execution.eliminationExecution.recLevelParams := by
      simpa only [AddInductive.NormalizationEliminationExecution.recLevelParams]
        using levels
    exact (congrArg List.length levelsEq).trans
      run.elimination.recUvars_eq.symm
  · intro raw member
    simp only [BlockGenerationChecked.recursors, List.mem_map] at member
    obtain ⟨family, hfamily, rfl⟩ := member
    rfl

/-- Representation-only alignment of every synthesized host recursor type
with its family-indexed Theory recursor.  Target typing is deliberately not a
field: it is recovered from `BlockGenerationEnv` at the exact constructor
endpoint. -/
structure ProducedBlockRecursorTypeShapeRun
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source)
    (generation : BlockGenerationChecked source)
    (run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation)
    (staging : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source) : Type where
  types : List.Forall₂
    (fun info raw => info.name = raw.name ∧
      TrTypeExpr (run.declarationRun staging).constructors.ctorEnv
        info.levelParams [] info.type raw.toVConstant.type)
    produced.execution.recursors.infos generation.recursors

/-- Type-valued wrapper used by the executable list checker below. -/
private structure RecursorTypeShapeList (ctorEnv : VEnv)
    (infos : List RecursorVal) (raws : List VConstVal) : Type where
  types : List.Forall₂
    (fun info raw => info.name = raw.name ∧
      TrTypeExpr ctorEnv info.levelParams [] info.type
        raw.toVConstant.type) infos raws

/-- Execute the exact name and structural-type comparison in source order. -/
private def buildRecursorTypeShapes? (ctorEnv : VEnv) :
    (infos : List RecursorVal) → (raws : List VConstVal) →
      Option (RecursorTypeShapeList ctorEnv infos raws)
  | [], [] => some ⟨.nil⟩
  | info :: infos, raw :: raws =>
      if nameEq : info.name = raw.name then
        match TrTypeExpr.buildExact? ctorEnv info.levelParams [] info.type
            raw.toVConstant.type with
        | none => none
        | some typeShape =>
            match buildRecursorTypeShapes? ctorEnv infos raws with
            | none => none
            | some tail => some ⟨.cons ⟨nameEq, typeShape.proof⟩ tail.types⟩
      else none
  | _, _ => none

/-- Computable success bit for the source-ordered recursor shape checker.
This erases only the proof payload returned on success; it executes the same
name and exact structural-type comparisons as `build?`. -/
def recursorTypeShapesMatch (ctorEnv : VEnv)
    (infos : List RecursorVal) (raws : List VConstVal) : Bool :=
  (buildRecursorTypeShapes? ctorEnv infos raws).isSome

/-- Run the proof-producing structural checker against the actual host
recursor inventory and the exact generated Theory inventory. -/
noncomputable def ProducedBlockRecursorTypeShapeRun.build?
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source)
    (generation : BlockGenerationChecked source)
    (run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation)
    (staging : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source) :
    Option (ProducedBlockRecursorTypeShapeRun produced semantic generation
      run staging) :=
  let declarations := run.declarationRun staging
  match buildRecursorTypeShapes? declarations.constructors.ctorEnv
      produced.execution.recursors.infos generation.recursors with
  | none => none
  | some shapes => some { types := shapes.types }

/-- Observing success of the proof-producing wrapper is exactly observing
the computable structural checker after erasing its certificate payload. -/
theorem ProducedBlockRecursorTypeShapeRun.build?_isSome_eq
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source)
    (generation : BlockGenerationChecked source)
    (run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation)
    (staging : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source) :
    (ProducedBlockRecursorTypeShapeRun.build? produced semantic generation
      run staging).isSome =
      recursorTypeShapesMatch
        (run.declarationRun staging).constructors.ctorEnv
        produced.execution.recursors.infos generation.recursors := by
  unfold ProducedBlockRecursorTypeShapeRun.build? recursorTypeShapesMatch
  dsimp only
  cases buildRecursorTypeShapes?
      (run.declarationRun staging).constructors.ctorEnv
      produced.execution.recursors.infos generation.recursors <;> rfl

/-- Turn structural recursor-type alignment into complete constant
translation once both inventories have uniform universe arity, safe host
metadata, canonical names, and Theory typing at the shared endpoint. -/
private theorem recursorTranslationEvidence_of_typeShapes
    {ctorEnv : VEnv} {infos : List RecursorVal} {raws : List VConstVal}
    {recUvars : Nat}
    (shapes : List.Forall₂
      (fun info raw => info.name = raw.name ∧
        TrTypeExpr ctorEnv info.levelParams [] info.type
          raw.toVConstant.type) infos raws)
    (infosSafe : ∀ info ∈ infos,
      .safe ≤ (.recInfo info : ConstantInfo).safety)
    (infosUvars : ∀ info ∈ infos,
      info.levelParams.length = recUvars)
    (rawsUvars : ∀ raw ∈ raws,
      raw.toVConstant.uvars = recUvars)
    (rawsWF : ∀ raw ∈ raws, raw.toVConstant.WF ctorEnv)
    (ordered : ctorEnv.Ordered) :
    List.Forall₂
      (fun info raw => TrConstVal .safe ctorEnv (.recInfo info) raw)
      infos raws := by
  induction shapes with
  | nil => exact .nil
  | @cons info raw infos raws shape shapes ih =>
      have infoMember : info ∈ info :: infos := List.mem_cons_self
      have rawMember : raw ∈ raw :: raws := List.mem_cons_self
      refine .cons ?_ (ih
        (fun other member => infosSafe other (.tail info member))
        (fun other member => infosUvars other (.tail info member))
        (fun other member => rawsUvars other (.tail raw member))
        (fun other member => rawsWF other (.tail raw member)))
      refine ⟨⟨infosSafe info infoMember, ?_, ?_⟩, shape.1⟩
      · exact (infosUvars info infoMember).trans
          (rawsUvars raw rawMember).symm
      · obtain ⟨u, rawWF⟩ := rawsWF raw rawMember
        apply shape.2.to_trExprS ordered trivial
        have targetWF : raw.toVConstant.type.WF ctorEnv
            info.levelParams.length [] := by
          rw [infosUvars info infoMember, ← rawsUvars raw rawMember]
          exact ⟨.sort u, rawWF⟩
        exact targetWF

/-- Full semantic translation of the actual generated host recursor records,
derived from representation-only type shapes.  Safety, universe arity, names,
and target well-formedness are all producer-owned consequences. -/
theorem ProducedBlockRecursorTypeShapeRun.evidence
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    {run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation}
    {staging : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source}
    (shape : ProducedBlockRecursorTypeShapeRun produced semantic generation
      run staging) :
    List.Forall₂
      (fun info raw => TrConstVal .safe
        (run.declarationRun staging).constructors.ctorEnv
        (.recInfo info) raw)
      produced.execution.recursors.infos generation.recursors := by
  let declarations := run.declarationRun staging
  apply recursorTranslationEvidence_of_typeShapes
    (recUvars := generation.recUvars) shape.types
  · intro info member
    have unsafeRun := AddInductive.declareRecursors_infos_isUnsafe
      produced.execution.recursorsRun member
    have unsafeFalse : info.isUnsafe = false := by
      calc
        info.isUnsafe =
            ((produced.execution.eliminationExecution.normalization
              |>.validationContext).safety != DefinitionSafety.safe) := by
          simpa using unsafeRun
        _ = false := by
          have validationSafe :
              produced.execution.eliminationExecution.normalization.validationContext.safety =
                DefinitionSafety.safe := by
            simpa only [ProducedBlockRecursorShapeCandidate.eliminationBase]
              using run.validation_safety_eq
          rw [validationSafe]
          rfl
    change DefinitionSafety.safe ≤
      (if info.isUnsafe then DefinitionSafety.unsafe else DefinitionSafety.safe)
    rw [unsafeFalse]
    decide
  · intro info member
    have levels := AddInductive.declareRecursors_infos_levelParams
      produced.execution.recursorsRun member
    have levelsEq : info.levelParams =
        produced.execution.eliminationExecution.recLevelParams := by
      simpa only [AddInductive.NormalizationEliminationExecution.recLevelParams]
        using levels
    exact (congrArg List.length levelsEq).trans
      run.elimination.recUvars_eq.symm
  · intro raw member
    simp only [BlockGenerationChecked.recursors, List.mem_map] at member
    obtain ⟨family, hfamily, rfl⟩ := member
    rfl
  · exact declarations.recursorConstantsWF
  · exact declarations.generationEnv.ord

/-- Package the canonical V3.4 generation and V3.5 elimination proofs as one
exact producer-owned boundary. -/
noncomputable def
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion.canonicalProducedBlockEliminationRun
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {staging : produced.SecondFamilyIndexStaging semantic}
    {raw : Option staging.annotation.RawFirstIndexDomain}
    (completion : staging.TerminalIndexDomainCompletion raw)
    (context_lctx_eq : context.lctx = {})
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (alignmentRun :
      AddInductive.ConstructorBlockCandidateAlignmentTrace.check
        (produced.execution.eliminationExecution.normalization
          |>.constructorValidation.traces)
        produced.candidate.families = .ok ())
    (stage3Run :
      AddInductive.ConstructorBlockStage3SafetyTraces.check
        produced.execution.eliminationExecution.normalization.stats
        Us source.uvars produced.candidate.families = .ok ())
    (preFamilyRun :
      AddInductive.checkConstructorMutualBlockPreFamilySafety
        produced.execution.eliminationExecution.normalization.stats
        produced.execution.eliminationExecution.normalization.validationContext
        produced.candidate.families = .ok ())
    (universeRun :
      AddInductive.checkConstructorBlockUniverseSemantics
        produced.execution.eliminationExecution.normalization.stats
        (firstSource :: secondSource :: remainingSources)
        { produced.execution.eliminationExecution.normalization.validationContext
          with env :=
            produced.execution.eliminationExecution.normalization.familyEnv } =
          .ok ())
    (recUniverseRun :
      AddInductive.checkBlockRecursorUniverseSemantics source.uvars
        produced.execution.eliminationExecution = .ok ()) :
    ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic
      (completion.canonicalBlockGenerationChecked context_lctx_eq stagingInput
        alignmentRun stage3Run) where
  blockEnv_wf := by
    obtain ⟨inventory⟩ :=
      completion.constructorValidationSemanticState context_lctx_eq
        stagingInput alignmentRun
    simpa only [inventory.semantic.contextRun.venv_eq] using
      inventory.semantic.contextRun.candidate.context.Ewf
  block := completion.canonicalBlockGenerationRun context_lctx_eq stagingInput
    alignmentRun stage3Run preFamilyRun universeRun
  elimination := completion.canonicalBlockEliminationRun context_lctx_eq
    stagingInput alignmentRun stage3Run recUniverseRun
  isUnsafe_eq := by
    calc
      isUnsafe = (context.safety != .safe) :=
        produced.execution.isUnsafe_eq
      _ = false := by rw [stagingInput.context_safety_eq]; rfl
  validation_lparams_eq := stagingInput.validation_lparams_eq
  validation_safety_eq := by
    calc
      produced.execution.eliminationExecution.normalization.validationContext.safety =
          context.safety := completion.blockValidationContext_safety
      _ = .safe := stagingInput.context_safety_eq
  rawIndexCounts := by
    let normalization :=
      produced.execution.eliminationExecution.normalization
    let params := blockParams source.nparams semantic.families.views
    have paramsLength : params.length = source.nparams :=
      produced.semanticViewParams_length semantic context_lctx_eq
    have counts := completion.canonicalFamilyIndexCounts context_lctx_eq
      paramsLength
    have shapes := semantic.generationShapes produced.shape
    have headersEq := semantic.families.familyHeaders_canonicalize shapes
      normalization.familyParameterSpines normalization.familyTerminalSorts
      paramsLength
    exact counts.of_familyHeaders_eq headersEq
  fieldSorts_isSome :=
    (completion.canonicalCheckedBlockConstructorRuns context_lctx_eq
      stagingInput alignmentRun stage3Run preFamilyRun universeRun).2.1
  fieldSortTelescopes :=
    (completion.canonicalCheckedBlockConstructorRuns context_lctx_eq
      stagingInput alignmentRun stage3Run preFamilyRun universeRun).2.2 _

/-- Select the canonical generation and its elimination proof as one
producer-owned dependent result.  This is the handoff used by outer
environment replay; consumers cannot replace the generation while retaining
the proof assembled from this completion. -/
noncomputable def
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion.canonicalProducedBlockSemanticRecursorRun
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {staging : produced.SecondFamilyIndexStaging semantic}
    {raw : Option staging.annotation.RawFirstIndexDomain}
    (completion : staging.TerminalIndexDomainCompletion raw)
    (context_lctx_eq : context.lctx = {})
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (alignmentRun :
      AddInductive.ConstructorBlockCandidateAlignmentTrace.check
        (produced.execution.eliminationExecution.normalization
          |>.constructorValidation.traces)
        produced.candidate.families = .ok ())
    (stage3Run :
      AddInductive.ConstructorBlockStage3SafetyTraces.check
        produced.execution.eliminationExecution.normalization.stats
        Us source.uvars produced.candidate.families = .ok ())
    (preFamilyRun :
      AddInductive.checkConstructorMutualBlockPreFamilySafety
        produced.execution.eliminationExecution.normalization.stats
        produced.execution.eliminationExecution.normalization.validationContext
        produced.candidate.families = .ok ())
    (universeRun :
      AddInductive.checkConstructorBlockUniverseSemantics
        produced.execution.eliminationExecution.normalization.stats
        (firstSource :: secondSource :: remainingSources)
        { produced.execution.eliminationExecution.normalization.validationContext
          with env :=
            produced.execution.eliminationExecution.normalization.familyEnv } =
          .ok ())
    (recUniverseRun :
      AddInductive.checkBlockRecursorUniverseSemantics source.uvars
        produced.execution.eliminationExecution = .ok ()) :
    ProducedBlockSemanticRecursorRun env blockEnv Us produced semantic where
  generation := completion.canonicalBlockGenerationChecked context_lctx_eq
    stagingInput alignmentRun stage3Run
  run := completion.canonicalProducedBlockEliminationRun context_lctx_eq
    stagingInput alignmentRun stage3Run preFamilyRun universeRun
      recUniverseRun

/-- The complete family/constructor/recursor metadata prefix for a semantic
generation run.  Its constructor environment is computed by the retained
declaration trace, and recursor well-formedness is recovered from that exact
endpoint; only the structural translation of the synthesized host recursor
types remains proof-relevant input. -/
structure ProducedBlockSemanticMetadataPrefixRun
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source)
    (generation : BlockGenerationChecked source)
    (run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation) where
  declarations : ProducedBlockSemanticDeclarationRun run
  recursors : RecursorDeclarationStagingRun
    produced.execution.recursors.allowPrimitive
    produced.execution.recursors.initialEnv
    produced.execution.recursors.env
    produced.execution.recursors.infos
    declarations.constructors.ctorEnv generation.recursors
    generation.kTarget
    produced.execution.eliminationExecution.normalization.validationContext.env.quotInit

/-- Extend a semantic declaration run through the actual generated recursor
inventory.  Theory typing of every target recursor is derived internally at
the computed constructor endpoint. -/
noncomputable def ProducedBlockRecursorShapeCandidate.semanticMetadataPrefix
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    (run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation)
    (staging : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (evidence : List.Forall₂
      (fun info raw => TrConstVal .safe
        (run.declarationRun staging).constructors.ctorEnv
        (.recInfo info) raw)
      produced.execution.recursors.infos generation.recursors) :
    ProducedBlockSemanticMetadataPrefixRun produced semantic generation run := by
  let declarations := run.declarationRun staging
  have pre : TrEnv' .safe
      produced.execution.recursors.initialEnv.constants
      produced.execution.eliminationExecution.normalization.validationContext.env.quotInit
      declarations.constructors.ctorEnv := by
    rw [produced.execution.recursor_initialEnv_eq]
    exact declarations.constructors.trenv
  let recursors := recursorDeclarationStaging
    (kTarget := generation.kTarget)
    produced.execution.recursors.trace.run evidence (by
      intro info member
      rw [run.elimination.kTarget_eq]
      exact AddInductive.declareRecursors_infos_kTarget
        produced.execution.recursorsRun member)
    declarations.recursorConstantsWF pre
  exact { declarations, recursors }

/-- Projection-aware entry point for the complete metadata prefix.  The only
remaining input is semantic translation of the generated recursor types;
all header and endpoint obligations are recovered from the retained run. -/
noncomputable def
    ProducedBlockRecursorShapeCandidate.semanticMetadataPrefixOfTypeTranslation
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    (run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation)
    (staging : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (translation : ProducedBlockRecursorTypeTranslationRun produced semantic
      generation run staging) :
    ProducedBlockSemanticMetadataPrefixRun produced semantic generation run :=
  produced.semanticMetadataPrefix run staging translation.evidence

/-- Representation-only entry point for the complete metadata prefix.  The
structural shape package is upgraded to `TrConstVal` internally using the
producer-owned header facts and constructor-end generation environment. -/
noncomputable def
    ProducedBlockRecursorShapeCandidate.semanticMetadataPrefixOfTypeShape
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    (run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation)
    (staging : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (shape : ProducedBlockRecursorTypeShapeRun produced semantic generation
      run staging) :
    ProducedBlockSemanticMetadataPrefixRun produced semantic generation run :=
  produced.semanticMetadataPrefix run staging shape.evidence

/-- Execute recursor structural alignment and, on success, construct the
complete metadata prefix.  This is the honest executable V3.5 boundary:
`none` denotes an exact host/Theory shape mismatch, while success carries all
translation, typing, insertion, and K-alignment evidence. -/
noncomputable def ProducedBlockRecursorShapeCandidate.semanticMetadataPrefix?
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source)
    (generation : BlockGenerationChecked source)
    (run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation)
    (staging : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source) :
    Option (ProducedBlockSemanticMetadataPrefixRun produced semantic
      generation run) :=
  match ProducedBlockRecursorTypeShapeRun.build? produced semantic generation
      run staging with
  | none => none
  | some shape =>
      some (produced.semanticMetadataPrefixOfTypeShape run staging shape)

/-- The complete metadata wrapper succeeds exactly when its structural
recursor-type subcheck succeeds. -/
theorem
    ProducedBlockRecursorShapeCandidate.semanticMetadataPrefix?_isSome_eq
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source)
    (generation : BlockGenerationChecked source)
    (run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation)
    (staging : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source) :
    (produced.semanticMetadataPrefix? semantic generation run staging).isSome =
      (ProducedBlockRecursorTypeShapeRun.build? produced semantic generation
        run staging).isSome := by
  unfold ProducedBlockRecursorShapeCandidate.semanticMetadataPrefix?
  cases ProducedBlockRecursorTypeShapeRun.build? produced semantic generation
      run staging <;> rfl

/-- Complete the semantic metadata prefix with the canonical generated-rule
fold.  The output environment is definitionally the fold result, so no
caller-selected rule transaction remains. -/
def ProducedBlockSemanticMetadataPrefixRun.addInductBlockTrace
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    {run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation}
    (metadata : ProducedBlockSemanticMetadataPrefixRun produced semantic
      generation run) :
    AddInductBlockTrace
      produced.execution.eliminationExecution.normalization.validationContext.env.constants
      env source produced.execution.recursors.env.constants
      (generation.generatedRules.foldl VEnv.addDefEq
        metadata.recursors.recEnv) where
  generation := generation
  blockEnv := blockEnv
  generation_wf := run.block.wf
  typeMap :=
    produced.execution.eliminationExecution.normalization.familyEnv.constants
  typeEnv := blockEnv
  ctorMap := produced.execution.eliminationExecution.constructorEnv.constants
  ctorEnv := metadata.declarations.constructors.ctorEnv
  recEnv := metadata.recursors.recEnv
  addTypes := metadata.declarations.families.addTypes
  addCtors := metadata.declarations.constructors.addCtors
  addRecs := by
    rw [← produced.execution.recursor_initialEnv_eq]
    exact metadata.recursors.addRecs
  recK := metadata.recursors.recK
  addRules := ⟨rfl⟩

/-- Proposition-valued public projection of the completed semantic block
transaction. -/
theorem ProducedBlockSemanticMetadataPrefixRun.addInductBlock
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {env blockEnv : VEnv} {Us : List Name}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {generation : BlockGenerationChecked source}
    {run : ProducedBlockSemanticEliminationRun env blockEnv Us
      produced.eliminationBase semantic generation}
    (metadata : ProducedBlockSemanticMetadataPrefixRun produced semantic
      generation run) :
    AddInductBlock
      produced.execution.eliminationExecution.normalization.validationContext.env.constants
      env source produced.execution.recursors.env.constants
      (generation.generatedRules.foldl VEnv.addDefEq
        metadata.recursors.recEnv) :=
  ⟨metadata.addInductBlockTrace⟩

/-- Analyze the exact semantic family spine selected by the retained ordinary
producer and, on success, construct its complete checked block.  In
particular, callers do not select a dependent `CheckedFamilies` witness: the
Theory analyzer computes that witness from the producer's normalized view.

The remaining `Option` boundary is intentional.  Kernel validation compares
later-family parameter domains by definitional equality, whereas
`CheckedFamily.params_eq` requires syntactic equality with the first
normalized parameter telescope.  A later producer theorem must either prove
that exact equality or construct a semantically equivalent canonical view;
this function does not silently strengthen the kernel check. -/
def ProducedBlockRecursorShapeCandidate.semanticCheckedBlock?
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    {env blockEnv : VEnv} {Us : List Name}
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source)
    (validationMapWF : produced.execution.eliminationExecution.normalization
      |>.validationContext.env.constants.WF)
    (context_lctx_eq : context.lctx = {}) :
    Option semantic.normalization.view.CheckedBlock :=
  let view := semantic.normalization.view
  let params := blockParams view.nparams view.types
  match VInductDecl.checkedFamilies? view params 0 view.types with
  | none => none
  | some families => some {
      params
      params_eq := rfl
      params_length :=
        produced.semanticViewParams_length semantic context_lctx_eq
      families
      nonempty := semantic.viewTypes_isEmpty_eq_sources.trans
        produced.kernelSources_nonempty
      names := blockGeneratedNames view.types
      names_eq := rfl
      names_nodup :=
        produced.semanticViewGeneratedNames_nodup semantic validationMapWF }

/-- Compute the analyzer block and the validator-owned common result universe
as one semantic validation value.  Both data fields are fixed by the retained
ordinary execution: family analysis runs on its exact normalized view and the
level is the strict Theory translation of its stored kernel statistic. -/
def ProducedBlockRecursorShapeCandidate.semanticValidatedBlock?
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    {env blockEnv : VEnv} {Us : List Name}
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source)
    (validationMapWF : produced.execution.eliminationExecution.normalization
      |>.validationContext.env.constants.WF)
    (context_lctx_eq : context.lctx = {}) :
    Option (ValidatedBlock source) := do
  let checked ← produced.semanticCheckedBlock? semantic validationMapWF
    context_lctx_eq
  let resultLevel ← VLevel.ofLevel Us
    produced.execution.eliminationExecution.normalization.stats.resultLevel
  return {
    block := semantic.normalizedCheckedBlock checked
    resultLevel }

/-- Run the retained ordinary producer through recursor synthesis/declaration
and the unchanged complete generation-shape gate. -/
def produceBlockRecursorShapeCandidate
    (source : VInductDecl) (kernelSources : List InductiveType)
    (numNested : Nat) (isUnsafe : Bool)
    (context : AddInductive.Context)
    (kernelSources_nonempty : kernelSources.isEmpty = false) :
    Except Exception (ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context) :=
  match producedExecution :
      AddInductive.NormalizationRecursorExecution.buildExecution source.nparams
        kernelSources numNested isUnsafe context with
  | .error error => .error error
  | .ok execution =>
      if shape : normalizationCandidateBlockGenerationShape source
          execution.candidate then
        .ok { execution, producedExecution, shape, kernelSources_nonempty }
      else
        .error (.other
          "recursor candidate block does not preserve the generation spine")

private theorem produceBlockRecursorShapeCandidate_match_ok
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (result : Except Exception
      (AddInductive.NormalizationRecursorExecution source.nparams
        kernelSources numNested isUnsafe context))
    (toProducedExecution : ∀ actual, result = .ok actual →
      AddInductive.NormalizationRecursorExecution.buildExecution source.nparams
          kernelSources numNested isUnsafe context = .ok actual)
    {execution : AddInductive.NormalizationRecursorExecution source.nparams
      kernelSources numNested isUnsafe context}
    (result_ok : result = .ok execution)
    (shape : normalizationCandidateBlockGenerationShape source
      execution.candidate = true)
    (kernelSources_nonempty : kernelSources.isEmpty = false) :
    (match result_eq : result with
    | .error error => Except.error error
    | .ok actual =>
      if actualShape : normalizationCandidateBlockGenerationShape source
          actual.candidate then
        Except.ok (show ProducedBlockRecursorShapeCandidate source
            kernelSources numNested isUnsafe context from {
          execution := actual
          producedExecution := toProducedExecution actual result_eq
          shape := actualShape
          kernelSources_nonempty })
      else
        Except.error (.other
          "recursor candidate block does not preserve the generation spine")) =
      Except.ok (show ProducedBlockRecursorShapeCandidate source kernelSources
          numNested isUnsafe context from {
        execution
        producedExecution := toProducedExecution execution result_ok
        shape
        kernelSources_nonempty }) := by
  subst result
  simp [shape]

theorem produceBlockRecursorShapeCandidate_eq_ok
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {execution : AddInductive.NormalizationRecursorExecution source.nparams
      kernelSources numNested isUnsafe context}
    (producedExecution :
      AddInductive.NormalizationRecursorExecution.buildExecution source.nparams
          kernelSources numNested isUnsafe context = .ok execution)
    (shape : normalizationCandidateBlockGenerationShape source
      execution.candidate = true)
    (kernelSources_nonempty : kernelSources.isEmpty = false) :
    produceBlockRecursorShapeCandidate source kernelSources numNested isUnsafe
        context kernelSources_nonempty =
      .ok { execution, producedExecution, shape, kernelSources_nonempty } := by
  unfold produceBlockRecursorShapeCandidate
  exact produceBlockRecursorShapeCandidate_match_ok
    (result := AddInductive.NormalizationRecursorExecution.buildExecution
      source.nparams kernelSources numNested isUnsafe context)
    (toProducedExecution := fun _ result_eq => result_eq)
    producedExecution shape kernelSources_nonempty

/-- The ordinary constructor-validation trace retained by a recursor
producer already discharges the block universe audit.  In particular, this
equation is producer evidence rather than a supplemental acceptance premise. -/
theorem ProducedBlockRecursorShapeCandidate.constructorUniverseRun
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context) :
    AddInductive.checkConstructorBlockUniverseSemantics
        produced.execution.eliminationExecution.normalization.stats
        kernelSources
        { produced.execution.eliminationExecution.normalization.validationContext
          with env :=
            produced.execution.eliminationExecution.normalization.familyEnv } =
      .ok () :=
  produced.execution.eliminationExecution.normalization.constructorValidation
    |>.traces.universeRun

/-- The family-suffix phase shared by resolved Stage-3 and pre-family replay
is forced by the retained family validator.  Every family candidate carries
the accepted parameter-prefix bound, so collecting its exact
parameter-instantiated view cannot fail.  The remaining pre-family
obligation is therefore only the constructor traversal over these suffixes. -/
theorem ProducedBlockRecursorShapeCandidate.resolvedFamilySuffixRun
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context) :
    ∃ suffixes :
        AddInductive.ConstructorBlockResolvedFamilyParameterSuffixes
          produced.execution.eliminationExecution.normalization.stats
          produced.candidate.families,
      AddInductive.ConstructorBlockResolvedFamilyParameterSuffixes.build
          produced.execution.eliminationExecution.normalization.stats
          produced.candidate.families = .ok suffixes := by
  let normalization :=
    produced.execution.eliminationExecution.normalization
  have normalizationProduced :=
    produced.execution.normalization_run produced.producedExecution
  have familyRun := normalization.familyValidationResult_run
    normalizationProduced
  have paramsSize : normalization.stats.params.size = source.nparams := by
    have sizes := normalization.familyValidationResult.sizes_of_run
      produced.kernelSources_nonempty familyRun
    simpa only [normalization,
      AddInductive.NormalizationCandidateExecution.familyValidationResult]
      using sizes.1
  exact
    AddInductive.ConstructorBlockResolvedFamilyParameterSuffixes.build_ok_of_parameterSpines
      normalization.familyParameterSpines paramsSize

/-- All executable constructor and recursor audits attached to one already
retained recursor-shape producer.  Unlike
`ProducedBlockRecursorStage3Candidate`, this package does not select or
rebuild the producer; its dependent index is the caller's exact value. -/
structure ProducedBlockRecursorStage3AuditRun
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    (Us : List Name) : Type where
  alignmentRun :
    AddInductive.ConstructorBlockCandidateAlignmentTrace.check
      (produced.execution.eliminationExecution.normalization
        |>.constructorValidation.traces)
      produced.candidate.families = .ok ()
  stage3Run :
    AddInductive.ConstructorBlockStage3SafetyTraces.check
      produced.execution.eliminationExecution.normalization.stats
      Us source.uvars produced.candidate.families = .ok ()
  preFamilyRun :
    AddInductive.checkConstructorMutualBlockPreFamilySafety
      produced.execution.eliminationExecution.normalization.stats
      produced.execution.eliminationExecution.normalization.validationContext
      produced.candidate.families = .ok ()
  rawParameterPreFamilyRun :
    AddInductive.ConstructorCandidateRawParameterPreFamilyBlockTrace.check
      produced.execution.eliminationExecution.normalization.stats
      produced.execution.eliminationExecution.normalization.validationContext
      produced.candidate.families = .ok ()
  sourceRawParameterPreFamilyRun :
    AddInductive.ConstructorRawParameterPreFamilyBlockTrace.check
      produced.execution.eliminationExecution.normalization.stats
      produced.execution.eliminationExecution.normalization.validationContext
      kernelSources = .ok ()
  universeRun :
    AddInductive.checkConstructorBlockUniverseSemantics
      produced.execution.eliminationExecution.normalization.stats
      kernelSources
      { produced.execution.eliminationExecution.normalization.validationContext
        with env :=
          produced.execution.eliminationExecution.normalization.familyEnv } =
        .ok ()
  recUniverseRun :
    AddInductive.checkBlockRecursorUniverseSemantics source.uvars
      produced.execution.eliminationExecution = .ok ()

/-- Execute the proof-relevant Stage-3 audits against the exact retained
producer.  No normalization or recursor producer is rerun; success merely
packages the six checker equations selected by these matches. -/
def ProducedBlockRecursorShapeCandidate.auditStage3?
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    (Us : List Name) :
    Except Exception (ProducedBlockRecursorStage3AuditRun produced Us) :=
  match alignmentRun :
      AddInductive.ConstructorBlockCandidateAlignmentTrace.check
        (produced.execution.eliminationExecution.normalization
          |>.constructorValidation.traces)
        produced.candidate.families with
  | .error error => .error error
  | .ok () =>
      match stage3Run :
          AddInductive.ConstructorBlockStage3SafetyTraces.check
            produced.execution.eliminationExecution.normalization.stats
            Us source.uvars produced.candidate.families with
      | .error error => .error error
      | .ok () =>
          match preFamilyRun :
              AddInductive.checkConstructorMutualBlockPreFamilySafety
                produced.execution.eliminationExecution.normalization.stats
                produced.execution.eliminationExecution.normalization.validationContext
                produced.candidate.families with
          | .error error => .error error
          | .ok () =>
              match rawParameterPreFamilyRun :
                  AddInductive.ConstructorCandidateRawParameterPreFamilyBlockTrace.check
                    produced.execution.eliminationExecution.normalization.stats
                    produced.execution.eliminationExecution.normalization.validationContext
                    produced.candidate.families with
              | .error error => .error error
              | .ok () =>
                  match sourceRawParameterPreFamilyRun :
                      AddInductive.ConstructorRawParameterPreFamilyBlockTrace.check
                        produced.execution.eliminationExecution.normalization.stats
                        produced.execution.eliminationExecution.normalization.validationContext
                        kernelSources with
                  | .error error => .error error
                  | .ok () =>
                      match universeRun :
                          AddInductive.checkConstructorBlockUniverseSemantics
                            produced.execution.eliminationExecution.normalization.stats
                            kernelSources
                            { produced.execution.eliminationExecution.normalization.validationContext
                              with env :=
                                produced.execution.eliminationExecution.normalization.familyEnv } with
                      | .error error => .error error
                      | .ok () =>
                          match recUniverseRun :
                              AddInductive.checkBlockRecursorUniverseSemantics
                                source.uvars
                                produced.execution.eliminationExecution with
                          | .error error => .error error
                          | .ok () => .ok {
                              alignmentRun
                              stage3Run
                              preFamilyRun
                              rawParameterPreFamilyRun
                              sourceRawParameterPreFamilyRun
                              universeRun
                              recUniverseRun }

