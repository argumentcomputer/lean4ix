/-- Every accepted resolved audit constructs its family targets and complete
constructor endpoint matrix directly.  This is the first producer boundary
with no `ResolvedProjectionNamesSafe` argument. -/
theorem
    ProducedBlockRecursorShapeCandidate.CanonicalFamilyAssemblySupport.canonicalResolvedConstructorEndpointRuns
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {context_lctx_eq : context.lctx = {}}
    (support : produced.CanonicalFamilyAssemblySupport semantic
      context_lctx_eq)
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (safetyEq :
      produced.execution.eliminationExecution.normalization.validationContext.safety =
        context.safety)
    (audit : ProducedBlockRecursorResolvedCoreAuditRun produced Us) :
    Nonempty (produced.CanonicalResolvedConstructorEndpointRuns semantic
      context_lctx_eq support) := by
  let normalization :=
    produced.execution.eliminationExecution.normalization
  let params := blockParams source.nparams semantic.families.views
  let spineInventory := Classical.choice
    (ConstructorRawPreFamilyParameterAuditBasis.constructorSpineSemanticState
      (produced := produced) (semantic := semantic) support.basis stagingInput
        safetyEq)
  let parameterSuffixes := Classical.choice spineInventory.parameterSuffixes
  let validationFields := Classical.choice spineInventory.validationFields
  let familySuffixes := Classical.choose produced.resolvedFamilySuffixRun
  have henv : env.WF := by
    simpa only [support.basis.contextRun.venv_eq] using
      support.basis.contextRun.candidate.context.Ewf
  have hblockEnv : blockEnv.WF := by
    simpa only [spineInventory.contextRun.venv_eq] using
      spineInventory.contextRun.candidate.context.Ewf
  have addType : env ≤ blockEnv :=
    VEnv.stageInductiveTypes_le stagingInput.stage
  have paramsLength : params.length = source.nparams :=
    produced.semanticViewParams_length semantic context_lctx_eq
  have referenceWF : VLCtx.WF env Us.length
      support.basis.alignment.reference :=
    (support.basis.alignment.current_reference.symm henv.ordered).wf
  have rawParameterWF : VLCtx.WF env Us.length
      support.basis.parameterDelta :=
    support.basis.alignment.root_reference_lift.wf henv referenceWF
  have storedFirst : TypeChecker.TelDefEqEvidence env Us.length []
      support.basis.storedTypes
      (VExpr.telN source.nparams support.firstView) := by
    rw [← support.params_eq]
    exact support.basis.storedCanonical
  obtain ⟨viewParameterDelta, viewParameterContext, viewRelation,
      viewUnique, viewParameterWF⟩ :=
    support.basis.params.retypeExact henv storedFirst rawParameterWF
  have canonicalParameterContext := viewParameterContext
  rw [← support.basis.parameterSources_eq] at canonicalParameterContext
  have blockParameterContext := canonicalParameterContext
  rw [← support.params_eq] at blockParameterContext
  obtain ⟨preFamilyTrace⟩ :=
    AddInductive.ConstructorMutualBlockResolvedPreFamilySafetyTrace.nonempty_of_check
      audit.preFamilyRun
  have preFamilySuffixesEq : preFamilyTrace.suffixes.values =
      familySuffixes.values :=
    preFamilyTrace.suffixes.values_eq familySuffixes
  have preFamilyFamilies :
      AddInductive.ConstructorMutualBlockPreFamilyTraces normalization.stats
        familySuffixes.values normalization.validationContext (owner := 0)
        produced.candidate.families := by
    rw [← preFamilySuffixesEq]
    exact preFamilyTrace.families
  obtain ⟨preFamilyRuns⟩ :=
    AddInductive.ConstructorMutualBlockPreFamilySemanticRuns.nonempty
      support.basis.contextRun semantic.families preFamilyFamilies
  have familyTargets : ResolvedFamilyTargetTranslationState env Us
      source.nparams params viewParameterDelta semantic.families
      familySuffixes :=
    ResolvedFamilyTargetTranslationState.ofSemantics semantic.families
      familySuffixes support.parameterDefEqs
      canonicalParameterContext henv viewParameterWF paramsLength
      normalization.familyTerminalSorts normalization.generationSpines
  obtain ⟨d3ViewContext, d3ViewExtension, d3ReferenceRelation,
      d3ReferenceUnique, d3ViewWF⟩ :=
    support.basis.alignment.root_reference_lift.retypeSourceExact henv
      referenceWF viewRelation viewUnique viewParameterWF
  have commonNoBV : viewParameterDelta.NoBV := by
    exact
      (VInductDecl.TypeChecker.CandidateParameterContext.fvarLamOnly
        viewParameterContext .nil).noBV
  let d3State : ConstructorValidation.D3FullContextState env blockEnv Us
      normalization.validationContext viewParameterDelta viewParameterDelta
      support.basis.contextRun.candidate.context.vlctx d3ViewContext .refl
      support.basis.alignment.rootLift := {
    commonWF := viewParameterWF
    commonNoBV := commonNoBV
    fullWF := viewParameterWF.mono addType
    fullExtension := .refl
    actualWF := support.basis.alignment.current_reference.wf
    viewDefEq := support.basis.alignment.current_reference.trans' henv
      d3ReferenceRelation
    viewUnique := support.basis.alignment.current_unique.trans'
      d3ReferenceUnique
    viewExtension := d3ViewExtension
    freshInvariant := by
      intro fv present
      exact .inl present }
  have canonicalStored :=
    (support.basis.storedCanonical.symm henv trivial).mono addType
  have constructorParameters :=
    spineInventory.constructorParameters.precompose canonicalStored hblockEnv
  have shapes := semantic.generationShapes produced.shape
  have headersEq := semantic.families.familyHeaders_canonicalize shapes
    normalization.familyParameterSpines normalization.familyTerminalSorts
    paramsLength
  have normalizationProduced :=
    produced.execution.normalization_run produced.producedExecution
  have familyRun := normalization.familyValidationResult_run
    normalizationProduced
  have constants := semantic.families.rawFamilyConstantInventory
    produced.kernelSources_nonempty familyRun
  have indConstsSize : normalization.stats.indConsts.size =
      kernelSources.length := by
    have sizes := normalization.familyValidationResult.sizes_of_run
      produced.kernelSources_nonempty familyRun
    simpa only [normalization,
      AddInductive.NormalizationCandidateExecution.familyValidationResult]
      using sizes.2.2
  have viewLength : semantic.families.views.length = kernelSources.length := by
    have namesLength := congrArg List.length
      semantic.families.viewHeaderNames.1
    simpa using namesLength
  have canonicalLength :
      (canonicalizeFamilyParamsList source.nparams params
        semantic.families.views).length = normalization.stats.indConsts.size := by
    calc
      _ = semantic.families.views.length := by
        simp only [canonicalizeFamilyParamsList, List.length_map]
      _ = kernelSources.length := viewLength
      _ = normalization.stats.indConsts.size := indConstsSize.symm
  have rawFamilyData := support.indexCounts.familyData canonicalLength
    headersEq constants
  have canonicalHeadersEq :
      familyHeaders semantic.canonicalNormalization.view.nparams
          semantic.canonicalNormalization.view.types =
        familyHeaders source.nparams source.types := by
    simpa only [NormalizationCandidateBlockSemanticRun.canonicalNormalization,
      Normalization.canonicalizeSharedParams,
      VInductDecl.canonicalizeSharedParams,
      NormalizationCandidateBlockSemanticRun.normalization,
      NormalizationCandidateBlockSemanticRun.viewDecl, params] using
      headersEq.symm
  have familyData : ∀ familyIdx,
      familyIdx < normalization.stats.indConsts.size →
      ∃ header,
        (familyHeaders semantic.canonicalNormalization.view.nparams
          semantic.canonicalNormalization.view.types)[familyIdx]? =
            some header ∧
        normalization.stats.indConsts[familyIdx]! =
          .const header.name normalization.stats.levels ∧
        normalization.stats.nindices[familyIdx]! = header.indices := by
    intro familyIdx familyIdxLt
    obtain ⟨header, headerAt, headerIndices, constant⟩ :=
      rawFamilyData familyIdx familyIdxLt
    exact ⟨header, by rw [canonicalHeadersEq]; exact headerAt,
      constant, headerIndices⟩
  have targets : ConstructorValidation.ResolvedMutualFamilyTargetState env
      blockEnv Us normalization.stats
      (familyHeaders semantic.canonicalNormalization.view.nparams
        semantic.canonicalNormalization.view.types)
      familySuffixes.values
      (canonicalFamilyIndexLists source.nparams params
        semantic.families.views)
      viewParameterDelta viewParameterDelta 0 .refl :=
    familyTargets.mutualTargetState addType support.indexCounts
      canonicalLength familyData
  have familyHeads : ∀ {familyOwner : Nat} {ownerSuffix : Expr},
      familySuffixes.values[familyOwner]? = some ownerSuffix →
        ∃ familyName familyLevels,
          normalization.stats.indConsts[familyOwner]! =
            .const familyName familyLevels := by
    intro familyOwner ownerSuffix ownerAt
    obtain ⟨_baseIndices, _currentIndices, _level, _familyTarget, header,
        _baseAt, _headerAt, familyHead, _headerIndices, _indexLength,
        _commonTr, _fullTr, _familyTargetEq, _familyLiftEq⟩ := targets ownerAt
    exact ⟨header.name, normalization.stats.levels, familyHead⟩
  obtain ⟨preFamilyResidual⟩ := preFamilyRuns.afterParameters
    familySuffixes parameterSuffixes (by simp) familyHeads
  have sourceUvars : semantic.canonicalNormalization.view.uvars =
      Us.length := by
    simpa only [NormalizationCandidateBlockSemanticRun.canonicalNormalization,
      Normalization.canonicalizeSharedParams,
      VInductDecl.canonicalizeSharedParams,
      NormalizationCandidateBlockSemanticRun.normalization,
      NormalizationCandidateBlockSemanticRun.viewDecl] using semantic.uvars_eq
  have sourceNparams : semantic.canonicalNormalization.view.nparams =
      normalization.stats.params.size := by
    simpa only [NormalizationCandidateBlockSemanticRun.canonicalNormalization,
      Normalization.canonicalizeSharedParams,
      VInductDecl.canonicalizeSharedParams,
      NormalizationCandidateBlockSemanticRun.normalization,
      NormalizationCandidateBlockSemanticRun.viewDecl] using
      spineInventory.params_size.symm
  have resultLevelTr :=
    produced.canonicalResultLevel_eq semantic context_lctx_eq
  have executionLevelsTr :=
    produced.execution.stage3LevelsTranslation produced.producedExecution
      produced.kernelSources_nonempty
  have contextLparams : context.lparams = Us := by
    have validationLparams :=
      normalization.validationContext_lparams_all normalizationProduced
    exact validationLparams.symm.trans stagingInput.validation_lparams_eq
  have canonicalLevelsTr :
      normalization.stats.levels.mapM (VLevel.ofLevel Us) =
        some (VLevel.params Us.length) := by
    simpa only [contextLparams] using executionLevelsTr
  have familyFresh : ∀ name,
      name ∈ familyNames semantic.canonicalNormalization.view.types →
      env.constants name = none :=
    semantic.canonicalFamilyNames_fresh
  have canonicalNamesEq :
      familyNames semantic.canonicalNormalization.view.types =
        familyNames source.types := by
    have viewRawNames : familyNames semantic.families.views =
        familyNames source.types := by
      simpa only [familyNames] using
        semantic.families.viewHeaderNames.1.trans
          semantic.families.rawHeaderNames.1.symm
    simpa only [NormalizationCandidateBlockSemanticRun.canonicalNormalization,
      Normalization.canonicalizeSharedParams,
      VInductDecl.canonicalizeSharedParams,
      NormalizationCandidateBlockSemanticRun.normalization,
      NormalizationCandidateBlockSemanticRun.viewDecl, params,
      familyNames_canonicalizeFamilyParamsList] using viewRawNames
  have validationMapWF : normalization.validationContext.env.constants.WF := by
    rw [normalization.validationContext_env_all normalizationProduced]
    exact stagingInput.preMapWF
  have generatedNodup := produced.semanticGeneratedNames_nodup semantic
    validationMapWF
  have rawFamilyNodup : (familyNames source.types).Nodup := by
    rw [blockGeneratedNames, List.nodup_append] at generatedNodup
    rw [List.nodup_append] at generatedNodup
    simpa only [familyNames] using generatedNodup.1.1
  have familyNodup :
      (familyNames semantic.canonicalNormalization.view.types).Nodup := by
    rw [canonicalNamesEq]
    exact rawFamilyNodup
  obtain ⟨selected, fieldSorts, endpointRuns, selectedTypes, familyAlignment,
      selectedFamilyParameters, selectedConstructorParameters,
      selectedFieldCounts, computed⟩ :=
    semantic.families.resolvedBlockConstructorEndpoints_structural
      (source := semantic.canonicalNormalization.view) familySuffixes
      parameterSuffixes preFamilyResidual validationFields
      constructorParameters support.parameterDefEqs
      henv hblockEnv addType blockParameterContext viewParameterWF d3State
      targets rfl rfl sourceUvars sourceNparams resultLevelTr
      canonicalLevelsTr familyFresh familyNodup
  have fieldSortsSome :
      normalization.constructorValidation.traces.fieldSorts? Us |>.isSome := by
    rw [computed]
    rfl
  have fieldSortsEq :
      (normalization.constructorValidation.traces.fieldSorts? Us).get
          fieldSortsSome = fieldSorts :=
    Option.some.inj ((Option.some_get fieldSortsSome).trans computed)
  have coherentEndpoints :
      ∃ runs : ResolvedBlockConstructorEndpointRunList
          semantic.canonicalNormalization.view env blockEnv Us
          (produced.canonicalResultLevel semantic context_lctx_eq)
          (canonicalFamilyIndexLists source.nparams params
            semantic.families.views)
          params viewParameterDelta 0 parameterSuffixes.values
          fieldSorts,
        List.Forall₂ (fun family endpoints =>
          List.Forall₂ (fun constructor endpoint =>
            constructor.type = VExpr.forallN params endpoint)
            family.ctors endpoints)
          (canonicalizeFamilyParamsList
            semantic.canonicalNormalization.view.nparams params selected.views)
          runs.endpoints :=
    ⟨endpointRuns, selectedTypes⟩
  rw [← fieldSortsEq] at coherentEndpoints
  obtain ⟨endpointRuns, selectedTypes⟩ := coherentEndpoints
  refine ⟨{
    parameterΔ := viewParameterDelta
    parameterSuffixes := parameterSuffixes
    selectedFamilies := selected
    familyAlignment := familyAlignment
    familyParameters := by simpa only using selectedFamilyParameters
    constructorParameters := by simpa only [params] using
      selectedConstructorParameters
    fieldCounts := selectedFieldCounts
    fieldSorts_isSome := fieldSortsSome
    runs := endpointRuns
    endpointTypes := by simpa only [params] using selectedTypes }⟩

/-- Constructor replay consequences consumed by checked-block WF and
generation.  The package is indexed by the trace-independent semantic
evidence and by the exact checked-family value selected from it.  A future
projection-aware replay producer therefore has one output contract; no
downstream consumer needs to know which executable trace established it. -/
structure
    ProducedBlockRecursorShapeCandidate.CanonicalConstructorReplayEvidence
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {context_lctx_eq : context.lctx = {}}
    (support : produced.CanonicalFamilyAssemblySupport semantic
      context_lctx_eq)
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (safetyEq :
      produced.execution.eliminationExecution.normalization.validationContext.safety =
        context.safety)
    (evidence : produced.CanonicalConstructorSemanticEvidence semantic) :
    Prop where
  constructors : Nonempty (CheckedBlockConstructorRunList env
    (produced.canonicalResultLevel semantic context_lctx_eq)
    (support.canonicalCheckedFamiliesOfEvidence stagingInput safetyEq
      evidence).indices
    (support.canonicalCheckedFamiliesOfEvidence stagingInput safetyEq
      evidence))
  fieldSorts_isSome :
    let validation :=
      produced.execution.eliminationExecution.normalization
        |>.constructorValidation.traces
    (validation.fieldSorts? Us).isSome
  fieldSortTelescopes :
    let validation :=
      produced.execution.eliminationExecution.normalization
        |>.constructorValidation.traces
    ∀ success : (validation.fieldSorts? Us).isSome,
      CheckedBlockFieldSortTelescopes blockEnv Us.length
        (blockParams source.nparams semantic.families.views)
        (support.canonicalCheckedFamiliesOfEvidence stagingInput safetyEq
          evidence)
        ((validation.fieldSorts? Us).get success)

/-- Complete constructor-side contract of a projection-aware accepted audit.
The evidence and replay fields are dependent, so the checked-family value
cannot be selected twice or mismatched.  This is the sole unresolved producer
obligation at the ordinary semantic-recursor boundary. -/
structure
    ProducedBlockRecursorShapeCandidate.CanonicalResolvedConstructorCertificate
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {context_lctx_eq : context.lctx = {}}
    (support : produced.CanonicalFamilyAssemblySupport semantic
      context_lctx_eq)
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (safetyEq :
      produced.execution.eliminationExecution.normalization.validationContext.safety =
        context.safety) : Prop where
  evidence : produced.CanonicalConstructorSemanticEvidence semantic
  replay : produced.CanonicalConstructorReplayEvidence support stagingInput
    safetyEq evidence

/-- Construction-owned endpoints discharge the complete replay contract for
the selected semantic hierarchy, without projection-safety provenance. -/
theorem
    ProducedBlockRecursorShapeCandidate.CanonicalResolvedConstructorEndpointRuns.selectedConstructorReplayEvidence
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {context_lctx_eq : context.lctx = {}}
    {support : produced.CanonicalFamilyAssemblySupport semantic
      context_lctx_eq}
    (endpoints : produced.CanonicalResolvedConstructorEndpointRuns semantic
      context_lctx_eq support)
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (safetyEq :
      produced.execution.eliminationExecution.normalization.validationContext.safety =
        context.safety) :
    produced.CanonicalConstructorReplayEvidence
      endpoints.selectedFamilyAssemblySupport stagingInput safetyEq
      endpoints.selectedConstructorSemanticEvidence := by
  let selectedSupport := endpoints.selectedFamilyAssemblySupport
  let evidence := endpoints.selectedConstructorSemanticEvidence
  let checked := selectedSupport.canonicalCheckedFamiliesOfEvidence
    stagingInput safetyEq evidence
  have indicesEq :
      canonicalFamilyIndexLists source.nparams
          (blockParams source.nparams endpoints.selectedFamilies.views)
          endpoints.selectedFamilies.views = checked.indices := by
    exact checked.indices_eq_canonicalFamilyIndexLists.symm
  have indicesDrop :
      (canonicalFamilyIndexLists source.nparams
        (blockParams source.nparams endpoints.selectedFamilies.views)
        endpoints.selectedFamilies.views).drop 0 = checked.indices := by
    simpa only [List.drop_zero] using indicesEq
  obtain ⟨_stage3, constructorRuns, fieldSortTelescopes⟩ :=
    endpoints.selectedRuns.canonicalReplay endpoints.selectedParams_length
      checked endpoints.selectedRuns_alignment indicesDrop
  refine {
    constructors := ?_
    fieldSorts_isSome := endpoints.fieldSorts_isSome
    fieldSortTelescopes := ?_ }
  · change Nonempty (CheckedBlockConstructorRunList env
      (produced.canonicalResultLevel endpoints.selectedSemantic
        context_lctx_eq) checked.indices checked)
    rw [indicesEq] at constructorRuns
    exact constructorRuns
  · dsimp only
    intro success
    change CheckedBlockFieldSortTelescopes blockEnv Us.length
      (blockParams source.nparams endpoints.selectedFamilies.views) checked
      ((produced.execution.eliminationExecution.normalization
        |>.constructorValidation.traces.fieldSorts? Us).get success)
    simpa only using fieldSortTelescopes

/-- The resolved audit therefore owns a complete constructor certificate for
its construction-selected semantic interpretation. -/
theorem
    ProducedBlockRecursorShapeCandidate.CanonicalResolvedConstructorEndpointRuns.selectedResolvedConstructorCertificate
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
