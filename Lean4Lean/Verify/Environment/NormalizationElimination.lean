    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion.RemainingFamilyValidationCursor.contextRun_fuel_eq
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
