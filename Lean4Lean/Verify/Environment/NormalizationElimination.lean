  obtain ⟨preFamilyTrace⟩ :=
    AddInductive.ConstructorMutualBlockPreFamilySafetyTrace.nonempty_of_check
      preFamilyRun
  obtain ⟨preFamilyRuns⟩ :=
    AddInductive.ConstructorMutualBlockPreFamilySemanticRuns.nonempty
      preFamilyContextRun semantic.families preFamilyTrace.families
  let preFamily : AddInductive.ConstructorMutualBlockPreFamilySemanticState
      env blockEnv Us normalization.stats semantic.families := {
    context := normalization.validationContext
    contextRun := preFamilyContextRun
    trace := preFamilyTrace
    runs := preFamilyRuns }
  let preFamilyAlignment : ConstructorSharedParameterContextAlignment env Us
      completion.prefixes.firstParameterΔ preFamily.contextRun := {
    reference := reference
    rootLift := rootLift
    root_reference_lift := rootReferenceLift
    current_reference := currentReference
    current_unique := currentUnique }
  have parameterDefEqs :=
    completion.viewParameterTelescopeDefEqList context_lctx_eq
  let checked := completion.canonicalCheckedFamilies context_lctx_eq
