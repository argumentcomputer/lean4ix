/-- Build the coherent projection-aware pre-family translation state from a
shape-neutral parameter basis and exact constructor semantics.  No family
suffix uniqueness proposition occurs in the result. -/
theorem
    ProducedBlockRecursorShapeCandidate.CanonicalFamilyAssemblySupport.canonicalResolvedPreFamilyTranslationState
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {context_lctx_eq : context.lctx = {}}
    (support : produced.CanonicalFamilyAssemblySupport semantic
      context_lctx_eq)
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (safetyEq :
      produced.execution.eliminationExecution.normalization.validationContext.safety =
        context.safety)
    (audit : ProducedBlockRecursorResolvedCoreAuditRun produced Us)
    (evidence : produced.CanonicalConstructorSemanticEvidence semantic) :
    Nonempty (CandidateBlockResolvedMutualPreFamilyTranslationState env
      blockEnv Us produced.execution.eliminationExecution.normalization.stats
      source.nparams support.firstView
      (blockParams source.nparams semantic.families.views)
      semantic.canonicalNormalization.view support.basis.parameterDelta
      { produced.execution.eliminationExecution.normalization.validationContext
        with env :=
          produced.execution.eliminationExecution.normalization.familyEnv }
      semantic.families
      (support.canonicalCheckedFamiliesOfEvidence stagingInput safetyEq
        evidence)
      support.parameterDefEqs) := by
  let normalization :=
    produced.execution.eliminationExecution.normalization
  have henv : env.WF := by
    simpa only [support.basis.contextRun.venv_eq] using
      support.basis.contextRun.candidate.context.Ewf
  have referenceWF : VLCtx.WF env Us.length
      support.basis.alignment.reference :=
    (support.basis.alignment.current_reference.symm henv.ordered).wf
  have parameterWF : VLCtx.WF env Us.length
      support.basis.parameterDelta :=
    support.basis.alignment.root_reference_lift.wf henv referenceWF
  have storedFirst : TypeChecker.TelDefEqEvidence env Us.length []
      support.basis.storedTypes
      (VExpr.telN source.nparams support.firstView) := by
    rw [← support.params_eq]
    exact support.basis.storedCanonical
  obtain ⟨viewParameterDelta, viewParameterContext, viewRelation,
      viewUnique, viewParameterWF⟩ :=
    support.basis.params.retypeExact henv storedFirst parameterWF
  have canonicalParameterContext := viewParameterContext
  rw [← support.basis.parameterSources_eq] at canonicalParameterContext
  obtain ⟨preFamilyTrace⟩ :=
    AddInductive.ConstructorMutualBlockResolvedPreFamilySafetyTrace.nonempty_of_check
      audit.preFamilyRun
  obtain ⟨preFamilyRuns⟩ :=
    AddInductive.ConstructorMutualBlockPreFamilySemanticRuns.nonempty
      support.basis.contextRun semantic.families preFamilyTrace.families
  let preFamily :
      AddInductive.ConstructorMutualBlockResolvedPreFamilySemanticState env
        blockEnv Us normalization.stats semantic.families := {
    context := normalization.validationContext
    contextRun := support.basis.contextRun
    trace := preFamilyTrace
    runs := preFamilyRuns }
  let checked := support.canonicalCheckedFamiliesOfEvidence stagingInput
    safetyEq evidence
  obtain ⟨translations⟩ :=
    CandidateBlockResolvedFamilySuffixTranslationList.nonempty
      semantic.families preFamily.trace.suffixes checked
      support.parameterDefEqs canonicalParameterContext henv viewParameterWF
      (produced.semanticViewParams_length semantic context_lctx_eq)
  exact ⟨{
    preFamily := preFamily
    parameterΔ := viewParameterDelta
    params_eq := support.params_eq
    parameterContext := canonicalParameterContext
    parameterRelation := viewRelation
    parameterUnique := viewUnique
    parameterWF := viewParameterWF
    preFamily_ngen_eq := rfl
    preFamilyAlignment := support.basis.alignment
    translations := translations }⟩

