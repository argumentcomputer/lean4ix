/-- The completed family traversal and one exact Stage-3 audit construct the
dependency-stage parameter-prefix inventory for every retained constructor
view.  The post-family environment appears only in strict translations used
to identify endpoints; the resulting telescope equalities are all judgments
of the original dependency environment. -/
theorem
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion.preFamilyConstructorParameterDefEqListsOfAudit
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {staging : produced.SecondFamilyIndexStaging semantic}
    {raw : Option staging.annotation.RawFirstIndexDomain}
    (completion : staging.TerminalIndexDomainCompletion raw)
    (context_lctx_eq : context.lctx = {})
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (audit : ProducedBlockRecursorStage3AuditRun produced Us) :
    CandidateBlockConstructorPreFamilyParameterDefEqLists env blockEnv Us
      source.nparams
      (VExpr.telN source.nparams
        staging.annotation.firstSemantic.type.view)
      semantic.families := by
  obtain ⟨terminalRun, terminalVenv, terminalLparams, reference, rootLift,
      rootReferenceLift, currentReference, currentUnique⟩ :=
    completion.blockValidationParameterContextAlignment context_lctx_eq
  let contextRun : AddInductive.ConstructorContextRun env Us
      produced.execution.eliminationExecution.normalization.validationContext :=
    ⟨terminalRun, terminalVenv, terminalLparams⟩
  let alignment : ConstructorSharedParameterContextAlignment env Us
      completion.prefixes.firstParameterΔ contextRun := {
    reference := reference
    rootLift := rootLift
    root_reference_lift := rootReferenceLift
    current_reference := currentReference
    current_unique := currentUnique }
  obtain ⟨localState, parameterSourcesEq, paramsSize⟩ :=
    completion.blockValidationLocalStateExact context_lctx_eq
  obtain ⟨stage⟩ :=
    AddInductive.ConstructorBlockStage3SafetyTraces.nonempty_of_check
      audit.stage3Run
  obtain ⟨auditTrace, ⟨auditSemantic⟩⟩ :=
    audit.rawParameterPreFamilySemanticRuns contextRun
  obtain ⟨validationRun, validationVenv, validationLparams⟩ :=
    completion.constructorValidationContextRun context_lctx_eq stagingInput
  have hblockEnv : VEnv.WF blockEnv := by
    simpa only [validationVenv] using validationRun.context.Ewf
  have henv : VEnv.WF env := by
    simpa only [terminalVenv] using terminalRun.context.Ewf
  have stored := semantic.families.preFamilyParameterDefEqLists stage
    auditSemantic completion.firstParameterContext localState alignment
    parameterSourcesEq paramsSize
    (VEnv.stageInductiveTypes_le stagingInput.stage) hblockEnv
  exact stored.postcompose
    (staging.firstStoredViewParameterTelescopeDefEq context_lctx_eq) henv

