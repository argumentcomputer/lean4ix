/-- Generic annotation ownership at the first semantic family of any
nonempty producer.  Unlike `SecondFamilyAnnotationSpine`, this package does
not assume that a later family exists: it retains the complete source-order
shape and annotation spines and exposes their canonical head. -/
structure ProducedBlockRecursorShapeCandidate.FirstFamilyAnnotationSpine
    {source : VInductDecl}
    {firstSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: remainingSources) numNested isUnsafe context)
    {env blockEnv : VEnv} {Us : List Name}
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source) where
  generationShapes : CandidateBlockFamilySemanticGenerationShapeList source
    env blockEnv Us semantic.families
  validationAnnotations : CandidateFamilyValidationAnnotationList
    { context with lctx := {} } produced.candidate.families
  annotations : CandidateBlockFamilyAnnotationSpineList source env blockEnv
    Us semantic.families generationShapes

/-- Construct the first-family annotation owner from the exact semantic
hierarchy and the validator-produced family annotation inventory. -/
theorem
    ProducedBlockRecursorShapeCandidate.semanticFirstFamilyAnnotationSpine
    {source : VInductDecl}
    {firstSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: remainingSources) numNested isUnsafe context)
    {env blockEnv : VEnv} {Us : List Name}
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source) :
    Nonempty (produced.FirstFamilyAnnotationSpine semantic) := by
  let normalization :=
    produced.execution.eliminationExecution.normalization
  have familyTypesProduced := normalization.familyTypes.produced
  rw [← normalization.families.produced.familyTypes_eq]
    at familyTypesProduced
  have terminals := normalization.familyTerminals
  rw [← normalization.families.produced.familyTypes_eq] at terminals
  have validationAnnotations :=
    CandidateFamilyValidationAnnotationList.ofProduced
      normalization.families.candidates familyTypesProduced terminals
  have shapes := semantic.generationShapes produced.shape
  obtain ⟨annotations⟩ :=
    CandidateBlockFamilyAnnotationSpineList.exists semantic.families shapes
      validationAnnotations
  exact ⟨{
    generationShapes := shapes
    validationAnnotations := validationAnnotations
    annotations := annotations }⟩

