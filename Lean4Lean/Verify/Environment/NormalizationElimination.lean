private theorem list_all_mem_stage3
    (all : List.All predicate values) :
    ∀ value ∈ values, predicate value := by
  induction values with
  | nil => intro value member; nomatch member
  | cons head tail ih =>
      intro value member
      rcases List.mem_cons.mp member with rfl | member
      · exact all.1
      · exact ih all.2 value member

private theorem list_all_of_mem
    (all : ∀ value ∈ values, predicate value) : List.All predicate values := by
  induction values with
  | nil => trivial
  | cons head tail ih =>
      exact ⟨all head (.head _), ih (by
        intro value member
        exact all value (.tail _ member))⟩

private theorem list_getElem?_eq_some_of_drop_eq_cons
    {α : Type u} {values tail : List α} {index : Nat} {head : α}
    (dropped : values.drop index = head :: tail) :
    values[index]? = some head := by
  have atHead := congrArg (fun current => current[0]?) dropped
  simpa only [List.getElem?_drop, Nat.add_zero,
    List.getElem?_cons_zero] using atHead

private theorem list_drop_succ_eq_of_drop_eq_cons
    {α : Type u} {values tail : List α} {index : Nat} {head : α}
    (dropped : values.drop index = head :: tail) :
    values.drop (index + 1) = tail := by
  calc
    values.drop (index + 1) = (values.drop index).drop 1 := by
      rw [List.drop_drop]
    _ = tail := by simp only [dropped, List.drop_succ_cons, List.drop_zero]

/-- The validator-selected universe label for every checked constructor field,
grouped in the same family/constructor order as the dependent checked block. -/
def CheckedBlockFieldSortTelescopes
    (env : VEnv) (U : Nat) (params : List VExpr)
    {source : VInductDecl} {types : List VInductiveType} {ordinal : Nat}
    (checked : CheckedFamilies source params ordinal types)
    (fieldSorts : List (List (List VLevel))) : Prop :=
  List.Forall₂ (fun constructors constructorSorts =>
    List.Forall₂ (fun constructor sorts =>
      env.OnSortTel U params.reverse constructor.fields sorts)
      constructors constructorSorts)
    checked.constructors fieldSorts

/-- Looking up erased checked-family data and its constructor projection uses
the same source position. -/
theorem CheckedFamilies.constructors_getElem?_of_data
    {source : VInductDecl} {params : List VExpr} :
    ∀ {ordinal types} (families : CheckedFamilies source params ordinal types)
      {index : Nat} {family : CheckedFamilyData},
      families.data[index]? = some family →
        families.constructors[index]? = some family.constructors
  | _, _, .nil, index, _, found => by
      simp [CheckedFamilies.data] at found
  | _, _, .cons head tail, 0, family, found => by
      simp only [CheckedFamilies.data, CheckedFamilies.constructors,
        List.getElem?_cons_zero, Option.some.injEq] at found ⊢
      subst family
      rfl
  | _, _, .cons head tail, index + 1, family, found => by
      simp only [CheckedFamilies.data, CheckedFamilies.constructors,
        List.getElem?_cons_succ] at found ⊢
      exact CheckedFamilies.constructors_getElem?_of_data tail found

