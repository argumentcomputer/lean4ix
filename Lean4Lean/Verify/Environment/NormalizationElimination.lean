/-- The legacy projection-free audit remains a compatibility producer for
the trace-independent replay package.  Reducible semantic evidence ensures
that both sides are indexed by the identical checked-family value. -/
theorem
    ProducedBlockRecursorShapeCandidate.CanonicalFamilyAssemblySupport.canonicalConstructorReplayEvidenceFromAudit
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {context_lctx_eq : context.lctx = {}}
    (support : produced.CanonicalFamilyAssemblySupport semantic
      context_lctx_eq)
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (safetyEq :
      produced.execution.eliminationExecution.normalization.validationContext.safety =
        context.safety)
    (audit : ProducedBlockRecursorStage3AuditRun produced Us) :
    produced.CanonicalConstructorReplayEvidence support stagingInput safetyEq
      (support.canonicalConstructorSemanticEvidenceFromAudit stagingInput
        safetyEq audit) := by
  have replay := support.canonicalCheckedBlockConstructorRuns stagingInput
    safetyEq audit
  refine {
    constructors := ?_
    fieldSorts_isSome := replay.2.1
    fieldSortTelescopes := ?_
  }
  · simpa only [canonicalCheckedFamiliesOfEvidence,
      canonicalConstructorSemanticEvidenceFromAudit,
      ConstructorRawPreFamilyParameterAuditBasis.canonicalCheckedFamiliesOfStage3,
      canonicalCheckedFamilies,
      ConstructorRawPreFamilyParameterAuditBasis.canonicalCheckedFamilies]
      using replay.1
  · dsimp only
    intro success
    simpa only [canonicalCheckedFamiliesOfEvidence,
      canonicalConstructorSemanticEvidenceFromAudit,
      ConstructorRawPreFamilyParameterAuditBasis.canonicalCheckedFamiliesOfStage3,
      canonicalCheckedFamilies,
      ConstructorRawPreFamilyParameterAuditBasis.canonicalCheckedFamilies]
      using replay.2.2 success

