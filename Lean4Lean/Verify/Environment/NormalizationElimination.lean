/-- Execute only the raw host-parameter audit needed by nested restoration.
This is the narrow producer boundary for restored parameter layout; unlike
`auditStage3?`, it does not rerun unrelated candidate, universe, or recursor
checks. -/
def ProducedBlockRecursorShapeCandidate.rawHostParameterAudit?
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context) :
    Except Lean.Kernel.Exception
      (ProducedBlockRawHostParameterAuditRun produced) :=
  match run :
      AddInductive.ConstructorRawParameterPreFamilyBlockTrace.build
        produced.execution.eliminationExecution.normalization.stats
        produced.execution.eliminationExecution.normalization.validationContext
        kernelSources with
  | .error error => .error error
  | .ok trace => .ok ⟨trace, run⟩

/-- A complete Stage-3 audit proves success of the narrower executable
raw-host audit at the same dependent producer.  This theorem does not assert
proof equality between the two retained packages; it exposes the exact
successful `Except` branch, which is the stable computation boundary used by
outer environment staging. -/
theorem
    ProducedBlockRecursorStage3AuditRun.rawHostParameterAudit?_success
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {Us : List Name}
    (audit : ProducedBlockRecursorStage3AuditRun produced Us) :
    ∃ rawAudit : ProducedBlockRawHostParameterAuditRun produced,
      produced.rawHostParameterAudit? = .ok rawAudit := by
  have success := audit.sourceRawParameterPreFamilyRun
  unfold AddInductive.ConstructorRawParameterPreFamilyBlockTrace.check at success
  cases run : AddInductive.ConstructorRawParameterPreFamilyBlockTrace.build
      produced.execution.eliminationExecution.normalization.stats
      produced.execution.eliminationExecution.normalization.validationContext
      kernelSources with
  | error error =>
      rw [run] at success
      contradiction
  | ok trace =>
      refine ⟨⟨trace, run⟩, ?_⟩
      unfold ProducedBlockRecursorShapeCandidate.rawHostParameterAudit?
      split
      · simp_all
      · rename_i trace' run'
        have trace_eq : trace' = trace :=
          Except.ok.inj (run'.symm.trans run)
        subst trace'
        rfl

