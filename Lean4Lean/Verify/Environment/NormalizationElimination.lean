private theorem candidateContextRun_cast_context
    {left right : AddInductive.Context}
    (h : left = right)
    (run : TypeChecker.CandidateContextRun left) :
    (h ▸ run).context = run.context := by
  cases h
  rfl

private theorem list_map_fvar_injective :
    ∀ {left right : List FVarId},
      left.map Expr.fvar = right.map Expr.fvar → left = right := by
  intro left
  induction left with
  | nil =>
      intro right equality
      cases right
      · rfl
      · simp at equality
  | cons head tail ih =>
      intro right equality
      cases right with
      | nil => simp at equality
      | cons other rest =>
          simp only [List.map_cons, List.cons.injEq] at equality
          rw [Expr.fvar.inj equality.1, ih equality.2]

/-- A producer candidate with a nonempty retained main spine starts at a
stored Pi.  At positive recursion depth its root WHNF observation therefore
returns the source literally. -/
theorem _root_.Lean4Lean.AddInductive.CandidateExprTrace.rootWhnf_eq_source_of_spineLength_pos
    {candidateContext : AddInductive.Context} {source : Expr}
    (trace : AddInductive.CandidateExprTrace candidateContext source)
    (stored : trace.storedSpine = true)
    (positive : 0 < trace.spineLength)
    (recursionFuel : Nat)
    (depth : candidateContext.fuel.recDepth = recursionFuel + 1) :
    trace.rootWhnf = source := by
  cases trace with
  | terminal =>
      simp [AddInductive.CandidateExprTrace.spineLength] at positive
  | forallE context source inferred name domain body binderInfo fresh
      annotations annotationsEq checked normalized domainCandidate
      bodyCandidate =>
      simp only [AddInductive.CandidateExprTrace.storedSpine,
        Bool.and_eq_true] at stored
      exact AddInductive.CandidateWhnfStep.result_eq_of_source_isForall
        normalized recursionFuel depth
        (AddInductive.CandidateWhnfStep.isForall_of_structuralEq_forall
          stored.1)

/-- Instantiating a strict prefix of the producer-owned main-spine parameter
list reaches the exact recursive candidate selected by the corresponding
structural position.  The strict bound deliberately excludes the terminal
normalization node, whose WHNF result need not be its stored source. -/
theorem _root_.Lean4Lean.AddInductive.CandidateExprTrace.instantiateParameterList_mainSpine
    {candidateContext : AddInductive.Context} {source : Expr}
    {trace : AddInductive.CandidateExprTrace candidateContext source}
    {count : Nat}
    (position : trace.MainSpineAt count)
    (stored : trace.storedSpine = true)
    (remaining : count < trace.spineLength)
    (recursionFuel : Nat)
    (depth : candidateContext.fuel.recDepth = recursionFuel + 1) :
    AddInductive.instantiateFamilyParameters trace.rootWhnf
        (trace.parameterList count) =
      .ok position.position.trace.rootWhnf := by
  induction position generalizing recursionFuel with
  | zero trace => rfl
  | succ bodyCandidate position ih =>
      simp only [AddInductive.CandidateExprTrace.storedSpine,
        Bool.and_eq_true] at stored
      have tailPositive : 0 < bodyCandidate.spineLength := by
        simp only [AddInductive.CandidateExprTrace.spineLength,
          Nat.succ_lt_succ_iff] at remaining
        omega
      have bodyRoot :=
        bodyCandidate.rootWhnf_eq_source_of_spineLength_pos stored.2
          tailPositive recursionFuel (by
            simpa [AddInductive.Context.pushLocalDecl] using depth)
      simp only [AddInductive.CandidateExprTrace.rootWhnf,
        AddInductive.CandidateExprTrace.parameterList,
        AddInductive.instantiateFamilyParameters]
      have tailRun := ih stored.2 (by
        simpa only [AddInductive.CandidateExprTrace.spineLength,
          Nat.succ_lt_succ_iff] using remaining) recursionFuel (by
            simpa [AddInductive.Context.pushLocalDecl] using depth)
      exact (congrArg
        (fun expression => AddInductive.instantiateFamilyParameters expression
          (bodyCandidate.parameterList _)) bodyRoot.symm).trans (by
            simpa only [AddInductive.CandidateExprTrace.MainSpineAt.position,
              AddInductive.CandidateExprTrace.rootWhnf]
              using tailRun)

/-- Alpha-equivalent Pi roots remain alpha-equivalent after each side
instantiates its own source-ordered free-variable parameter telescope.  The
two telescopes may use different FVar identifiers and dependency metadata;
only their common length and the positional root abstraction matter. -/
theorem _root_.Lean4Lean.TypeChecker.CandidateParameterContext.instantiateAlpha
    {env : VEnv} {U : Nat}
    {leftBase rightBase leftFinal rightFinal : VLCtx}
    {leftParameters rightParameters : List Expr}
    {leftTypes rightTypes : List VExpr}
    (left : TypeChecker.CandidateParameterContext leftBase leftParameters
      leftTypes leftFinal)
    (right : TypeChecker.CandidateParameterContext rightBase rightParameters
      rightTypes rightFinal)
    (leftFinalWF : VLCtx.WF env U leftFinal)
    (rightFinalWF : VLCtx.WF env U rightFinal)
    (lengthEq : leftParameters.length = rightParameters.length)
    {leftSource rightSource leftRest rightRest : Expr}
    (leftScope : leftSource.FVarsIn (fun fv => fv ∈ leftBase.fvars))
    (rightScope : rightSource.FVarsIn (fun fv => fv ∈ rightBase.fvars))
    (sourceAlpha : Lean.Expr.abstractFVars leftBase leftSource =
      Lean.Expr.abstractFVars rightBase rightSource)
    (leftInstantiation : AddInductive.instantiateFamilyParameters leftSource
      leftParameters = .ok leftRest)
    (rightInstantiation : AddInductive.instantiateFamilyParameters rightSource
      rightParameters = .ok rightRest) :
    Lean.Expr.abstractFVars leftFinal leftRest =
      Lean.Expr.abstractFVars rightFinal rightRest := by
  induction left generalizing rightBase rightParameters rightTypes rightFinal
      right leftSource rightSource leftRest rightRest with
  | nil =>
      cases right with
      | nil =>
          have leftEq : leftSource = leftRest := Except.ok.inj (by
            change Except.ok leftSource = Except.ok leftRest at leftInstantiation
            exact leftInstantiation)
          have rightEq : rightSource = rightRest := Except.ok.inj (by
            change Except.ok rightSource = Except.ok rightRest at rightInstantiation
            exact rightInstantiation)
          subst leftRest
          subst rightRest
          exact sourceAlpha
      | cons tail => simp at lengthEq
  | @cons leftFv leftDeps leftA leftBase leftParameters leftTypes
      leftFinal leftTail ih =>
      cases right with
      | nil => simp at lengthEq
      | @cons rightFv rightDeps rightA rightBase rightParameters rightTypes
          rightFinal rightTail =>
          cases leftSource <;>
            simp only [AddInductive.instantiateFamilyParameters] at leftInstantiation
          case forallE leftName leftDomain leftBody leftBinderInfo =>
            cases rightSource <;>
              simp only [AddInductive.instantiateFamilyParameters] at rightInstantiation
            case forallE rightName rightDomain rightBody rightBinderInfo =>
              rw [Lean.Expr.abstractFVars_forallE,
                Lean.Expr.abstractFVars_forallE] at sourceAlpha
              simp only [Lean.Expr.forallE.injEq] at sourceAlpha
              obtain ⟨_nameAlpha, _domainAlpha, bodyAlpha,
                _binderAlpha⟩ := sourceAlpha
              have leftPushedWF := leftTail.initialWF leftFinalWF
              have rightPushedWF := rightTail.initialWF rightFinalWF
              have leftFresh : leftFv ∉ VLCtx.fvars leftBase :=
                (leftPushedWF.2.1 leftFv leftDeps rfl).1
              have rightFresh : rightFv ∉ VLCtx.fvars rightBase :=
                (rightPushedWF.2.1 rightFv rightDeps rfl).1
              have leftBodyAvoid : leftBody.FVarsIn
                  (fun fv => fv ≠ leftFv) :=
                leftScope.2.mono (by
                  intro fv member equality
                  subst fv
                  exact leftFresh member)
              have rightBodyAvoid : rightBody.FVarsIn
                  (fun fv => fv ≠ rightFv) :=
                rightScope.2.mono (by
                  intro fv member equality
                  subst fv
                  exact rightFresh member)
              have nextAlpha : Lean.Expr.abstractFVars
                    ((some (leftFv, leftDeps), .vlam leftA) :: leftBase)
                    (leftBody.instantiate1 (.fvar leftFv)) =
                  Lean.Expr.abstractFVars
                    ((some (rightFv, rightDeps), .vlam rightA) :: rightBase)
                    (rightBody.instantiate1 (.fvar rightFv)) := by
                calc
                  _ = Lean.Expr.abstractFVarsAux 1 (VLCtx.fvars leftBase)
                        leftBody :=
                      Lean.Expr.abstractFVars_cons_instantiate1
                        leftBodyAvoid
                  _ = Lean.Expr.abstractFVarsAux 1 (VLCtx.fvars rightBase)
                        rightBody := bodyAlpha
                  _ = _ :=
                    (Lean.Expr.abstractFVars_cons_instantiate1
                      rightBodyAvoid).symm
              have leftBodyInPushed : leftBody.FVarsIn
                  (fun fv => fv ∈
                    VLCtx.fvars (((some (leftFv, leftDeps), .vlam leftA) ::
                      leftBase) : VLCtx)) :=
                leftScope.2.mono (by
                  intro fv member
                  simp only [VLCtx.fvars]
                  exact .tail _ member)
              have rightBodyInPushed : rightBody.FVarsIn
                  (fun fv => fv ∈
                    VLCtx.fvars (((some (rightFv, rightDeps), .vlam rightA) ::
                      rightBase) : VLCtx)) :=
                rightScope.2.mono (by
                  intro fv member
                  simp only [VLCtx.fvars]
                  exact .tail _ member)
              have leftFreshScope : (.fvar leftFv : Expr).FVarsIn
                  (fun fv => fv ∈
                    VLCtx.fvars (((some (leftFv, leftDeps), .vlam leftA) ::
                      leftBase) : VLCtx)) := by
                simp [FVarsIn, VLCtx.fvars]
              have rightFreshScope : (.fvar rightFv : Expr).FVarsIn
                  (fun fv => fv ∈
                    VLCtx.fvars (((some (rightFv, rightDeps), .vlam rightA) ::
                      rightBase) : VLCtx)) := by
                simp [FVarsIn, VLCtx.fvars]
              have leftNextScope :
                  (leftBody.instantiate1 (.fvar leftFv)).FVarsIn
                    (fun fv => fv ∈
                      VLCtx.fvars (((some (leftFv, leftDeps), .vlam leftA) ::
                        leftBase) : VLCtx)) := by
                simpa only [Lean.Expr.instantiate1_eq] using
                  leftBodyInPushed.instantiate1 leftFreshScope
              have rightNextScope :
                  (rightBody.instantiate1 (.fvar rightFv)).FVarsIn
                    (fun fv => fv ∈
                      VLCtx.fvars (((some (rightFv, rightDeps), .vlam rightA) ::
                        rightBase) : VLCtx)) := by
                simpa only [Lean.Expr.instantiate1_eq] using
                  rightBodyInPushed.instantiate1 rightFreshScope
              have tailLength : leftParameters.length =
                  rightParameters.length := by
                simpa only [List.length_cons, Nat.succ_inj] using lengthEq
              exact ih rightTail leftFinalWF rightFinalWF tailLength
                leftNextScope rightNextScope nextAlpha leftInstantiation
                rightInstantiation
            all_goals exact nomatch rightInstantiation
          all_goals exact nomatch leftInstantiation

/-- A nonempty producer annotation spine starts at a stored Pi, so its
retained WHNF result is literally its source. -/
theorem _root_.Lean4Lean.TypeChecker.CandidateAnnotationSpine.rootWhnf_eq_source_of_domains_ne_nil
    {env : VEnv} {Us : List Name}
    {candidateContext : AddInductive.Context} {source : Expr}
    {trace : AddInductive.CandidateExprTrace candidateContext source}
    {Delta terminalDelta : VLCtx} {domains : List VExpr}
    (spine : TypeChecker.CandidateAnnotationSpine env Us trace Delta
      terminalDelta domains)
    (stored : trace.storedSpine = true)
    (domainsNe : domains ≠ [])
    (recursionFuel : Nat)
    (depth : candidateContext.fuel.recDepth = recursionFuel + 1) :
    trace.rootWhnf = source := by
  have rootValid := trace.rootWhnf_valid
  cases spine with
  | terminal node => exact (domainsNe rfl).elim
  | forallE domainCandidate bodyCandidate storedDomain tailDomains head tail =>
      simp only [AddInductive.CandidateExprTrace.storedSpine,
        Bool.and_eq_true] at stored
      exact AddInductive.CandidateWhnfStep.result_eq_of_source_isForall
        rootValid recursionFuel depth
        (AddInductive.CandidateWhnfStep.isForall_of_structuralEq_forall
          stored.1)

/-- The exact ordinary-validation suffix after every shared parameter has
been instantiated.  Parameter traversal does not change the validation
context, and it does not change either the ordinary-field universe inventory
or its semantic audit. -/
structure _root_.Lean4Lean.AddInductive.ConstructorTypeValidationParameterSuffix
    {stats : AddInductive.InductiveStats} {isUnsafe : Bool}
    {familyIdx : Nat} {ctor : Name}
    {context : AddInductive.Context} {source : Expr}
    {argIdx fuel : Nat}
    (original : AddInductive.ConstructorTypeValidationTrace stats isUnsafe
      familyIdx ctor context source argIdx fuel)
    (rest : Expr) where
  fuel : Nat
  trace : AddInductive.ConstructorTypeValidationTrace stats isUnsafe
    familyIdx ctor context rest stats.params.size fuel
  universeSemantics_eq :
    trace.universeSemantics = original.universeSemantics
  fieldSorts_eq : ∀ Us,
    trace.fieldSorts? Us = original.fieldSorts? Us
  spineLength_eq : original.spineLength =
    stats.params.size - argIdx + trace.spineLength

private theorem validation_drop_eq_cons_of_getElem?_eq_some
    {values : List α} {index : Nat} {value : α}
    (atIndex : values[index]? = some value) :
    values.drop index = value :: values.drop (index + 1) := by
  induction values generalizing index with
  | nil => simp at atIndex
  | cons head tail ih =>
      cases index with
      | zero =>
          simp at atIndex
          simp [atIndex]
      | succ index =>
          simp at atIndex ⊢
          simpa [Nat.add_assoc, Nat.add_comm 1] using ih atIndex

private theorem validation_eq_length_of_getElem?_eq_none
    {values : List α} {index : Nat}
    (atIndex : values[index]? = none)
    (indexLe : index ≤ values.length) :
    index = values.length := by
  induction values generalizing index with
  | nil => simp_all
  | cons head tail ih =>
      cases index with
      | zero => simp at atIndex
      | succ index =>
          simp at atIndex
          simp only [List.length_cons, Nat.succ_le_succ_iff] at indexLe
          have indexEq : index = tail.length :=
            Nat.le_antisymm indexLe atIndex
          simp [indexEq]

/-- Strip the exact shared-parameter prefix directly from the retained
ordinary validation trace.  Unlike the supplemental view alignment, this
uses no second checker execution: the successful instantiation equation is
replayed along the trace's own parameter branches. -/
theorem _root_.Lean4Lean.AddInductive.ConstructorTypeValidationTrace.afterParameters
    {stats : AddInductive.InductiveStats} {isUnsafe : Bool}
    {familyIdx : Nat} {ctor : Name}
    {context : AddInductive.Context} {source rest : Expr}
    {argIdx fuel : Nat}
    (trace : AddInductive.ConstructorTypeValidationTrace stats isUnsafe
      familyIdx ctor context source argIdx fuel)
    (argIdxLe : argIdx ≤ stats.params.size)
    (instantiation : AddInductive.instantiateFamilyParameters source
      (stats.params.toList.drop argIdx) = .ok rest) :
    Nonempty (AddInductive.ConstructorTypeValidationParameterSuffix
      trace rest) := by
  induction trace generalizing rest with
  | parameter context fuel argIdx name domain body binderInfo parameter
      parameterType parameterAt parameterTypeRun validationDefEq tail ih =>
      have atList : stats.params.toList[argIdx]? = some parameter := by
        simpa only [← Array.getElem?_toList] using parameterAt
      have dropped :=
        validation_drop_eq_cons_of_getElem?_eq_some atList
      rw [dropped] at instantiation
      simp only [AddInductive.instantiateFamilyParameters] at instantiation
      have argIdxLt : argIdx < stats.params.size :=
        (Array.getElem?_eq_some_iff.mp parameterAt).1
      obtain ⟨suffix⟩ := ih (by omega) instantiation
      exact ⟨{
        fuel := suffix.fuel
        trace := suffix.trace
        universeSemantics_eq := by
          simpa only [
            AddInductive.ConstructorTypeValidationTrace.universeSemantics]
            using suffix.universeSemantics_eq
        fieldSorts_eq := fun Us => by
          simpa only [AddInductive.ConstructorTypeValidationTrace.fieldSorts?]
            using suffix.fieldSorts_eq Us
        spineLength_eq := by
          simp only [
            AddInductive.ConstructorTypeValidationTrace.spineLength]
          rw [suffix.spineLength_eq]
          omega }⟩
  | ordinary context fuel argIdx name domain body binderInfo sortResult
      noParameter ensureType universeTrace positivity tail ih =>
      have noParameterList : stats.params.toList[argIdx]? = none := by
        simpa only [← Array.getElem?_toList] using noParameter
      have argIdxEq : argIdx = stats.params.toList.length :=
        validation_eq_length_of_getElem?_eq_none noParameterList
          (by simpa using argIdxLe)
      have sizeEq : stats.params.toList.length = stats.params.size := by simp
      rw [sizeEq] at argIdxEq
      subst argIdx
      have dropEq : stats.params.toList.drop stats.params.size = [] := by
        simp
      rw [dropEq] at instantiation
      have sourceEq : (.forallE name domain body binderInfo) = rest :=
        Except.ok.inj (by
          change Except.ok (.forallE name domain body binderInfo) =
            Except.ok rest at instantiation
          exact instantiation)
      subst rest
      let suffixTrace :=
        AddInductive.ConstructorTypeValidationTrace.ordinary context fuel
          stats.params.size name domain body binderInfo sortResult noParameter
          ensureType universeTrace positivity tail
      exact ⟨{
        fuel := fuel + 1
        trace := suffixTrace
        universeSemantics_eq := rfl
        fieldSorts_eq := fun _ => rfl
        spineLength_eq := by simp [suffixTrace] }⟩
  | terminal context source fuel argIdx terminal valid =>
      by_cases argIdxEq : argIdx = stats.params.size
      · subst argIdx
        have dropEq : stats.params.toList.drop stats.params.size = [] := by
          simp
        rw [dropEq] at instantiation
        have sourceEq : source = rest := Except.ok.inj instantiation
        subst rest
        let suffixTrace :
            AddInductive.ConstructorTypeValidationTrace stats isUnsafe
              familyIdx ctor context source stats.params.size (fuel + 1) :=
          AddInductive.ConstructorTypeValidationTrace.terminal context source
            fuel stats.params.size terminal valid
        exact ⟨{
          fuel := fuel + 1
          trace := suffixTrace
          universeSemantics_eq := rfl
          fieldSorts_eq := fun _ => rfl
          spineLength_eq := by simp [suffixTrace] }⟩
      · have argIdxLt : argIdx < stats.params.size := by omega
        obtain ⟨parameter, parameterAt⟩ :
            ∃ parameter, stats.params.toList[argIdx]? = some parameter := by
          have listLt : argIdx < stats.params.toList.length := by
            simpa using argIdxLt
          exact ⟨stats.params.toList[argIdx], by
            simp only [List.getElem?_eq_getElem listLt]⟩
        have dropped :=
          validation_drop_eq_cons_of_getElem?_eq_some parameterAt
        rw [dropped] at instantiation
        cases source <;>
          simp only [AddInductive.instantiateFamilyParameters] at instantiation
        case forallE =>
          change true = false at terminal
          contradiction
        all_goals exact nomatch instantiation

/-- A zero-length constructor validation suffix has reached its terminal
family application, so it contributes no ordinary-field sort labels. -/
theorem _root_.Lean4Lean.AddInductive.ConstructorTypeValidationTrace.fieldSorts?_eq_nil_of_spineLength_eq_zero
    {stats : AddInductive.InductiveStats} {isUnsafe : Bool}
    {familyIdx : Nat} {ctor : Name}
    {context : AddInductive.Context} {source : Expr}
    {argIdx fuel : Nat}
    (trace : AddInductive.ConstructorTypeValidationTrace stats isUnsafe
      familyIdx ctor context source argIdx fuel)
    (empty : trace.spineLength = 0) :
    trace.fieldSorts? Us = some [] := by
  induction trace with
  | parameter context fuel argIdx name domain body binderInfo parameter
      parameterType parameterAt parameterTypeRun validationDefEq tail ih =>
      simp [AddInductive.ConstructorTypeValidationTrace.spineLength] at empty
  | ordinary context fuel argIdx name domain body binderInfo sortResult
      noParameter ensureType universeTrace positivity tail ih =>
      simp [AddInductive.ConstructorTypeValidationTrace.spineLength] at empty
  | terminal => rfl

/-- The exact field-sort inventory computed from ordinary validation carries
the universe bound required by nonrecursive Theory fields at every position. -/
theorem _root_.Lean4Lean.AddInductive.ConstructorTypeValidationTrace.fieldSortBounds
    {stats : AddInductive.InductiveStats} {isUnsafe : Bool}
    {familyIdx : Nat} {ctor : Name}
    {context : AddInductive.Context} {source : Expr}
    {argIdx fuel : Nat}
    (trace : AddInductive.ConstructorTypeValidationTrace stats isUnsafe
      familyIdx ctor context source argIdx fuel)
    (result_tr : VLevel.ofLevel Us stats.resultLevel = some resultLevel)
    (computed : trace.fieldSorts? Us = some sorts) :
    List.All (fun fieldLevel =>
      resultLevel ≈ .zero ∨ fieldLevel ≤ resultLevel) sorts := by
  induction trace generalizing sorts with
  | parameter context fuel argIdx name domain body binderInfo parameter
      parameterType parameterAt parameterTypeRun validationDefEq tail ih =>
      exact ih computed
  | ordinary context fuel argIdx name domain body binderInfo sortResult
      noParameter ensureType universeTrace positivity tail ih =>
      cases fieldTr : VLevel.ofLevel Us sortResult.sortLevel! with
      | none =>
          simp [AddInductive.ConstructorTypeValidationTrace.fieldSorts?,
            fieldTr] at computed
      | some fieldLevel =>
          cases tailComputed : tail.fieldSorts? Us with
          | none =>
              simp [AddInductive.ConstructorTypeValidationTrace.fieldSorts?,
                fieldTr, tailComputed] at computed
          | some tailSorts =>
              have sortsEq : sorts = fieldLevel :: tailSorts := by
                simpa [AddInductive.ConstructorTypeValidationTrace.fieldSorts?,
                  fieldTr, tailComputed] using computed.symm
              subst sorts
              exact ⟨AddInductive.constructorUniverseSemanticGe_ofLevel
                  (by simpa only [
                    AddInductive.ConstructorUniverseTrace.semantic] using
                      universeTrace.semantic_eq_true)
                  result_tr fieldTr,
                ih tailComputed⟩
  | terminal =>
      have sortsEq : sorts = [] := by
        simpa [AddInductive.ConstructorTypeValidationTrace.fieldSorts?] using
          computed.symm
      subst sorts
      trivial

/-- Interpret the ordinary-field suffix of a constructor validation trace
against the producer-owned annotation spine.  The trace supplies the exact
`ensureType` universe labels, while the annotation spine supplies the exact
consumed domains stored by normalization.  Shared parameters have already
been consumed, so a parameter node is ruled out arithmetically rather than by
the supplemental constructor/view alignment audit. -/
theorem _root_.Lean4Lean.TypeChecker.CandidateAnnotationStructuralCursor.constructorFieldSorts
    {env : VEnv} {Us : List Name} {terminalDelta : VLCtx}
    (cursor : TypeChecker.CandidateAnnotationStructuralCursor env Us terminalDelta)
    (terminalWF : VLCtx.WF env Us.length terminalDelta)
    {stats : AddInductive.InductiveStats} {isUnsafe : Bool}
    {familyIdx : Nat} {ctor : Name}
    {context : AddInductive.Context} {source : Expr}
    {argIdx fuel : Nat}
    {trace : AddInductive.ConstructorTypeValidationTrace stats isUnsafe
      familyIdx ctor context source argIdx fuel}
    (contextRun : AddInductive.ConstructorContextRun env Us context)
    {sourceTarget : VExpr}
    (sourceTr : contextRun.candidate.context.TrExprS source sourceTarget)
    (localState : TypeChecker.FamilyParameterLocalState stats context)
    (parametersDone : stats.params.size ≤ argIdx)
    {base reference : VLCtx} {lift : Lift}
    (baseShape : base.FVarLamOnly)
    (relation : VLCtx.FVarAlpha env Us.length base cursor.Δ)
    (referenceLift : VLCtx.FVLift' base reference 0 lift 0)
    (currentReference : VLCtx.IsDefEq env Us.length
      contextRun.candidate.context.vlctx reference)
    (sourceScope : source.FVarsIn (fun fv => fv ∈ base.fvars))
    (sourceAlpha : Lean.Expr.abstractFVars base source =
      Lean.Expr.abstractFVars cursor.Δ cursor.trace.rootWhnf)
    (spineLength : trace.spineLength = cursor.domains.length)
    (recursionFuel : Nat)
    (candidateDepth : cursor.candidateContext.fuel.recDepth =
      recursionFuel + 1) :
    ∃ sorts,
      trace.fieldSorts? Us = some sorts ∧
        env.OnSortTel Us.length cursor.Δ.toCtx cursor.domains sorts := by
  rcases cursor with ⟨candidateContext, candidateSource, candidateTrace,
    candidateDelta, candidateDomains, spine, candidateShape, stored,
    annotations⟩
  induction spine generalizing stats isUnsafe familyIdx ctor context source
      argIdx fuel trace contextRun sourceTarget base reference lift
      recursionFuel with
  | terminal node =>
      cases trace with
      | parameter context fuel argIdx name domain body binderInfo parameter
          parameterType parameterAt parameterTypeRun validationDefEq tail =>
          have parameterLt : argIdx < stats.params.size :=
            (Array.getElem?_eq_some_iff.mp parameterAt).1
          omega
      | ordinary context fuel argIdx name domain body binderInfo sortResult
          noParameter ensureType universeTrace positivity tail =>
          simp only [AddInductive.ConstructorTypeValidationTrace.spineLength,
            List.length_nil] at spineLength
          omega
      | terminal context source fuel argIdx terminal valid =>
          exact ⟨[], rfl, .nil⟩
  | @forallE candidateContext candidateDomain candidateName
      candidateBinderInfo candidateBody candidateDelta terminalDelta
      candidateSource candidateInferred candidateFresh annotationsNode
      annotationsEq candidateChecked candidateNormalized domainCandidate
      bodyCandidate storedDomain candidateDomains head tail ih =>
      simp only [AddInductive.CandidateExprTrace.storedSpine,
        Bool.and_eq_true] at stored
      rcases annotations with ⟨annotationMatch, tailAnnotations⟩
      obtain ⟨snapshot, snapshotContext, snapshotStored⟩ :=
        head annotationMatch
      subst candidateDelta
      cases trace with
      | parameter context fuel argIdx name domain body binderInfo parameter
          parameterType parameterAt parameterTypeRun validationDefEq tailTrace =>
          have parameterLt : argIdx < stats.params.size :=
            (Array.getElem?_eq_some_iff.mp parameterAt).1
          omega
      | terminal context source fuel argIdx terminal valid =>
          simp only [AddInductive.ConstructorTypeValidationTrace.spineLength,
            List.length_cons] at spineLength
          omega
      | ordinary context fuel argIdx name domain body binderInfo sortResult
          noParameter ensureTypeStep universeTrace positivityTrace tailTrace =>
          obtain ⟨domainRun⟩ := snapshot.alphaAlignedDomainRun
            contextRun.candidate sourceTr contextRun.venv_eq
            contextRun.lparams_eq baseShape candidateShape relation
            referenceLift currentReference sourceScope sourceAlpha rfl
          have sourceParts := domainRun.source_eq
          simp only [Expr.forallE.injEq] at sourceParts
          obtain ⟨nameEq, domainEq, bodyEq, binderInfoEq⟩ := sourceParts
          have validatorDomainTr : contextRun.candidate.context.TrExprS
              domain domainRun.domain' := by
            simpa only [domainEq] using domainRun.domain_tr
          obtain ⟨ensureTypeRun⟩ :=
            AddInductive.TypeChecker.EnsureTypeRun.exists_ofConstructorStep
              ⟨context, domain, sortResult⟩ ensureTypeStep
              contextRun.candidate domainRun.domain' validatorDomainTr
          have henv : VEnv.WF env := by
            simpa only [contextRun.venv_eq] using
              contextRun.candidate.context.Ewf
          have currentWF : VLCtx.WF env Us.length
              contextRun.candidate.context.vlctx := by
            simpa only [contextRun.venv_eq, contextRun.lparams_eq] using
              contextRun.candidate.context.Δwf
          have referenceWF : VLCtx.WF env Us.length reference :=
            (currentReference.symm henv.ordered).wf
          have baseWF : VLCtx.WF env Us.length base :=
            referenceLift.wf henv referenceWF
          have annotationAtExact : env.IsDefEq Us.length
              contextRun.candidate.context.vlctx.toCtx domainRun.domain'
              domainRun.consumed' (.sort ensureTypeRun.resultLevel') :=
            (by
              have annotationDef : env.IsDefEqU Us.length
                  contextRun.candidate.context.vlctx.toCtx domainRun.domain'
                  domainRun.consumed' := by
                simpa only [contextRun.venv_eq,
                  contextRun.lparams_eq] using domainRun.annotation_def.toU
              have sourceType : env.HasType Us.length
                  contextRun.candidate.context.vlctx.toCtx domainRun.domain'
                  (.sort ensureTypeRun.resultLevel') := by
                simpa only [contextRun.venv_eq,
                  contextRun.lparams_eq] using ensureTypeRun.source_type
              exact annotationDef.of_l henv currentWF.toCtx
                sourceType)
          have consumedTypeExact : env.HasType Us.length
              contextRun.candidate.context.vlctx.toCtx domainRun.consumed'
              (.sort ensureTypeRun.resultLevel') :=
            annotationAtExact.hasType.2
          have consumedType : contextRun.candidate.context.IsType
              domainRun.consumed' :=
            ⟨ensureTypeRun.resultLevel', by
              simpa only [contextRun.venv_eq,
                contextRun.lparams_eq] using consumedTypeExact⟩
          have fresh : context.lctx.find? context.freshFVarId = none :=
            localState.localContext.fresh
          have validatorConsumedTr : contextRun.candidate.context.TrExprS
              (AddInductive.consumeTypeAnnotations domain)
              domainRun.consumed' := by
            simpa only [domainEq] using domainRun.consumed_tr
          let pushed := contextRun.pushLocalDecl name binderInfo
            (AddInductive.consumeTypeAnnotations domain) fresh
            domainRun.consumed' validatorConsumedTr consumedType
          have pushedVenv : pushed.candidate.context.venv = env :=
            pushed.venv_eq
          have pushedLparams : pushed.candidate.context.lparams = Us :=
            pushed.lparams_eq
          have pushedWF : VLCtx.WF env Us.length
              pushed.candidate.context.vlctx := by
            simpa only [pushedVenv, pushedLparams] using
              pushed.candidate.context.Δwf
          obtain ⟨bodyTarget, bodyTr⟩ := domainRun.bodyTranslation
          have instantiatedBodyTr : TrExprS env Us
              pushed.candidate.context.vlctx
              (body.instantiate1 context.freshExpr) bodyTarget := by
            have bodyTr' : TrExprS env Us
                ((none, .vlam domainRun.consumed') ::
                  contextRun.candidate.context.vlctx)
                body bodyTarget := by
              simpa only [contextRun.venv_eq,
                contextRun.lparams_eq, bodyEq] using bodyTr
            have instantiated := bodyTr'.inst_fvar henv.ordered pushedWF
            simpa only [pushed,
              AddInductive.ConstructorContextRun.pushLocalDecl,
              TypeChecker.CandidateContextRun.pushLocalDecl_vlctx,
              AddInductive.Context.freshExpr, Expr.instantiate1_eq,
              contextRun.venv_eq, contextRun.lparams_eq] using instantiated
          have currentConsumedTr : TrExprS env Us
              contextRun.candidate.context.vlctx
              (AddInductive.consumeTypeAnnotations domain)
              domainRun.consumed' := by
            simpa only [TypeChecker.VContext.TrExprS, contextRun.venv_eq,
              contextRun.lparams_eq, domainEq] using domainRun.consumed_tr
          have domainScope : domain.FVarsIn
              (fun fv => fv ∈ base.fvars) := sourceScope.1
          have consumedScope :
              (AddInductive.consumeTypeAnnotations domain).FVarsIn
                (fun fv => fv ∈ base.fvars) := by
            cases htrace : AddInductive.CandidateTypeAnnotationTrace.build
                domain with
            | mk consumed annotationTrace =>
                have consumedEq : consumed =
                    AddInductive.consumeTypeAnnotations domain := by
                  simpa only [htrace] using
                    AddInductive.CandidateTypeAnnotationTrace.build_consumed
                      domain
                simpa only [← consumedEq] using
                  TypeChecker.candidateTypeAnnotation_fvarsIn
                    annotationTrace domainScope
          have currentNoBV : contextRun.candidate.context.vlctx.NoBV :=
            contextRun.candidate.context.mlctx.noBV
          have consumedClosed : Closed
              (AddInductive.consumeTypeAnnotations domain) 0 := by
            simpa only [currentNoBV] using currentConsumedTr.closed
          obtain ⟨baseConsumed, baseConsumedTr⟩ :=
            currentConsumedTr.weakFV'_inv henv referenceLift currentReference
              consumedClosed consumedScope
          have rootAlpha : Lean.Expr.abstractFVars base
              (.forallE name domain body binderInfo) =
              Lean.Expr.abstractFVars snapshot.Δ
                (.forallE candidateName candidateDomain candidateBody
                  candidateBinderInfo) := by
            calc
              _ = Lean.Expr.abstractFVars snapshot.Δ
                    (AddInductive.CandidateExprTrace.forallE candidateContext
                      candidateSource candidateInferred candidateName
                      candidateDomain candidateBody candidateBinderInfo
                      candidateFresh annotationsNode annotationsEq
                      candidateChecked candidateNormalized domainCandidate
                      bodyCandidate).rootWhnf := by
                  simpa only using sourceAlpha
              _ = _ := rfl
          rw [Lean.Expr.abstractFVars_forallE,
            Lean.Expr.abstractFVars_forallE] at rootAlpha
          simp only [Lean.Expr.forallE.injEq] at rootAlpha
          obtain ⟨_nameAlpha, domainAlpha, bodyAlpha,
            _binderAlpha⟩ := rootAlpha
          have snapshotRoot := snapshot.root_eq
          simp only [Lean.Expr.forallE.injEq] at snapshotRoot
          obtain ⟨_snapshotName, snapshotDomain, snapshotBody,
            _snapshotBinder⟩ := snapshotRoot
          have domainAlpha' : Lean.Expr.abstractFVars base domain =
              Lean.Expr.abstractFVars snapshot.Δ snapshot.domain := by
            simpa only [snapshotDomain] using domainAlpha
          have consumedAlpha : Lean.Expr.abstractFVars base
              (AddInductive.consumeTypeAnnotations domain) =
              Lean.Expr.abstractFVars snapshot.Δ snapshot.consumed := by
            calc
              _ = AddInductive.consumeTypeAnnotations
                    (Lean.Expr.abstractFVars base domain) :=
                  (AddInductive.consumeTypeAnnotations_abstractFVars
                    base domain).symm
              _ = AddInductive.consumeTypeAnnotations
                    (Lean.Expr.abstractFVars snapshot.Δ snapshot.domain) :=
                  congrArg AddInductive.consumeTypeAnnotations domainAlpha'
              _ = Lean.Expr.abstractFVars snapshot.Δ
                    (AddInductive.consumeTypeAnnotations snapshot.domain) :=
                  AddInductive.consumeTypeAnnotations_abstractFVars
                    snapshot.Δ snapshot.domain
              _ = Lean.Expr.abstractFVars snapshot.Δ snapshot.consumed :=
                  congrArg (Lean.Expr.abstractFVars snapshot.Δ)
                    snapshot.annotation_match.symm
          have baseConsumedEq : env.IsDefEqU Us.length base.toCtx
              baseConsumed snapshot.consumed' :=
            baseConsumedTr.uniqAlpha henv relation baseShape candidateShape
              snapshot.consumed_tr consumedAlpha
          have baseConsumedAtReference :=
            baseConsumedTr.weakFV' henv.ordered referenceLift referenceWF
          have currentConsumedEq :=
            currentConsumedTr.uniq henv currentReference
              baseConsumedAtReference
          have currentConsumedReference : env.IsDefEq Us.length
              contextRun.candidate.context.vlctx.toCtx domainRun.consumed'
              (baseConsumed.lift' lift)
              (.sort ensureTypeRun.resultLevel') :=
            currentConsumedEq.of_l henv currentWF.toCtx consumedTypeExact
          have liftedTypeAtCurrent : env.HasType Us.length
              contextRun.candidate.context.vlctx.toCtx
              (baseConsumed.lift' lift)
              (.sort ensureTypeRun.resultLevel') :=
            currentConsumedReference.hasType.2
          have liftedTypeAtReference : env.HasType Us.length reference.toCtx
              (baseConsumed.lift' lift)
              (.sort ensureTypeRun.resultLevel') :=
            liftedTypeAtCurrent.defeqDFC henv.ordered
              currentReference.defeqCtx
          have baseConsumedType : env.HasType Us.length base.toCtx
              baseConsumed (.sort ensureTypeRun.resultLevel') := by
            apply (VEnv.HasType.weak'_iff henv referenceWF.toCtx
              referenceLift.toCtx).1
            simpa using liftedTypeAtReference
          have candidateConsumedAtBase : env.HasType Us.length base.toCtx
              snapshot.consumed' (.sort ensureTypeRun.resultLevel') :=
            (baseConsumedEq.of_l henv baseWF.toCtx baseConsumedType).hasType.2
          have candidateConsumedType : env.HasType Us.length
              snapshot.Δ.toCtx snapshot.consumed'
              (.sort ensureTypeRun.resultLevel') :=
            candidateConsumedAtBase.defeqDFC henv.ordered relation.defeqCtx
          let deps := (AddInductive.consumeTypeAnnotations
            domain).fvarsList
          let nextBase : VLCtx :=
            (some (context.freshFVarId, deps), .vlam baseConsumed) :: base
          let nextReference : VLCtx :=
            (some (context.freshFVarId, deps),
              .vlam (baseConsumed.lift' lift)) :: reference
          have depsSubset : deps ⊆ base.fvars :=
            (fvarsIn_iff.mp baseConsumedTr.fvarsIn).1
          have nextReferenceLift : VLCtx.FVLift' nextBase nextReference 0
              (.consN lift 1) 0 := by
            simpa only [nextBase, nextReference, VLocalDecl.lift',
              VLocalDecl.depth] using referenceLift.cons_fvar
                (context.freshFVarId, deps) (.vlam baseConsumed) depsSubset
          have nextCurrentReference : VLCtx.IsDefEq env Us.length
              pushed.candidate.context.vlctx nextReference := by
            have concrete : VLCtx.IsDefEq env Us.length
                ((some (context.freshFVarId, deps),
                    .vlam domainRun.consumed') ::
                  contextRun.candidate.context.vlctx) nextReference :=
              .cons currentReference pushedWF.2.1
                (.vlam currentConsumedReference)
            change VLCtx.IsDefEq env Us.length
              ((some (context.freshFVarId, deps),
                  .vlam domainRun.consumed') ::
                contextRun.candidate.context.vlctx) nextReference
            exact concrete
          have baseConsumedCandidate : env.IsDefEq Us.length base.toCtx
              baseConsumed snapshot.consumed'
              (.sort ensureTypeRun.resultLevel') :=
            baseConsumedEq.of_l henv baseWF.toCtx baseConsumedType
          have nextRelation : VLCtx.FVarAlpha env Us.length nextBase
              ((some (candidateContext.freshFVarId,
                  annotationsNode.consumed.fvarsList),
                .vlam storedDomain) :: snapshot.Δ) := by
            rw [← snapshotStored]
            exact .cons relation (.vlam baseConsumedCandidate)
          have nextBaseShape : nextBase.FVarLamOnly := .cons baseShape
          have nextCandidateShape : VLCtx.FVarLamOnly
              ((some (candidateContext.freshFVarId,
                  annotationsNode.consumed.fvarsList),
                .vlam storedDomain) :: snapshot.Δ) :=
            .cons candidateShape
          have candidateTailWF := tail.terminalLift.wf henv terminalWF
          have validatorBodyScope : body.FVarsIn
              (fun fv => fv ∈ base.fvars) := sourceScope.2
          have freshBase : context.freshFVarId ∉ base.fvars := by
            intro present
            have presentReference : context.freshFVarId ∈ reference.fvars :=
              referenceLift.fvars_sublist.subset present
            have presentCurrent : context.freshFVarId ∈
                contextRun.candidate.context.vlctx.fvars := by
              rw [currentReference.fvars]
              exact presentReference
            exact (pushedWF.2.1 _ _ rfl).1 presentCurrent
          have validatorBodyAvoid : body.FVarsIn
              (fun fv => fv ≠ context.freshFVarId) :=
            validatorBodyScope.mono (by
              intro fv member equal
              subst fv
              exact freshBase member)
          have freshCandidate : candidateContext.freshFVarId ∉
              snapshot.Δ.fvars :=
            (candidateTailWF.2.1 _ _ rfl).1
          have candidateBodyScope : candidateBody.FVarsIn
              (fun fv => fv ∈ snapshot.Δ.fvars) := by
            simpa only [snapshotBody] using snapshot.body_fvars
          have candidateBodyAvoid : candidateBody.FVarsIn
              (fun fv => fv ≠ candidateContext.freshFVarId) :=
            candidateBodyScope.mono (by
              intro fv member equal
              subst fv
              exact freshCandidate member)
          have nextSourceAlpha : Lean.Expr.abstractFVars nextBase
              (body.instantiate1 context.freshExpr) =
              Lean.Expr.abstractFVars
                ((some (candidateContext.freshFVarId,
                    annotationsNode.consumed.fvarsList),
                  .vlam storedDomain) :: snapshot.Δ)
                (candidateBody.instantiate1 candidateContext.freshExpr) := by
            calc
              _ = Lean.Expr.abstractFVarsAux 1 base.fvars
                    body :=
                  Lean.Expr.abstractFVars_cons_instantiate1
                    validatorBodyAvoid
              _ = Lean.Expr.abstractFVarsAux 1 snapshot.Δ.fvars
                    candidateBody := bodyAlpha
              _ = _ := (Lean.Expr.abstractFVars_cons_instantiate1
                    candidateBodyAvoid).symm
          have nextSourceScope :
              (body.instantiate1 context.freshExpr).FVarsIn
                (fun fv => fv ∈ nextBase.fvars) := by
            have bodyScope : body.FVarsIn
                (fun fv => fv ∈ nextBase.fvars) :=
              validatorBodyScope.mono (by
                intro fv member
                simp only [nextBase, VLCtx.fvars]
                exact .tail _ member)
            have freshScope : context.freshExpr.FVarsIn
                (fun fv => fv ∈ nextBase.fvars) := by
              simp [AddInductive.Context.freshExpr, nextBase, VLCtx.fvars,
                FVarsIn]
            simpa only [Lean.Expr.instantiate1_eq] using
              bodyScope.instantiate1 freshScope
          have nextSpineLength : tailTrace.spineLength =
              candidateDomains.length := by
            simp only [AddInductive.ConstructorTypeValidationTrace.spineLength,
              List.length_cons] at spineLength
            omega
          have nextParametersDone : stats.params.size ≤ argIdx + 1 := by
            omega
          have nextCandidateDepth :
              (candidateContext.pushLocalDecl candidateName
                candidateBinderInfo annotationsNode.consumed).fuel.recDepth =
                recursionFuel + 1 := by
            simpa [AddInductive.Context.pushLocalDecl] using candidateDepth
          have tailSourceTr : pushed.candidate.context.TrExprS
              (body.instantiate1 context.freshExpr) bodyTarget := by
            simpa only [TypeChecker.VContext.TrExprS, pushedVenv,
              pushedLparams] using instantiatedBodyTr
          have tailLocalState := localState.pushLocal name binderInfo
            (AddInductive.consumeTypeAnnotations domain)
          have tailResult : ∃ tailSorts,
              tailTrace.fieldSorts? Us = some tailSorts ∧
                env.OnSortTel Us.length
                  (VLCtx.toCtx ((some (candidateContext.freshFVarId,
                      annotationsNode.consumed.fvarsList),
                    .vlam storedDomain) :: snapshot.Δ))
                  candidateDomains tailSorts := by
            by_cases tailEmpty : tailTrace.spineLength = 0
            · have candidateDomainsNil : candidateDomains = [] := by
                apply List.length_eq_zero_iff.mp
                omega
              subst candidateDomains
              have tailComputed : tailTrace.fieldSorts? Us = some [] :=
                tailTrace.fieldSorts?_eq_nil_of_spineLength_eq_zero tailEmpty
              exact ⟨[], tailComputed, .nil⟩
            · have candidateDomainsNe : candidateDomains ≠ [] := by
                intro candidateDomainsNil
                subst candidateDomains
                simp only [List.length_nil] at nextSpineLength
                exact tailEmpty nextSpineLength
              have candidateRootEq :=
                tail.rootWhnf_eq_source_of_domains_ne_nil stored.2
                  candidateDomainsNe recursionFuel nextCandidateDepth
              have nextSourceAlphaRoot : Lean.Expr.abstractFVars nextBase
                  (body.instantiate1 context.freshExpr) =
                  Lean.Expr.abstractFVars
                    ((some (candidateContext.freshFVarId,
                        annotationsNode.consumed.fvarsList),
                      .vlam storedDomain) :: snapshot.Δ)
                    bodyCandidate.rootWhnf := by
                calc
                  _ = Lean.Expr.abstractFVars
                        ((some (candidateContext.freshFVarId,
                            annotationsNode.consumed.fvarsList),
                          .vlam storedDomain) :: snapshot.Δ)
                        (candidateBody.instantiate1
                          candidateContext.freshExpr) := nextSourceAlpha
                  _ = _ := congrArg
                    (Lean.Expr.abstractFVars
                      ((some (candidateContext.freshFVarId,
                          annotationsNode.consumed.fvarsList),
                        .vlam storedDomain) :: snapshot.Δ))
                    candidateRootEq.symm
              obtain ⟨tailSorts, tailComputed, tailTelescope⟩ := ih
                (trace := tailTrace)
                terminalWF pushed tailSourceTr tailLocalState
                nextParametersDone nextBaseShape nextReferenceLift
                nextCurrentReference nextSourceScope recursionFuel
                nextCandidateShape
                stored.2 tailAnnotations nextRelation nextSourceAlphaRoot
                nextSpineLength nextCandidateDepth
              exact ⟨tailSorts, tailComputed, tailTelescope⟩
          obtain ⟨tailSorts, tailComputed, tailTelescope⟩ := tailResult
          have sortLevelEq : sortResult.sortLevel! =
              ensureTypeRun.resultLevel := by
            simpa only [Expr.sortLevel!] using
              congrArg (fun expression : Expr => expression.sortLevel!)
                ensureTypeRun.result_eq
          have levelTranslation : VLevel.ofLevel Us sortResult.sortLevel! =
              some ensureTypeRun.resultLevel' := by
            calc
              _ = VLevel.ofLevel Us ensureTypeRun.resultLevel :=
                congrArg (VLevel.ofLevel Us) sortLevelEq
              _ = some ensureTypeRun.resultLevel' := by
                simpa only [contextRun.lparams_eq] using
                  ensureTypeRun.resultLevel_tr
          refine ⟨ensureTypeRun.resultLevel' :: tailSorts, ?_, ?_⟩
          · simp [AddInductive.ConstructorTypeValidationTrace.fieldSorts?,
              levelTranslation, tailComputed]
          · exact .cons (by
              simpa only [snapshotStored] using candidateConsumedType)
              (by simpa only [VLCtx.toCtx] using tailTelescope)

/-- Alignment-free field semantics for one exact constructor position.  The
ordinary validator selects the universe labels, while the normalization
producer selects the annotation-consumed telescope on which those labels are
interpreted.  Both suffixes are reached by consuming their own copy of the
shared parameter FVars; `sourceAlpha` inside `constructorFieldSorts` is the
only bridge between the two local-name inventories. -/
structure CandidateConstructorValidationFieldState
    (source : VInductDecl) (env : VEnv) (Us : List Name)
    {stats : AddInductive.InductiveStats} {isUnsafe : Bool}
    {familyIdx : Nat} {context : AddInductive.Context}
    {kernelSource : Constructor}
    {candidate : AddInductive.CandidateConstructor kernelSource}
    {raw : VConstVal}
    (validation : AddInductive.ConstructorTypeValidationTrace stats isUnsafe
      familyIdx kernelSource.name context kernelSource.type 0
      context.fuel.inductiveFuel)
    (semantic : CandidateConstructorSemanticRun env Us candidate raw)
    (shape : CandidateConstructorSemanticGenerationShape
      (source := source) env Us semantic)
    (annotation : CandidateConstructorAnnotationSpine source env Us semantic
      shape) where
  rest : Expr
  validationSuffix :
    AddInductive.ConstructorTypeValidationParameterSuffix validation rest
  position : candidate.type.trace.MainSpineAt stats.params.size
  viewSpineLength : AddInductive.constructorArity candidate.type.view 0 =
    candidate.type.trace.spineLength
  annotationSuffix :
    annotation.annotation_spine.StructuralMainPositionSuffix position
  sorts : List VLevel
  computed : validation.fieldSorts? Us = some sorts
  telescope : env.OnSortTel Us.length annotationSuffix.cursor.Δ.toCtx
    annotationSuffix.cursor.domains sorts

/-- The retained validator labels have exactly the producer-owned residual
constructor arity.  This fact is independent of the normalized view's
terminal shape and therefore does not require a Stage-3 or alignment replay. -/
theorem CandidateConstructorValidationFieldState.sorts_length
    {source : VInductDecl} {env : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {isUnsafe : Bool}
    {familyIdx : Nat} {context : AddInductive.Context}
    {kernelSource : Constructor}
    {candidate : AddInductive.CandidateConstructor kernelSource}
    {raw : VConstVal}
    {validation : AddInductive.ConstructorTypeValidationTrace stats isUnsafe
      familyIdx kernelSource.name context kernelSource.type 0
      context.fuel.inductiveFuel}
    {semantic : CandidateConstructorSemanticRun env Us candidate raw}
    {shape : CandidateConstructorSemanticGenerationShape
      (source := source) env Us semantic}
    {annotation : CandidateConstructorAnnotationSpine source env Us semantic
      shape}
    (state : CandidateConstructorValidationFieldState source env Us
      validation semantic shape annotation) :
    state.sorts.length =
      candidate.type.trace.spineLength - stats.params.size := by
  calc
    state.sorts.length = state.annotationSuffix.cursor.domains.length :=
      state.telescope.length_eq.symm
    _ = (annotation.storedBinders.drop stats.params.size).length :=
      congrArg List.length state.annotationSuffix.domains_eq
    _ = annotation.storedBinders.length - stats.params.size :=
      List.length_drop
    _ = (ctorFields raw.type).length - stats.params.size := by
      rw [annotation.stored_length]
    _ = candidate.type.trace.spineLength - stats.params.size := by
      rw [shape.spineLength_eq_ctorFields]

private theorem structuralGenerationTelNForallNLength :
    ∀ (binders : List VExpr) (result : VExpr),
      VExpr.telN binders.length (VExpr.forallN binders result) = binders
  | [], _ => rfl
  | _ :: binders, result => by
      simp only [List.length_cons, VExpr.forallN, VExpr.telN,
        structuralGenerationTelNForallNLength binders result]

private theorem structuralGenerationDropNForallNLength :
    ∀ (binders : List VExpr) (result : VExpr),
      VExpr.dropN binders.length (VExpr.forallN binders result) = result
  | [], _ => rfl
  | _ :: binders, result => by
      simp only [List.length_cons, VExpr.forallN, VExpr.dropN,
        structuralGenerationDropNForallNLength binders result]

/-- Split a complete producer-owned view telescope at the shared-parameter
boundary.  This is the local, constructor-neutral counterpart of the private
generation helper in `Normalization`: the only premise is the exact total
Pi-arity. -/
private theorem structuralCandidateFullTelComponents
    (nparams total : Nat) (expression : VExpr)
    (length_eq : total =
      (VExpr.telN nparams expression ++
        ctorFields (VExpr.dropN nparams expression)).length) :
    VExpr.telN total expression =
        VExpr.telN nparams expression ++
          ctorFields (VExpr.dropN nparams expression) ∧
      VExpr.dropN total expression =
        VExpr.resultOf (VExpr.dropN nparams expression) := by
  let binders := VExpr.telN nparams expression ++
    ctorFields (VExpr.dropN nparams expression)
  let result := VExpr.resultOf (VExpr.dropN nparams expression)
  have reconstructed : VExpr.forallN binders result = expression := by
    simp only [binders, result, VExpr.forallN_append,
      forallN_ctorFields_resultOf, VExpr.forallN_telN_dropN]
  have total_eq : total = binders.length := by
    simpa only [binders] using length_eq
  change VExpr.telN total expression = binders ∧
    VExpr.dropN total expression = result
  constructor
  · calc
      VExpr.telN total expression = VExpr.telN binders.length expression :=
        congrArg (fun count => VExpr.telN count expression) total_eq
      _ = VExpr.telN binders.length (VExpr.forallN binders result) :=
        congrArg (VExpr.telN binders.length) reconstructed.symm
      _ = binders := structuralGenerationTelNForallNLength _ _
  · calc
      VExpr.dropN total expression = VExpr.dropN binders.length expression :=
        congrArg (fun count => VExpr.dropN count expression) total_eq
      _ = VExpr.dropN binders.length (VExpr.forallN binders result) :=
        congrArg (VExpr.dropN binders.length) reconstructed.symm
      _ = result := structuralGenerationDropNForallNLength _ _

/-- Move the validator's exact universe labels from the producer-owned
annotation suffix to the normalized constructor view.  The shared parameter
prefix is transported twice—first from the view to the stored annotation
prefix, then from the view to the canonical parameter context—so the result
contains no constructor/view alignment trace. -/
theorem CandidateConstructorValidationFieldState.fieldView_onSortTel
    {source : VInductDecl} {env : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {isUnsafe : Bool}
    {familyIdx : Nat} {context : AddInductive.Context}
    {kernelSource : Constructor}
    {candidate : AddInductive.CandidateConstructor kernelSource}
    {raw : VConstVal}
    {validation : AddInductive.ConstructorTypeValidationTrace stats isUnsafe
      familyIdx kernelSource.name context kernelSource.type 0
      context.fuel.inductiveFuel}
    {semantic : CandidateConstructorSemanticRun env Us candidate raw}
    {shape : CandidateConstructorSemanticGenerationShape
      (source := source) env Us semantic}
    {annotation : CandidateConstructorAnnotationSpine source env Us semantic
      shape}
    (state : CandidateConstructorValidationFieldState source env Us
      validation semantic shape annotation)
    {params : List VExpr}
    (bound : stats.params.size ≤ candidate.type.trace.spineLength)
    (fieldCount :
      (ctorFields
        (VExpr.dropN stats.params.size semantic.type.view)).length =
        candidate.type.trace.spineLength - stats.params.size)
    (parameters : TypeChecker.TelDefEqEvidence env Us.length [] params
      (VExpr.telN stats.params.size semantic.type.view)) :
    env.OnSortTel Us.length params.reverse
      (ctorFields (VExpr.dropN stats.params.size semantic.type.view))
        state.sorts := by
  have henv : VEnv.WF env := by
    simpa only [semantic.type.venv_eq] using
      semantic.type.contextRun.context.Ewf
  obtain ⟨_resultType, rawView⟩ :=
    annotation.recursive.spineEvidence shape.storedSpine
  rw [shape.spineLength_eq_ctorFields] at rawView
  have viewRaw := rawView.telescope.symm henv trivial
  have viewStored := viewRaw.trans henv trivial annotation.telescope
  have prefixLength :
      (VExpr.telN stats.params.size semantic.type.view).length =
        stats.params.size :=
    annotation.recursive.viewTelN_length_of_le shape.storedSpine bound
  have fullLength : (ctorFields raw.type).length =
      (VExpr.telN stats.params.size semantic.type.view ++
        ctorFields
          (VExpr.dropN stats.params.size semantic.type.view)).length := by
    simp only [List.length_append, prefixLength, fieldCount]
    rw [← shape.spineLength_eq_ctorFields]
    omega
  have components := structuralCandidateFullTelComponents stats.params.size
      (ctorFields raw.type).length semantic.type.view fullLength
  rw [components.1] at viewStored
  have prefixEvidence := viewStored.take
    (VExpr.telN stats.params.size semantic.type.view).length
  have suffix := viewStored.drop
    (VExpr.telN stats.params.size semantic.type.view).length
  simp only [List.take_left, List.drop_left] at prefixEvidence suffix
  rw [prefixLength] at prefixEvidence suffix
  have storedContext : state.annotationSuffix.cursor.Δ.toCtx =
      (annotation.storedBinders.take stats.params.size).reverse := by
    simpa [VLCtx.toCtx] using state.annotationSuffix.context_eq
  have storedDomains : state.annotationSuffix.cursor.domains =
      annotation.storedBinders.drop stats.params.size :=
    state.annotationSuffix.domains_eq
  have storedTelescope : env.OnSortTel Us.length
      (annotation.storedBinders.take stats.params.size).reverse
      (annotation.storedBinders.drop stats.params.size) state.sorts := by
    simpa only [storedContext, storedDomains] using state.telescope
  have prefixContexts : env.IsDefEqCtx Us.length []
      (VExpr.telN stats.params.size semantic.type.view).reverse
      (annotation.storedBinders.take stats.params.size).reverse := by
    simpa [VLCtx.toCtx] using prefixEvidence.telDefEq.ctx
  have storedAtView : env.OnSortTel Us.length
      (VExpr.telN stats.params.size semantic.type.view).reverse
      (annotation.storedBinders.drop stats.params.size) state.sorts :=
    storedTelescope.defeqDFC henv.ordered
      (prefixContexts.symm henv.ordered)
  have viewPrefixOnCtx : OnCtx
      (VExpr.telN stats.params.size semantic.type.view).reverse
      (env.IsType Us.length) := by
    simpa [VLCtx.toCtx] using
      VEnv.OnTel.toOnCtx prefixEvidence.telDefEq.raw_onTel (by trivial)
  have fieldsAtView : env.OnSortTel Us.length
      (VExpr.telN stats.params.size semantic.type.view).reverse
      (ctorFields (VExpr.dropN stats.params.size semantic.type.view))
        state.sorts :=
    VEnv.TelDefEq.raw_onSortTel henv viewPrefixOnCtx
      (by simpa [VLCtx.toCtx] using suffix.telDefEq) storedAtView
  have parameterContexts : env.IsDefEqCtx Us.length [] params.reverse
      (VExpr.telN stats.params.size semantic.type.view).reverse := by
    simpa [VLCtx.toCtx] using parameters.telDefEq.ctx
  exact fieldsAtView.defeqDFC henv.ordered
    (parameterContexts.symm henv.ordered)

/-- Construct the exact post-parameter validation/annotation field state from
the ordinary validation trace and producer-owned spine facts.  In
particular, this performs no `ConstructorViewAlignmentTrace` build and does
not interpret the supplemental positivity alignment. -/
theorem CandidateConstructorAnnotationSpine.validationFieldState
    {source : VInductDecl} {env : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {isUnsafe : Bool}
    {familyIdx : Nat} {context : AddInductive.Context}
    {contextRun : AddInductive.ConstructorContextRun env Us context}
    {kernelSource : Constructor}
    {candidate : AddInductive.CandidateConstructor kernelSource}
    {raw : VConstVal}
    {validation : AddInductive.ConstructorTypeValidationTrace stats isUnsafe
      familyIdx kernelSource.name context kernelSource.type 0
      context.fuel.inductiveFuel}
    {semantic : CandidateConstructorSemanticRun env Us candidate raw}
    {shape : CandidateConstructorSemanticGenerationShape
      (source := source) env Us semantic}
    (annotation : CandidateConstructorAnnotationSpine source env Us semantic
      shape)
    {base : VLCtx} {parameterSources : List Expr}
    {storedTypes : List VExpr}
    (params : TypeChecker.CandidateParameterContext [] parameterSources
      storedTypes base)
    (localState : TypeChecker.FamilyParameterLocalState stats context)
    (contextAlignment : ConstructorSharedParameterContextAlignment env Us
      base contextRun)
    (parameterSources_eq : stats.params.toList = parameterSources)
    (spineLength : candidate.type.trace.spineLength =
      validation.spineLength)
    (viewSpineLength : AddInductive.constructorArity candidate.type.view 0 =
      candidate.type.trace.spineLength) :
    Nonempty (CandidateConstructorValidationFieldState source env Us
      validation semantic shape annotation) := by
  have henv : VEnv.WF env := by
    simpa only [contextRun.venv_eq] using
      contextRun.candidate.context.Ewf
  have parameterLength : parameterSources.length = stats.params.size := by
    calc
      parameterSources.length = stats.params.toList.length :=
        congrArg List.length parameterSources_eq.symm
      _ = stats.params.size := by simp
  have paramsEq : stats.params.toList.drop 0 = parameterSources := by
    simpa only [List.drop_zero] using parameterSources_eq
  have rawResult := constructorRawParameterTelescopeDefEqOfTraceAux
    (trace := validation) params localState contextAlignment
      (.refl henv (by trivial)) .base paramsEq semantic.type.source_tr
  have candidateBound : stats.params.size ≤
      candidate.type.trace.spineLength := by
    calc
      stats.params.size = parameterSources.length := parameterLength.symm
      _ ≤ validation.spineLength := rawResult.2
      _ = candidate.type.trace.spineLength := spineLength.symm
  have rawAnnotationBound : stats.params.size ≤
      (ctorFields raw.type).length := by
    rw [← shape.spineLength_eq_ctorFields]
    exact candidateBound
  have validationArity :=
    validation.constructorArity_eq_spineLength localState
  obtain ⟨rest, rawInstantiation⟩ :=
    AddInductive.instantiateFamilyParameters_exists_of_constructorArity
      (source := kernelSource.type) (parameters := stats.params.toList) (by
        rw [validationArity]
        calc
          stats.params.toList.length = stats.params.size :=
            Array.length_toList
          _ = parameterSources.length := parameterLength.symm
          _ ≤ validation.spineLength := rawResult.2)
  have rawInstantiation' :
      AddInductive.instantiateFamilyParameters kernelSource.type
        parameterSources = .ok rest := by
    simpa only [← parameterSources_eq] using rawInstantiation
  obtain ⟨validationSuffix⟩ :=
    validation.afterParameters (Nat.zero_le _) rawInstantiation
  obtain ⟨position⟩ := candidate.type.trace.mainSpineAt candidateBound
  obtain ⟨annotationSuffix⟩ :=
    annotation.annotation_spine.structuralMainPositionSuffix .nil
      shape.storedSpine annotation.validation_annotations position
  have terminalWF : VLCtx.WF env Us.length
      annotation.terminalRun.context.vlctx := by
    simpa only [annotation.terminal_venv, annotation.terminal_lparams] using
      annotation.terminalRun.context.Δwf
  have cursorWF : VLCtx.WF env Us.length annotationSuffix.cursor.Δ :=
    annotationSuffix.cursor.spine.terminalLift.wf henv terminalWF
  have cursorDomainsLength : annotationSuffix.cursor.domains.length =
      validationSuffix.trace.spineLength := by
    rw [annotationSuffix.domains_eq, List.length_drop,
      annotation.stored_length, ← shape.spineLength_eq_ctorFields,
      spineLength, validationSuffix.spineLength_eq]
    omega
  by_cases suffixEmpty : validationSuffix.trace.spineLength = 0
  · have cursorDomainsNil : annotationSuffix.cursor.domains = [] := by
      apply List.length_eq_zero_iff.mp
      rw [cursorDomainsLength, suffixEmpty]
    have suffixComputed :=
      validationSuffix.trace.fieldSorts?_eq_nil_of_spineLength_eq_zero
        suffixEmpty (Us := Us)
    have computed : validation.fieldSorts? Us = some [] :=
      (validationSuffix.fieldSorts_eq Us).symm.trans suffixComputed
    exact ⟨{
      rest := rest
      validationSuffix := validationSuffix
      position := position
      viewSpineLength := viewSpineLength
      annotationSuffix := annotationSuffix
      sorts := []
      computed := computed
      telescope := by rw [cursorDomainsNil]; exact .nil }⟩
  · have suffixPositive : 0 < validationSuffix.trace.spineLength := by
      omega
    have candidateRemaining : stats.params.size <
        candidate.type.trace.spineLength := by
      rw [spineLength, validationSuffix.spineLength_eq]
      omega
    let annotationParams : TypeChecker.CandidateParameterContext []
        (candidate.type.trace.parameterList stats.params.size)
        (annotation.storedBinders.take stats.params.size)
        annotationSuffix.cursor.Δ :=
      TypeChecker.CandidateParameterContext.of_fvarLamOnly
        annotationSuffix.cursor.shape
        (by simpa only [VLCtx.toCtx, List.append_nil] using
          annotationSuffix.context_eq)
        (by simpa only [VLCtx.fvars_nil, List.map_nil, List.append_nil] using
          annotationSuffix.fvars_eq)
    have annotationParameterLength :
        (candidate.type.trace.parameterList stats.params.size).length =
          stats.params.size := by
      have storedBound : stats.params.size ≤
          annotation.storedBinders.length := by
        rw [annotation.stored_length]
        exact rawAnnotationBound
      rw [annotationParams.length_eq]
      exact List.length_take_of_le storedBound
    have rawAnnotationPrefix :=
      annotation.telescope.take stats.params.size
    rw [telN_take_of_le raw.type rawAnnotationBound] at rawAnnotationPrefix
    have rawAnnotationPrefix' : TypeChecker.TelDefEqEvidence env Us.length []
        (VExpr.telN parameterSources.length raw.type)
        (annotation.storedBinders.take stats.params.size) := by
      simpa only [parameterLength] using rawAnnotationPrefix
    have storedAnnotation : TypeChecker.TelDefEqEvidence env Us.length []
        storedTypes (annotation.storedBinders.take stats.params.size) :=
      (rawResult.1.symm henv trivial).trans henv trivial
        rawAnnotationPrefix'
    have baseContext : base.toCtx = storedTypes.reverse := by
      simpa only [VLCtx.toCtx, List.append_nil] using
        TypeChecker.CandidateParameterContext.toCtx params
    have cursorContext : annotationSuffix.cursor.Δ.toCtx =
        (annotation.storedBinders.take stats.params.size).reverse := by
      simpa only [VLCtx.toCtx, List.append_nil] using
        annotationSuffix.context_eq
    have parameterContextEq : env.IsDefEqCtx Us.length [] base.toCtx
        annotationSuffix.cursor.Δ.toCtx := by
      rw [baseContext, cursorContext]
      simpa only [List.append_nil] using storedAnnotation.telDefEq.ctx
    have relation : VLCtx.FVarAlpha env Us.length base
        annotationSuffix.cursor.Δ :=
      VLCtx.FVarAlpha.of_defeqCtx
        (TypeChecker.CandidateParameterContext.fvarLamOnly params .nil)
        annotationSuffix.cursor.shape parameterContextEq
    have referenceWF : VLCtx.WF env Us.length contextAlignment.reference :=
      (contextAlignment.current_reference.symm henv.ordered).wf
    have baseWF : VLCtx.WF env Us.length base :=
      contextAlignment.root_reference_lift.wf henv referenceWF
    have candidateRootEq : candidate.type.trace.rootWhnf =
        kernelSource.type :=
      candidate.type.trace.rootWhnf_eq_source_of_spineLength_pos
        shape.storedSpine (by omega) semantic.type.whnfFuel
        semantic.type.whnfDepth
    have annotationInstantiation :=
      candidate.type.trace.instantiateParameterList_mainSpine position
        shape.storedSpine candidateRemaining semantic.type.whnfFuel
        semantic.type.whnfDepth
    rw [annotationSuffix.root_eq] at annotationInstantiation
    have rootScope : kernelSource.type.FVarsIn
        (fun fv => fv ∈ VLCtx.fvars ([] : VLCtx)) :=
      semantic.type.source_tr.fvarsIn
    have candidateRootScope : candidate.type.trace.rootWhnf.FVarsIn
        (fun fv => fv ∈ VLCtx.fvars ([] : VLCtx)) := by
      rw [candidateRootEq]
      exact rootScope
    have rootAlpha : Lean.Expr.abstractFVars ([] : VLCtx)
        kernelSource.type =
        Lean.Expr.abstractFVars ([] : VLCtx)
          candidate.type.trace.rootWhnf := by
      rw [candidateRootEq]
    have sourceAlpha := params.instantiateAlpha annotationParams baseWF
      cursorWF (by rw [parameterLength, annotationParameterLength])
      rootScope candidateRootScope rootAlpha rawInstantiation'
      annotationInstantiation
    have rawWhole : TrExprS env Us [] kernelSource.type
        (VExpr.forallN (VExpr.telN parameterSources.length raw.type)
          (VExpr.dropN parameterSources.length raw.type)) := by
      rw [VExpr.forallN_telN_dropN]
      exact semantic.type.source_tr
    have rawSuffixTr : TrExprS env Us base rest
        (VExpr.dropN parameterSources.length raw.type) :=
      params.instantiateForallRetypedResolved henv baseWF
        (rawResult.1.symm henv trivial) rawInstantiation' rawWhole
    have rawSuffixAtReference := rawSuffixTr.weakFV' henv.ordered
      contextAlignment.root_reference_lift referenceWF
    have rawSuffixAtCurrent := rawSuffixAtReference.defeqDFC_same henv
      (contextAlignment.current_reference.symm henv.ordered)
      contextAlignment.current_unique.symm
    have rawSuffixAtCurrent' : contextRun.candidate.context.TrExprS rest
        ((VExpr.dropN parameterSources.length raw.type).lift'
          (contextAlignment.rootLift.consN 0)) := by
      simpa only [TypeChecker.VContext.TrExprS, contextRun.venv_eq,
        contextRun.lparams_eq] using rawSuffixAtCurrent
    have cursorDepth : annotationSuffix.cursor.candidateContext.fuel.recDepth =
        semantic.type.whnfFuel + 1 := by
      calc
        annotationSuffix.cursor.candidateContext.fuel.recDepth =
            candidate.type.context.fuel.recDepth :=
          congrArg (fun fuel => fuel.recDepth) annotationSuffix.fuel_eq
        _ = semantic.type.whnfFuel + 1 := semantic.type.whnfDepth
    obtain ⟨sorts, suffixComputed, telescope⟩ :=
      annotationSuffix.cursor.constructorFieldSorts terminalWF contextRun
        rawSuffixAtCurrent' localState (Nat.le_refl _)
        (TypeChecker.CandidateParameterContext.fvarLamOnly params .nil)
        relation contextAlignment.root_reference_lift
        contextAlignment.current_reference rawSuffixTr.fvarsIn sourceAlpha
        cursorDomainsLength.symm semantic.type.whnfFuel cursorDepth
    have computed : validation.fieldSorts? Us = some sorts :=
      (validationSuffix.fieldSorts_eq Us).symm.trans suffixComputed
    exact ⟨{
      rest := rest
      validationSuffix := validationSuffix
      position := position
      viewSpineLength := viewSpineLength
      annotationSuffix := annotationSuffix
      sorts := sorts
      computed := computed
      telescope := telescope }⟩

/-- Exact validator-selected field semantics for every constructor in one
semantic family.  The dependent indices preserve source order and tie each
ordinary validation trace to the producer-owned semantic root, generation
shape, and annotation spine at that same position. -/
inductive CandidateConstructorValidationFieldStateList
    (source : VInductDecl) (env : VEnv) (Us : List Name)
    (stats : AddInductive.InductiveStats) (isUnsafe : Bool)
    (familyIdx : Nat) (context : AddInductive.Context) :
    {seen : NameSet} → {kernelSources : List Constructor} →
    (validation : AddInductive.ConstructorListValidationTrace stats isUnsafe
      familyIdx context seen kernelSources) →
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateConstructor kernelSources} →
    {raws : List VConstVal} →
    (semantics : CandidateConstructorSemanticListRun env Us candidates raws) →
      Type where
  | nil (seen : NameSet) :
      CandidateConstructorValidationFieldStateList source env Us stats
        isUnsafe familyIdx context (.nil seen) .nil
  | cons
      {seen : NameSet} {kernelSource : Constructor}
      {kernelSources : List Constructor}
      {fresh : seen.contains kernelSource.name = false}
      {closed : context.env.checkNoMVarNoFVar kernelSource.name
        kernelSource.type = .ok ()}
      {rootCheck : AddInductive.CandidateCheckTypeObservation
        context.withEmptyLocalContext kernelSource.type}
      {validation : AddInductive.ConstructorTypeValidationTrace stats
        isUnsafe familyIdx kernelSource.name context kernelSource.type 0
          context.fuel.inductiveFuel}
      {validationTail : AddInductive.ConstructorListValidationTrace stats
        isUnsafe familyIdx context (seen.insert kernelSource.name)
          kernelSources}
      {candidate : AddInductive.CandidateConstructor kernelSource}
      {candidates : AddInductive.CandidateList
        AddInductive.CandidateConstructor kernelSources}
      {raw : VConstVal} {raws : List VConstVal}
      {semantic : CandidateConstructorSemanticRun env Us candidate raw}
      {semantics : CandidateConstructorSemanticListRun env Us candidates raws}
      {shape : CandidateConstructorSemanticGenerationShape
        (source := source) env Us semantic}
      {annotation : CandidateConstructorAnnotationSpine source env Us
        semantic shape}
      (head : CandidateConstructorValidationFieldState source env Us
        validation semantic shape annotation)
      (tail : CandidateConstructorValidationFieldStateList source env Us
        stats isUnsafe familyIdx context validationTail semantics) :
      CandidateConstructorValidationFieldStateList source env Us stats
        isUnsafe familyIdx context
          (.cons seen kernelSource kernelSources fresh closed rootCheck
            validation validationTail)
          (CandidateConstructorSemanticListRun.cons
            (candidate := candidate) (candidates := candidates)
            (raw := raw) (raws := raws) semantic semantics)

namespace CandidateConstructorValidationFieldStateList

/-- Build one family's complete field-semantic inventory from structural
spine alignment.  No constructor/view alignment executable is involved. -/
theorem nonempty_of_spineAlignment
    {source : VInductDecl} {env : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {isUnsafe : Bool}
    {familyIdx : Nat} {context : AddInductive.Context}
    {contextRun : AddInductive.ConstructorContextRun env Us context}
    {seen : NameSet} {kernelSources : List Constructor}
    {validation : AddInductive.ConstructorListValidationTrace stats isUnsafe
      familyIdx context seen kernelSources}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateConstructor kernelSources}
    {raws : List VConstVal}
    (spineAlignment : AddInductive.ConstructorCandidateSpineAlignment stats
      isUnsafe familyIdx context validation candidates)
    (semantics : CandidateConstructorSemanticListRun env Us candidates raws)
    (shapes : CandidateConstructorSemanticGenerationShapeList source env Us
      semantics)
    (annotations : CandidateConstructorAnnotationSpineList source env Us
      semantics shapes)
    {base : VLCtx} {parameterSources : List Expr}
    {storedTypes : List VExpr}
    (params : TypeChecker.CandidateParameterContext [] parameterSources
      storedTypes base)
    (localState : TypeChecker.FamilyParameterLocalState stats context)
    (contextAlignment : ConstructorSharedParameterContextAlignment env Us
      base contextRun)
    (parameterSources_eq : stats.params.toList = parameterSources) :
    Nonempty (CandidateConstructorValidationFieldStateList source env Us
      stats isUnsafe familyIdx context validation semantics) := by
  induction spineAlignment generalizing raws with
  | nil =>
      cases semantics
      cases shapes
      cases annotations
      exact ⟨.nil _⟩
  | @cons seen kernelSource kernelSources fresh closed rootCheck validation
      validationTail candidate candidates rootScope storedSpine spineLength
      viewSpineLength tailAlignment ih =>
      cases semantics with
      | cons semantic semantics =>
          cases shapes with
          | cons shape shapes =>
              cases annotations with
              | cons annotation annotations =>
                  obtain ⟨head⟩ := annotation.validationFieldState params
                    localState contextAlignment parameterSources_eq spineLength
                    viewSpineLength
                  obtain ⟨tail⟩ := ih semantics shapes annotations
                  exact ⟨.cons head tail⟩

end CandidateConstructorValidationFieldStateList

/-- Family-major validator-selected field semantics for a complete mutual
block. -/
inductive CandidateBlockConstructorValidationFieldStateLists
    (source : VInductDecl) (env blockEnv : VEnv) (Us : List Name)
    (stats : AddInductive.InductiveStats) (isUnsafe : Bool)
    (context : AddInductive.Context) :
    {familyIdx : Nat} → {kernelSources : List InductiveType} →
    (validation : AddInductive.ConstructorBlockValidationTraces stats
      isUnsafe context familyIdx kernelSources) →
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily kernelSources} →
    {raws : List VInductiveType} →
    (semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws) →
      Type where
  | nil : CandidateBlockConstructorValidationFieldStateLists source env
      blockEnv Us stats isUnsafe context .nil .nil
  | cons
      {familyIdx : Nat} {kernelSource : InductiveType}
      {kernelSources : List InductiveType}
      {validationHead : AddInductive.ConstructorListValidationTrace stats
        isUnsafe familyIdx context {} kernelSource.ctors}
      {validationTail : AddInductive.ConstructorBlockValidationTraces stats
        isUnsafe context (familyIdx + 1) kernelSources}
      {candidate : AddInductive.CandidateFamily kernelSource}
      {candidates : AddInductive.CandidateList
        AddInductive.CandidateFamily kernelSources}
      {raw : VInductiveType} {raws : List VInductiveType}
      {semantic : CandidateBlockFamilySemanticRun env blockEnv Us candidate raw}
      {semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
        candidates raws}
      (head : CandidateConstructorValidationFieldStateList source blockEnv Us
        stats isUnsafe familyIdx context validationHead semantic.constructors)
      (tail : CandidateBlockConstructorValidationFieldStateLists source env
        blockEnv Us stats isUnsafe context validationTail semantics) :
      CandidateBlockConstructorValidationFieldStateLists source env blockEnv
        Us stats isUnsafe context (.cons validationHead validationTail)
          (.cons semantic semantics)

namespace CandidateBlockConstructorValidationFieldStateLists

/-- Build the complete family-major field-semantic inventory from the
producer-forced block spine alignment. -/
theorem nonempty_of_spineAlignment
    {source : VInductDecl} {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {contextRun : AddInductive.ConstructorContextRun blockEnv Us context}
    {familyIdx : Nat} {kernelSources : List InductiveType}
    {validation : AddInductive.ConstructorBlockValidationTraces stats
      isUnsafe context familyIdx kernelSources}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily kernelSources}
    {raws : List VInductiveType}
    (spineAlignment : AddInductive.ConstructorBlockCandidateSpineAlignment
      stats isUnsafe context validation candidates)
    (semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws)
    (shapes : CandidateBlockFamilySemanticGenerationShapeList source env
      blockEnv Us semantics)
    (annotations : CandidateBlockConstructorAnnotationSpineLists source env
      blockEnv Us semantics shapes)
    {base : VLCtx} {parameterSources : List Expr}
    {storedTypes : List VExpr}
    (params : TypeChecker.CandidateParameterContext [] parameterSources
      storedTypes base)
    (localState : TypeChecker.FamilyParameterLocalState stats context)
    (contextAlignment : ConstructorSharedParameterContextAlignment blockEnv Us
      base contextRun)
    (parameterSources_eq : stats.params.toList = parameterSources) :
    Nonempty (CandidateBlockConstructorValidationFieldStateLists source env
      blockEnv Us stats isUnsafe context validation semantics) := by
  induction spineAlignment generalizing raws with
  | nil =>
      cases semantics
      cases shapes
      cases annotations
      exact ⟨.nil⟩
  | cons headAlignment tailAlignment ih =>
      cases semantics with
      | cons semantic semantics =>
          cases shapes with
          | cons shape shapes =>
              cases annotations with
              | cons annotationsHead annotationsTail =>
                  obtain ⟨head⟩ :=
                    CandidateConstructorValidationFieldStateList.nonempty_of_spineAlignment
                      headAlignment
                      semantic.constructors shape.constructors
                      annotationsHead params localState contextAlignment
                      parameterSources_eq
                  obtain ⟨tail⟩ := ih semantics shapes annotationsTail
                  exact ⟨.cons head tail⟩

end CandidateBlockConstructorValidationFieldStateLists

/-- Project exact validator-selected field semantics directly from the
alignment-audit-free constructor inventory. -/
theorem CandidateBlockConstructorSpineSemanticInventoryState.validationFields
    {source : VInductDecl} {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {isUnsafe : Bool}
    {context : AddInductive.Context} {base : VLCtx} {nparams : Nat}
    {parameterSources : List Expr} {storedTypes : List VExpr}
    {params : TypeChecker.CandidateParameterContext [] parameterSources
      storedTypes base}
    {familyIdx : Nat} {kernelSources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily kernelSources}
    {raws : List VInductiveType}
    {validation : AddInductive.ConstructorBlockValidationTraces stats
      isUnsafe context familyIdx kernelSources}
    {semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws}
    (inventory : CandidateBlockConstructorSpineSemanticInventoryState source
      env blockEnv Us stats isUnsafe context base nparams parameterSources
        storedTypes params validation semantics) :
    Nonempty (CandidateBlockConstructorValidationFieldStateLists source env
      blockEnv Us stats isUnsafe context validation semantics) :=
  CandidateBlockConstructorValidationFieldStateLists.nonempty_of_spineAlignment
    inventory.spineAlignment semantics
    inventory.generationShapes inventory.annotationSpines params
    inventory.parameterLocalState inventory.parameterContext
    inventory.parameterSources_eq

end VInductDecl

namespace ConstructorValidation
open AddInductive TypeChecker
open _root_.Lean4Lean.ConstructorValidation.VEnv _root_.Lean4Lean.TypeChecker.VEnv

private theorem structuralConstructorArity_instantiate1'_fvar
    (source : Expr) (fresh : FVarId) (depth arity : Nat) :
    AddInductive.constructorArity
        (source.instantiate1' (.fvar fresh) depth) arity =
      AddInductive.constructorArity source arity := by
  induction source generalizing depth arity <;>
    simp [Expr.instantiate1', Expr.liftLooseBVars',
      AddInductive.constructorArity, *]
  case bvar index =>
    split
    · rfl
    · split <;> rfl

private theorem structuralConstructorArity_instantiate1_fvar
    (source : Expr) (fresh : FVarId) :
    AddInductive.constructorArity (source.instantiate1 (.fvar fresh)) 0 =
      AddInductive.constructorArity source 0 := by
  simpa only [Expr.instantiate1_eq] using
    structuralConstructorArity_instantiate1'_fvar source fresh 0 0

/-- Instantiating a constructor prefix by the retained shared free variables
removes exactly that many literal Pi binders. -/
private theorem structuralInstantiateFamilyParameters_constructorArity
    {source suffix : Expr} {parameters : List Expr}
    (fvars : ∀ parameter ∈ parameters, ∃ fv, parameter = .fvar fv)
    (run : instantiateFamilyParameters source parameters = .ok suffix) :
    AddInductive.constructorArity source 0 = parameters.length +
      AddInductive.constructorArity suffix 0 := by
  induction parameters generalizing source with
  | nil =>
      change Except.ok source = Except.ok suffix at run
      have sourceEq := Except.ok.inj run
      subst suffix
      simp
  | cons parameter parameters ih =>
      obtain ⟨fv, parameterEq⟩ := fvars parameter (.head _)
      subst parameter
      cases source with
      | forallE name domain body binderInfo =>
          simp only [instantiateFamilyParameters] at run
          have tailFVars : ∀ parameter ∈ parameters,
              ∃ fv, parameter = .fvar fv := by
            intro parameter member
            exact fvars parameter (.tail _ member)
          have tailArity := ih tailFVars run
          rw [structuralConstructorArity_instantiate1_fvar] at tailArity
          simp only [AddInductive.constructorArity, List.length_cons]
          rw [AddInductive.constructorArity_eq_zero_add, tailArity]
          omega
      | bvar | fvar | mvar | sort | const | app | lam | letE | lit | mdata |
          proj =>
          simp only [instantiateFamilyParameters] at run
          contradiction

/-- A successful construction-owned D3 traversal fixes the complete outer
Pi count of any strict Theory translation of its source.  Unlike the
resolved Stage-3 count theorem, the terminal case is owned by D3's exact
family application, so no projection-name premise is needed. -/
private theorem
    ConstructorMutualPreFamilyViewSemanticRun.ctorFields_length_of_translation
    {env typeEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {owner : Nat} {ownerSuffix : Expr} {familySuffixes : List Expr}
    {context : AddInductive.Context} {view : Expr} {argIdx : Nat}
    {removed : List FVarId} {recursiveStarted : Bool}
    {contextRun : AddInductive.ConstructorContextRun env Us context}
    {trace : AddInductive.ConstructorMutualPreFamilyViewTrace stats owner
      ownerSuffix familySuffixes context view argIdx removed recursiveStarted}
    (d3 : AddInductive.ConstructorMutualPreFamilyViewSemanticRun env Us stats
      owner ownerSuffix familySuffixes contextRun trace)
    (henv : VEnv.WF env) (typeEnvWF : VEnv.WF typeEnv)
    (addType : env ≤ typeEnv)
    {common full d3ViewContext : VLCtx} {fullLift viewLift : Lift}
    (d3State : D3FullContextState env typeEnv Us context common full
      contextRun.candidate.context.vlctx d3ViewContext fullLift viewLift)
    (removedInvariant : FullRemovedInvariant common full removed)
    (sourceClosed : Closed view)
    {target : VExpr}
    (wholeTr : TrExprS typeEnv Us full view target)
    (parametersDone : stats.params.size ≤ argIdx)
    {familyName : Name} {familyLevels : List Level}
    (familyHead : stats.indConsts[owner]! =
      .const familyName familyLevels) :
    (VInductDecl.ctorFields target).length =
      AddInductive.constructorArity view 0 := by
  induction d3 generalizing common full d3ViewContext fullLift viewLift
      target with
  | @parameter context parameterArgIdx removed recursiveStarted name domain
      body binderInfo parameter parameterAt tailTrace contextRun tail ih =>
      have parameterLt : parameterArgIdx < stats.params.size :=
        (Array.getElem?_eq_some_iff.mp parameterAt).1
      omega
  | @ordinary context ordinaryArgIdx removed recursiveStarted name domain body
      binderInfo noParameter nonrecursive independent domainCheck ensureType
      consumedCheck annotations fresh tailTrace contextRun domainRun
      consumedRun ensureTypeRun annotationsRun consumedType tail ih =>
      obtain ⟨translatedField, translatedBody, targetEq,
          translatedFieldType, _translatedBodyType, translatedFieldTr,
          translatedBodyTr⟩ := TrExprS.forallE_components wholeTr
      have domainFVars : FVarsIn (· ∈ common.fvars) domain :=
        constructorIndependentOf_fvars translatedFieldTr.fvarsIn independent
          removedInvariant
      have actualFieldTr : TrExprS env Us
          contextRun.candidate.context.vlctx domain domainRun.source' := by
        simpa only [contextRun.venv_eq, contextRun.lparams_eq] using
          domainRun.check.expr_tr
      have actualFieldType : env.HasType Us.length
          contextRun.candidate.context.vlctx.toCtx domainRun.source'
          (.sort ensureTypeRun.resultLevel') := by
        simpa only [contextRun.venv_eq, contextRun.lparams_eq] using
          ensureTypeRun.source_type
      have actualAnnotations : env.IsDefEqU Us.length
          contextRun.candidate.context.vlctx.toCtx domainRun.source'
          consumedRun.source' := by
        simpa only [contextRun.venv_eq, contextRun.lparams_eq] using
          annotationsRun.isDefEqU
      obtain ⟨consumedLevel, actualConsumedType⟩ := consumedType
      have actualConsumedType' : env.HasType Us.length
          contextRun.candidate.context.vlctx.toCtx consumedRun.source'
          (.sort consumedLevel) := by
        simpa only [contextRun.venv_eq, contextRun.lparams_eq] using
          actualConsumedType
      let nextD3ContextRun := contextRun.pushLocalDecl name binderInfo
        (consumeTypeAnnotations domain) fresh consumedRun.source'
        consumedRun.check.expr_tr ⟨consumedLevel, actualConsumedType⟩
      have actualTailWF : VLCtx.WF env Us.length
          ((some (context.freshFVarId,
              (consumeTypeAnnotations domain).fvarsList),
            .vlam consumedRun.source') ::
            contextRun.candidate.context.vlctx) := by
        have nextWF := nextD3ContextRun.candidate.context.Δwf
        rw [nextD3ContextRun.venv_eq, nextD3ContextRun.lparams_eq] at nextWF
        exact nextWF
      obtain ⟨commonDomain, field, commonDomainTr, fieldTr, fieldEq,
          commonDomainType, nextD3State⟩ :=
        d3State.pushResolved (name := name) (binderInfo := binderInfo)
          henv typeEnvWF addType sourceClosed.1 domainFVars actualFieldTr
          actualFieldType actualAnnotations actualTailWF
      obtain ⟨translatedFieldLevel, translatedFieldHasType⟩ :=
        translatedFieldType
      have domainDefEqU : typeEnv.IsDefEqU Us.length full.toCtx
          translatedField field :=
        translatedFieldTr.uniq typeEnvWF
          (.refl typeEnvWF d3State.fullWF) fieldTr
      have domainDefEq : typeEnv.IsDefEq Us.length full.toCtx
          translatedField field (.sort translatedFieldLevel) :=
        domainDefEqU.of_l typeEnvWF d3State.fullWF.toCtx
          translatedFieldHasType
      have originalTailWF : VLCtx.WF typeEnv Us.length
          ((some (context.freshFVarId,
              (consumeTypeAnnotations domain).fvarsList),
            .vlam translatedField) :: full) :=
        ⟨d3State.fullWF, nextD3State.fullWF.2.1,
          ⟨translatedFieldLevel, translatedFieldHasType⟩⟩
      have bodyOpenedOriginal : TrExprS typeEnv Us
          ((some (context.freshFVarId,
              (consumeTypeAnnotations domain).fvarsList),
            .vlam translatedField) :: full)
          (body.instantiate1 context.freshExpr) translatedBody := by
        simpa only [AddInductive.Context.freshExpr,
          Expr.instantiate1_eq] using
            translatedBodyTr.inst_fvar typeEnvWF.ordered originalTailWF
      have openedContexts : VLCtx.IsDefEq typeEnv Us.length
          ((some (context.freshFVarId,
              (consumeTypeAnnotations domain).fvarsList),
            .vlam translatedField) :: full)
          ((some (context.freshFVarId,
              (consumeTypeAnnotations domain).fvarsList),
            .vlam field) :: full) :=
        .cons (.refl typeEnvWF d3State.fullWF) originalTailWF.2.1
          (.vlam domainDefEq)
      have openedValues : TrExprS.IsUniqueCtx
          ((some (context.freshFVarId,
              (consumeTypeAnnotations domain).fvarsList),
            .vlam translatedField) :: full)
          ((some (context.freshFVarId,
              (consumeTypeAnnotations domain).fvarsList),
            .vlam field) :: full) := .cons .base .vlam
      have bodyOpened : TrExprS typeEnv Us
          ((some (context.freshFVarId,
              (consumeTypeAnnotations domain).fvarsList),
            .vlam field) :: full)
          (body.instantiate1 context.freshExpr) translatedBody :=
        bodyOpenedOriginal.defeqDFC_same typeEnvWF openedContexts
          openedValues
      have nextFullNoBV :
          VLCtx.bvars (((some (context.freshFVarId,
              (consumeTypeAnnotations domain).fvarsList),
            .vlam field) :: full) : VLCtx) = 0 :=
        nextD3State.fullExtension.bvars_eq.trans nextD3State.commonNoBV
      have tailClosed : Closed (body.instantiate1 context.freshExpr) := by
        have closed := bodyOpened.closed
        rw [nextFullNoBV] at closed
        exact closed
      have tailCount := ih nextD3State removedInvariant.push tailClosed
        bodyOpened (by omega)
      have instantiatedArity : AddInductive.constructorArity
          (body.instantiate1 context.freshExpr) 0 =
          AddInductive.constructorArity body 0 := by
        simpa only [AddInductive.Context.freshExpr] using
          structuralConstructorArity_instantiate1_fvar body
            context.freshFVarId
      rw [targetEq]
      simp only [VInductDecl.ctorFields, List.length_cons,
        AddInductive.constructorArity]
      rw [AddInductive.constructorArity_eq_zero_add, ← instantiatedArity,
        tailCount]
  | @recursive context recursiveArgIdx removed recursiveStarted name domain
      body binderInfo noParameter isRecursive independent shape targetSuffix
      targetAt fieldTrace fresh tailTrace contextRun recursiveRun tail ih =>
      obtain ⟨translatedField, translatedBody, targetEq,
          translatedFieldType, _translatedBodyType, _translatedFieldTr,
          translatedBodyTr⟩ := TrExprS.forallE_components wholeTr
      obtain ⟨translatedFieldLevel, translatedFieldHasType⟩ :=
        translatedFieldType
      have depsSubset : (consumeTypeAnnotations domain).fvarsList ⊆
          full.fvars :=
        (FVarsIn.consumeTypeAnnotations wholeTr.fvarsIn.1 |>
          fvarsIn_iff.mp).1
      have freshActual : context.freshFVarId ∉
          contextRun.candidate.context.vlctx.fvars := by
        apply contextRun.candidate.context.trlctx.find?_eq_none.mp
        change contextRun.candidate.context.mlctx.lctx.find?
            context.freshFVarId = none
        rw [contextRun.candidate.context.lctx_eq,
          contextRun.candidate.context_lctx]
        exact fresh
      have freshCommon : context.freshFVarId ∉ common.fvars := by
        intro present
        have presentView := d3State.viewExtension.fvars_sublist.subset present
        have presentActual : context.freshFVarId ∈
            contextRun.candidate.context.vlctx.fvars := by
          simpa only [d3State.viewDefEq.fvars] using presentView
        exact freshActual presentActual
      have freshFull := d3State.freshInvariant.fresh freshCommon
      have nextFullWF : VLCtx.WF typeEnv Us.length
          ((some (context.freshFVarId,
              (consumeTypeAnnotations domain).fvarsList),
            .vlam translatedField) :: full) := by
        refine ⟨d3State.fullWF, ?_,
          ⟨translatedFieldLevel, translatedFieldHasType⟩⟩
        intro fv deps equality
        cases equality
        exact ⟨freshFull, depsSubset⟩
      have nextD3State : D3FullContextState env typeEnv Us
          context.advanceFresh common
          ((some (context.freshFVarId,
              (consumeTypeAnnotations domain).fvarsList),
            .vlam translatedField) :: full)
          contextRun.advanceFresh.candidate.context.vlctx d3ViewContext
          (.skipN fullLift 1) viewLift := by
        simpa only [AddInductive.ConstructorContextRun.advanceFresh,
          AddInductive.advanceCandidateContextRun] using
            d3State.skip (source := domain) nextFullWF
      have bodyOpened : TrExprS typeEnv Us
          ((some (context.freshFVarId,
              (consumeTypeAnnotations domain).fvarsList),
            .vlam translatedField) :: full)
          (body.instantiate1 context.freshExpr) translatedBody := by
        simpa only [AddInductive.Context.freshExpr,
          Expr.instantiate1_eq] using
            translatedBodyTr.inst_fvar typeEnvWF.ordered nextFullWF
      have nextFullNoBV :
          VLCtx.bvars (((some (context.freshFVarId,
              (consumeTypeAnnotations domain).fvarsList),
            .vlam translatedField) :: full) : VLCtx) = 0 :=
        nextD3State.fullExtension.bvars_eq.trans nextD3State.commonNoBV
      have tailClosed : Closed (body.instantiate1 context.freshExpr) := by
        have closed := bodyOpened.closed
        rw [nextFullNoBV] at closed
        exact closed
      have tailCount := ih nextD3State
        (removedInvariant.skip freshFull) tailClosed bodyOpened (by omega)
      have instantiatedArity : AddInductive.constructorArity
          (body.instantiate1 context.freshExpr) 0 =
          AddInductive.constructorArity body 0 := by
        simpa only [AddInductive.Context.freshExpr] using
          structuralConstructorArity_instantiate1_fvar body
            context.freshFVarId
      rw [targetEq]
      simp only [VInductDecl.ctorFields, List.length_cons,
        AddInductive.constructorArity]
      rw [AddInductive.constructorArity_eq_zero_add, ← instantiatedArity,
        tailCount]
  | @terminal context terminalSource terminalArgIdx removed recursiveStarted
      valid independent spineTrace contextRun expected spine =>
      have terminalSourceHead : terminalSource.getAppFn =
          .const familyName familyLevels :=
        isValidIndAppIdx_getAppFn_eq valid familyHead
      obtain ⟨_targetLevels, targetHead, _argumentsTr⟩ :=
        TrExprS.constApp_components wholeTr terminalSourceHead
      have sourceArity : AddInductive.constructorArity terminalSource 0 =
          0 := by
        cases terminalSource <;>
          simp_all [AddInductive.constructorArity, Expr.getAppFn]
      have targetFields : (VInductDecl.ctorFields target).length = 0 := by
        cases target <;> simp_all [VInductDecl.ctorFields, VExpr.appHead]
      exact targetFields.trans sourceArity.symm

/-- Projection-aware block-field assembly driven only by the construction
owned pre-family semantics.  The analyzer-side field telescope and its exact
validator universe bounds replace the supplemental post-family alignment
replay: each selected D3 field is transported from the corresponding
analyzer field by definitional equality before the recursive call. -/
theorem constructorBlockFields_structural
    {env typeEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {owner : Nat} {ownerSuffix : Expr} {familySuffixes : List Expr}
    {d3Context : AddInductive.Context}
    {d3ContextRun : AddInductive.ConstructorContextRun env Us d3Context}
    {view : Expr} {argIdx : Nat} {removed : List FVarId}
    {recursiveStarted : Bool}
    {d3Trace : AddInductive.ConstructorMutualPreFamilyViewTrace stats owner
      ownerSuffix familySuffixes d3Context view argIdx removed
      recursiveStarted}
    (d3 : AddInductive.ConstructorMutualPreFamilyViewSemanticRun env Us stats
      owner ownerSuffix familySuffixes d3ContextRun d3Trace)
    (henv : VEnv.WF env) (typeEnvWF : VEnv.WF typeEnv)
    (addType : env ≤ typeEnv)
    {common full d3ViewContext : VLCtx}
    {fullLift viewLift : Lift}
    (d3State : D3FullContextState env typeEnv Us d3Context common full
      d3ContextRun.candidate.context.vlctx d3ViewContext fullLift viewLift)
    (removedInvariant : FullRemovedInvariant common full removed)
    {source : VInductDecl} {familyIndices : List (List VExpr)}
    {ownerIndices : List VExpr} {fieldIndex : Nat}
    {resultLevel : VLevel}
    (targets : ResolvedMutualFamilyTargetState env typeEnv Us stats
      (VInductDecl.familyHeaders source.nparams source.types)
      familySuffixes familyIndices common full fieldIndex fullLift)
    (ownerAt : familySuffixes[owner]? = some ownerSuffix)
    (ownerIndicesAt : familyIndices[owner]? = some ownerIndices)
    (sourceUvars : source.uvars = Us.length)
    (sourceNparams : source.nparams = stats.params.size)
    (levelsTr : stats.levels.mapM (VLevel.ofLevel Us) =
      some (VLevel.params Us.length))
    (familyFresh : ∀ name,
      name ∈ VInductDecl.familyNames source.types →
        env.constants name = none)
    (headerNames : ∀ {i : Nat} {header : VInductDecl.FamilyHeader},
      (VInductDecl.familyHeaders source.nparams source.types)[i]? =
          some header →
        header.name ∈ VInductDecl.familyNames source.types)
    (headerNameInjective :
      ∀ {i j : Nat} {left right : VInductDecl.FamilyHeader},
        (VInductDecl.familyHeaders source.nparams source.types)[i]? =
            some left →
          (VInductDecl.familyHeaders source.nparams source.types)[j]? =
            some right →
          left.name = right.name → i = j)
    (sourceClosed : Closed view)
    {analyzerFields : List VExpr} {analyzerResult : VExpr}
    {fieldSorts : List VLevel}
    (wholeTr : TrExprS typeEnv Us full view
      (VExpr.forallN analyzerFields analyzerResult))
    (parameterTranslations : List.Forall₂ (TrExprS typeEnv Us full)
      stats.params.toList
      (VExpr.bvarRevRange fieldIndex stats.params.size))
    (parametersDone : stats.params.size ≤ argIdx)
    (analyzerResultNotForall : ∀ domain body,
      analyzerResult ≠ .forallE domain body)
    (fieldTelescope : typeEnv.OnSortTel Us.length full.toCtx
      analyzerFields fieldSorts)
    (fieldBounds : List.All (fun fieldLevel =>
      resultLevel ≈ .zero ∨ fieldLevel ≤ resultLevel) fieldSorts) :
    ∃ fields resultTarget,
      TrExprS typeEnv Us full view
          (VExpr.forallN fields resultTarget) ∧
        ConstructorBlockFieldsRunResult source env resultLevel familyIndices
          full ownerIndices fields fieldIndex resultTarget ∧
        VInductDecl.blockStage3Ctor source.uvars source.nparams
          (VInductDecl.familyHeaders source.nparams source.types)
          (VInductDecl.familyNames source.types) owner fieldIndex
          (VExpr.forallN fields resultTarget) = true ∧
        (∀ domain body, resultTarget ≠ .forallE domain body) ∧
        typeEnv.OnSortTel Us.length full.toCtx fields fieldSorts := by
  induction d3 generalizing common full d3ViewContext fullLift viewLift
      analyzerFields analyzerResult fieldSorts fieldIndex with
  | @parameter context parameterArgIdx removed recursiveStarted name domain
      body binderInfo parameter parameterAt tailTrace contextRun tail ih =>
      have parameterLt : parameterArgIdx < stats.params.size :=
        (Array.getElem?_eq_some_iff.mp parameterAt).1
      omega
  | @ordinary context ordinaryArgIdx removed recursiveStarted name domain body
      binderInfo noParameter nonrecursive independent domainCheck ensureType
      consumedCheck annotations fresh tailTrace contextRun domainRun
      consumedRun ensureTypeRun annotationsRun consumedType tail ih =>
      cases analyzerFields with
      | nil =>
          obtain ⟨analyzerField, analyzerBody, targetEq, _fieldType,
              _bodyType, _fieldTr, _bodyTr⟩ :=
            TrExprS.forallE_components wholeTr
          simp only [VExpr.forallN] at targetEq
          exact (analyzerResultNotForall analyzerField analyzerBody
            targetEq).elim
      | cons analyzerField analyzerFields =>
          cases fieldTelescope with
          | @cons _ _ fieldSort _ fieldSorts analyzerFieldType
              analyzerTailTelescope =>
            cases fieldBounds with
            | intro analyzerFieldBound analyzerTailBounds =>
              simp only [VExpr.forallN] at wholeTr
              obtain ⟨translatedField, translatedBody, targetEq,
                  _translatedFieldType, analyzerBodyType, analyzerFieldTr,
                  analyzerBodyTr⟩ := TrExprS.forallE_components wholeTr
              simp only [VExpr.forallE.injEq] at targetEq
              obtain ⟨rfl, rfl⟩ := targetEq
              have domainFVars : FVarsIn (· ∈ common.fvars) domain :=
                constructorIndependentOf_fvars analyzerFieldTr.fvarsIn
                  independent removedInvariant
              have actualFieldTr : TrExprS env Us
                  contextRun.candidate.context.vlctx domain
                  domainRun.source' := by
                simpa only [contextRun.venv_eq, contextRun.lparams_eq]
                  using domainRun.check.expr_tr
              have actualFieldType : env.HasType Us.length
                  contextRun.candidate.context.vlctx.toCtx
                  domainRun.source' (.sort ensureTypeRun.resultLevel') := by
                simpa only [contextRun.venv_eq, contextRun.lparams_eq]
                  using ensureTypeRun.source_type
              have actualAnnotations : env.IsDefEqU Us.length
                  contextRun.candidate.context.vlctx.toCtx
                  domainRun.source' consumedRun.source' := by
                simpa only [contextRun.venv_eq, contextRun.lparams_eq]
                  using annotationsRun.isDefEqU
              obtain ⟨consumedLevel, actualConsumedType⟩ := consumedType
              have actualConsumedType' : env.HasType Us.length
                  contextRun.candidate.context.vlctx.toCtx
                  consumedRun.source' (.sort consumedLevel) := by
                simpa only [contextRun.venv_eq, contextRun.lparams_eq]
                  using actualConsumedType
              let nextD3ContextRun := contextRun.pushLocalDecl name
                binderInfo (consumeTypeAnnotations domain) fresh
                consumedRun.source' consumedRun.check.expr_tr
                ⟨consumedLevel, actualConsumedType⟩
              have actualTailWF : VLCtx.WF env Us.length
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam consumedRun.source') ::
                    contextRun.candidate.context.vlctx) := by
                have nextWF := nextD3ContextRun.candidate.context.Δwf
                rw [nextD3ContextRun.venv_eq,
                  nextD3ContextRun.lparams_eq] at nextWF
                exact nextWF
              obtain ⟨commonDomain, field, commonDomainTr, fieldTr,
                  fieldEq, commonDomainType, nextD3State⟩ :=
                d3State.pushResolved (name := name)
                  (binderInfo := binderInfo) henv typeEnvWF addType
                  sourceClosed.1 domainFVars actualFieldTr actualFieldType
                  actualAnnotations actualTailWF
              have fieldBaseType : env.HasType Us.length full.toCtx field
                  (.sort ensureTypeRun.resultLevel') := by
                rw [fieldEq]
                exact commonDomainType.weak' henv.ordered
                  d3State.fullExtension.toCtx
              have domainDefEqU : typeEnv.IsDefEqU Us.length full.toCtx
                  analyzerField field :=
                analyzerFieldTr.uniq typeEnvWF
                  (.refl typeEnvWF d3State.fullWF) fieldTr
              have domainDefEq : typeEnv.IsDefEq Us.length full.toCtx
                  analyzerField field (.sort fieldSort) :=
                domainDefEqU.of_l typeEnvWF d3State.fullWF.toCtx
                  analyzerFieldType
              have selectedFieldType : typeEnv.HasType Us.length full.toCtx
                  field (.sort fieldSort) := domainDefEq.hasType.2
              have levelEq : ensureTypeRun.resultLevel' ≈ fieldSort :=
                (fieldBaseType.mono addType).uniqU typeEnvWF
                  d3State.fullWF.toCtx selectedFieldType |>.sort_inv
                    typeEnvWF d3State.fullWF.toCtx
              have fieldBound : resultLevel ≈ .zero ∨
                  ensureTypeRun.resultLevel' ≤ resultLevel := by
                rcases analyzerFieldBound with prop | bound
                · exact .inl prop
                · exact .inr <| VLevel.le_trans
                    (VLevel.le_antisymm_iff.mp levelEq).1 bound
              have commonFree : commonDomain.hasAnyConst
                  (VInductDecl.familyNames source.types) = false := by
                simp only [VExpr.hasAnyConst, List.any_eq_false]
                intro familyName member
                simpa [Bool.not_eq_true'] using
                  commonDomainType.hasConst_false_of_absent henv.ordered
                    d3State.commonWF.toCtx (familyFresh familyName member)
              have fieldFree : field.hasAnyConst
                  (VInductDecl.familyNames source.types) = false := by
                rw [fieldEq, VExpr.hasAnyConst_lift']
                exact commonFree
              have recNone :=
                VInductDecl.blockRecArg?_eq_none_of_hasAnyConst_false
                  (U := Us.length) (np := stats.params.size)
                  (j := fieldIndex) (expression := field)
                  headerNames fieldFree
              have recNoneSource : VInductDecl.blockRecArg?
                  source.uvars source.nparams
                  (VInductDecl.familyHeaders source.nparams source.types)
                  (VInductDecl.familyNames source.types) fieldIndex field =
                    none := by
                simpa only [sourceUvars, sourceNparams] using recNone
              have nextD3State' : D3FullContextState env typeEnv Us
                  (context.pushLocalDecl name binderInfo
                    (consumeTypeAnnotations domain))
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam commonDomain) :: common)
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam field) :: full)
                  nextD3ContextRun.candidate.context.vlctx
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam (commonDomain.lift' viewLift)) :: d3ViewContext)
                  (.consN fullLift 1) (.consN viewLift 1) := nextD3State
              have nextTargets : ResolvedMutualFamilyTargetState env typeEnv
                  Us stats
                  (VInductDecl.familyHeaders source.nparams source.types)
                  familySuffixes familyIndices
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam commonDomain) :: common)
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam field) :: full) (fieldIndex + 1)
                  (.consN fullLift 1) :=
                ResolvedMutualFamilyTargetState.push targets henv typeEnvWF
                  nextD3State'.commonWF nextD3State'.fullWF
              have originalTailWF : VLCtx.WF typeEnv Us.length
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam analyzerField) :: full) :=
                ⟨d3State.fullWF, nextD3State'.fullWF.2.1,
                  ⟨fieldSort, analyzerFieldType⟩⟩
              have bodyOpenedOriginal : TrExprS typeEnv Us
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam analyzerField) :: full)
                  (body.instantiate1 context.freshExpr)
                  (VExpr.forallN analyzerFields analyzerResult) := by
                simpa only [AddInductive.Context.freshExpr,
                  Expr.instantiate1_eq] using
                    analyzerBodyTr.inst_fvar typeEnvWF.ordered originalTailWF
              have openedContexts : VLCtx.IsDefEq typeEnv Us.length
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam analyzerField) :: full)
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam field) :: full) :=
                .cons (.refl typeEnvWF d3State.fullWF)
                  originalTailWF.2.1 (.vlam domainDefEq)
              have openedValues : TrExprS.IsUniqueCtx
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam analyzerField) :: full)
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam field) :: full) := .cons .base .vlam
              have bodyOpened : TrExprS typeEnv Us
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam field) :: full)
                  (body.instantiate1 context.freshExpr)
                  (VExpr.forallN analyzerFields analyzerResult) :=
                bodyOpenedOriginal.defeqDFC_same typeEnvWF openedContexts
                  openedValues
              have tailTelescope : typeEnv.OnSortTel Us.length
                  (field :: full.toCtx) analyzerFields fieldSorts := by
                simpa only [VLCtx.toCtx] using
                  analyzerTailTelescope.defeqDFC typeEnvWF.ordered
                    openedContexts.defeqCtx
              have nextParameterTranslations : List.Forall₂
                  (TrExprS typeEnv Us
                    ((some (context.freshFVarId,
                        (consumeTypeAnnotations domain).fvarsList),
                      .vlam field) :: full))
                  stats.params.toList
                  (VExpr.bvarRevRange (fieldIndex + 1)
                    stats.params.size) := by
                have weakened := forall₂_tr_push_fvar typeEnvWF.ordered
                  nextD3State'.fullWF parameterTranslations
                simpa only [VExpr.bvarRevRange_liftN_low, Nat.add_comm]
                  using weakened
              have nextFullNoBV :
                  VLCtx.bvars (((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam field) :: full) : VLCtx) = 0 :=
                nextD3State'.fullExtension.bvars_eq.trans
                  nextD3State'.commonNoBV
              have tailClosed : Closed
                  (body.instantiate1 context.freshExpr) := by
                have closed := bodyOpened.closed
                rw [nextFullNoBV] at closed
                exact closed
              obtain ⟨tailFields, resultTarget, tailTr, tailRun, tailStage,
                  resultNotForall, tailSorts⟩ :=
                ih (fieldIndex := fieldIndex + 1) nextD3State'
                  removedInvariant.push nextTargets tailClosed bodyOpened
                  nextParameterTranslations (by omega)
                  analyzerResultNotForall tailTelescope analyzerTailBounds
              have tailAbstract := tailTr.abstract VLCtx.Abstract.zero
              have freshFull : context.freshFVarId ∉ full.fvars :=
                (nextD3State'.fullWF.2.1 _ _ rfl).1
              have bodyAvoid : body.FVarsIn
                  (· ≠ context.freshFVarId) :=
                wholeTr.fvarsIn.2.mono (fun fv member equality => by
                  subst fv
                  exact freshFull member)
              have bodyRoundTrip :
                  (body.instantiate1 context.freshExpr).abstract1
                      context.freshFVarId = body := by
                simpa only [AddInductive.Context.freshExpr,
                  Expr.instantiate1_eq] using
                    bodyAvoid.abstract_instantiate1 (k := 0)
              rw [bodyRoundTrip] at tailAbstract
              have fieldType : typeEnv.IsType Us.length full.toCtx field :=
                ⟨fieldSort, selectedFieldType⟩
              have abstractWF : VLCtx.WF typeEnv Us.length
                  ((none, .vlam field) :: full) := by
                simpa using VLCtx.Abstract.zero.wf nextD3State'.fullWF
              have bodyOriginalSelected :=
                bodyOpened.abstract VLCtx.Abstract.zero
              rw [bodyRoundTrip] at bodyOriginalSelected
              have binderContexts : VLCtx.IsDefEq typeEnv Us.length
                  ((none, .vlam analyzerField) :: full)
                  ((none, .vlam field) :: full) :=
                .cons (.refl typeEnvWF d3State.fullWF) (by nofun)
                  (.vlam domainDefEq)
              obtain ⟨analyzerBodyLevel, analyzerBodyHasType⟩ :=
                analyzerBodyType
              have analyzerBodyAtSelected : typeEnv.HasType Us.length
                  (field :: full.toCtx)
                  (VExpr.forallN analyzerFields analyzerResult)
                  (.sort analyzerBodyLevel) := by
                simpa only [VLCtx.toCtx] using
                  analyzerBodyHasType.defeqDFC typeEnvWF.ordered
                    binderContexts.defeqCtx
              have bodyTargetsDefEq : typeEnv.IsDefEqU Us.length
                  (field :: full.toCtx)
                  (VExpr.forallN analyzerFields analyzerResult)
                  (VExpr.forallN tailFields resultTarget) := by
                simpa only [VLCtx.toCtx] using
                  bodyOriginalSelected.uniq typeEnvWF
                    (.refl typeEnvWF abstractWF) tailAbstract
              have selectedBodyType : typeEnv.IsType Us.length
                  (field :: full.toCtx)
                  (VExpr.forallN tailFields resultTarget) :=
                ⟨analyzerBodyLevel,
                  (bodyTargetsDefEq.of_l typeEnvWF
                    (by simpa only [VLCtx.toCtx] using abstractWF.toCtx)
                    analyzerBodyAtSelected).hasType.2⟩
              have selectedWholeTr : TrExprS typeEnv Us full
                  (.forallE name domain body binderInfo)
                  (.forallE field
                    (VExpr.forallN tailFields resultTarget)) :=
                .forallE fieldType selectedBodyType fieldTr tailAbstract
              refine ⟨field :: tailFields, resultTarget,
                by simpa only [VExpr.forallN] using selectedWholeTr,
                ?_, ?_, resultNotForall, ?_⟩
              · unfold ConstructorBlockFieldsRunResult at tailRun ⊢
                refine ⟨?_, ?_⟩
                · rw [VInductDecl.blockFieldsWF, recNoneSource]
                  refine ⟨⟨ensureTypeRun.resultLevel', ?_, fieldBound⟩, ?_⟩
                  · simpa only [sourceUvars] using fieldBaseType
                  · simpa only [VLCtx.toCtx] using tailRun.1
                · simpa only [sourceUvars, sourceNparams,
                    List.reverse_cons, List.singleton_append,
                    List.append_assoc, VLCtx.toCtx, List.length_cons,
                    Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
                    tailRun.2
              · simp only [VExpr.forallN,
                  VInductDecl.blockStage3Ctor,
                  VInductDecl.blockStage3Field, recNoneSource,
                  Option.isSome_none, fieldFree, Bool.not_false,
                  Bool.or_true, Bool.true_and]
                exact tailStage
              · exact .cons selectedFieldType (by
                  simpa only [VLCtx.toCtx] using tailSorts)
  | @recursive context recursiveArgIdx removed recursiveStarted name domain
      body binderInfo noParameter isRecursive independent shape targetSuffix
      targetAt fieldTrace fresh tailTrace contextRun recursiveRun tail ih =>
      cases analyzerFields with
      | nil =>
          obtain ⟨analyzerField, analyzerBody, targetEq, _fieldType,
              _bodyType, _fieldTr, _bodyTr⟩ :=
            TrExprS.forallE_components wholeTr
          simp only [VExpr.forallN] at targetEq
          exact (analyzerResultNotForall analyzerField analyzerBody
            targetEq).elim
      | cons analyzerField analyzerFields =>
          cases fieldTelescope with
          | @cons _ _ fieldSort _ fieldSorts analyzerFieldType
              analyzerTailTelescope =>
            cases fieldBounds with
            | intro _analyzerFieldBound analyzerTailBounds =>
              simp only [VExpr.forallN] at wholeTr
              obtain ⟨translatedField, translatedBody, targetEq,
                  _translatedFieldType, analyzerBodyType, analyzerFieldTr,
                  analyzerBodyTr⟩ := TrExprS.forallE_components wholeTr
              simp only [VExpr.forallE.injEq] at targetEq
              obtain ⟨rfl, rfl⟩ := targetEq
              have domainFVars : FVarsIn (· ∈ common.fvars) domain :=
                constructorIndependentOf_fvars analyzerFieldTr.fvarsIn
                  independent removedInvariant
              obtain ⟨baseIndices, currentIndices, targetLevel, familyTarget,
                  targetHeader, baseAt, targetHeaderAt, familyHead,
                  headerIndices, indexLength, familyCommonTr, familyFullTr,
                  familyTargetEq, familyLiftEq⟩ := targets targetAt
              have before : ∀ k, k < shape.targetIdx →
                  ∀ earlier,
                    (VInductDecl.familyHeaders source.nparams
                      source.types)[k]? = some earlier →
                    earlier.name ≠ targetHeader.name := by
                intro k kLt earlier earlierAt namesEq
                have indexEq := headerNameInjective earlierAt
                  targetHeaderAt namesEq
                omega
              obtain ⟨field, fieldTr, recursiveResult⟩ :=
                recursiveField_resolved (fieldIndex := fieldIndex)
                  recursiveRun henv typeEnvWF addType d3State
                  familyCommonTr familyFullTr familyLiftEq indexLength
                  targetHeaderAt familyHead headerIndices levelsTr
                  parameterTranslations before familyFresh sourceClosed.1
                  domainFVars analyzerFieldTr
              obtain ⟨recursive, recursiveEq, targetTypeEq, recursiveWF⟩ :=
                recursiveResult.blockRecArgWF familyTargetEq
              have recursiveWFCommon :=
                recursiveWF.retargetResultLevel (l' := resultLevel)
              have domainDefEqU : typeEnv.IsDefEqU Us.length full.toCtx
                  analyzerField field :=
                analyzerFieldTr.uniq typeEnvWF
                  (.refl typeEnvWF d3State.fullWF) fieldTr
              have domainDefEq : typeEnv.IsDefEq Us.length full.toCtx
                  analyzerField field (.sort fieldSort) :=
                domainDefEqU.of_l typeEnvWF d3State.fullWF.toCtx
                  analyzerFieldType
              have selectedFieldType : typeEnv.HasType Us.length full.toCtx
                  field (.sort fieldSort) := domainDefEq.hasType.2
              have depsSubset :
                  (consumeTypeAnnotations domain).fvarsList ⊆ common.fvars :=
                (FVarsIn.consumeTypeAnnotations domainFVars |>
                  fvarsIn_iff.mp).1
              have freshActual : context.freshFVarId ∉
                  contextRun.candidate.context.vlctx.fvars := by
                apply contextRun.candidate.context.trlctx.find?_eq_none.mp
                change contextRun.candidate.context.mlctx.lctx.find?
                    context.freshFVarId = none
                rw [contextRun.candidate.context.lctx_eq,
                  contextRun.candidate.context_lctx]
                exact fresh
              have freshCommon : context.freshFVarId ∉ common.fvars := by
                intro present
                have presentView :=
                  d3State.viewExtension.fvars_sublist.subset present
                have presentActual : context.freshFVarId ∈
                    contextRun.candidate.context.vlctx.fvars := by
                  simpa only [d3State.viewDefEq.fvars] using presentView
                exact freshActual presentActual
              have freshFull := d3State.freshInvariant.fresh freshCommon
              have nextFullWF : VLCtx.WF typeEnv Us.length
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam field) :: full) := by
                refine ⟨d3State.fullWF, ?_, ⟨fieldSort,
                  selectedFieldType⟩⟩
                intro fv deps equality
                cases equality
                exact ⟨freshFull, fun fv member =>
                  d3State.fullExtension.fvars_sublist.subset
                    (depsSubset member)⟩
              have nextD3State : D3FullContextState env typeEnv Us
                  context.advanceFresh common
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam field) :: full)
                  contextRun.advanceFresh.candidate.context.vlctx
                  d3ViewContext (.skipN fullLift 1) viewLift := by
                simpa only [AddInductive.ConstructorContextRun.advanceFresh,
                  AddInductive.advanceCandidateContextRun] using
                  d3State.skip (source := domain) nextFullWF
              have nextTargets : ResolvedMutualFamilyTargetState env typeEnv
                  Us stats
                  (VInductDecl.familyHeaders source.nparams source.types)
                  familySuffixes familyIndices common
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam field) :: full) (fieldIndex + 1)
                  (.skipN fullLift 1) :=
                ResolvedMutualFamilyTargetState.skip targets typeEnvWF
                  nextD3State.fullWF
              have originalTailWF : VLCtx.WF typeEnv Us.length
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam analyzerField) :: full) :=
                ⟨d3State.fullWF, nextD3State.fullWF.2.1,
                  ⟨fieldSort, analyzerFieldType⟩⟩
              have bodyOpenedOriginal : TrExprS typeEnv Us
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam analyzerField) :: full)
                  (body.instantiate1 context.freshExpr)
                  (VExpr.forallN analyzerFields analyzerResult) := by
                simpa only [AddInductive.Context.freshExpr,
                  Expr.instantiate1_eq] using
                    analyzerBodyTr.inst_fvar typeEnvWF.ordered originalTailWF
              have openedContexts : VLCtx.IsDefEq typeEnv Us.length
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam analyzerField) :: full)
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam field) :: full) :=
                .cons (.refl typeEnvWF d3State.fullWF)
                  originalTailWF.2.1 (.vlam domainDefEq)
              have openedValues : TrExprS.IsUniqueCtx
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam analyzerField) :: full)
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam field) :: full) := .cons .base .vlam
              have bodyOpened : TrExprS typeEnv Us
                  ((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam field) :: full)
                  (body.instantiate1 context.freshExpr)
                  (VExpr.forallN analyzerFields analyzerResult) :=
                bodyOpenedOriginal.defeqDFC_same typeEnvWF openedContexts
                  openedValues
              have tailTelescope : typeEnv.OnSortTel Us.length
                  (field :: full.toCtx) analyzerFields fieldSorts := by
                simpa only [VLCtx.toCtx] using
                  analyzerTailTelescope.defeqDFC typeEnvWF.ordered
                    openedContexts.defeqCtx
              have nextParameterTranslations : List.Forall₂
                  (TrExprS typeEnv Us
                    ((some (context.freshFVarId,
                        (consumeTypeAnnotations domain).fvarsList),
                      .vlam field) :: full))
                  stats.params.toList
                  (VExpr.bvarRevRange (fieldIndex + 1)
                    stats.params.size) := by
                have weakened := forall₂_tr_push_fvar typeEnvWF.ordered
                  nextD3State.fullWF parameterTranslations
                simpa only [VExpr.bvarRevRange_liftN_low, Nat.add_comm]
                  using weakened
              have nextFullNoBV :
                  VLCtx.bvars (((some (context.freshFVarId,
                      (consumeTypeAnnotations domain).fvarsList),
                    .vlam field) :: full) : VLCtx) = 0 :=
                nextD3State.fullExtension.bvars_eq.trans
                  nextD3State.commonNoBV
              have tailClosed : Closed
                  (body.instantiate1 context.freshExpr) := by
                have closed := bodyOpened.closed
                rw [nextFullNoBV] at closed
                exact closed
              obtain ⟨tailFields, resultTarget, tailTr, tailRun, tailStage,
                  resultNotForall, tailSorts⟩ :=
                ih (fieldIndex := fieldIndex + 1) nextD3State
                  (removedInvariant.skip freshFull) nextTargets tailClosed
                  bodyOpened nextParameterTranslations (by omega)
                  analyzerResultNotForall tailTelescope analyzerTailBounds
              have tailAbstract := tailTr.abstract VLCtx.Abstract.zero
              have bodyAvoid : body.FVarsIn
                  (· ≠ context.freshFVarId) :=
                wholeTr.fvarsIn.2.mono (fun fv member equality => by
                  subst fv
                  exact freshFull member)
              have bodyRoundTrip :
                  (body.instantiate1 context.freshExpr).abstract1
                      context.freshFVarId = body := by
                simpa only [AddInductive.Context.freshExpr,
                  Expr.instantiate1_eq] using
                    bodyAvoid.abstract_instantiate1 (k := 0)
              rw [bodyRoundTrip] at tailAbstract
              have fieldType : typeEnv.IsType Us.length full.toCtx field :=
                ⟨fieldSort, selectedFieldType⟩
              have abstractWF : VLCtx.WF typeEnv Us.length
                  ((none, .vlam field) :: full) := by
                simpa using VLCtx.Abstract.zero.wf nextD3State.fullWF
              have bodyOriginalSelected :=
                bodyOpened.abstract VLCtx.Abstract.zero
              rw [bodyRoundTrip] at bodyOriginalSelected
              have binderContexts : VLCtx.IsDefEq typeEnv Us.length
                  ((none, .vlam analyzerField) :: full)
                  ((none, .vlam field) :: full) :=
                .cons (.refl typeEnvWF d3State.fullWF) (by nofun)
                  (.vlam domainDefEq)
              obtain ⟨analyzerBodyLevel, analyzerBodyHasType⟩ :=
                analyzerBodyType
              have analyzerBodyAtSelected : typeEnv.HasType Us.length
                  (field :: full.toCtx)
                  (VExpr.forallN analyzerFields analyzerResult)
                  (.sort analyzerBodyLevel) := by
                simpa only [VLCtx.toCtx] using
                  analyzerBodyHasType.defeqDFC typeEnvWF.ordered
                    binderContexts.defeqCtx
              have bodyTargetsDefEq : typeEnv.IsDefEqU Us.length
                  (field :: full.toCtx)
                  (VExpr.forallN analyzerFields analyzerResult)
                  (VExpr.forallN tailFields resultTarget) := by
                simpa only [VLCtx.toCtx] using
                  bodyOriginalSelected.uniq typeEnvWF
                    (.refl typeEnvWF abstractWF) tailAbstract
              have selectedBodyType : typeEnv.IsType Us.length
                  (field :: full.toCtx)
                  (VExpr.forallN tailFields resultTarget) :=
                ⟨analyzerBodyLevel,
                  (bodyTargetsDefEq.of_l typeEnvWF
                    (by simpa only [VLCtx.toCtx] using abstractWF.toCtx)
                    analyzerBodyAtSelected).hasType.2⟩
              have selectedWholeTr : TrExprS typeEnv Us full
                  (.forallE name domain body binderInfo)
                  (.forallE field
                    (VExpr.forallN tailFields resultTarget)) :=
                .forallE fieldType selectedBodyType fieldTr tailAbstract
              refine ⟨field :: tailFields, resultTarget,
                by simpa only [VExpr.forallN] using selectedWholeTr,
                ?_, ?_, resultNotForall, ?_⟩
              · have recursiveEqSource : VInductDecl.blockRecArg?
                    source.uvars source.nparams
                    (VInductDecl.familyHeaders source.nparams source.types)
                    (VInductDecl.familyNames source.types) fieldIndex field =
                      some recursive := by
                  simpa only [sourceUvars, sourceNparams] using recursiveEq
                unfold ConstructorBlockFieldsRunResult at tailRun ⊢
                refine ⟨?_, ?_⟩
                · rw [VInductDecl.blockFieldsWF, recursiveEqSource]
                  simp only
                  rw [targetTypeEq, baseAt]
                  refine ⟨?_, ?_⟩
                  · simpa only [sourceUvars] using recursiveWFCommon
                  · simpa only [VLCtx.toCtx] using tailRun.1
                · simpa only [sourceUvars, sourceNparams,
                    List.reverse_cons, List.singleton_append,
                    List.append_assoc, VLCtx.toCtx, List.length_cons,
                    Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
                    tailRun.2
              · have recursiveEqSource : VInductDecl.blockRecArg?
                    source.uvars source.nparams
                    (VInductDecl.familyHeaders source.nparams source.types)
                    (VInductDecl.familyNames source.types) fieldIndex field =
                      some recursive := by
                  simpa only [sourceUvars, sourceNparams] using recursiveEq
                simp only [VExpr.forallN,
                  VInductDecl.blockStage3Ctor,
                  VInductDecl.blockStage3Field, recursiveEqSource,
                  Option.isSome_some, Bool.true_or, Bool.true_and]
                exact tailStage
              · exact .cons selectedFieldType (by
                  simpa only [VLCtx.toCtx] using tailSorts)
  | @terminal context terminalSource terminalArgIdx removed recursiveStarted
      valid independent spineTrace contextRun expected spine =>
      cases analyzerFields with
      | cons analyzerField analyzerFields =>
          obtain ⟨_baseIndices, _currentIndices, _ownerLevel, _familyTarget,
              ownerHeader, _baseAt, _ownerHeaderAt, familyHead,
              _headerIndices, _indexLength, _familyCommonTr, _familyFullTr,
              _familyTargetEq, _familyLiftEq⟩ := targets ownerAt
          have terminalSourceHead : terminalSource.getAppFn =
              .const ownerHeader.name stats.levels :=
            isValidIndAppIdx_getAppFn_eq valid familyHead
          obtain ⟨_targetLevels, targetHead, _argumentsTr⟩ :=
            TrExprS.constApp_components wholeTr terminalSourceHead
          simp only [VExpr.forallN, VExpr.appHead] at targetHead
          cases targetHead
      | nil =>
          cases fieldTelescope with
          | nil =>
            obtain ⟨baseIndices, currentIndices, ownerLevel, familyTarget,
                ownerHeader, baseAt, ownerHeaderAt, familyHead, headerIndices,
                indexLength, familyCommonTr, familyFullTr, familyTargetEq,
                familyLiftEq⟩ := targets ownerAt
            have terminalSourceHead' : terminalSource.getAppFn =
                .const ownerHeader.name stats.levels :=
              isValidIndAppIdx_getAppFn_eq valid familyHead
            have baseIndicesEq : baseIndices = ownerIndices :=
              Option.some.inj (baseAt.symm.trans ownerIndicesAt)
            have sourceFVars : FVarsIn (· ∈ common.fvars)
                terminalSource :=
              constructorIndependentOf_fvars wholeTr.fvarsIn independent
                removedInvariant
            have ownerBefore : ∀ k, k < owner → ∀ earlier,
                (VInductDecl.familyHeaders source.nparams
                  source.types)[k]? = some earlier →
                  earlier.name ≠ ownerHeader.name := by
              intro k kLt earlier earlierAt namesEq
              have indexEq := headerNameInjective earlierAt ownerHeaderAt
                namesEq
              omega
            obtain ⟨resultTarget, targetIndices, resultTr, terminalSpine,
                targetFound⟩ :=
              terminal_resolved_block (valid := valid)
                (fieldIndex := fieldIndex) spine henv typeEnvWF addType
                d3State familyCommonTr familyLiftEq indexLength ownerHeaderAt
                familyHead headerIndices levelsTr parameterTranslations
                ownerBefore familyFresh sourceClosed sourceFVars wholeTr
            rw [familyTargetEq, baseIndicesEq] at terminalSpine
            have spineLength := terminalSpine.forallN_sort_length
            have retargeted := terminalSpine.retarget spineLength
              (.sort resultLevel)
            have sortInst : (VExpr.sort resultLevel).instRev
                (VInductDecl.recFieldIdxs stats.params.size resultTarget) =
                  .sort resultLevel :=
              VExpr.instRev_closedN _ (by trivial)
            rw [sortInst] at retargeted
            have targetFoundSource : VInductDecl.blockTarget? source.uvars
                source.nparams fieldIndex
                (VInductDecl.familyHeaders source.nparams source.types)
                (VInductDecl.familyNames source.types) resultTarget =
                  some (owner, targetIndices) := by
              simpa only [sourceUvars, sourceNparams] using targetFound
            obtain ⟨targetHeader, targetHeaderAt, targetShape⟩ :=
              VInductDecl.blockTarget?_eq_some targetFoundSource
            have resultNotForall : ∀ domain body,
                resultTarget ≠ .forallE domain body := by
              intro domain body equality
              rw [equality] at targetShape
              have headEq := congrArg VExpr.appHead targetShape
              simp only [VExpr.appHead, VExpr.appHead_appN] at headEq
              exact VExpr.noConfusion headEq
            refine ⟨[], resultTarget, resultTr, ?_, ?_, resultNotForall,
              .nil⟩
            · unfold ConstructorBlockFieldsRunResult
              refine ⟨trivial, ?_⟩
              simpa only [sourceUvars, sourceNparams, List.reverse_nil,
                List.nil_append, List.length_nil, Nat.add_zero] using
                retargeted
            · cases resultTarget with
              | forallE domain body =>
                  exact (resultNotForall domain body rfl).elim
              | bvar | sort | const | app | lam =>
                  simp only [VExpr.forallN, VInductDecl.blockStage3Ctor]
                  rw [targetFoundSource]
                  simp

end ConstructorValidation

namespace VInductDecl

/-- Keep only the post-parameter field/result evidence from a complete
family-major pre-family replay.  The family and constructor suffixes are the
construction-owned inventories; the full replay is used only to interpret
the residual branches. -/
theorem
    _root_.Lean4Lean.AddInductive.ConstructorMutualBlockPreFamilySemanticRuns.afterParameters
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {globalSuffixes : List Expr} {context : AddInductive.Context}
    {contextRun : AddInductive.ConstructorContextRun env Us context}
    {owner : Nat} {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    {semantics : VInductDecl.CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws}
    {trace : AddInductive.ConstructorMutualBlockPreFamilyTraces stats
      globalSuffixes context (owner := owner) candidates}
    (runs : AddInductive.ConstructorMutualBlockPreFamilySemanticRuns env
      blockEnv Us stats globalSuffixes context contextRun semantics trace)
    (familySuffixes :
      AddInductive.ConstructorBlockResolvedFamilyParameterSuffixes stats
        candidates)
    (constructorSuffixes :
      AddInductive.ConstructorBlockCandidateParameterSuffixes stats candidates)
    (suffixDrop : globalSuffixes.drop owner = familySuffixes.values)
    (familyHeads : ∀ {familyOwner : Nat} {ownerSuffix : Expr},
      globalSuffixes[familyOwner]? = some ownerSuffix →
        ∃ familyName familyLevels,
          stats.indConsts[familyOwner]! = .const familyName familyLevels) :
    Nonempty
      (AddInductive.ConstructorMutualBlockPreFamilyParameterSuffixLists env Us
        stats globalSuffixes context contextRun (owner := owner)
        familySuffixes constructorSuffixes) := by
  induction runs with
  | nil =>
      cases familySuffixes
      cases constructorSuffixes
      exact ⟨.nil⟩
  | @cons owner source sources candidate candidates raw raws semantic semantics
      d3OwnerSuffix d3Parameters headTrace tailTrace head tail ih =>
      cases familySuffixes with
      | cons ownerSuffix parameters familyTail =>
        have ownerSuffixEq : d3OwnerSuffix = ownerSuffix :=
          Except.ok.inj (d3Parameters.symm.trans parameters)
        subst d3OwnerSuffix
        cases constructorSuffixes with
        | cons headSuffixes tailSuffixes =>
          have ownerAt : globalSuffixes[owner]? = some ownerSuffix :=
            list_getElem?_eq_some_of_drop_eq_cons suffixDrop
          obtain ⟨familyName, familyLevels, familyHead⟩ :=
            familyHeads ownerAt
          obtain ⟨headResidual⟩ :=
            head.afterParameters headSuffixes familyHead
          obtain ⟨tailResidual⟩ := ih familyTail tailSuffixes
            (list_drop_succ_eq_of_drop_eq_cons suffixDrop)
          exact ⟨.cons headResidual tailResidual⟩

/-- Reconstruct one constructor endpoint from the construction-owned D3
replay and the validator's structural field inventory.  Unlike
`resolvedBlockConstructorWF`, this theorem has no post-family semantic run,
view-alignment trace, or analyzer context state. -/
theorem CandidateConstructorSemanticRun.resolvedBlockConstructorWF_structural
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {source inventorySource : VInductDecl} {params : List VExpr}
    {familyIndices : List (List VExpr)} {resultLevel : VLevel}
    {kernelCtor : Constructor}
    {candidate : AddInductive.CandidateConstructor kernelCtor}
    {rawCtor : VConstVal}
    (semantic : CandidateConstructorSemanticRun blockEnv Us candidate rawCtor)
    {owner : Nat} {suffix : Expr}
    (instantiation : AddInductive.instantiateFamilyParameters
      candidate.type.view stats.params.toList = .ok suffix)
    {ownerSuffix : Expr} {familySuffixes : List Expr}
    {d3Context : AddInductive.Context}
    {d3ContextRun : AddInductive.ConstructorContextRun env Us d3Context}
    (d3 : AddInductive.ConstructorMutualPreFamilyParameterSuffix
      (env := env) (Us := Us) (stats := stats) (owner := owner)
      (ownerSuffix := ownerSuffix) (familySuffixes := familySuffixes)
      (context := d3Context) (removed := []) (recursiveStarted := false)
      (contextRun := d3ContextRun) suffix)
    {isUnsafe : Bool} {validationContext : AddInductive.Context}
    {validation : AddInductive.ConstructorTypeValidationTrace stats isUnsafe
      owner kernelCtor.name validationContext kernelCtor.type 0
      validationContext.fuel.inductiveFuel}
    {shape : CandidateConstructorSemanticGenerationShape
      (source := inventorySource) blockEnv Us semantic}
    {annotation : CandidateConstructorAnnotationSpine inventorySource blockEnv
      Us semantic shape}
    (fieldState : CandidateConstructorValidationFieldState inventorySource
      blockEnv Us validation semantic shape annotation)
    (fieldBound : stats.params.size ≤ candidate.type.trace.spineLength)
    (henv : VEnv.WF env) (hblockEnv : VEnv.WF blockEnv)
    (addType : env ≤ blockEnv)
    {parameterΔ d3ViewContext : VLCtx}
    {d3ViewLift : Lift}
    (parameterContext : TypeChecker.CandidateParameterContext []
      stats.params.toList params parameterΔ)
    (parameterWF : VLCtx.WF env Us.length parameterΔ)
    (headParameters : TypeChecker.TelDefEqEvidence blockEnv Us.length []
      params (VExpr.telN source.nparams semantic.type.view))
    (d3State : ConstructorValidation.D3FullContextState env blockEnv Us
      d3Context parameterΔ parameterΔ
      d3ContextRun.candidate.context.vlctx d3ViewContext .refl d3ViewLift)
    (targets : ConstructorValidation.ResolvedMutualFamilyTargetState env
      blockEnv Us stats (familyHeaders source.nparams source.types)
      familySuffixes familyIndices parameterΔ parameterΔ 0 .refl)
    (ownerAt : familySuffixes[owner]? = some ownerSuffix)
    {ownerIndices : List VExpr}
    (ownerIndicesAt : familyIndices[owner]? = some ownerIndices)
    (sourceUvars : source.uvars = Us.length)
    (sourceNparams : source.nparams = stats.params.size)
    (resultLevelTr : VLevel.ofLevel Us stats.resultLevel = some resultLevel)
    (levelsTr : stats.levels.mapM (VLevel.ofLevel Us) =
      some (VLevel.params Us.length))
    (familyFresh : ∀ name, name ∈ familyNames source.types →
      env.constants name = none)
    (familyNodup : (familyNames source.types).Nodup) :
    ∃ fields resultTarget,
      TrExprS blockEnv Us parameterΔ suffix
          (VExpr.forallN fields resultTarget) ∧
        TrExprS blockEnv Us [] candidate.type.view
          (VExpr.forallN
            (VExpr.telN source.nparams semantic.type.view)
            (VExpr.forallN fields resultTarget)) ∧
        (checkedBlockFieldsWF env source.uvars resultLevel familyIndices
              fields
              (blockRecArgsAt source.uvars source.nparams
                (familyHeaders source.nparams source.types)
                (familyNames source.types) fields 0)
              params.reverse 0 ∧
          env.SpineWF source.uvars (fields.reverse ++ params.reverse)
            (VExpr.forallN
              (VExpr.liftTelN fields.length ownerIndices 0)
              (.sort resultLevel))
            (recFieldIdxs source.nparams resultTarget)
            (.sort resultLevel)) ∧
        blockStage3Ctor source.uvars source.nparams
          (familyHeaders source.nparams source.types)
          (familyNames source.types) owner 0
          (VExpr.forallN fields resultTarget) = true ∧
        (∀ domain body, resultTarget ≠ .forallE domain body) ∧
        blockEnv.OnSortTel Us.length params.reverse fields
          fieldState.sorts := by
  have paramsLength : params.length = source.nparams := by
    rw [← parameterContext.length_eq]
    simpa using sourceNparams.symm
  obtain ⟨_inferred, recursive⟩ := semantic.type.recursive
  have wholeStrict : TrExprS blockEnv Us [] candidate.type.view
      semantic.type.view :=
    recursive.view_tr_resolved
  have wholeStrict' : TrExprS blockEnv Us [] candidate.type.view
      (VExpr.forallN (VExpr.telN source.nparams semantic.type.view)
        (VExpr.dropN source.nparams semantic.type.view)) := by
    rw [VExpr.forallN_telN_dropN]
    exact wholeStrict
  have suffixTr : TrExprS blockEnv Us parameterΔ suffix
      (VExpr.dropN source.nparams semantic.type.view) :=
    parameterContext.instantiateForallRetypedResolved hblockEnv
      (parameterWF.mono addType) headParameters instantiation wholeStrict'
  obtain ⟨_baseIndices, _currentIndices, _level, _familyTarget, _header,
      _baseAt, _headerAt, familyHead, _headerIndices, _indexLength,
      _commonTr, _fullTr, _familyTargetEq, _familyLiftEq⟩ := targets ownerAt
  have sourceClosed : Closed suffix := by
    have closed := suffixTr.closed
    rw [show parameterΔ.bvars = 0 from by
      exact
        (VInductDecl.TypeChecker.CandidateParameterContext.fvarLamOnly
          parameterContext .nil).noBV] at closed
    exact closed
  have parameterTranslations : List.Forall₂
      (TrExprS blockEnv Us parameterΔ) stats.params.toList
      (VExpr.bvarRevRange 0 stats.params.size) := by
    have translated := TypeChecker.CandidateParameterContext.sourceTranslations
      parameterContext henv parameterWF
    have translated' := ConstructorValidation.forall₂_tr_mono addType
      translated
    have lengthEq : params.length = stats.params.size := by
      rw [← parameterContext.length_eq]
      simp
    simpa only [lengthEq] using translated'
  have translatedFieldCount :=
    ConstructorValidation.ConstructorMutualPreFamilyViewSemanticRun.ctorFields_length_of_translation
      d3.semantic henv hblockEnv addType d3State (by
        intro fv member _
        exact member) sourceClosed suffixTr (by simp) familyHead
  have instantiatedArity :=
    ConstructorValidation.structuralInstantiateFamilyParameters_constructorArity
      parameterContext.sources_fvar instantiation
  have suffixArity : AddInductive.constructorArity suffix 0 =
      candidate.type.trace.spineLength - stats.params.size := by
    rw [fieldState.viewSpineLength] at instantiatedArity
    simp only [Array.length_toList] at instantiatedArity
    omega
  have fieldCount :
      (ctorFields
        (VExpr.dropN stats.params.size semantic.type.view)).length =
        candidate.type.trace.spineLength - stats.params.size := by
    simpa only [sourceNparams] using translatedFieldCount.trans suffixArity
  have analyzerFields : blockEnv.OnSortTel Us.length parameterΔ.toCtx
      (ctorFields (VExpr.dropN source.nparams semantic.type.view))
      fieldState.sorts := by
    have selected := fieldState.fieldView_onSortTel fieldBound fieldCount
      (by simpa only [sourceNparams] using headParameters)
    have parameterCtx : parameterΔ.toCtx = params.reverse := by
      simpa only [VLCtx.toCtx, List.append_nil] using
        VInductDecl.TypeChecker.CandidateParameterContext.toCtx
          parameterContext
    simpa only [sourceNparams, parameterCtx] using selected
  have suffixFields : TrExprS blockEnv Us parameterΔ suffix
      (VExpr.forallN
        (ctorFields (VExpr.dropN source.nparams semantic.type.view))
        (VExpr.resultOf
          (VExpr.dropN source.nparams semantic.type.view))) := by
    rw [forallN_ctorFields_resultOf]
    exact suffixTr
  have result := ConstructorValidation.constructorBlockFields_structural
    (d3 := d3.semantic) henv hblockEnv addType d3State
    (by
      intro fv member _
      exact member)
    targets ownerAt ownerIndicesAt sourceUvars sourceNparams levelsTr
    familyFresh
    (fun headerAt => familyHeaders_name_mem headerAt)
    (fun leftAt rightAt namesEq =>
      familyHeaders_index_eq_of_name_eq familyNodup leftAt rightAt namesEq)
    sourceClosed suffixFields parameterTranslations (by simp)
    (resultOf_ne_forall _) analyzerFields
    (validation.fieldSortBounds resultLevelTr fieldState.computed)
  obtain ⟨fields, resultTarget, selectedTr, selectedRun, selectedStage,
      resultNotForall, fieldSorts⟩ := result
  obtain ⟨selectedParameterΔ, selectedParameterContext,
      parameterRelation, parameterUnique, selectedParameterWF⟩ :=
    parameterContext.retypeExact hblockEnv headParameters
      (parameterWF.mono addType)
  have selectedTrAtView : TrExprS blockEnv Us selectedParameterΔ
      suffix (VExpr.forallN fields resultTarget) :=
    selectedTr.defeqDFC_same hblockEnv parameterRelation parameterUnique
  have selectedWhole : TrExprS blockEnv Us [] candidate.type.view
      (VExpr.forallN (VExpr.telN source.nparams semantic.type.view)
        (VExpr.forallN fields resultTarget)) :=
    selectedParameterContext.rebuildForall hblockEnv selectedParameterWF
      instantiation wholeStrict' selectedTrAtView
  have parameterCtx : parameterΔ.toCtx = params.reverse := by
    simpa only [VLCtx.toCtx, List.append_nil] using
      VInductDecl.TypeChecker.CandidateParameterContext.toCtx parameterContext
  unfold ConstructorValidation.ConstructorBlockFieldsRunResult at selectedRun
  rw [parameterCtx] at selectedRun fieldSorts
  have checkedFields : checkedBlockFieldsWF env source.uvars resultLevel
      familyIndices fields
      (blockRecArgsAt source.uvars source.nparams
        (familyHeaders source.nparams source.types)
        (familyNames source.types) fields 0)
      params.reverse 0 :=
    checkedBlockFieldsWF_blockRecArgsAt_iff.mpr selectedRun.1
  exact ⟨fields, resultTarget, selectedTr, selectedWhole,
    ⟨checkedFields, by simpa only [Nat.zero_add] using selectedRun.2⟩,
    selectedStage, resultNotForall, fieldSorts⟩

/-- Traverse one constructor family using only the D3 pre-family replay and
the structural validator/producer inventory.  The returned sort matrix is
also proved to be the literal result of the ordinary validation trace. -/
theorem
    CandidateConstructorSemanticListRun.resolvedBlockConstructorsWF_structural
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {source inventorySource : VInductDecl} {params : List VExpr}
    {familyIndices : List (List VExpr)} {resultLevel : VLevel}
    {owner : Nat} {ownerSuffix : Expr} {familySuffixes : List Expr}
    {kernelCtors : List Constructor}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateConstructor kernelCtors}
    {d3Context : AddInductive.Context}
    {d3ContextRun : AddInductive.ConstructorContextRun env Us d3Context}
    (suffixes : AddInductive.ConstructorCandidateParameterSuffixes stats
      candidates)
    (d3 : AddInductive.ConstructorMutualPreFamilyParameterSuffixList env Us
      stats owner ownerSuffix familySuffixes d3Context d3ContextRun suffixes)
    {isUnsafe : Bool} {validationContext : AddInductive.Context}
    {seen : NameSet}
    {validation : AddInductive.ConstructorListValidationTrace stats isUnsafe
      owner validationContext seen kernelCtors}
    {raws : List VConstVal}
    {semantics : CandidateConstructorSemanticListRun blockEnv Us candidates
      raws}
    (fieldStates : CandidateConstructorValidationFieldStateList inventorySource
      blockEnv Us stats isUnsafe owner validationContext validation semantics)
    (parameters : CandidateConstructorViewParameterDefEqList blockEnv Us
      source.nparams params semantics)
    (henv : VEnv.WF env) (hblockEnv : VEnv.WF blockEnv)
    (addType : env ≤ blockEnv)
    {parameterΔ d3ViewContext : VLCtx}
    {d3ViewLift : Lift}
    (parameterContext : TypeChecker.CandidateParameterContext []
      stats.params.toList params parameterΔ)
    (parameterWF : VLCtx.WF env Us.length parameterΔ)
    (d3State : ConstructorValidation.D3FullContextState env blockEnv Us
      d3Context parameterΔ parameterΔ
      d3ContextRun.candidate.context.vlctx d3ViewContext .refl d3ViewLift)
    (targets : ConstructorValidation.ResolvedMutualFamilyTargetState env
      blockEnv Us stats (familyHeaders source.nparams source.types)
      familySuffixes familyIndices parameterΔ parameterΔ 0 .refl)
    (ownerAt : familySuffixes[owner]? = some ownerSuffix)
    {ownerIndices : List VExpr}
    (ownerIndicesAt : familyIndices[owner]? = some ownerIndices)
    (sourceUvars : source.uvars = Us.length)
    (sourceNparams : source.nparams = stats.params.size)
    (resultLevelTr : VLevel.ofLevel Us stats.resultLevel = some resultLevel)
    (levelsTr : stats.levels.mapM (VLevel.ofLevel Us) =
      some (VLevel.params Us.length))
    (familyFresh : ∀ name, name ∈ familyNames source.types →
      env.constants name = none)
    (familyNodup : (familyNames source.types).Nodup) :
    ∃ endpoints,
      ∃ selected : CandidateConstructorSemanticListRun blockEnv Us
          candidates raws,
        ∃ fieldSorts,
          List.Forall₂ (TrExprS blockEnv Us parameterΔ) suffixes.values
              endpoints ∧
            List.Forall₂
              (ResolvedBlockConstructorEndpointWF source env blockEnv Us
                resultLevel familyIndices owner params ownerIndices)
              endpoints fieldSorts ∧
            List.Forall₂ (fun constructor endpoint =>
              constructor.type = VExpr.forallN params endpoint)
              (selected.roots.views.map
                (canonicalizeConstructorParams source.nparams params))
              endpoints ∧
            CandidateConstructorViewParameterDefEqList blockEnv Us
              source.nparams params selected ∧
            CandidateConstructorCanonicalFieldCountList source.nparams
              selected ∧
            validation.fieldSorts? Us = some fieldSorts := by
  induction suffixes generalizing seen raws with
  | nil =>
      cases d3
      cases fieldStates
      cases parameters
      exact ⟨[], .nil, [], .nil, .nil, .nil, .nil, .nil, rfl⟩
  | @cons suffixSource suffixSources suffixCandidate suffixCandidates suffix
      instantiation suffixTail ih =>
      cases d3 with
      | cons d3Head d3Tail =>
          cases fieldStates with
          | @cons seen kernelCtor kernelCtors fresh closed rootCheck
              headValidation tailValidation candidate candidates raw raws
              headSemantic tailSemantics shape annotation headState
              tailStates =>
              cases parameters with
              | cons headBound headParameters tailParameters =>
                      have structuralBound := headBound
                      rw [sourceNparams] at structuralBound
                      obtain ⟨headFields, headTarget, headTr, headWhole,
                          headWF, headStage, headNotForall, headSorts⟩ :=
                        headSemantic.resolvedBlockConstructorWF_structural
                          instantiation d3Head headState structuralBound
                          henv hblockEnv addType parameterContext parameterWF
                          headParameters d3State targets ownerAt ownerIndicesAt
                          sourceUvars sourceNparams resultLevelTr levelsTr
                          familyFresh familyNodup
                      obtain ⟨selectedHead, selectedHeadEq⟩ :=
                        headSemantic.existsAtView headWhole
                      obtain ⟨tailEndpoints, selectedTail, tailFieldSorts,
                          tailTr, tailWF, tailTypes,
                          tailSelectedParameters, tailSelectedCounts,
                          tailComputed⟩ :=
                        ih d3Tail tailStates tailParameters
                      refine ⟨VExpr.forallN headFields headTarget ::
                          tailEndpoints,
                        .cons selectedHead selectedTail,
                        headState.sorts :: tailFieldSorts,
                        .cons headTr tailTr, .cons ?_ tailWF,
                        .cons ?_ tailTypes,
                        .cons headBound ?_ tailSelectedParameters,
                        .cons headBound ?_ tailSelectedCounts, ?_⟩
                      · exact ⟨headFields, headTarget, rfl, headStage, headWF,
                          headNotForall, headSorts⟩
                      · have paramsLength : params.length = source.nparams := by
                          rw [← parameterContext.length_eq]
                          simpa using sourceNparams.symm
                        have viewParamsLength :
                            (VExpr.telN source.nparams
                              headSemantic.type.view).length = source.nparams :=
                          headParameters.length_eq.symm.trans paramsLength
                        change (canonicalizeConstructorParams source.nparams
                          params selectedHead.root.view).type =
                            VExpr.forallN params
                              (VExpr.forallN headFields headTarget)
                        simp only [canonicalizeConstructorParams,
                          CandidateConstructorSemanticRun.root,
                          CandidateConstructorRun.view]
                        have selectedDrop : VExpr.dropN source.nparams
                            (VExpr.forallN
                              (VExpr.telN source.nparams headSemantic.type.view)
                              (VExpr.forallN headFields headTarget)) =
                              VExpr.forallN headFields headTarget := by
                          calc
                            _ = VExpr.dropN
                                (VExpr.telN source.nparams
                                  headSemantic.type.view).length
                                (VExpr.forallN
                                  (VExpr.telN source.nparams
                                    headSemantic.type.view)
                                  (VExpr.forallN headFields headTarget)) :=
                              congrArg
                                (fun count => VExpr.dropN count
                                  (VExpr.forallN
                                    (VExpr.telN source.nparams
                                      headSemantic.type.view)
                                    (VExpr.forallN headFields headTarget)))
                                viewParamsLength.symm
                            _ = _ := VExpr.dropN_forallN_length _ _
                        rw [selectedHeadEq, selectedDrop]
                      · have paramsLength : params.length = source.nparams := by
                          rw [← parameterContext.length_eq]
                          simpa using sourceNparams.symm
                        have viewParamsLength :
                            (VExpr.telN source.nparams
                              headSemantic.type.view).length = source.nparams :=
                          headParameters.length_eq.symm.trans paramsLength
                        have selectedParameterTypes :
                            VExpr.telN source.nparams selectedHead.type.view =
                              VExpr.telN source.nparams
                                headSemantic.type.view := by
                          calc
                            _ = VExpr.telN source.nparams
                                selectedHead.type.view := rfl
                            _ = VExpr.telN source.nparams
                                (VExpr.forallN
                                  (VExpr.telN source.nparams
                                    headSemantic.type.view)
                                  (VExpr.forallN headFields headTarget)) :=
                              congrArg (VExpr.telN source.nparams)
                                selectedHeadEq
                            _ = VExpr.telN
                                (VExpr.telN source.nparams
                                  headSemantic.type.view).length
                                (VExpr.forallN
                                  (VExpr.telN source.nparams
                                    headSemantic.type.view)
                                  (VExpr.forallN headFields headTarget)) := by
                              rw [viewParamsLength]
                            _ = _ := VExpr.telN_forallN_length _ _
                        rw [selectedParameterTypes]
                        exact headParameters
                      · have selectedFieldsLength :=
                          headSorts.length_eq.trans headState.sorts_length
                        rw [← sourceNparams] at selectedFieldsLength
                        have viewParamsLength :
                            (VExpr.telN source.nparams
                              headSemantic.type.view).length = source.nparams :=
                          headParameters.length_eq.symm.trans (by
                            rw [← parameterContext.length_eq]
                            simpa using sourceNparams.symm)
                        have selectedDrop : VExpr.dropN source.nparams
                            selectedHead.type.view =
                              VExpr.forallN headFields headTarget := by
                          rw [selectedHeadEq]
                          calc
                            _ = VExpr.dropN
                                (VExpr.telN source.nparams
                                  headSemantic.type.view).length
                                (VExpr.forallN
                                  (VExpr.telN source.nparams
                                    headSemantic.type.view)
                                  (VExpr.forallN headFields headTarget)) := by
                              rw [viewParamsLength]
                            _ = _ := VExpr.dropN_forallN_length _ _
                        rw [selectedDrop,
                          ctorFields_forallN_of_not_forall headFields
                            headTarget headNotForall]
                        exact selectedFieldsLength
                      · simp [AddInductive.ConstructorListValidationTrace.fieldSorts?,
                          headState.computed, tailComputed]

/-- Traverse the complete family-major constructor block using only the D3
pre-family replay and structural producer/validator inventories.  The
returned universe matrix is the exact result computed by the retained
ordinary validation trace, so no post-family alignment replay is needed. -/
theorem
    CandidateBlockFamilySemanticListRun.resolvedBlockConstructorEndpoints_structural
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {source inventorySource : VInductDecl} {params : List VExpr}
    {firstView : VExpr}
    {resultLevel : VLevel}
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    (semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws)
    {owner : Nat}
    {globalSuffixes : List Expr} {globalIndices : List (List VExpr)}
    {d3Context : AddInductive.Context}
    {d3ContextRun : AddInductive.ConstructorContextRun env Us d3Context}
    (suffixes : AddInductive.ConstructorBlockResolvedFamilyParameterSuffixes
      stats candidates)
    (constructorSuffixes :
      AddInductive.ConstructorBlockCandidateParameterSuffixes stats candidates)
    (d3Runs :
      AddInductive.ConstructorMutualBlockPreFamilyParameterSuffixLists env Us
        stats globalSuffixes d3Context d3ContextRun (owner := owner) suffixes
        constructorSuffixes)
    {isUnsafe : Bool} {validationContext : AddInductive.Context}
    {validation : AddInductive.ConstructorBlockValidationTraces stats
      isUnsafe validationContext owner sources}
    (fieldStates : CandidateBlockConstructorValidationFieldStateLists
      inventorySource env blockEnv Us stats isUnsafe validationContext
      validation semantics)
    (constructorParameters : CandidateBlockConstructorViewParameterDefEqLists
      env blockEnv Us source.nparams params semantics)
    (familyParameters : CandidateBlockFamilyViewParameterDefEqList env
      blockEnv Us source.nparams firstView semantics)
    (henv : VEnv.WF env) (hblockEnv : VEnv.WF blockEnv)
    (addType : env ≤ blockEnv)
    (parameterContext : TypeChecker.CandidateParameterContext []
      stats.params.toList params parameterΔ)
    (parameterWF : VLCtx.WF env Us.length parameterΔ)
    {d3ViewContext : VLCtx} {d3ViewLift : Lift}
    (d3State : ConstructorValidation.D3FullContextState env blockEnv Us
      d3Context parameterΔ parameterΔ
      d3ContextRun.candidate.context.vlctx d3ViewContext .refl d3ViewLift)
    (targets : ConstructorValidation.ResolvedMutualFamilyTargetState env
      blockEnv Us stats (familyHeaders source.nparams source.types)
      globalSuffixes globalIndices parameterΔ parameterΔ 0 .refl)
    (suffixDrop : globalSuffixes.drop owner = suffixes.values)
    (indicesDrop : globalIndices.drop owner =
      canonicalFamilyIndexLists source.nparams params semantics.views)
    (sourceUvars : source.uvars = Us.length)
    (sourceNparams : source.nparams = stats.params.size)
    (resultLevelTr : VLevel.ofLevel Us stats.resultLevel = some resultLevel)
    (levelsTr : stats.levels.mapM (VLevel.ofLevel Us) =
      some (VLevel.params Us.length))
    (familyFresh : ∀ name, name ∈ familyNames source.types →
      env.constants name = none)
    (familyNodup : (familyNames source.types).Nodup) :
    ∃ selected : CandidateBlockFamilySemanticListRun env blockEnv Us
        candidates raws,
      ∃ fieldSorts,
        ∃ runs : ResolvedBlockConstructorEndpointRunList source env blockEnv Us
            resultLevel globalIndices params parameterΔ owner
            constructorSuffixes.values fieldSorts,
          List.Forall₂ (fun family endpoints =>
            List.Forall₂ (fun constructor endpoint =>
              constructor.type = VExpr.forallN params endpoint)
              family.ctors endpoints)
            (canonicalizeFamilyParamsList source.nparams params selected.views)
            runs.endpoints ∧
          List.Forall₂ (fun original selectedFamily =>
            original.name = selectedFamily.name ∧
              original.type = selectedFamily.type)
            semantics.views selected.views ∧
          CandidateBlockFamilyViewParameterDefEqList env blockEnv Us
            source.nparams firstView selected ∧
          CandidateBlockConstructorViewParameterDefEqLists env blockEnv Us
            source.nparams params selected ∧
          CandidateBlockConstructorCanonicalFieldCountLists source.nparams
            selected ∧
          validation.fieldSorts? Us = some fieldSorts := by
  induction suffixes generalizing raws owner with
  | nil =>
      cases semantics
      cases d3Runs
      cases fieldStates
      cases constructorParameters
      cases familyParameters
      exact ⟨.nil, [], .nil, .nil, .nil, .nil, .nil, .nil, rfl⟩
  | @cons kernelSource kernelSources candidate candidates ownerSuffix
      parameters suffixTail ih =>
      cases semantics with
      | cons semantic semanticTail =>
        cases constructorSuffixes with
        | cons headSuffixes tailSuffixes =>
          cases d3Runs with
          | cons d3Head d3Tail =>
            cases fieldStates with
            | cons headStates tailStates =>
              cases constructorParameters with
              | cons headParameters tailParameters =>
                cases familyParameters with
                | cons headFamilyParameters tailFamilyParameters =>
                    have ownerAt : globalSuffixes[owner]? =
                        some ownerSuffix :=
                      list_getElem?_eq_some_of_drop_eq_cons suffixDrop
                    let ownerIndices := ctorFields
                      (VExpr.dropN source.nparams
                        (canonicalizeFamilyParams source.nparams params
                          semantic.view).type)
                    have ownerIndicesAt : globalIndices[owner]? =
                        some ownerIndices :=
                      list_getElem?_eq_some_of_drop_eq_cons indicesDrop
                    obtain ⟨headEndpoints, selectedHeadConstructors,
                        headFieldSorts, headTranslations, headRuns,
                        selectedHeadTypes, selectedHeadParameters,
                        selectedHeadCounts, headComputed⟩ :=
                      semantic.constructors
                        |>.resolvedBlockConstructorsWF_structural headSuffixes
                          d3Head headStates headParameters henv hblockEnv
                          addType parameterContext parameterWF d3State targets
                          ownerAt ownerIndicesAt sourceUvars sourceNparams
                          resultLevelTr levelsTr familyFresh familyNodup
                    obtain ⟨selectedTail, tailFieldSorts, tailRuns,
                        selectedTailTypes, selectedTailFamilyTypes,
                        selectedTailFamilyParameters,
                        selectedTailConstructorParameters,
                        selectedTailCounts, tailComputed⟩ :=
                      ih semanticTail tailSuffixes d3Tail tailStates
                        tailParameters tailFamilyParameters
                        (list_drop_succ_eq_of_drop_eq_cons suffixDrop)
                        (list_drop_succ_eq_of_drop_eq_cons indicesDrop)
                    let selectedHead : CandidateBlockFamilySemanticRun env
                        blockEnv Us candidate _ := {
                      name_eq := semantic.name_eq
                      uvars_eq := semantic.uvars_eq
                      type := semantic.type
                      constructors := selectedHeadConstructors }
                    let selected := CandidateBlockFamilySemanticListRun.cons
                      selectedHead selectedTail
                    let runs := ResolvedBlockConstructorEndpointRunList.cons
                      ownerIndices ownerIndicesAt headEndpoints
                      headTranslations headRuns tailRuns
                    refine ⟨selected, headFieldSorts :: tailFieldSorts, runs,
                      ?_, ?_, ?_, ?_, ?_, ?_⟩
                    · simp only [selected, selectedHead,
                        canonicalizeFamilyParamsList,
                        CandidateBlockFamilySemanticListRun.views,
                        List.map_cons, canonicalizeFamilyParams,
                        CandidateBlockFamilySemanticRun.view]
                      exact .cons selectedHeadTypes selectedTailTypes
                    · simp only [selected, selectedHead,
                        CandidateBlockFamilySemanticListRun.views,
                        CandidateBlockFamilySemanticRun.view]
                      exact .cons ⟨rfl, rfl⟩ selectedTailFamilyTypes
                    · exact .cons headFamilyParameters
                        selectedTailFamilyParameters
                    · exact .cons selectedHeadParameters
                        selectedTailConstructorParameters
                    · exact .cons selectedHeadCounts selectedTailCounts
                    · simp [AddInductive.ConstructorBlockValidationTraces.fieldSorts?,
                        headComputed, tailComputed]

private theorem sharedParameterTelescopeDefEqAux
    {env : VEnv} {Us : List Name}
    {nparams : Nat}
    {stats : AddInductive.InductiveStats}
    {validatorContext : AddInductive.Context}
    {validatorSource : Expr} {i nindices fuel : Nat}
    {outer : AddInductive.FamilyTypeParameterComparisonTrace nparams stats
      validatorContext validatorSource i nindices fuel}
    {suffixSource : Expr} {suffixFuel : Nat}
    {suffix : AddInductive.FamilyTypeParameterComparisonTrace nparams stats
      validatorContext suffixSource nparams nindices suffixFuel}
    {parameters : List Expr}
    (path : AddInductive.FamilyTypeParameterComparisonTrace.SharedPrefixPath
      nparams outer suffix parameters)
    (paramsSize : stats.params.size = nparams)
    (localState : TypeChecker.FamilyParameterLocalState stats validatorContext)
    (currentRun : TypeChecker.CandidateContextRun validatorContext)
    (currentVenv : currentRun.context.venv = env)
    (currentLparams : currentRun.context.lparams = Us)
    {validatorSource' : VExpr}
    (validatorSourceTr : currentRun.context.TrExprS
      validatorSource validatorSource')
    (recursionFuel : Nat)
    (validatorDepth : validatorContext.fuel.recDepth = recursionFuel + 1)
    {firstContext : AddInductive.Context} {firstSource : Expr}
    {firstTrace : AddInductive.CandidateExprTrace firstContext firstSource}
    {firstΔ firstTerminalΔ : VLCtx} {firstDomains : List VExpr}
    (firstSpine : TypeChecker.CandidateAnnotationSpine env Us firstTrace
      firstΔ firstTerminalΔ firstDomains)
    (firstAnnotations : firstTrace.validationAnnotations)
    (firstLocalRun : TypeChecker.CandidateLocalContextRun firstContext)
    (firstTerminalFind : ∀ {fv : FVarId} {decl : LocalDecl},
      firstTrace.terminalContext.lctx.find? fv = some decl →
        validatorContext.lctx.find? fv = some decl)
    {secondContext : AddInductive.Context} {secondSource : Expr}
    {secondTrace : AddInductive.CandidateExprTrace secondContext secondSource}
    {secondΔ secondTerminalΔ : VLCtx} {secondDomains : List VExpr}
    (secondSpine : TypeChecker.CandidateAnnotationSpine env Us secondTrace
      secondΔ secondTerminalΔ secondDomains)
    (secondAnnotations : secondTrace.validationAnnotations)
    (secondPosition : secondTrace.MainSpineAt count)
    (secondAligned : secondTrace.storedSpine = true)
    (secondDepth : secondContext.fuel.recDepth = recursionFuel + 1)
    (validatorSecondRoot : 0 < count →
      validatorSource = secondTrace.rootWhnf)
    (parametersFirst : parameters = firstTrace.parameterList count)
    (parametersSecond : parameters = secondTrace.parameterList count)
    (contextRelation : VLCtx.IsDefEqFVars env Us.length firstΔ secondΔ)
    {reference : VLCtx} {firstReferenceLift : Lift}
    (firstTerminalReference : VLCtx.FVLift' firstTerminalΔ reference 0
      firstReferenceLift 0)
    (currentReference : VLCtx.IsDefEq env Us.length
      currentRun.context.vlctx reference) :
    TypeChecker.TelDefEqEvidence env Us.length firstΔ.toCtx
      (firstDomains.take count) (secondDomains.take count) := by
  have henv : VEnv.WF env := by
    simpa only [currentVenv] using currentRun.context.Ewf
  have currentWF : VLCtx.WF env Us.length currentRun.context.vlctx := by
    simpa only [currentVenv, currentLparams] using currentRun.context.Δwf
  have referenceWF : VLCtx.WF env Us.length reference :=
    (currentReference.symm henv.ordered).wf
  have firstTerminalWF : VLCtx.WF env Us.length firstTerminalΔ :=
    firstTerminalReference.wf henv referenceWF
  induction secondPosition generalizing stats validatorSource i fuel outer
      suffixSource suffixFuel suffix parameters validatorSource'
      firstContext firstSource firstTrace firstΔ firstDomains
      secondΔ secondDomains with
  | zero trace =>
      cases path with
      | done => exact .nil
      | shared =>
          simp only [AddInductive.CandidateExprTrace.parameterList]
            at parametersSecond
          contradiction
  | succ bodyCandidate secondPosition ih =>
      rename_i n secondCandidateContext secondCandidateSource
        secondInferred secondName secondDomain secondBody secondBinderInfo
        secondFresh secondAnnotationsNode secondAnnotationsEq secondChecked
        secondNormalized secondDomainCandidate
      simp only [AddInductive.CandidateExprTrace.storedSpine,
        Bool.and_eq_true] at secondAligned
      rcases secondAligned with ⟨secondSourceStored, secondBodyAligned⟩
      rcases secondAnnotations with
        ⟨secondAnnotationMatch, secondTailAnnotations⟩
      cases secondSpine with
      | forallE secondDomainCandidate' secondBodyCandidate secondStoredDomain
          secondStoredDomains secondHead secondTail =>
          cases firstSpine with
          | terminal =>
              simp only [AddInductive.CandidateExprTrace.parameterList]
                at parametersFirst parametersSecond
              simp_all
          | forallE firstDomainCandidate firstBodyCandidate firstStoredDomain
              firstStoredDomains firstHead firstTail =>
              rename_i firstDomain firstName firstBinderInfo firstBody
                firstInferred firstAnnotationsNode firstFresh
                firstAnnotationsEq firstChecked firstNormalized
              rcases firstAnnotations with
                ⟨firstAnnotationMatch, firstTailAnnotations⟩
              simp only [AddInductive.CandidateExprTrace.parameterList]
                at parametersFirst parametersSecond
              cases path with
              | done => simp_all
              | shared tail suffix parametersTail isParameter laterFamily
                  parameterTypeRun comparisonValid whnf pathTail =>
                  rename_i validatorView validatorFuel parameterType
                    validatorDomain validatorName validatorBody
                    validatorBinderInfo
                  have parameterFirst : stats.params[i]! =
                      firstContext.freshExpr :=
                    (List.cons.inj parametersFirst).1
                  have parameterSecond : stats.params[i]! =
                      secondCandidateContext.freshExpr :=
                    (List.cons.inj parametersSecond).1
                  have parametersFirstTail : parametersTail =
                      firstBodyCandidate.parameterList n :=
                    (List.cons.inj parametersFirst).2
                  have parametersSecondTail : parametersTail =
                      bodyCandidate.parameterList n :=
                    (List.cons.inj parametersSecond).2
                  have sourceParts := validatorSecondRoot (by omega)
                  simp only [AddInductive.CandidateExprTrace.rootWhnf,
                    Expr.forallE.injEq] at sourceParts
                  rcases sourceParts with
                    ⟨validatorNameEq, validatorDomainEq, validatorBodyEq,
                      validatorBinderInfoEq⟩
                  obtain ⟨firstSnapshot, firstSnapshotContext,
                      firstStoredEq⟩ := firstHead firstAnnotationMatch
                  subst firstSnapshotContext
                  obtain ⟨secondSnapshot, secondSnapshotContext,
                      secondStoredEq⟩ := secondHead secondAnnotationMatch
                  subst secondSnapshotContext
                  have firstRootParts := firstSnapshot.root_eq
                  simp only [Expr.forallE.injEq] at firstRootParts
                  rcases firstRootParts with
                    ⟨firstSnapshotNameEq, firstSnapshotDomainEq,
                      firstSnapshotBodyEq, firstSnapshotBinderInfoEq⟩
                  have secondRootParts := secondSnapshot.root_eq
                  simp only [Expr.forallE.injEq] at secondRootParts
                  rcases secondRootParts with
                    ⟨secondSnapshotNameEq, secondSnapshotDomainEq,
                      secondSnapshotBodyEq, secondSnapshotBinderInfoEq⟩
                  have validatorSnapshotDomainEq : validatorDomain =
                      secondSnapshot.domain :=
                    validatorDomainEq.trans secondSnapshotDomainEq
                  have firstConsumedSourceEq :
                      firstAnnotationsNode.consumed =
                        firstSnapshot.consumed := by
                    calc
                      firstAnnotationsNode.consumed =
                          AddInductive.consumeTypeAnnotations firstDomain :=
                        firstAnnotationMatch
                      _ = AddInductive.consumeTypeAnnotations
                            firstSnapshot.domain :=
                        congrArg AddInductive.consumeTypeAnnotations
                          firstSnapshotDomainEq
                      _ = firstSnapshot.consumed :=
                        firstSnapshot.annotation_match.symm
                  have firstParameterFind :=
                    TypeChecker.CandidateExprTrace.head_find_terminal
                      firstName firstBinderInfo firstAnnotationsNode
                      firstBodyCandidate firstLocalRun
                  have validatorParameterFind :=
                    firstTerminalFind firstParameterFind
                  have validatorFirstParameterTypeRun :
                      AddInductive.getType firstContext.freshExpr
                        validatorContext =
                          .ok firstAnnotationsNode.consumed := by
                    simpa [AddInductive.Context.freshExpr, LocalDecl.type]
                      using TypeChecker.getType_fvar_of_find
                        validatorParameterFind
                  have parameterTypeEq : parameterType =
                      firstAnnotationsNode.consumed := by
                    have validatorParameterTypeRun := parameterTypeRun
                    rw [parameterFirst] at validatorParameterTypeRun
                    exact Except.ok.inj
                      (validatorParameterTypeRun.symm.trans
                        validatorFirstParameterTypeRun)
                  have parameterSnapshotEq : parameterType =
                      firstSnapshot.consumed :=
                    parameterTypeEq.trans firstConsumedSourceEq
                  let @TrExprS.forallE _ _ validatorDomain'
                      validatorBody' _ _ _ _ _ validatorDomainType
                      validatorBodyType validatorDomainTr validatorBodyTr :=
                    validatorSourceTr
                  have parameterMember : stats.params[i]! ∈
                      stats.params.toList := by
                    rw [show stats.params[i]! = stats.params[i] by
                      simp [isParameter, paramsSize]]
                    exact List.getElem_mem (by
                      simpa only [Array.length_toList, paramsSize] using
                        isParameter)
                  obtain ⟨fv, decl, parameterEq, parameterFind⟩ :=
                    localState.parameters parameterMember
                  have parameterTypeRun' :
                      AddInductive.getType (.fvar fv) validatorContext =
                        .ok parameterType := by
                    rw [← parameterEq]
                    exact parameterTypeRun
                  obtain ⟨fvValue, parameterType', fvFind,
                      parameterTypeTr⟩ :=
                    currentRun.getTypeTranslation parameterFind
                      parameterTypeRun'
                  have fvTr : currentRun.context.TrExprS (.fvar fv)
                      fvValue := .fvar fvFind
                  let comparisonRun : TypeChecker.IsDefEqRun
                      currentRun.context.venv currentRun.context.lparams
                      currentRun.context.vlctx validatorDomain parameterType
                      validatorDomain' parameterType' :=
                    TypeChecker.IsDefEqRun.ofCandidateStep
                      ⟨validatorContext, validatorDomain, parameterType⟩
                      comparisonValid currentRun.context
                      currentRun.context_eq rfl rfl rfl
                      currentRun.state_wf validatorDomainTr parameterTypeTr
                      validatorContext.fuel.recDepth rfl
                  have currentEnvWF : VEnv.WF currentRun.context.venv :=
                    currentRun.context.Ewf
                  have currentCtxWF : OnCtx
                      currentRun.context.vlctx.toCtx
                      (currentRun.context.venv.IsType
                        currentRun.context.lparams.length) :=
                    currentRun.context.Δwf.toCtx
                  obtain ⟨validatorSort, validatorDomainHasType⟩ :=
                    validatorDomainType
                  have validatorDomainDef :
                      currentRun.context.venv.IsDefEq
                        currentRun.context.lparams.length
                        currentRun.context.vlctx.toCtx validatorDomain'
                        parameterType' (.sort validatorSort) :=
                    comparisonRun.isDefEqU.of_l currentEnvWF currentCtxWF
                      validatorDomainHasType
                  have fvHasParameterType :
                      currentRun.context.venv.HasType
                        currentRun.context.lparams.length
                        currentRun.context.vlctx.toCtx fvValue
                        parameterType' :=
                    currentRun.context.Δwf.find?_wf
                      currentRun.context.Ewf.ordered fvFind
                  have fvHasDomain : currentRun.context.venv.HasType
                      currentRun.context.lparams.length
                      currentRun.context.vlctx.toCtx fvValue
                      validatorDomain' :=
                    validatorDomainDef.symm.defeq fvHasParameterType
                  have bodyInstTr : currentRun.context.TrExprS
                      (validatorBody.instantiate1 (.fvar fv))
                      (validatorBody'.inst fvValue) := by
                    simpa only [Expr.instantiate1_eq] using
                      validatorBodyTr.inst currentRun.context.Ewf.ordered
                        fvHasDomain fvTr
                  have bodyInstTr' : currentRun.context.TrExprS
                      (validatorBody.instantiate1 stats.params[i]!)
                      (validatorBody'.inst fvValue) := by
                    rw [parameterEq]
                    exact bodyInstTr
                  obtain ⟨validatorView', validatorViewTr,
                      ⟨validatorViewRun⟩⟩ :=
                    TypeChecker.WhnfRun.exists_ofCandidateStep
                      ⟨validatorContext,
                        validatorBody.instantiate1 stats.params[i]!,
                        validatorView⟩ whnf currentRun
                      (validatorBody'.inst fvValue) bodyInstTr'
                      recursionFuel validatorDepth
                  have validatorDomainTrEnv : TrExprS env Us
                      currentRun.context.vlctx validatorDomain
                      validatorDomain' := by
                    simpa only [TypeChecker.VContext.TrExprS, currentVenv,
                      currentLparams] using validatorDomainTr
                  have parameterTypeTrEnv : TrExprS env Us
                      currentRun.context.vlctx parameterType
                      parameterType' := by
                    simpa only [TypeChecker.VContext.TrExprS, currentVenv,
                      currentLparams] using parameterTypeTr
                  have firstLift : VLCtx.FVLift' firstSnapshot.Δ
                      firstTerminalΔ 0
                      (.skipN .refl
                        (firstStoredDomain :: firstStoredDomains).length) 0 := by
                    have combined :=
                      (VLCtx.FVLift'.skip_fvar _ _
                        VLCtx.FVLift'.refl).comp
                        (TypeChecker.CandidateAnnotationSpine.terminalLift
                          firstTail)
                    simpa only [List.length_cons, Lift.comp_skipN,
                      Lift.comp, Lift.skipN_skipN, VLocalDecl.depth,
                      Nat.one_add] using combined
                  have firstReference : VLCtx.FVLift' firstSnapshot.Δ
                      reference 0
                      ((Lift.skipN Lift.refl
                        (firstStoredDomain ::
                          firstStoredDomains).length).comp
                        firstReferenceLift) 0 :=
                    firstLift.comp firstTerminalReference
                  have firstWF : VLCtx.WF env Us.length firstSnapshot.Δ :=
                    firstLift.wf henv firstTerminalWF
                  have validatorDomainClosed : Closed validatorDomain 0 := by
                    rw [validatorSnapshotDomainEq]
                    simpa only [secondSnapshot.context_noBV] using
                      secondSnapshot.domain_tr.closed
                  have validatorDomainFVars :
                      FVarsIn (· ∈ firstSnapshot.Δ.fvars)
                        validatorDomain := by
                    rw [validatorSnapshotDomainEq]
                    simpa only [contextRelation.fvars] using
                      secondSnapshot.domain_tr.fvarsIn
                  have parameterTypeClosed : Closed parameterType 0 := by
                    rw [parameterSnapshotEq]
                    simpa only [firstSnapshot.context_noBV] using
                      firstSnapshot.consumed_tr.closed
                  have parameterTypeFVars :
                      FVarsIn (· ∈ firstSnapshot.Δ.fvars)
                        parameterType := by
                    rw [parameterSnapshotEq]
                    exact firstSnapshot.consumed_tr.fvarsIn
                  obtain ⟨baseDomain, baseDomainTr⟩ :=
                    validatorDomainTrEnv.weakFV'_inv henv firstReference
                      currentReference validatorDomainClosed
                      validatorDomainFVars
                  obtain ⟨baseParameterType, baseParameterTypeTr⟩ :=
                    parameterTypeTrEnv.weakFV'_inv henv firstReference
                      currentReference parameterTypeClosed
                      parameterTypeFVars
                  have comparisonCurrent : env.IsDefEqU Us.length
                      currentRun.context.vlctx.toCtx validatorDomain'
                      parameterType' := by
                    simpa only [currentVenv, currentLparams] using
                      comparisonRun.isDefEqU
                  have baseDomainAtReference :=
                    baseDomainTr.weakFV' henv.ordered firstReference
                      referenceWF
                  have baseParameterTypeAtReference :=
                    baseParameterTypeTr.weakFV' henv.ordered firstReference
                      referenceWF
                  have currentDomainEq :=
                    validatorDomainTrEnv.uniq henv currentReference
                      baseDomainAtReference
                  have currentParameterTypeEq :=
                    parameterTypeTrEnv.uniq henv currentReference
                      baseParameterTypeAtReference
                  have comparisonAtReference :=
                    comparisonCurrent.defeqDFC henv.ordered
                      currentReference.defeqCtx
                  have currentDomainEqAtReference :=
                    currentDomainEq.defeqDFC henv.ordered
                      currentReference.defeqCtx
                  have currentParameterTypeEqAtReference :=
                    currentParameterTypeEq.defeqDFC henv.ordered
                      currentReference.defeqCtx
                  have liftedComparison : env.IsDefEqU Us.length
                      reference.toCtx
                      (baseDomain.lift'
                        (((Lift.skipN Lift.refl
                          (firstStoredDomain :: firstStoredDomains).length).comp
                            firstReferenceLift).consN 0))
                      (baseParameterType.lift'
                        (((Lift.skipN Lift.refl
                          (firstStoredDomain :: firstStoredDomains).length).comp
                            firstReferenceLift).consN 0)) :=
                    (currentDomainEqAtReference.symm.trans henv
                      referenceWF.toCtx comparisonAtReference).trans henv
                        referenceWF.toCtx
                        currentParameterTypeEqAtReference
                  have comparisonAtBase : env.IsDefEqU Us.length
                      firstSnapshot.Δ.toCtx baseDomain baseParameterType :=
                    (VEnv.IsDefEqU.weak'_iff henv referenceWF.toCtx
                      firstReference.toCtx).1 liftedComparison
                  have snapshotDomainTr : TrExprS env Us secondSnapshot.Δ
                      validatorDomain secondSnapshot.domain' := by
                    rw [validatorSnapshotDomainEq]
                    exact secondSnapshot.domain_tr
                  have baseDomainSnapshotEq : env.IsDefEqU Us.length
                      firstSnapshot.Δ.toCtx baseDomain
                      secondSnapshot.domain' :=
                    baseDomainTr.uniqFVars henv contextRelation firstWF
                      snapshotDomainTr
                  have snapshotParameterTypeTr : TrExprS env Us
                      firstSnapshot.Δ parameterType
                      firstSnapshot.consumed' := by
                    rw [parameterSnapshotEq]
                    exact firstSnapshot.consumed_tr
                  have baseParameterSnapshotEq : env.IsDefEqU Us.length
                      firstSnapshot.Δ.toCtx baseParameterType
                      firstSnapshot.consumed' :=
                    baseParameterTypeTr.uniq henv (.refl henv firstWF)
                      snapshotParameterTypeTr
                  have secondAnnotationAtFirst : env.IsDefEqU Us.length
                      firstSnapshot.Δ.toCtx secondSnapshot.domain'
                      secondSnapshot.consumed' :=
                    secondSnapshot.annotation_run.isDefEqU.defeqDFC
                      henv.ordered
                      (contextRelation.defeqCtx.symm henv.ordered)
                  have firstAnnotation :=
                    firstSnapshot.annotation_run.isDefEqU.of_l henv
                      firstWF.toCtx firstSnapshot.domain_type
                  have storedDomainsU : env.IsDefEqU Us.length
                      firstSnapshot.Δ.toCtx firstSnapshot.consumed'
                      secondSnapshot.consumed' :=
                    (((baseParameterSnapshotEq.symm.trans henv firstWF.toCtx
                      comparisonAtBase.symm).trans henv firstWF.toCtx
                        baseDomainSnapshotEq).trans henv firstWF.toCtx
                          secondAnnotationAtFirst)
                  have storedDomainsDef :=
                    storedDomainsU.of_l henv firstWF.toCtx
                      firstAnnotation.hasType.2
                  rw [firstStoredEq, secondStoredEq] at storedDomainsDef
                  cases n with
                  | zero =>
                      have combined :
                          TypeChecker.TelDefEqEvidence env Us.length
                            firstSnapshot.Δ.toCtx
                            (firstStoredDomain ::
                              firstStoredDomains.take 0)
                            (secondStoredDomain ::
                              secondStoredDomains.take 0) :=
                        .cons (.ofDefEq storedDomainsDef) .nil
                      simpa only [List.take_succ_cons] using combined
                  | succ n =>
                      have candidateTailIsForall :
                          (secondBody.instantiate1
                            secondCandidateContext.freshExpr).isForall =
                              true :=
                        secondPosition.traceSource_isForall (by omega)
                          secondBodyAligned
                      have candidateBodyEq :=
                        AddInductive.CandidateWhnfStep.result_eq_of_source_isForall
                          bodyCandidate.rootWhnf_valid recursionFuel (by
                            simpa [AddInductive.Context.pushLocalDecl] using
                              secondDepth) candidateTailIsForall
                      have validatorTailIsForall :
                          (validatorBody.instantiate1
                            stats.params[i]!).isForall = true := by
                        rw [parameterSecond, validatorBodyEq]
                        exact candidateTailIsForall
                      have validatorBodyWhnfEq :=
                        AddInductive.CandidateWhnfStep.result_eq_of_source_isForall
                          whnf recursionFuel validatorDepth
                          validatorTailIsForall
                      have nextSourceEq : validatorView =
                          bodyCandidate.rootWhnf :=
                        validatorBodyWhnfEq.trans (by
                          rw [parameterSecond, validatorBodyEq]
                          exact candidateBodyEq.symm)
                      have freshIdEq : firstContext.freshFVarId =
                          secondCandidateContext.freshFVarId := by
                        apply Expr.fvar.inj
                        exact parameterFirst.symm.trans parameterSecond
                      have nextRelation :
                          VLCtx.IsDefEqFVars env Us.length
                            ((some (firstContext.freshFVarId,
                                firstAnnotationsNode.consumed.fvarsList),
                              .vlam firstStoredDomain) :: firstSnapshot.Δ)
                            ((some (secondCandidateContext.freshFVarId,
                                secondAnnotationsNode.consumed.fvarsList),
                              .vlam secondStoredDomain) ::
                                secondSnapshot.Δ) := by
                        rw [← freshIdEq]
                        exact .cons_fvar contextRelation
                          (.vlam storedDomainsDef)
                      have tailEvidence := ih pathTail paramsSize localState
                        validatorViewTr firstTail firstTailAnnotations
                        (firstLocalRun.push firstName firstBinderInfo
                          firstAnnotationsNode.consumed)
                        (fun found => firstTerminalFind (by
                          simpa only [
                            AddInductive.CandidateExprTrace.terminalContext]
                            using found))
                        secondTail secondTailAnnotations secondBodyAligned
                        (by simpa [AddInductive.Context.pushLocalDecl] using
                          secondDepth)
                        (fun _ => nextSourceEq) parametersFirstTail
                        parametersSecondTail
                        nextRelation
                      have combined :
                          TypeChecker.TelDefEqEvidence env Us.length
                            firstSnapshot.Δ.toCtx
                            (firstStoredDomain ::
                              firstStoredDomains.take (n + 1))
                            (secondStoredDomain ::
                              secondStoredDomains.take (n + 1)) :=
                        .cons (.ofDefEq storedDomainsDef) tailEvidence
                      simpa only [List.take_succ_cons] using combined

/-- A selected second-family telescope starts in the exact reader context
reached after the first family's complete telescope. -/
private theorem secondTelescope_context_eq_firstContext
    {nparams dIdx : Nat} {indTypes : Array InductiveType}
    {stats : AddInductive.InductiveStats}
    {context : AddInductive.Context}
    (trace : AddInductive.FamilyParameterComparisonBlockTrace nparams
      indTypes dIdx stats context)
    (position :
      AddInductive.FamilyParameterComparisonBlockTrace.FamilyTelescopePosition
        nparams)
    (h : trace.secondTelescope? = some position) :
    position.context = trace.firstContext := by
  cases trace with
  | firstFamily dIdx stats context inBounds closed inferred root checkType
      rootWhnf telescope sorted ensureSort isFirst tail =>
      cases tail
      case firstFamily =>
        simp only [
          AddInductive.FamilyParameterComparisonBlockTrace.secondTelescope?,
          AddInductive.FamilyParameterComparisonBlockTrace.headTelescope?,
          AddInductive.FamilyParameterComparisonBlockTrace.firstContext]
            at h ⊢
        cases Option.some.inj h
        rfl
      case laterFamily =>
        simp only [
          AddInductive.FamilyParameterComparisonBlockTrace.secondTelescope?,
          AddInductive.FamilyParameterComparisonBlockTrace.headTelescope?,
          AddInductive.FamilyParameterComparisonBlockTrace.firstContext]
            at h ⊢
        cases Option.some.inj h
        rfl
      case terminal =>
        simp only [
          AddInductive.FamilyParameterComparisonBlockTrace.secondTelescope?,
          AddInductive.FamilyParameterComparisonBlockTrace.headTelescope?]
            at h
        contradiction
  | laterFamily dIdx stats context inBounds closed inferred root checkType
      rootWhnf telescope sorted ensureSort isLater compatible tail =>
      cases tail
      case firstFamily =>
        simp only [
          AddInductive.FamilyParameterComparisonBlockTrace.secondTelescope?,
          AddInductive.FamilyParameterComparisonBlockTrace.headTelescope?,
          AddInductive.FamilyParameterComparisonBlockTrace.firstContext]
            at h ⊢
        cases Option.some.inj h
        rfl
      case laterFamily =>
        simp only [
          AddInductive.FamilyParameterComparisonBlockTrace.secondTelescope?,
          AddInductive.FamilyParameterComparisonBlockTrace.headTelescope?,
          AddInductive.FamilyParameterComparisonBlockTrace.firstContext]
            at h ⊢
        cases Option.some.inj h
        rfl
      case terminal =>
        simp only [
          AddInductive.FamilyParameterComparisonBlockTrace.secondTelescope?,
          AddInductive.FamilyParameterComparisonBlockTrace.headTelescope?]
            at h
        contradiction
  | terminal =>
      simp only [
        AddInductive.FamilyParameterComparisonBlockTrace.secondTelescope?]
          at h
      contradiction

private theorem candidateExprTrace_cast_context_spineLength
    {left right : AddInductive.Context} {source : Expr}
    (h : left = right)
    (trace : AddInductive.CandidateExprTrace left source) :
    (h ▸ trace).spineLength = trace.spineLength := by
  cases h
  rfl

private theorem candidateExprTrace_cast_context_terminalResult
    {left right : AddInductive.Context} {source : Expr}
    (h : left = right)
    (trace : AddInductive.CandidateExprTrace left source) :
    (h ▸ trace).terminalResult = trace.terminalResult := by
  cases h
  rfl

private theorem candidateExprTrace_cast_context_parameterList
    {left right : AddInductive.Context} {source : Expr}
    (h : left = right)
    (trace : AddInductive.CandidateExprTrace left source) (count : Nat) :
    (h ▸ trace).parameterList count = trace.parameterList count := by
  cases h
  rfl

private theorem candidateExprTrace_cast_context_validationAnnotations
    {left right : AddInductive.Context} {source : Expr}
    (h : left = right)
    {trace : AddInductive.CandidateExprTrace left source}
    (annotations : trace.validationAnnotations) :
    (h ▸ trace).validationAnnotations := by
  cases h
  exact annotations

/-- Exact first outer-family continuation together with the local parameter
inventory produced by its complete inner telescope. -/
structure
    ProducedBlockRecursorShapeCandidate.FirstFamilyAnnotationSpine.FirstFamilyValidationState
    {source : VInductDecl}
    {firstSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: remainingSources) numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    (owner : produced.FirstFamilyAnnotationSpine semantic) where
  continuation : AddInductive.FamilyParameterComparisonBlockTrace.FamilyContinuation
    source.nparams (firstSource :: remainingSources).toArray
  selected :
    (produced.execution.eliminationExecution.normalization
      |>.familyParameterComparisonTrace
        (produced.execution.normalization_run produced.producedExecution)
        produced.kernelSources_nonempty).headContinuation? =
      some continuation
  localState : TypeChecker.FamilyParameterLocalState
    continuation.telescope.result.stats
    continuation.telescope.result.context
  parameterSources_eq : continuation.telescope.result.stats.params.toList =
    produced.candidate.families.head.familyType.type.trace.parameterList
      source.nparams
  params_size : continuation.telescope.result.stats.params.size =
    source.nparams

/-- Replay the first validator telescope against the exact producer head.
This identifies the allocated parameter array position-for-position with the
candidate annotation prefix and retains the genuine terminal local state. -/
theorem
    ProducedBlockRecursorShapeCandidate.FirstFamilyAnnotationSpine.firstFamilyValidationState
    {source : VInductDecl}
    {firstSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: remainingSources) numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    (owner : produced.FirstFamilyAnnotationSpine semantic)
    (context_lctx_eq : context.lctx = {}) :
    Nonempty owner.FirstFamilyValidationState := by
  let normalization :=
    produced.execution.eliminationExecution.normalization
  have normalizationProduced :=
    produced.execution.normalization_run produced.producedExecution
  have firstBound := owner.nparams_le_spineLength context_lctx_eq
  have familyTypeFuel :=
    normalization.firstFamilyType_spineLength_lt_inductiveFuel
      normalizationProduced context_lctx_eq
  have firstFuel :
      produced.candidate.families.head.familyType.type.trace.spineLength <
        context.fuel.inductiveFuel := by
    have candidateFuel :
        normalization.families.candidates.head.familyType.type.trace.spineLength <
          context.fuel.inductiveFuel := by
      rw [normalization.families.produced.head_familyType]
      exact familyTypeFuel
    exact candidateFuel
  have candidateContextEq : { context with lctx := {} } = context := by
    cases context
    simp_all
  have firstContextEq :
      produced.candidate.families.head.familyType.type.context = context :=
    owner.validationAnnotations.head_context_eq.trans candidateContextEq
  let firstTrace : AddInductive.CandidateExprTrace context firstSource.type :=
    firstContextEq ▸
      produced.candidate.families.head.familyType.type.trace
  have firstTraceSpine := candidateExprTrace_cast_context_spineLength
    firstContextEq produced.candidate.families.head.familyType.type.trace
  have firstTraceBound : source.nparams ≤ firstTrace.spineLength := by
    rw [firstTraceSpine]
    exact firstBound
  have firstTraceFuel : firstTrace.spineLength <
      context.fuel.inductiveFuel := by
    rw [firstTraceSpine]
    exact firstFuel
  have firstTraceAnnotations : firstTrace.validationAnnotations := by
    simpa only [firstTrace] using
      (candidateExprTrace_cast_context_validationAnnotations firstContextEq
        owner.validationAnnotations.head)
  obtain ⟨_firstLevel, firstTerminal⟩ :=
    owner.validationAnnotations.head_terminal
  have firstTraceTerminal :=
    candidateExprTrace_cast_context_terminalResult firstContextEq
      produced.candidate.families.head.familyType.type.trace
  have terminalForall : firstTrace.terminalResult.isForall = false := by
    rw [firstTraceTerminal, firstTerminal]
    rfl
  let comparisonTrace :=
    normalization.familyParameterComparisonTrace normalizationProduced
      produced.kernelSources_nonempty
  generalize comparisonTrace_eq : comparisonTrace = trace
  cases trace with
  | firstFamily dIdx stats validationContext inBounds closed inferred root
      checkType rootWhnf telescope sorted ensureSort isFirst tail =>
    have candidateWhnf := firstTrace.rootWhnf_valid
    have candidateWhnf' : AddInductive.CandidateWhnfStep.Valid
        ⟨context, firstSource.type, firstTrace.rootWhnf⟩ :=
      candidateWhnf
    have rootWhnf' : AddInductive.CandidateWhnfStep.Valid
        ⟨context, firstSource.type, root⟩ := by
      simpa using rootWhnf
    have root_eq : root = firstTrace.rootWhnf :=
      Except.ok.inj (rootWhnf'.symm.trans candidateWhnf')
    subst root
    have resultEq :=
      AddInductive.FamilyTypeParameterComparisonTrace.result_eq_candidate
        (nparams := source.nparams) (i := 0) (nindices := 0)
        (fuel := context.fuel.inductiveFuel)
        (stats := AddInductive.InductiveStats.initial
          (context.lparams.map .param))
        (context := context) (candidate := firstTrace)
        (trace := telescope) (remaining := source.nparams)
        (hi := by simp) (hcount := firstTraceBound)
        (hfuel := firstTraceFuel) (hempty := rfl)
        (hannotations := firstTraceAnnotations)
        (hterminal := terminalForall)
    have paramsEq := congrArg
      (fun result : AddInductive.FamilyTypeParameterComparisonTrace.Result =>
        result.stats.params.toList) resultEq
    have parameterSourcesEq : telescope.result.stats.params.toList =
        produced.candidate.families.head.familyType.type.trace.parameterList
          source.nparams := by
      calc
        telescope.result.stats.params.toList =
            firstTrace.parameterList source.nparams := by
          simpa [AddInductive.InductiveStats.initial] using paramsEq
        _ = produced.candidate.families.head.familyType.type.trace.parameterList
              source.nparams :=
          candidateExprTrace_cast_context_parameterList firstContextEq
            produced.candidate.families.head.familyType.type.trace
            source.nparams
    obtain ⟨localState, paramsSize⟩ :=
      TypeChecker.familyTypeParameterComparison_localResult_of_first
        telescope (by rfl) (by rfl)
          (TypeChecker.FamilyParameterLocalState.empty context
            (context.lparams.map .param) context_lctx_eq)
    exact ⟨{
      continuation := _
      selected := by
        change comparisonTrace.headContinuation? = some _
        rw [comparisonTrace_eq]
        rfl
      localState := localState
      parameterSources_eq := parameterSourcesEq
      params_size := paramsSize }⟩
  | laterFamily dIdx stats validationContext inBounds closed inferred root
      checkType rootWhnf telescope sorted ensureSort isLater
      resultLevelCompatible tail =>
    have first : telescope.result.stats.indConsts.isEmpty = true := by
      rw [telescope.result_indConsts_eq]
      rfl
    rw [first] at isLater
    contradiction
  | terminal dIdx stats validationContext outOfBounds =>
    simp at outOfBounds

private theorem familyParameterComparisonBlockTrace_headContinuation_firstContext
    {nparams dIdx : Nat} {indTypes : Array InductiveType}
    {stats : AddInductive.InductiveStats}
    {context : AddInductive.Context}
    {trace : AddInductive.FamilyParameterComparisonBlockTrace nparams
      indTypes dIdx stats context}
    {continuation :
      AddInductive.FamilyParameterComparisonBlockTrace.FamilyContinuation
        nparams indTypes}
    (selected : trace.headContinuation? = some continuation) :
    trace.firstContext = continuation.telescope.result.context := by
  cases trace with
  | firstFamily dIdx stats context inBounds closed inferred root checkType
      rootWhnf telescope sorted ensureSort isFirst tail =>
    simp only [AddInductive.FamilyParameterComparisonBlockTrace.headContinuation?]
      at selected
    cases Option.some.inj selected
    rfl
  | laterFamily dIdx stats context inBounds closed inferred root checkType
      rootWhnf telescope sorted ensureSort isLater resultLevelCompatible tail =>
    simp only [AddInductive.FamilyParameterComparisonBlockTrace.headContinuation?]
      at selected
    cases Option.some.inj selected
    rfl
  | terminal =>
    simp only [AddInductive.FamilyParameterComparisonBlockTrace.headContinuation?]
      at selected
    contradiction

private theorem familyParameterComparisonBlockTrace_headContinuation_nextParams
    {nparams dIdx : Nat} {indTypes : Array InductiveType}
    {stats : AddInductive.InductiveStats}
    {context : AddInductive.Context}
    {trace : AddInductive.FamilyParameterComparisonBlockTrace nparams
      indTypes dIdx stats context}
    {continuation :
      AddInductive.FamilyParameterComparisonBlockTrace.FamilyContinuation
        nparams indTypes}
    (selected : trace.headContinuation? = some continuation) :
    continuation.nextStats.params =
      continuation.telescope.result.stats.params := by
  cases trace with
  | firstFamily dIdx stats context inBounds closed inferred root checkType
      rootWhnf telescope sorted ensureSort isFirst tail =>
    simp only [AddInductive.FamilyParameterComparisonBlockTrace.headContinuation?]
      at selected
    cases Option.some.inj selected
    rfl
  | laterFamily dIdx stats context inBounds closed inferred root checkType
      rootWhnf telescope sorted ensureSort isLater resultLevelCompatible tail =>
    simp only [AddInductive.FamilyParameterComparisonBlockTrace.headContinuation?]
      at selected
    cases Option.some.inj selected
    rfl
  | terminal =>
    simp only [AddInductive.FamilyParameterComparisonBlockTrace.headContinuation?]
      at selected
    contradiction

/-- At an exhausted outer-family suffix, transport the genuine local
parameter inventory through the validator's terminal assertion wrapper. -/
private theorem familyParameterComparisonBlockTrace_terminalLocalStateExact
    {nparams dIdx : Nat} {indTypes : Array InductiveType}
    {stats : AddInductive.InductiveStats}
    {context : AddInductive.Context}
    {parameterSources : List Expr}
    (trace : AddInductive.FamilyParameterComparisonBlockTrace nparams
      indTypes dIdx stats context)
    (lengthLe : indTypes.size ≤ dIdx)
    (localState : TypeChecker.FamilyParameterLocalState stats context)
    (rawParamsSize : stats.params.size = nparams)
    (parameterSourcesEq : stats.params.toList = parameterSources)
    (resultParamsSize : trace.result.stats.params.size = nparams) :
    TypeChecker.FamilyParameterLocalState trace.result.stats
        trace.result.validationContext ∧
      trace.result.stats.params.toList = parameterSources ∧
      trace.result.stats.params.size = nparams := by
  cases trace with
  | firstFamily dIdx stats context inBounds closed inferred root checkType
      rootWhnf telescope sorted ensureSort isFirst tail =>
    omega
  | laterFamily dIdx stats context inBounds closed inferred root checkType
      rootWhnf telescope sorted ensureSort isLater resultLevelCompatible tail =>
    omega
  | terminal dIdx stats context outOfBounds =>
    have paramsEq :
        (AddInductive.familyValidationTerminalStats nparams indTypes stats
          context).params = stats.params :=
      AddInductive.familyValidationTerminalStats_params_eq_of_sizes stats
        context rawParamsSize (by
          simpa only [
            AddInductive.FamilyParameterComparisonBlockTrace.result] using
            resultParamsSize)
    have terminalLocal : TypeChecker.FamilyParameterLocalState
        (AddInductive.familyValidationTerminalStats nparams indTypes stats
          context) context :=
      localState.of_params_eq paramsEq
    refine ⟨?_, ?_, resultParamsSize⟩
    · simpa only [AddInductive.FamilyParameterComparisonBlockTrace.result]
        using terminalLocal
    · exact (congrArg Array.toList paramsEq).trans parameterSourcesEq

/-- Interpret the first later family's complete shared-parameter comparison
inventory in the exact context reached by the first family.

The two-family source prefix fixes every position.  The first-family context
owner is transported only along the equality selected by the retained outer
trace.  The dependent semantic second root is then weakened into that exact
context, its retained validator WHNF supplies the inner root translation, and
the local-state traversal supplies the genuine shared-parameter declarations.
The result exposes the producer's grouped comparison list as an exact
`[] :: second :: remaining` decomposition; neither the second family nor its
comparison inventory is selected by a caller.  It also returns the exact
translated index-only suffix selected from that same second outer node. -/
theorem ProducedBlockRecursorShapeCandidate.semanticSecondFamilyParameterComparisons
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context)
    {env blockEnv : VEnv} {Us : List Name}
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source)
    (annotation : produced.SecondFamilyAnnotationSpine semantic)
    (context_lctx_eq : context.lctx = {}) :
    ∃ secondComparisons remainingComparisons,
      (produced.execution.eliminationExecution.normalization
        |>.familyParameterComparisonTrace
          (produced.execution.normalization_run produced.producedExecution)
          produced.kernelSources_nonempty).comparisons =
        [] :: secondComparisons :: remainingComparisons ∧
      (∀ step ∈ secondComparisons,
        TypeChecker.FamilyComparisonSemanticRun step) ∧
      ∃ position,
        (produced.execution.eliminationExecution.normalization
          |>.familyParameterComparisonTrace
          (produced.execution.normalization_run produced.producedExecution)
            produced.kernelSources_nonempty).secondTelescope? =
          some position ∧
        position.stats.indConsts.isEmpty = false ∧
        position.stats.params.size = source.nparams ∧
        position.i = 0 ∧
        position.nindices = 0 ∧
        position.context.fuel = context.fuel ∧
        AddInductive.CandidateWhnfStep.Valid
          ⟨position.context, secondSource.type, position.source⟩ ∧
        ∃ currentRun : TypeChecker.CandidateContextRun position.context,
          currentRun.context.venv = env ∧
          currentRun.context.lparams = Us ∧
          ∃ parameterRoot : VExpr,
            ∃ boundary : TypeChecker.FamilyParameterIndexBoundary
                position.trace currentRun,
              currentRun.context.TrExprS position.source parameterRoot ∧
              currentRun.context.venv.IsDefEqU
                currentRun.context.lparams.length
                currentRun.context.vlctx.toCtx annotation.secondRaw.type
                parameterRoot ∧
              TypeChecker.FamilyParameterSemanticSpine
                currentRun.context.venv currentRun.context.lparams.length
                currentRun.context.vlctx.toCtx parameterRoot
                (boundary.parameters.map Prod.snd) boundary.source' := by
  let normalization :=
    produced.execution.eliminationExecution.normalization
  have normalizationProduced :=
    produced.execution.normalization_run produced.producedExecution
  let comparisonTrace :=
    normalization.familyParameterComparisonTrace normalizationProduced
      produced.kernelSources_nonempty
  change ∃ secondComparisons remainingComparisons,
    comparisonTrace.comparisons =
      [] :: secondComparisons :: remainingComparisons ∧
    (∀ step ∈ secondComparisons,
      TypeChecker.FamilyComparisonSemanticRun step) ∧
    ∃ position,
      comparisonTrace.secondTelescope? = some position ∧
      position.stats.indConsts.isEmpty = false ∧
      position.stats.params.size = source.nparams ∧
      position.i = 0 ∧
      position.nindices = 0 ∧
      position.context.fuel = context.fuel ∧
      AddInductive.CandidateWhnfStep.Valid
        ⟨position.context, secondSource.type, position.source⟩ ∧
      ∃ currentRun : TypeChecker.CandidateContextRun position.context,
        currentRun.context.venv = env ∧
        currentRun.context.lparams = Us ∧
        ∃ parameterRoot : VExpr,
          ∃ boundary : TypeChecker.FamilyParameterIndexBoundary
              position.trace currentRun,
            currentRun.context.TrExprS position.source parameterRoot ∧
            currentRun.context.venv.IsDefEqU
              currentRun.context.lparams.length
              currentRun.context.vlctx.toCtx annotation.secondRaw.type
              parameterRoot ∧
            TypeChecker.FamilyParameterSemanticSpine
              currentRun.context.venv currentRun.context.lparams.length
              currentRun.context.vlctx.toCtx parameterRoot
              (boundary.parameters.map Prod.snd) boundary.source'
  have roots := semantic.families
  cases hCandidates : produced.candidate.families with
  | cons firstCandidate remainingCandidates =>
    rw [hCandidates] at roots
    cases remainingCandidates with
    | cons secondCandidate remainingCandidates =>
      cases hRawTypes : source.types with
      | nil =>
        rw [hRawTypes] at roots
        nomatch roots
      | cons firstRaw rawTypes =>
        rw [hRawTypes] at roots
        cases roots with
        | cons firstSemantic remainingSemantics =>
          cases hRawTypesTail : rawTypes with
          | nil =>
            rw [hRawTypesTail] at remainingSemantics
            nomatch remainingSemantics
          | cons secondRaw remainingRawTypes =>
            rw [hRawTypesTail] at remainingSemantics
            cases remainingSemantics with
            | cons secondSemantic remainingSemantics =>
              have annotationRawsEq := annotation.raws_eq
              rw [hRawTypes, hRawTypesTail] at annotationRawsEq
              simp only [List.cons.injEq] at annotationRawsEq
              have secondRawEq : secondRaw = annotation.secondRaw :=
                annotationRawsEq.2.1
              generalize comparisonTrace_eq : comparisonTrace = trace at ⊢
              cases trace with
              | firstFamily dIdx stats validationContext inBounds closed
                  inferred root checkType rootWhnf telescope sorted ensureSort
                  isFirst tail =>
                obtain ⟨firstContextRun, firstVenv, firstLparams⟩ :=
                  produced.semanticFirstFamilyContextRun semantic
                    context_lctx_eq
                have firstContextEq : comparisonTrace.firstContext =
                    telescope.result.context :=
                  congrArg
                    AddInductive.FamilyParameterComparisonBlockTrace.firstContext
                    comparisonTrace_eq
                let currentRun : TypeChecker.CandidateContextRun
                    telescope.result.context := firstContextEq ▸ firstContextRun
                have currentContextEq : currentRun.context =
                    firstContextRun.context :=
                  candidateContextRun_cast_context firstContextEq
                    firstContextRun
                have currentVenv : currentRun.context.venv = env := by
                  rw [currentContextEq]
                  exact firstVenv
                have currentLparams : currentRun.context.lparams = Us := by
                  rw [currentContextEq]
                  exact firstLparams
                have secondTranslation := currentRun.rootTranslation
                  currentVenv currentLparams secondSemantic.type.source_tr
                have firstComparisons :=
                  telescope.comparisons_eq_nil_of_firstFamily (by rfl)
                obtain ⟨firstLocal, firstParamsSize⟩ :=
                  TypeChecker.familyTypeParameterComparison_localResult_of_first
                    telescope (by rfl) (by rfl)
                      (TypeChecker.FamilyParameterLocalState.empty
                        context (context.lparams.map .param) context_lctx_eq)
                let nextStats : AddInductive.InductiveStats := {
                  telescope.result.stats with
                  lctx := telescope.result.context.lctx
                  resultLevel := sorted.sortLevel!
                  isNotZero := sorted.sortLevel!.isNeverZero
                  nindices := telescope.result.stats.nindices.push
                    telescope.result.nindices
                  indConsts := telescope.result.stats.indConsts.push
                    (.const
                      (firstSource :: secondSource ::
                        remainingSources).toArray[0].name
                      telescope.result.stats.levels) }
                cases tail with
                | @laterFamily dIdx stats secondContext inBounds closed
                    inferred secondRoot checkType secondRootWhnf
                    secondTelescope sorted ensureSort isLater
                    resultLevelCompatible tail =>
                  have statsLater : nextStats.indConsts.isEmpty = false := by
                    rw [secondTelescope.result_indConsts_eq] at isLater
                    simpa only [nextStats] using isLater
                  have paramsSize :
                      nextStats.params.size = source.nparams := by
                    simpa using firstParamsSize
                  have secondLocal :
                      TypeChecker.FamilyParameterLocalState nextStats
                        telescope.result.context := by
                    exact ⟨firstLocal.localContext, firstLocal.parameters⟩
                  have normalizationCandidatesEq := hCandidates
                  change normalization.families.candidates =
                    AddInductive.CandidateList.cons firstCandidate
                      (AddInductive.CandidateList.cons secondCandidate
                        remainingCandidates) at normalizationCandidatesEq
                  have familyTypesProduced :=
                    normalization.familyTypes.produced
                  rw [← normalization.families.produced.familyTypes_eq] at familyTypesProduced
                  rw [normalizationCandidatesEq] at familyTypesProduced
                  simp only [AddInductive.CandidateList.familyTypes] at familyTypesProduced
                  have secondProduced := familyTypesProduced.tail.head
                  have secondContextEq :=
                    AddInductive.CandidateFamilyType.context_eq_of_normalize
                      secondProduced
                  have whnfDepth :
                      telescope.result.context.fuel.recDepth =
                        secondSemantic.type.whnfFuel + 1 := by
                    calc
                      telescope.result.context.fuel.recDepth =
                          context.fuel.recDepth :=
                        congrArg (fun fuel => fuel.recDepth)
                          telescope.result_context_fuel
                      _ = secondCandidate.familyType.type.context.fuel.recDepth :=
                        (congrArg (fun candidateContext =>
                          candidateContext.fuel.recDepth)
                            secondContextEq).symm
                      _ = secondSemantic.type.whnfFuel + 1 :=
                        secondSemantic.type.whnfDepth
                  have secondSourceTranslation : currentRun.context.TrExprS
                      (firstSource :: secondSource ::
                        remainingSources).toArray[0 + 1].type
                      secondRaw.type := by
                    simpa using secondTranslation
                  obtain ⟨secondRoot', secondRootTranslation,
                      ⟨secondRootRun⟩⟩ :=
                    TypeChecker.WhnfRun.exists_ofCandidateStep
                      ⟨telescope.result.context,
                        (firstSource :: secondSource ::
                          remainingSources).toArray[0 + 1].type,
                        secondRoot⟩
                      secondRootWhnf currentRun secondRaw.type
                      secondSourceTranslation secondSemantic.type.whnfFuel
                      whnfDepth
                  obtain ⟨secondRuns, secondBoundary, parameterSpine⟩ :=
                    TypeChecker.familyTypeParameterComparison_semanticSpine_of_later
                      secondTelescope statsLater paramsSize secondLocal
                      currentRun secondRoot' secondRootTranslation
                      secondSemantic.type.whnfFuel whnfDepth
                  have rawRootDef := secondRootRun.isDefEqU
                  rw [secondRawEq] at rawRootDef
                  let secondPosition :
                      AddInductive.FamilyParameterComparisonBlockTrace.FamilyTelescopePosition
                        source.nparams := {
                    stats := nextStats
                    context := telescope.result.context
                    source := secondRoot
                    i := 0
                    nindices := 0
                    fuel := telescope.result.context.fuel.inductiveFuel
                    trace := secondTelescope }
                  refine ⟨secondTelescope.comparisons, tail.comparisons, ?_,
                    secondRuns, secondPosition, (by rfl), statsLater,
                    paramsSize,
                    (by rfl), (by rfl), telescope.result_context_fuel,
                    secondRootWhnf,
                    currentRun, currentVenv, currentLparams,
                    secondRoot', secondBoundary,
                    secondRootTranslation, rawRootDef, parameterSpine⟩
                  · simp only [
                      AddInductive.FamilyParameterComparisonBlockTrace.comparisons,
                      firstComparisons]
                | @firstFamily dIdx stats secondContext inBounds closed
                    inferred secondRoot checkType secondRootWhnf
                    secondTelescope sorted ensureSort isFirst tail =>
                  have notFirst :
                      secondTelescope.result.stats.indConsts.isEmpty = false := by
                    rw [secondTelescope.result_indConsts_eq]
                    simp
                  rw [notFirst] at isFirst
                  contradiction
                | @terminal dIdx stats secondContext outOfBounds =>
                  simp at outOfBounds
              | laterFamily dIdx stats validationContext inBounds closed
                  inferred root checkType rootWhnf telescope sorted ensureSort
                  isLater resultLevelCompatible tail =>
                have first :
                    telescope.result.stats.indConsts.isEmpty = true := by
                  rw [telescope.result_indConsts_eq]
                  rfl
                rw [first] at isLater
                contradiction
              | terminal dIdx stats validationContext outOfBounds =>
                simp at outOfBounds

/--
info: 'Lean4Lean.VInductDecl.ProducedBlockRecursorShapeCandidate.semanticSecondFamilyParameterComparisons' depends on axioms: [propext,
