    simpa using paramsSize
  rw [parameterLength] at parameterTranslations
  exact trace.stage.fieldCount_eq_ctorFields_length_of_translation_resolved
    suffixTr henv parameterWF paramsSize ownerLt familyData levelsTr
    parameterTranslations parameterContext.sources_fvar before covered
    projectionSafe
    (VLCtx.FVarLamOnly.valuesAnyConstFree
      (TypeChecker.CandidateParameterContext.fvarLamOnly
        parameterContext .nil) names) literalSafe

