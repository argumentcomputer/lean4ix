def ProducedBlockRecursorShapeCandidate.auditResolvedCore?
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    (Us : List Name) :
    Except Exception (ProducedBlockRecursorResolvedCoreAuditRun produced Us) :=
  match alignmentRun :
      AddInductive.ConstructorBlockCandidateAlignmentTrace.check
        (produced.execution.eliminationExecution.normalization
          |>.constructorValidation.traces)
        produced.candidate.families with
  | .error error => .error error
  | .ok () =>
      match stage3Run :
          AddInductive.ConstructorBlockStage3ResolvedTraces.check
            produced.execution.eliminationExecution.normalization.stats
            Us source.uvars produced.candidate.families with
      | .error error => .error error
      | .ok () =>
          match preFamilyRun :
              AddInductive.checkConstructorMutualBlockResolvedPreFamilySafety
                produced.execution.eliminationExecution.normalization.stats
                produced.execution.eliminationExecution.normalization.validationContext
                produced.candidate.families with
          | .error error => .error error
          | .ok () =>
              match universeRun :
                  AddInductive.checkConstructorBlockUniverseSemantics
                    produced.execution.eliminationExecution.normalization.stats
                    kernelSources
                    { produced.execution.eliminationExecution.normalization.validationContext
                      with env :=
                        produced.execution.eliminationExecution.normalization.familyEnv } with
              | .error error => .error error
              | .ok () => .ok {
                  alignmentRun
                  stage3Run
                  preFamilyRun
                  universeRun }

/-- Recompose the projection-aware core audit from successful equations for
its exact retained producer.  This theorem exposes the successful executable
branch without selecting a parallel producer or rerunning any earlier
normalization phase. -/
theorem ProducedBlockRecursorShapeCandidate.auditResolvedCore?_success
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    (Us : List Name)
    (alignmentRun :
      AddInductive.ConstructorBlockCandidateAlignmentTrace.check
        (produced.execution.eliminationExecution.normalization
          |>.constructorValidation.traces)
        produced.candidate.families = .ok ())
    (stage3Run :
      AddInductive.ConstructorBlockStage3ResolvedTraces.check
        produced.execution.eliminationExecution.normalization.stats
        Us source.uvars produced.candidate.families = .ok ())
    (preFamilyRun :
      AddInductive.checkConstructorMutualBlockResolvedPreFamilySafety
        produced.execution.eliminationExecution.normalization.stats
        produced.execution.eliminationExecution.normalization.validationContext
        produced.candidate.families = .ok ())
    (universeRun :
      AddInductive.checkConstructorBlockUniverseSemantics
        produced.execution.eliminationExecution.normalization.stats
        kernelSources
        { produced.execution.eliminationExecution.normalization.validationContext
          with env :=
            produced.execution.eliminationExecution.normalization.familyEnv } =
          .ok ()) :
    ∃ audit : ProducedBlockRecursorResolvedCoreAuditRun produced Us,
      produced.auditResolvedCore? Us = .ok audit := by
  unfold ProducedBlockRecursorShapeCandidate.auditResolvedCore?
  repeat' split <;> simp_all
  refine ⟨?_, trivial⟩
  constructor <;> assumption

