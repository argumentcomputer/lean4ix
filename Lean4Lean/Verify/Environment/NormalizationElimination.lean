    {env blockEnv : VEnv} {Us : List Name}
    {generation : BlockGenerationChecked source}
    {run : ExactProducedBlockGenerationRun env blockEnv Us
      produced.eliminationBase.base generation}
    (support : run.HasSecondFamilyIndexSupport)
    (context_lctx_eq : context.lctx = {}) :
    Nonempty (ConstructorRawPreFamilyParameterAuditBasis env Us
      produced.execution.eliminationExecution.normalization.stats
      produced.execution.eliminationExecution.normalization.validationContext
      source.nparams generation.block.checked.params) := by
  cases kernelSources with
