/-- List-shape-independent presentation of the two-or-more-family
parameter-audit domain.  No strict second-family index suffix is required. -/
def ExactProducedBlockGenerationRun.HasSecondFamilySupport
    {source : VInductDecl}
    {kernelSources : List Lean.InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {generation : BlockGenerationChecked source}
    (run : ExactProducedBlockGenerationRun env blockEnv Us
      produced.eliminationBase.base generation) : Type :=
  match kernelSources with
  | _firstSource :: _secondSource :: _remainingSources =>
      run.SecondFamilySupport
  | _ => Empty

/-- Forget the source-list case split after constructing the exact checked
parameter basis for any block with at least two families. -/
theorem
    ExactProducedBlockGenerationRun.HasSecondFamilySupport.rawParameterAuditBasis_nonempty
    {source : VInductDecl}
    {kernelSources : List Lean.InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {generation : BlockGenerationChecked source}
    {run : ExactProducedBlockGenerationRun env blockEnv Us
      produced.eliminationBase.base generation}
    (support : run.HasSecondFamilySupport)
    (context_lctx_eq : context.lctx = {}) :
    Nonempty (ConstructorRawPreFamilyParameterAuditBasis env Us
      produced.execution.eliminationExecution.normalization.stats
      produced.execution.eliminationExecution.normalization.validationContext
      source.nparams generation.block.checked.params) := by
  cases kernelSources with
  | nil => exact support.elim
  | cons firstSource laterSources =>
      cases laterSources with
      | nil => exact support.elim
      | cons secondSource remainingSources =>
          exact
            ExactProducedBlockGenerationRun.SecondFamilySupport.rawParameterAuditBasis_nonempty
              support context_lctx_eq

/-- Source-shape-independent ownership of the family traversal needed to
construct the checked shared-parameter basis.  Singleton blocks retain only
their first-family annotation; mutual blocks retain the second-family
staging, whose terminal completion covers both indexed and zero-index
families.  The empty case is uninhabited. -/
def ExactProducedBlockGenerationRun.FamilyTraversalSupport
    {source : VInductDecl}
    {kernelSources : List Lean.InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {generation : BlockGenerationChecked source}
    (run : ExactProducedBlockGenerationRun env blockEnv Us
      produced.eliminationBase.base generation) : Type :=
  match kernelSources with
  | [] => Empty
  | [_firstSource] => run.SingletonFamilySupport
  | _firstSource :: _secondSource :: _remainingSources =>
      run.SecondFamilySupport

/-- Eliminate the source-list case split after either singleton or mutual
family traversal has constructed the exact checked-parameter basis. -/
theorem
    ExactProducedBlockGenerationRun.FamilyTraversalSupport.rawParameterAuditBasis_nonempty
    {source : VInductDecl}
    {kernelSources : List Lean.InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {generation : BlockGenerationChecked source}
    {run : ExactProducedBlockGenerationRun env blockEnv Us
      produced.eliminationBase.base generation}
    (support : run.FamilyTraversalSupport)
    (context_lctx_eq : context.lctx = {}) :
    Nonempty (ConstructorRawPreFamilyParameterAuditBasis env Us
      produced.execution.eliminationExecution.normalization.stats
      produced.execution.eliminationExecution.normalization.validationContext
      source.nparams generation.block.checked.params) := by
  cases kernelSources with
  | nil => exact support.elim
  | cons firstSource laterSources =>
      cases laterSources with
      | nil =>
          exact
            ExactProducedBlockGenerationRun.SingletonFamilySupport.rawParameterAuditBasis_nonempty
              support context_lctx_eq
      | cons secondSource remainingSources =>
          exact
            ExactProducedBlockGenerationRun.SecondFamilySupport.rawParameterAuditBasis_nonempty
              support context_lctx_eq

/-- The retained producer and exact semantic generation select the total
family-traversal package directly.  Producer nonemptiness rules out the only
unsupported source shape. -/
theorem ExactProducedBlockGenerationRun.familyTraversalSupport_nonempty
    {source : VInductDecl}
    {kernelSources : List Lean.InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {generation : BlockGenerationChecked source}
    (run : ExactProducedBlockGenerationRun env blockEnv Us
      produced.eliminationBase.base generation)
    (context_lctx_eq : context.lctx = {}) :
    Nonempty run.FamilyTraversalSupport := by
  cases kernelSources with
  | nil =>
      have nonempty := produced.kernelSources_nonempty
      simp at nonempty
  | cons firstSource laterSources =>
      cases laterSources with
      | nil =>
          obtain ⟨owner⟩ :=
            produced.semanticFirstFamilyAnnotationSpine
              run.producedSemantic.semantic
          exact ⟨{ owner := owner }⟩
      | cons secondSource remainingSources =>
          obtain ⟨staging⟩ :=
            produced.semanticSecondFamilyIndexStaging
              run.producedSemantic.semantic context_lctx_eq
          exact ⟨{ staging := staging }⟩

/-- Compatibility presentation retaining the former strict second-family
index requirement. -/
def ExactProducedBlockGenerationRun.HasSecondFamilyIndexSupport
    {source : VInductDecl}
    {kernelSources : List Lean.InductiveType}
