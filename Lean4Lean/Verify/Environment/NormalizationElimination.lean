/-- Reindex the resolved endpoint matrix to the selected semantic source,
result universe, shared parameters, and family-index inventory while keeping
its endpoint/type alignment dependent on that exact transported matrix. -/
theorem
    ProducedBlockRecursorShapeCandidate.CanonicalResolvedConstructorEndpointRuns.selectedEndpointReplayInput
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {context_lctx_eq : context.lctx = {}}
    {support : produced.CanonicalFamilyAssemblySupport semantic
      context_lctx_eq}
    (endpoints : produced.CanonicalResolvedConstructorEndpointRuns semantic
      context_lctx_eq support) :
    ∃ runs : ResolvedBlockConstructorEndpointRunList
        endpoints.selectedSemantic.canonicalNormalization.view env blockEnv Us
        (produced.canonicalResultLevel endpoints.selectedSemantic
          context_lctx_eq)
        (canonicalFamilyIndexLists source.nparams
          (blockParams source.nparams endpoints.selectedFamilies.views)
          endpoints.selectedFamilies.views)
        (blockParams source.nparams endpoints.selectedFamilies.views)
        endpoints.parameterΔ 0 endpoints.parameterSuffixes.values
        ((produced.execution.eliminationExecution.normalization
          |>.constructorValidation.traces.fieldSorts? Us).get
            endpoints.fieldSorts_isSome),
      List.Forall₂ (fun family endpointList =>
        List.Forall₂ (fun constructor endpoint =>
          constructor.type = VExpr.forallN
            (blockParams source.nparams endpoints.selectedFamilies.views)
            endpoint)
          family.ctors endpointList)
        (canonicalizeFamilyParamsList source.nparams
          (blockParams source.nparams endpoints.selectedFamilies.views)
          endpoints.selectedFamilies.views)
        runs.endpoints := by
  have sourceUvarsEq : semantic.canonicalNormalization.view.uvars =
      endpoints.selectedSemantic.canonicalNormalization.view.uvars := by
    rfl
  have sourceNparamsEq : semantic.canonicalNormalization.view.nparams =
      endpoints.selectedSemantic.canonicalNormalization.view.nparams := by
    rfl
  let sourceRuns := endpoints.runs.ofSourceShapeEq
    (target := endpoints.selectedSemantic.canonicalNormalization.view)
    sourceUvarsEq sourceNparamsEq
      endpoints.selectedCanonicalFamilyHeaders_eq
      endpoints.selectedCanonicalFamilyNames_eq
  have sourceEndpointsEq : sourceRuns.endpoints = endpoints.runs.endpoints := by
    exact endpoints.runs.endpoints_ofSourceShapeEq sourceUvarsEq
      sourceNparamsEq endpoints.selectedCanonicalFamilyHeaders_eq
        endpoints.selectedCanonicalFamilyNames_eq
  have sourceAlignment : List.Forall₂ (fun family endpointList =>
      List.Forall₂ (fun constructor endpoint =>
        constructor.type = VExpr.forallN
          (blockParams source.nparams semantic.families.views) endpoint)
        family.ctors endpointList)
      (canonicalizeFamilyParamsList
        semantic.canonicalNormalization.view.nparams
        (blockParams source.nparams semantic.families.views)
        endpoints.selectedFamilies.views)
      sourceRuns.endpoints := by
    rw [sourceEndpointsEq]
    exact endpoints.endpointTypes
  have coherent :
      ∃ runs : ResolvedBlockConstructorEndpointRunList
          endpoints.selectedSemantic.canonicalNormalization.view env blockEnv Us
          (produced.canonicalResultLevel semantic context_lctx_eq)
          (canonicalFamilyIndexLists source.nparams
            (blockParams source.nparams semantic.families.views)
            semantic.families.views)
          (blockParams source.nparams semantic.families.views)
          endpoints.parameterΔ 0 endpoints.parameterSuffixes.values
          ((produced.execution.eliminationExecution.normalization
            |>.constructorValidation.traces.fieldSorts? Us).get
              endpoints.fieldSorts_isSome),
        List.Forall₂ (fun family endpointList =>
          List.Forall₂ (fun constructor endpoint =>
            constructor.type = VExpr.forallN
              (blockParams source.nparams semantic.families.views) endpoint)
            family.ctors endpointList)
          (canonicalizeFamilyParamsList
            semantic.canonicalNormalization.view.nparams
            (blockParams source.nparams semantic.families.views)
            endpoints.selectedFamilies.views)
          runs.endpoints :=
    ⟨sourceRuns, sourceAlignment⟩
  have paramsEq :
      blockParams source.nparams semantic.families.views =
        blockParams source.nparams endpoints.selectedFamilies.views :=
    blockParams_eq_of_family_type_alignment endpoints.familyAlignment
  rw [paramsEq] at coherent
  have familyIndicesEq :
      canonicalFamilyIndexLists source.nparams
          (blockParams source.nparams endpoints.selectedFamilies.views)
          semantic.families.views =
        canonicalFamilyIndexLists source.nparams
          (blockParams source.nparams endpoints.selectedFamilies.views)
          endpoints.selectedFamilies.views :=
    canonicalFamilyIndexLists_eq_of_family_type_alignment
      endpoints.familyAlignment
  rw [familyIndicesEq] at coherent
  have resultLevelEq :
      produced.canonicalResultLevel semantic context_lctx_eq =
        produced.canonicalResultLevel endpoints.selectedSemantic
          context_lctx_eq :=
    Option.some.inj
      ((produced.canonicalResultLevel_eq semantic context_lctx_eq).symm.trans
        (produced.canonicalResultLevel_eq endpoints.selectedSemantic
          context_lctx_eq))
  rw [resultLevelEq] at coherent
  simpa only [NormalizationCandidateBlockSemanticRun.canonicalNormalization,
    Normalization.canonicalizeSharedParams,
    VInductDecl.canonicalizeSharedParams,
    NormalizationCandidateBlockSemanticRun.normalization,
    NormalizationCandidateBlockSemanticRun.viewDecl,
    CanonicalResolvedConstructorEndpointRuns.selectedSemantic] using coherent

