      source)
    (safetyEq :
      produced.execution.eliminationExecution.normalization.validationContext.safety =
        context.safety)
    (audit : ProducedBlockRecursorStage3AuditRun produced Us) :
    List.All (fun indices => env.OnTel source.uvars []
        (blockParams source.nparams semantic.families.views ++ indices))
      (support.canonicalCheckedFamilies stagingInput safetyEq audit).indices := by
  have henv : env.WF := by
    simpa only [support.basis.contextRun.venv_eq] using
      support.basis.contextRun.candidate.context.Ewf
  have familyTypes :=
    semantic.families.canonicalFamilyTypesIsType support.familyTypes
  have familyTypes' : List.All (fun family =>
      env.IsType semantic.canonicalNormalization.view.uvars [] family.type)
      semantic.canonicalNormalization.view.types := by
    simpa only [NormalizationCandidateBlockSemanticRun.canonicalNormalization,
      Normalization.canonicalizeSharedParams,
      VInductDecl.canonicalizeSharedParams,
      NormalizationCandidateBlockSemanticRun.normalization,
      NormalizationCandidateBlockSemanticRun.viewDecl,
      semantic.uvars_eq] using familyTypes
  have result :=
    (support.canonicalCheckedFamilies stagingInput safetyEq audit)
      |>.familyOnTel_all henv.ordered familyTypes'
  simpa only [NormalizationCandidateBlockSemanticRun.canonicalNormalization,
    Normalization.canonicalizeSharedParams,
    VInductDecl.canonicalizeSharedParams,
    NormalizationCandidateBlockSemanticRun.normalization,
    NormalizationCandidateBlockSemanticRun.viewDecl] using result

/-- The analyzer-owned family spine records the support-selected common
result universe at every source position. -/
theorem
    ProducedBlockRecursorShapeCandidate.CanonicalFamilyAssemblySupport.canonicalCheckedFamilyResultLevels
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {context_lctx_eq : context.lctx = {}}
    (support : produced.CanonicalFamilyAssemblySupport semantic
      context_lctx_eq)
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (safetyEq :
      produced.execution.eliminationExecution.normalization.validationContext.safety =
        context.safety)
    (audit : ProducedBlockRecursorStage3AuditRun produced Us) :
    List.All (fun resultLevel => resultLevel ≈
        produced.canonicalResultLevel semantic context_lctx_eq)
      (support.canonicalCheckedFamilies stagingInput safetyEq audit).resultLevels := by
  rw [CheckedFamilies.resultLevels_eq_map_sortLevel]
  let rec mapResultLevels (families : List VInductiveType)
      (all : List.All (fun family => sortLevel source.nparams family ≈
        produced.canonicalResultLevel semantic context_lctx_eq) families) :
      List.All (fun resultLevel => resultLevel ≈
        produced.canonicalResultLevel semantic context_lctx_eq)
        (families.map (sortLevel source.nparams)) := by
    cases families with
    | nil => trivial
    | cons _ families =>
        exact ⟨all.1, mapResultLevels families all.2⟩
  simpa only [
    NormalizationCandidateBlockSemanticRun.canonicalNormalization,
    Normalization.canonicalizeSharedParams,
    VInductDecl.canonicalizeSharedParams,
    NormalizationCandidateBlockSemanticRun.normalization,
    NormalizationCandidateBlockSemanticRun.viewDecl] using
      mapResultLevels _ support.resultLevels

/-- Build the common pre-family suffix-translation state from a shape-neutral
parameter basis.  The construction is independent of the number of source
families. -/
theorem
    ProducedBlockRecursorShapeCandidate.CanonicalFamilyAssemblySupport.canonicalPreFamilyTranslationState
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {context_lctx_eq : context.lctx = {}}
    (support : produced.CanonicalFamilyAssemblySupport semantic
      context_lctx_eq)
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (safetyEq :
      produced.execution.eliminationExecution.normalization.validationContext.safety =
        context.safety)
    (audit : ProducedBlockRecursorStage3AuditRun produced Us) :
    Nonempty (CandidateBlockMutualPreFamilyTranslationState env blockEnv Us
      produced.execution.eliminationExecution.normalization.stats
      source.nparams support.firstView
      (blockParams source.nparams semantic.families.views)
      semantic.canonicalNormalization.view support.basis.parameterDelta
      { produced.execution.eliminationExecution.normalization.validationContext
        with env :=
          produced.execution.eliminationExecution.normalization.familyEnv }
      semantic.families
      (support.canonicalCheckedFamilies stagingInput safetyEq audit)
      support.parameterDefEqs) := by
  let normalization :=
    produced.execution.eliminationExecution.normalization
  have henv : env.WF := by
    simpa only [support.basis.contextRun.venv_eq] using
      support.basis.contextRun.candidate.context.Ewf
  have referenceWF : VLCtx.WF env Us.length
      support.basis.alignment.reference :=
    (support.basis.alignment.current_reference.symm henv.ordered).wf
  have parameterWF : VLCtx.WF env Us.length
      support.basis.parameterDelta :=
    support.basis.alignment.root_reference_lift.wf henv referenceWF
  have storedFirst : TypeChecker.TelDefEqEvidence env Us.length []
      support.basis.storedTypes
      (VExpr.telN source.nparams support.firstView) := by
    rw [← support.params_eq]
    exact support.basis.storedCanonical
  obtain ⟨viewParameterDelta, viewParameterContext, viewRelation,
      viewUnique, viewParameterWF⟩ :=
    support.basis.params.retypeExact henv storedFirst parameterWF
  have canonicalParameterContext := viewParameterContext
  rw [← support.basis.parameterSources_eq] at canonicalParameterContext
  obtain ⟨preFamilyTrace⟩ :=
    AddInductive.ConstructorMutualBlockPreFamilySafetyTrace.nonempty_of_check
      audit.preFamilyRun
  obtain ⟨preFamilyRuns⟩ :=
    AddInductive.ConstructorMutualBlockPreFamilySemanticRuns.nonempty
      support.basis.contextRun semantic.families preFamilyTrace.families
  let preFamily : AddInductive.ConstructorMutualBlockPreFamilySemanticState
      env blockEnv Us normalization.stats semantic.families := {
    context := normalization.validationContext
    contextRun := support.basis.contextRun
    trace := preFamilyTrace
    runs := preFamilyRuns }
  let checked := support.canonicalCheckedFamilies stagingInput safetyEq audit
  obtain ⟨translations⟩ :=
    CandidateBlockFamilySuffixTranslationList.nonempty semantic.families
      preFamily.trace.suffixes checked support.parameterDefEqs
      canonicalParameterContext henv viewParameterWF
      (produced.semanticViewParams_length semantic context_lctx_eq)
  exact ⟨{
    preFamily := preFamily
    parameterΔ := viewParameterDelta
    params_eq := support.params_eq
    parameterContext := canonicalParameterContext
    parameterRelation := viewRelation
    parameterUnique := viewUnique
    parameterWF := viewParameterWF
    preFamily_ngen_eq := rfl
    preFamilyAlignment := support.basis.alignment
    translations := translations }⟩

/-- Assemble constructor semantics and the exact field-sort telescope matrix
from the shape-neutral family support. -/
theorem
    ProducedBlockRecursorShapeCandidate.CanonicalFamilyAssemblySupport.canonicalCheckedBlockConstructorRuns
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {context_lctx_eq : context.lctx = {}}
    (support : produced.CanonicalFamilyAssemblySupport semantic
      context_lctx_eq)
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (safetyEq :
      produced.execution.eliminationExecution.normalization.validationContext.safety =
        context.safety)
    (audit : ProducedBlockRecursorStage3AuditRun produced Us) :
    let validation :=
      produced.execution.eliminationExecution.normalization
        |>.constructorValidation.traces
    let fieldSorts? := validation.fieldSorts? Us
    Nonempty (CheckedBlockConstructorRunList env
        (produced.canonicalResultLevel semantic context_lctx_eq)
        (support.canonicalCheckedFamilies stagingInput safetyEq audit).indices
        (support.canonicalCheckedFamilies stagingInput safetyEq audit)) ∧
      fieldSorts?.isSome ∧
      ∀ success : fieldSorts?.isSome,
        CheckedBlockFieldSortTelescopes blockEnv Us.length
          (blockParams source.nparams semantic.families.views)
          (support.canonicalCheckedFamilies stagingInput safetyEq audit)
          (fieldSorts?.get success) := by
  let normalization :=
    produced.execution.eliminationExecution.normalization
  let params := blockParams source.nparams semantic.families.views
  obtain ⟨inventory⟩ :=
    ConstructorRawPreFamilyParameterAuditBasis.constructorValidationSemanticState
      (produced := produced) (semantic := semantic) support.basis stagingInput
        safetyEq audit.alignmentRun
  obtain ⟨translationState⟩ :=
    support.canonicalPreFamilyTranslationState stagingInput safetyEq audit
  obtain ⟨stage⟩ :=
    AddInductive.ConstructorBlockStage3SafetyTraces.nonempty_of_check
      audit.stage3Run
  have henv : env.WF := by
    simpa only [support.basis.contextRun.venv_eq] using
      support.basis.contextRun.candidate.context.Ewf
  have hblockEnv : blockEnv.WF := by
    simpa only [inventory.semantic.contextRun.venv_eq] using
      inventory.semantic.contextRun.candidate.context.Ewf
  have addType : env ≤ blockEnv :=
    VEnv.stageInductiveTypes_le stagingInput.stage
  have storedConstructors := inventory.storedParameterDefEqLists
    support.basis.params
  have canonicalStored :=
    (support.basis.storedCanonical.symm henv trivial).mono addType
  have constructorParameters :=
    storedConstructors.precompose canonicalStored hblockEnv
  have canonicalStage :=
    (support.basis.canonicalConstructorAudit context_lctx_eq stagingInput
      safetyEq audit.alignmentRun audit.stage3Run support.indexCounts).1
  have paramsLength : params.length = source.nparams :=
    produced.semanticViewParams_length semantic context_lctx_eq
  have shapes := semantic.generationShapes produced.shape
  have headersEq := semantic.families.familyHeaders_canonicalize shapes
    normalization.familyParameterSpines normalization.familyTerminalSorts
    paramsLength
  have normalizationProduced :=
    produced.execution.normalization_run produced.producedExecution
  have familyRun := normalization.familyValidationResult_run
    normalizationProduced
  have constants := semantic.families.rawFamilyConstantInventory
    produced.kernelSources_nonempty familyRun
  have indConstsSize : normalization.stats.indConsts.size =
      kernelSources.length := by
    have sizes := normalization.familyValidationResult.sizes_of_run
      produced.kernelSources_nonempty familyRun
    simpa only [normalization,
      AddInductive.NormalizationCandidateExecution.familyValidationResult]
      using sizes.2.2
  have viewLength : semantic.families.views.length =
      kernelSources.length := by
    have namesLength := congrArg List.length
      semantic.families.viewHeaderNames.1
    simpa using namesLength
  have canonicalLength :
      (canonicalizeFamilyParamsList source.nparams params
        semantic.families.views).length = normalization.stats.indConsts.size := by
    calc
      _ = semantic.families.views.length := by
        simp only [canonicalizeFamilyParamsList, List.length_map]
      _ = kernelSources.length := viewLength
      _ = normalization.stats.indConsts.size := indConstsSize.symm
  have rawFamilyData := support.indexCounts.familyData canonicalLength
    headersEq constants
  have canonicalHeadersEq :
      familyHeaders semantic.canonicalNormalization.view.nparams
          semantic.canonicalNormalization.view.types =
        familyHeaders source.nparams source.types := by
    simpa only [NormalizationCandidateBlockSemanticRun.canonicalNormalization,
      Normalization.canonicalizeSharedParams,
      VInductDecl.canonicalizeSharedParams,
      NormalizationCandidateBlockSemanticRun.normalization,
      NormalizationCandidateBlockSemanticRun.viewDecl, params] using
      headersEq.symm
  have familyData : ∀ familyIdx,
      familyIdx < normalization.stats.indConsts.size →
      ∃ header,
        (familyHeaders semantic.canonicalNormalization.view.nparams
          semantic.canonicalNormalization.view.types)[familyIdx]? =
            some header ∧
        normalization.stats.indConsts[familyIdx]! =
          .const header.name normalization.stats.levels := by
    intro familyIdx familyIdxLt
    obtain ⟨header, headerAt, _indices, constant⟩ :=
      rawFamilyData familyIdx familyIdxLt
    exact ⟨header, by rw [canonicalHeadersEq]; exact headerAt, constant⟩
  have targets : ConstructorValidation.MutualFamilyTargetState env blockEnv
      Us normalization.stats
      (familyHeaders semantic.canonicalNormalization.view.nparams
        semantic.canonicalNormalization.view.types)
      translationState.preFamily.trace.suffixes.values
      (support.canonicalCheckedFamilies stagingInput safetyEq audit).indices
      translationState.parameterΔ translationState.parameterΔ 0 :=
    translationState.targetState addType rfl support.indexCounts
      canonicalLength familyData
  have sourceUvars : semantic.canonicalNormalization.view.uvars =
      Us.length := by
    simpa only [NormalizationCandidateBlockSemanticRun.canonicalNormalization,
      Normalization.canonicalizeSharedParams,
      VInductDecl.canonicalizeSharedParams,
      NormalizationCandidateBlockSemanticRun.normalization,
      NormalizationCandidateBlockSemanticRun.viewDecl] using semantic.uvars_eq
  have sourceNparams : semantic.canonicalNormalization.view.nparams =
      normalization.stats.params.size := by
    simpa only [NormalizationCandidateBlockSemanticRun.canonicalNormalization,
      Normalization.canonicalizeSharedParams,
      VInductDecl.canonicalizeSharedParams,
      NormalizationCandidateBlockSemanticRun.normalization,
      NormalizationCandidateBlockSemanticRun.viewDecl] using
      inventory.params_size.symm
  have resultLevelTr :=
    produced.canonicalResultLevel_eq semantic context_lctx_eq
  have familyFresh : ∀ name,
      name ∈ familyNames semantic.canonicalNormalization.view.types →
      env.constants name = none :=
    semantic.canonicalFamilyNames_fresh
  let checkedBlock := support.canonicalCheckedBlock stagingInput safetyEq audit
  have generatedNodup :
      (blockGeneratedNames
        semantic.canonicalNormalization.view.types).Nodup := by
    rw [← checkedBlock.names_eq]
    exact checkedBlock.names_nodup
  rw [blockGeneratedNames, List.nodup_append] at generatedNodup
  rw [List.nodup_append] at generatedNodup
  have familyNodup :
      (familyNames semantic.canonicalNormalization.view.types).Nodup := by
    simpa only [familyNames] using generatedNodup.1.1
  have universeSemantics :
      normalization.constructorValidation.traces.universeSemantics = true :=
    normalization.constructorValidation.traces.universeSemantics_of_run
      audit.universeRun
  have runs :=
    CandidateBlockMutualPreFamilyTranslationState.checkedBlockConstructorRuns
      (source := semantic.canonicalNormalization.view) translationState
      inventory stage constructorParameters canonicalStage henv hblockEnv
      addType targets sourceUvars sourceNparams resultLevelTr familyFresh
      familyNodup universeSemantics
  have computed :=
    CandidateBlockConstructorPostFamilySemanticRuns.fieldSorts?_eq
      inventory.semantic.constructors
  have fieldSortsSome :
      normalization.constructorValidation.traces.fieldSorts? Us |>.isSome := by
    rw [computed]
    rfl
  refine ⟨runs.1, fieldSortsSome, ?_⟩
  intro success
  have fieldSortsEq :
      (normalization.constructorValidation.traces.fieldSorts? Us).get success =
        inventory.semantic.constructors.fieldSorts := by
    exact Option.some.inj ((Option.some_get success).trans computed)
  exact fieldSortsEq.symm ▸ runs.2

/-- Construction-owned endpoint matrix selected by one resolved audit.  It
is intentionally earlier than `CanonicalConstructorReplayEvidence`: no
analyzer-owned constructor syntax or projection-safety premise appears in
this package. -/
structure
    ProducedBlockRecursorShapeCandidate.CanonicalResolvedConstructorEndpointRuns
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    {env blockEnv : VEnv} {Us : List Name}
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source)
    (context_lctx_eq : context.lctx = {})
    (support : produced.CanonicalFamilyAssemblySupport semantic
      context_lctx_eq) where
  parameterΔ : VLCtx
  parameterSuffixes :
    AddInductive.ConstructorBlockCandidateParameterSuffixes
      produced.execution.eliminationExecution.normalization.stats
      produced.candidate.families
  selectedFamilies : CandidateBlockFamilySemanticListRun env blockEnv Us
    produced.candidate.families source.types
  familyAlignment : List.Forall₂ (fun original selectedFamily =>
    original.name = selectedFamily.name ∧ original.type = selectedFamily.type)
    semantic.families.views selectedFamilies.views
  familyParameters : CandidateBlockFamilyViewParameterDefEqList env blockEnv
    Us semantic.canonicalNormalization.view.nparams support.firstView
    selectedFamilies
  constructorParameters : CandidateBlockConstructorViewParameterDefEqLists
    env blockEnv Us semantic.canonicalNormalization.view.nparams
    (blockParams source.nparams semantic.families.views) selectedFamilies
  fieldCounts : CandidateBlockConstructorCanonicalFieldCountLists
    semantic.canonicalNormalization.view.nparams selectedFamilies
  fieldSorts_isSome :
    (produced.execution.eliminationExecution.normalization
      |>.constructorValidation.traces.fieldSorts? Us).isSome
  runs : ResolvedBlockConstructorEndpointRunList
    semantic.canonicalNormalization.view env blockEnv Us
    (produced.canonicalResultLevel semantic context_lctx_eq)
    (canonicalFamilyIndexLists source.nparams
      (blockParams source.nparams semantic.families.views)
      semantic.families.views)
    (blockParams source.nparams semantic.families.views) parameterΔ 0
    parameterSuffixes.values
    ((produced.execution.eliminationExecution.normalization
      |>.constructorValidation.traces.fieldSorts? Us).get
        fieldSorts_isSome)
  endpointTypes : List.Forall₂ (fun family endpoints =>
    List.Forall₂ (fun constructor endpoint =>
      constructor.type = VExpr.forallN
        (blockParams source.nparams semantic.families.views) endpoint)
      family.ctors endpoints)
    (canonicalizeFamilyParamsList
      semantic.canonicalNormalization.view.nparams
      (blockParams source.nparams semantic.families.views)
      selectedFamilies.views)
    runs.endpoints

/-- The semantic hierarchy whose constructor views are the exact endpoints
selected by the resolved construction trace. -/
def
    ProducedBlockRecursorShapeCandidate.CanonicalResolvedConstructorEndpointRuns.selectedSemantic
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {context_lctx_eq : context.lctx = {}}
    {support : produced.CanonicalFamilyAssemblySupport semantic
      context_lctx_eq}
    (endpoints : produced.CanonicalResolvedConstructorEndpointRuns semantic
      context_lctx_eq support) :
    NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source where
  uvars_eq := semantic.uvars_eq
  stage := semantic.stage
  families := endpoints.selectedFamilies

private theorem blockParams_eq_of_family_type_alignment
    {nparams : Nat} {original selected : List VInductiveType}
    (alignment : List.Forall₂ (fun original selectedFamily =>
      original.name = selectedFamily.name ∧
        original.type = selectedFamily.type) original selected) :
    blockParams nparams original = blockParams nparams selected := by
  cases alignment with
  | nil => rfl
  | cons head tail =>
      exact congrArg (VExpr.telN nparams) head.2

private theorem familyNames_eq_of_family_type_alignment
    {original selected : List VInductiveType}
    (alignment : List.Forall₂ (fun original selectedFamily =>
      original.name = selectedFamily.name ∧
        original.type = selectedFamily.type) original selected) :
    familyNames original = familyNames selected := by
  induction alignment with
  | nil => rfl
  | cons head tail ih =>
      simp only [familyNames, List.map_cons, List.cons.injEq]
      exact ⟨head.1, ih⟩

private theorem familyHeaders_eq_of_family_type_alignment
    {nparams : Nat} {original selected : List VInductiveType}
    (alignment : List.Forall₂ (fun original selectedFamily =>
      original.name = selectedFamily.name ∧
        original.type = selectedFamily.type) original selected) :
    familyHeaders nparams original = familyHeaders nparams selected := by
  induction alignment with
  | nil => rfl
  | cons head tail ih =>
      simp only [familyHeaders, List.map_cons, List.cons.injEq]
      exact ⟨by simp only [head.1, head.2], ih⟩

private theorem canonicalFamilyHeaders_eq_of_family_type_alignment
    {nparams : Nat} {params : List VExpr}
    {original selected : List VInductiveType}
    (alignment : List.Forall₂ (fun original selectedFamily =>
      original.name = selectedFamily.name ∧
        original.type = selectedFamily.type) original selected) :
    familyHeaders nparams
        (canonicalizeFamilyParamsList nparams params original) =
      familyHeaders nparams
        (canonicalizeFamilyParamsList nparams params selected) := by
  induction alignment with
  | nil => rfl
  | cons head tail ih =>
      simp only [canonicalizeFamilyParamsList, List.map_cons,
        familyHeaders, List.cons.injEq, canonicalizeFamilyParams]
      exact ⟨by simp only [head.1, head.2], ih⟩

private theorem canonicalFamilyIndexLists_eq_of_family_type_alignment
    {nparams : Nat} {params : List VExpr}
    {original selected : List VInductiveType}
    (alignment : List.Forall₂ (fun original selectedFamily =>
      original.name = selectedFamily.name ∧
        original.type = selectedFamily.type) original selected) :
    canonicalFamilyIndexLists nparams params original =
      canonicalFamilyIndexLists nparams params selected := by
  induction alignment with
  | nil => rfl
  | cons head tail ih =>
      simp only [canonicalFamilyIndexLists, canonicalizeFamilyParamsList,
        List.map_cons, canonicalizeFamilyParams, List.cons.injEq]
      exact ⟨by simp only [head.2], by
        simpa only [canonicalFamilyIndexLists,
          canonicalizeFamilyParamsList] using ih⟩

private theorem canonicalFamilyTypes_of_family_type_alignment
    {env : VEnv} {Us : List Name} {nparams : Nat} {params : List VExpr}
    {original selected : List VInductiveType}
    (alignment : List.Forall₂ (fun original selectedFamily =>
      original.name = selectedFamily.name ∧
        original.type = selectedFamily.type) original selected)
    (types : List.All (fun family => ∃ resultLevel,
      TypeChecker.DefEqEvidence env Us.length [] family.type
        (canonicalizeFamilyParams nparams params family).type
        (.sort resultLevel)) original) :
    List.All (fun family => ∃ resultLevel,
      TypeChecker.DefEqEvidence env Us.length [] family.type
        (canonicalizeFamilyParams nparams params family).type
        (.sort resultLevel)) selected := by
  induction alignment with
  | nil => trivial
  | cons head tail ih =>
      refine ⟨?_, ih types.2⟩
      obtain ⟨resultLevel, headType⟩ := types.1
      exact ⟨resultLevel, by
        simpa only [head.2, canonicalizeFamilyParams] using headType⟩

private theorem canonicalResultLevels_of_family_type_alignment
    {nparams : Nat} {params : List VExpr}
    {original selected : List VInductiveType} {originalLevel selectedLevel : VLevel}
    (alignment : List.Forall₂ (fun original selectedFamily =>
      original.name = selectedFamily.name ∧
        original.type = selectedFamily.type) original selected)
    (levelEq : originalLevel = selectedLevel)
    (levels : List.All (fun family =>
      sortLevel nparams family ≈ originalLevel)
      (canonicalizeFamilyParamsList nparams params original)) :
    List.All (fun family => sortLevel nparams family ≈ selectedLevel)
      (canonicalizeFamilyParamsList nparams params selected) := by
  induction alignment with
  | nil => trivial
  | cons head tail ih =>
      simp only [canonicalizeFamilyParamsList, List.map_cons] at levels ⊢
      exact ⟨by
        simpa only [sortLevel, canonicalizeFamilyParams, head.2, levelEq]
          using levels.1,
        ih levels.2⟩

/-- Family-side assembly support transported to the construction-selected
semantic hierarchy.  Only family headers move across this boundary;
constructor syntax is deliberately owned by the selected endpoints. -/
noncomputable def
    ProducedBlockRecursorShapeCandidate.CanonicalResolvedConstructorEndpointRuns.selectedFamilyAssemblySupport
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {context_lctx_eq : context.lctx = {}}
    {support : produced.CanonicalFamilyAssemblySupport semantic
      context_lctx_eq}
    (endpoints : produced.CanonicalResolvedConstructorEndpointRuns semantic
      context_lctx_eq support) :
    produced.CanonicalFamilyAssemblySupport endpoints.selectedSemantic
      context_lctx_eq := by
  have paramsEq :
      blockParams source.nparams semantic.families.views =
        blockParams source.nparams endpoints.selectedFamilies.views :=
    blockParams_eq_of_family_type_alignment endpoints.familyAlignment
  have resultLevelEq :
      produced.canonicalResultLevel semantic context_lctx_eq =
        produced.canonicalResultLevel endpoints.selectedSemantic
          context_lctx_eq :=
    Option.some.inj
      ((produced.canonicalResultLevel_eq semantic context_lctx_eq).symm.trans
        (produced.canonicalResultLevel_eq endpoints.selectedSemantic
          context_lctx_eq))
  let normalization :=
    produced.execution.eliminationExecution.normalization
  have familyTypesProduced := normalization.familyTypes.produced
  rw [← normalization.families.produced.familyTypes_eq]
    at familyTypesProduced
  have terminals := normalization.familyTerminals
  rw [← normalization.families.produced.familyTypes_eq] at terminals
  let validationAnnotations :=
    CandidateFamilyValidationAnnotationList.ofProduced
      normalization.families.candidates familyTypesProduced terminals
  let generationShapes :=
    endpoints.selectedSemantic.generationShapes produced.shape
  let annotations := Classical.choice
    (CandidateBlockFamilyAnnotationSpineList.exists
      endpoints.selectedSemantic.families generationShapes
        validationAnnotations)
  exact {
    generationShapes := generationShapes
    annotations := annotations
    firstView := support.firstView
    params_eq := paramsEq.symm.trans support.params_eq
    parameterDefEqs := by
      simpa only [CanonicalResolvedConstructorEndpointRuns.selectedSemantic,
        NormalizationCandidateBlockSemanticRun.canonicalNormalization,
        Normalization.canonicalizeSharedParams,
        VInductDecl.canonicalizeSharedParams,
        NormalizationCandidateBlockSemanticRun.normalization,
        NormalizationCandidateBlockSemanticRun.viewDecl] using
        endpoints.familyParameters
    validation_safety := support.validation_safety
    basis := by
      simpa only [paramsEq,
        CanonicalResolvedConstructorEndpointRuns.selectedSemantic] using
        support.basis
    familyTypes := by
      have selectedTypes := canonicalFamilyTypes_of_family_type_alignment
        endpoints.familyAlignment support.familyTypes
      simpa only [paramsEq,
        CanonicalResolvedConstructorEndpointRuns.selectedSemantic] using
        selectedTypes
    indexCounts := by
      have selectedCounts := support.indexCounts.of_familyHeaders_eq
        (canonicalFamilyHeaders_eq_of_family_type_alignment
          (params := blockParams source.nparams semantic.families.views)
          endpoints.familyAlignment).symm
      simpa only [paramsEq,
        CanonicalResolvedConstructorEndpointRuns.selectedSemantic] using
        selectedCounts
    resultLevels := by
      have selectedLevels :=
        canonicalResultLevels_of_family_type_alignment
          endpoints.familyAlignment resultLevelEq support.resultLevels
      simpa only [paramsEq,
        CanonicalResolvedConstructorEndpointRuns.selectedSemantic] using
        selectedLevels }

private theorem
    ProducedBlockRecursorShapeCandidate.CanonicalResolvedConstructorEndpointRuns.selectedCanonicalFamilyHeaders_eq
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {context_lctx_eq : context.lctx = {}}
    {support : produced.CanonicalFamilyAssemblySupport semantic
      context_lctx_eq}
    (endpoints : produced.CanonicalResolvedConstructorEndpointRuns semantic
      context_lctx_eq support) :
    familyHeaders semantic.canonicalNormalization.view.nparams
        semantic.canonicalNormalization.view.types =
      familyHeaders endpoints.selectedSemantic.canonicalNormalization.view.nparams
        endpoints.selectedSemantic.canonicalNormalization.view.types := by
  have paramsEq :
      blockParams source.nparams semantic.families.views =
        blockParams source.nparams endpoints.selectedFamilies.views :=
    blockParams_eq_of_family_type_alignment endpoints.familyAlignment
  change familyHeaders source.nparams
      (canonicalizeFamilyParamsList source.nparams
        (blockParams source.nparams semantic.families.views)
        semantic.families.views) =
    familyHeaders source.nparams
      (canonicalizeFamilyParamsList source.nparams
        (blockParams source.nparams endpoints.selectedFamilies.views)
        endpoints.selectedFamilies.views)
  rw [← paramsEq]
  exact canonicalFamilyHeaders_eq_of_family_type_alignment
    endpoints.familyAlignment

