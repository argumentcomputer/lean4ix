        Us source.uvars produced.candidate.families = .ok ()) :
    List.All (fun indices => env.OnTel source.uvars []
        (blockParams source.nparams semantic.families.views ++ indices))
      (completion.canonicalCheckedFamilies context_lctx_eq stagingInput
        alignmentRun stage3Run).indices := by
  have henv : VEnv.WF env := by
    simpa only [staging.annotation.firstSemantic.type.venv_eq] using
      staging.annotation.firstSemantic.type.contextRun.context.Ewf
  have canonical := completion.canonicalFamilyTypeDefEqs context_lctx_eq
  have familyTypes :=
    semantic.families.canonicalFamilyTypesIsType canonical
