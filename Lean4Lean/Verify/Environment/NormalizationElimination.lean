/-- Shape-neutral ownership of the completed shared-parameter audit basis.
The basis is the actual downstream contract: singleton, zero-index, and
indexed mutual producers may all inhabit this package without exposing the
family cursor used to construct it. -/
structure ExactProducedBlockGenerationRun.ParameterAuditBasisSupport
    {source : VInductDecl}
    {kernelSources : List Lean.InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {generation : BlockGenerationChecked source}
    (_run : ExactProducedBlockGenerationRun env blockEnv Us
      produced.eliminationBase.base generation) where
  basis : ConstructorRawPreFamilyParameterAuditBasis env Us
    produced.execution.eliminationExecution.normalization.stats
    produced.execution.eliminationExecution.normalization.validationContext
    source.nparams generation.block.checked.params

/-- The two-or-more-family traversal discharges the shape-neutral
parameter-audit contract for both indexed and zero-index second families. -/
noncomputable def
    ExactProducedBlockGenerationRun.ParameterAuditBasisSupport.ofSecondFamily
    {source : VInductDecl}
    {kernelSources : List Lean.InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {generation : BlockGenerationChecked source}
    {run : ExactProducedBlockGenerationRun env blockEnv Us
      produced.eliminationBase.base generation}
    (support : run.HasSecondFamilySupport)
    (context_lctx_eq : context.lctx = {}) :
    run.ParameterAuditBasisSupport where
  basis := Classical.choice <|
    support.rawParameterAuditBasis_nonempty context_lctx_eq

/-- Any nonempty producer discharges the shape-neutral parameter-audit
contract through its canonical singleton-or-mutual family traversal. -/
noncomputable def
    ExactProducedBlockGenerationRun.ParameterAuditBasisSupport.ofFamilyTraversal
    {source : VInductDecl}
    {kernelSources : List Lean.InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {generation : BlockGenerationChecked source}
    {run : ExactProducedBlockGenerationRun env blockEnv Us
      produced.eliminationBase.base generation}
    (support : run.FamilyTraversalSupport)
    (context_lctx_eq : context.lctx = {}) :
    run.ParameterAuditBasisSupport where
  basis := Classical.choice <|
    support.rawParameterAuditBasis_nonempty context_lctx_eq

/-- Canonical checked-parameter audit ownership for every exact produced
generation. -/
noncomputable def ExactProducedBlockGenerationRun.parameterAuditBasisSupport
    {source : VInductDecl}
    {kernelSources : List Lean.InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {generation : BlockGenerationChecked source}
    (run : ExactProducedBlockGenerationRun env blockEnv Us
      produced.eliminationBase.base generation)
    (context_lctx_eq : context.lctx = {}) :
    run.ParameterAuditBasisSupport :=
  .ofFamilyTraversal
    (Classical.choice (run.familyTraversalSupport_nonempty context_lctx_eq))
    context_lctx_eq

/-- Compatibility constructor for callers that still retain a strict-index
witness. -/
noncomputable def
    ExactProducedBlockGenerationRun.ParameterAuditBasisSupport.ofSecondFamilyIndex
    {source : VInductDecl}
    {kernelSources : List Lean.InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context}
    {env blockEnv : VEnv} {Us : List Name}
    {generation : BlockGenerationChecked source}
    {run : ExactProducedBlockGenerationRun env blockEnv Us
      produced.eliminationBase.base generation}
    (support : run.HasSecondFamilyIndexSupport)
    (context_lctx_eq : context.lctx = {}) :
    run.ParameterAuditBasisSupport where
  basis := Classical.choice <|
    support.rawParameterAuditBasis_nonempty context_lctx_eq

/-- Canonical semantic recursor assembly from the single executable audit
package attached to this producer. -/
noncomputable def
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion.canonicalProducedBlockSemanticRecursorRunOfAudit
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {staging : produced.SecondFamilyIndexStaging semantic}
    {raw : Option staging.annotation.RawFirstIndexDomain}
    (completion : staging.TerminalIndexDomainCompletion raw)
    (context_lctx_eq : context.lctx = {})
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (audit : ProducedBlockRecursorStage3AuditRun produced Us) :
    ProducedBlockSemanticRecursorRun env blockEnv Us produced semantic :=
  completion.canonicalProducedBlockSemanticRecursorRun context_lctx_eq
    stagingInput audit.alignmentRun audit.stage3Run audit.preFamilyRun
      audit.universeRun audit.recUniverseRun

/-- Canonical mutual semantic assembly without an exposed index-domain
choice.  The producer selects the nonempty-index or terminal-at-parameters
completion internally, so this entry point covers every accepted second
family. -/
noncomputable def
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.canonicalProducedBlockSemanticRecursorRunOfAudit
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    (staging : produced.SecondFamilyIndexStaging semantic)
    (context_lctx_eq : context.lctx = {})
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (audit : ProducedBlockRecursorStage3AuditRun produced Us) :
    ProducedBlockSemanticRecursorRun env blockEnv Us produced semantic :=
  let completed := Classical.choice
    (staging.anyTerminalIndexDomainCompletion context_lctx_eq)
  completed.completion.canonicalProducedBlockSemanticRecursorRunOfAudit
    context_lctx_eq stagingInput audit

/-- A retained mutual producer selects both its second-family staging and
that family's terminal completion.  Thus the canonical semantic result
depends only on the exact semantic hierarchy and executable audit, with no
caller-owned family or index cursor. -/
noncomputable def
    ProducedBlockRecursorShapeCandidate.canonicalMutualProducedBlockSemanticRecursorRunOfAudit
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context)
    {env blockEnv : VEnv} {Us : List Name}
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source)
    (context_lctx_eq : context.lctx = {})
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (audit : ProducedBlockRecursorStage3AuditRun produced Us) :
    ProducedBlockSemanticRecursorRun env blockEnv Us produced semantic :=
  let staging := Classical.choice
    (produced.semanticSecondFamilyIndexStaging semantic context_lctx_eq)
  staging.canonicalProducedBlockSemanticRecursorRunOfAudit context_lctx_eq
    stagingInput audit

/-- A retained ordinary recursor execution together with all executable
constructor audits needed by the canonical analyzer and semantic boundaries.
The checks are indexed by the exact candidate and statistics stored in
`produced`; no result from a parallel normalization run can inhabit this
owner. -/
structure ProducedBlockRecursorStage3Candidate
    (source : VInductDecl) (kernelSources : List InductiveType)
    (numNested : Nat) (isUnsafe : Bool)
    (context : AddInductive.Context) (Us : List Name) where
  produced : ProducedBlockRecursorShapeCandidate source kernelSources
    numNested isUnsafe context
  alignmentRun :
    AddInductive.ConstructorBlockCandidateAlignmentTrace.check
      (produced.execution.eliminationExecution.normalization
        |>.constructorValidation.traces)
      produced.candidate.families = .ok ()
  stage3Run :
    AddInductive.ConstructorBlockStage3SafetyTraces.check
      produced.execution.eliminationExecution.normalization.stats
      Us source.uvars produced.candidate.families = .ok ()
  preFamilyRun :
    AddInductive.checkConstructorMutualBlockPreFamilySafety
      produced.execution.eliminationExecution.normalization.stats
      produced.execution.eliminationExecution.normalization.validationContext
      produced.candidate.families = .ok ()
  rawParameterPreFamilyRun :
    AddInductive.ConstructorCandidateRawParameterPreFamilyBlockTrace.check
      produced.execution.eliminationExecution.normalization.stats
      produced.execution.eliminationExecution.normalization.validationContext
      produced.candidate.families = .ok ()
  sourceRawParameterPreFamilyRun :
    AddInductive.ConstructorRawParameterPreFamilyBlockTrace.check
      produced.execution.eliminationExecution.normalization.stats
      produced.execution.eliminationExecution.normalization.validationContext
      kernelSources = .ok ()
  universeRun :
    AddInductive.checkConstructorBlockUniverseSemantics
      produced.execution.eliminationExecution.normalization.stats
      kernelSources
      { produced.execution.eliminationExecution.normalization.validationContext
        with env :=
          produced.execution.eliminationExecution.normalization.familyEnv } =
        .ok ()
  recUniverseRun :
    AddInductive.checkBlockRecursorUniverseSemantics source.uvars
      produced.execution.eliminationExecution = .ok ()

/-- Semantic interpretation of the exact arbitrary-target pre-family audit
retained by the stronger ordinary producer. -/
theorem ProducedBlockRecursorStage3Candidate.mutualPreFamilySemanticState
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context} {Us : List Name}
    (candidate : ProducedBlockRecursorStage3Candidate source kernelSources
      numNested isUnsafe context Us)
    {env blockEnv : VEnv}
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      candidate.produced.candidate source)
    (contextRun : AddInductive.ConstructorContextRun env Us
      candidate.produced.execution.eliminationExecution.normalization.validationContext) :
    Nonempty (AddInductive.ConstructorMutualBlockPreFamilySemanticState env
      blockEnv Us
      candidate.produced.execution.eliminationExecution.normalization.stats
      semantic.families) :=
  semantic.mutualPreFamilySemanticState contextRun candidate.preFamilyRun

/-- Run the ordinary producer and all proof-relevant constructor audits as
one executable boundary. -/
def produceBlockRecursorStage3Candidate
    (source : VInductDecl) (kernelSources : List InductiveType)
    (numNested : Nat) (isUnsafe : Bool)
    (context : AddInductive.Context) (Us : List Name)
    (kernelSources_nonempty : kernelSources.isEmpty = false) :
    Except Exception (ProducedBlockRecursorStage3Candidate source
      kernelSources numNested isUnsafe context Us) :=
  match produceBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context kernelSources_nonempty with
  | .error error => .error error
  | .ok produced =>
      match alignmentRun :
          AddInductive.ConstructorBlockCandidateAlignmentTrace.check
            (produced.execution.eliminationExecution.normalization
              |>.constructorValidation.traces)
            produced.candidate.families with
      | .error error => .error error
      | .ok () =>
          match stage3Run :
              AddInductive.ConstructorBlockStage3SafetyTraces.check
                produced.execution.eliminationExecution.normalization.stats
                Us source.uvars produced.candidate.families with
          | .error error => .error error
          | .ok () =>
              match preFamilyRun :
                  AddInductive.checkConstructorMutualBlockPreFamilySafety
                    produced.execution.eliminationExecution.normalization.stats
                    produced.execution.eliminationExecution.normalization.validationContext
                    produced.candidate.families with
              | .error error => .error error
              | .ok () =>
                  match rawParameterPreFamilyRun :
                      AddInductive.ConstructorCandidateRawParameterPreFamilyBlockTrace.check
                        produced.execution.eliminationExecution.normalization.stats
                        produced.execution.eliminationExecution.normalization.validationContext
                        produced.candidate.families with
                  | .error error => .error error
                  | .ok () =>
                      match sourceRawParameterPreFamilyRun :
                          AddInductive.ConstructorRawParameterPreFamilyBlockTrace.check
                            produced.execution.eliminationExecution.normalization.stats
                            produced.execution.eliminationExecution.normalization.validationContext
                            kernelSources with
                      | .error error => .error error
                      | .ok () =>
                          match universeRun :
                              AddInductive.checkConstructorBlockUniverseSemantics
                                produced.execution.eliminationExecution.normalization.stats
                                kernelSources
                                { produced.execution.eliminationExecution.normalization.validationContext
                                  with env :=
                                    produced.execution.eliminationExecution.normalization.familyEnv } with
                          | .error error => .error error
                          | .ok () =>
                              match recUniverseRun :
                                  AddInductive.checkBlockRecursorUniverseSemantics
                                    source.uvars
                                    produced.execution.eliminationExecution with
                              | .error error => .error error
                              | .ok () => .ok {
                                  produced
                                  alignmentRun
                                  stage3Run
                                  preFamilyRun
                                  rawParameterPreFamilyRun
                                  sourceRawParameterPreFamilyRun
                                  universeRun
                                  recUniverseRun }

/-- Reindex an already-retained ordinary recursor execution onto the exact
Theory source whose generation shape it satisfies.  The only transport is
the source parameter-count equality; the execution and its producer equation
remain the caller's original dependent values. -/
def ProducedBlockRecursorShapeCandidate.ofExecution
    {source : VInductDecl} {nparams : Nat}
    {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (execution : AddInductive.NormalizationRecursorExecution nparams
      kernelSources numNested isUnsafe context)
    (producedExecution :
      AddInductive.NormalizationRecursorExecution.buildExecution nparams
        kernelSources numNested isUnsafe context = .ok execution)
    (kernelSources_nonempty : kernelSources.isEmpty = false)
    (nparams_eq : source.nparams = nparams)
    (shape : normalizationCandidateBlockGenerationShape source
      execution.candidate = true) :
    ProducedBlockRecursorShapeCandidate source kernelSources numNested
      isUnsafe context := by
  cases source with
  | mk uvars sourceNparams types =>
      simp only at nparams_eq ⊢
      subst nparams
      exact { execution, producedExecution, shape, kernelSources_nonempty }

/-- Exact semantic generation plus the post-constructor decisions that drove
the same ordinary kernel execution. -/
structure ExactProducedBlockEliminationRun
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (env blockEnv : VEnv) (Us : List Name)
    (produced : ProducedBlockEliminationShapeCandidate source kernelSources
      numNested isUnsafe context)
    (generation : BlockGenerationChecked source) where
  block : ExactProducedBlockGenerationRun env blockEnv Us produced.base
    generation
  elimination : AddInductive.CheckerBlockEliminationRun generation
    produced.execution
  isUnsafe_eq : isUnsafe = false
  validation_lparams_eq :
    produced.execution.normalization.validationContext.lparams = Us

/-- Forward the exact producer-owned raw family index inventory through the
post-constructor elimination alignment. -/
theorem ExactProducedBlockEliminationRun.rawIndexCounts
    {source : VInductDecl} {kernelSources : List InductiveType}
