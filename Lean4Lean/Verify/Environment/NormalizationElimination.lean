/-- Strict translation preserves the executable syntactic nonzero test used
by both the kernel inductive statistics and Theory elimination analysis. -/
theorem VLevel.ofLevel_isNeverZero_eq
    (translated : VLevel.ofLevel Us level = some value) :
    value.isNeverZero = level.isNeverZero := by
  induction level generalizing value with
  | zero => simp [VLevel.ofLevel] at translated; subst value; rfl
  | succ level ih =>
      simp [VLevel.ofLevel] at translated
      obtain ⟨_, inner, rfl⟩ := translated
      rfl
  | max left right leftIH rightIH =>
      simp [VLevel.ofLevel] at translated
      obtain ⟨_, leftTr, _, rightTr, rfl⟩ := translated
      simp [VLevel.isNeverZero, leftIH leftTr, rightIH rightTr,
        Level.isNeverZero]
  | imax left right leftIH rightIH =>
      simp [VLevel.ofLevel] at translated
      obtain ⟨_, leftTr, _, rightTr, rfl⟩ := translated
      simp [VLevel.isNeverZero, rightIH rightTr, Level.isNeverZero]
  | param name =>
      simp [VLevel.ofLevel] at translated
      obtain ⟨_, rfl⟩ := translated
      rfl
  | mvar mvarId => simp [VLevel.ofLevel] at translated

/-- Translating a source level after prepending a genuinely fresh universe
parameter shifts every former parameter by one.  This is the universe-level
transport used when a large eliminator inserts its motive universe ahead of
the declaration universes. -/
theorem VLevel.ofLevel_cons_fresh
    {ps : List Name} {fresh : Name} (freshAbsent : fresh ∉ ps)
    {source : Level} {target : VLevel}
    (translated : VLevel.ofLevel ps source = some target) :
    VLevel.ofLevel (fresh :: ps) source =
      some (target.inst (VLevel.params' ps.length 1)) := by
  induction source generalizing target with
  | zero =>
      simp [VLevel.ofLevel] at translated ⊢
      cases translated
      rfl
  | succ source ih =>
      simp [VLevel.ofLevel] at translated
      obtain ⟨inner, innerTr, rfl⟩ := translated
      simp [VLevel.ofLevel, VLevel.inst, ih innerTr]
  | max left right leftIH rightIH =>
      simp [VLevel.ofLevel] at translated
      obtain ⟨left', leftTr, right', rightTr, rfl⟩ := translated
      simp [VLevel.ofLevel, VLevel.inst, leftIH leftTr, rightIH rightTr]
  | imax left right leftIH rightIH =>
      simp [VLevel.ofLevel] at translated
      obtain ⟨left', leftTr, right', rightTr, rfl⟩ := translated
      simp [VLevel.ofLevel, VLevel.inst, leftIH leftTr, rightIH rightTr]
  | param name =>
      simp [VLevel.ofLevel] at translated
      obtain ⟨inBounds, rfl⟩ := translated
      have nameMem : name ∈ ps :=
        List.idxOf_lt_length_iff.mp inBounds
      have freshNe : fresh ≠ name := by
        intro equal
        exact freshAbsent (equal ▸ nameMem)
      have freshBeq : (fresh == name) = false := by
        simp [freshNe]
      simp [VLevel.ofLevel, freshNe, inBounds, VLevel.inst,
        VLevel.params', List.getD_eq_getElem?_getD]
      rw [List.idxOf_cons, freshBeq]
      simp only [cond_false]
      exact ⟨by omega, trivial⟩
  | mvar mvarId => simp [VLevel.ofLevel] at translated

/-- Read one aligned pair from a `Forall₂` witness.  This small positional
form is useful when an executable `mapM` audit fixes the exact output list. -/
private theorem forall₂_getElem
    {R : α → β → Prop} {xs : List α} {ys : List β}
    (h : List.Forall₂ R xs ys) (i : Nat) (hi : i < xs.length) :
    ∃ hj : i < ys.length, R xs[i] ys[i] := by
  induction h generalizing i with
  | nil => simp at hi
  | cons head tail ih =>
      cases i with
      | zero => exact ⟨by simp, head⟩
      | succ i =>
          obtain ⟨hj, relation⟩ := ih i (Nat.lt_of_succ_lt_succ hi)
          exact ⟨Nat.succ_lt_succ hj, relation⟩

/-- Build a `Forall₂` witness from equal lengths and its pointwise indexed
relations.  This is the converse positional form used by executable `mapM`
audits. -/
private theorem forall₂_of_getElem
    {R : α → β → Prop} {xs : List α} {ys : List β}
    (length_eq : xs.length = ys.length)
    (relation : ∀ (i : Nat) (hi : i < xs.length) (hj : i < ys.length),
      R xs[i] ys[i]) :
    List.Forall₂ R xs ys := by
  induction xs generalizing ys with
  | nil =>
      simp only [List.length_nil] at length_eq
      have : ys = [] := List.eq_nil_of_length_eq_zero length_eq.symm
      subst ys
      exact .nil
  | cons x xs ih =>
      cases ys with
      | nil => simp at length_eq
      | cons y ys =>
          simp only [List.length_cons, Nat.succ.injEq] at length_eq
          exact .cons
            (relation 0 (by simp) (by simp))
            (ih length_eq fun i hi hj => by
              simpa only [List.getElem_cons_succ] using
                relation (i + 1) (Nat.succ_lt_succ hi)
                  (Nat.succ_lt_succ hj))

/-- If translating a universe-name inventory against itself produces the
positional parameter list, the inventory has no duplicate names.  This lets
the retained recursor-universe audit establish freshness without reasoning
about the opaque string implementation of `Name.appendIndexAfter`. -/
private theorem recLevelParams_nodup_of_translation
    (names : List Name)
    (translated : (names.map Level.param).mapM (VLevel.ofLevel names) =
      some (VLevel.params names.length)) :
    names.Nodup := by
  have aligned := List.mapM_eq_some.mp translated
  have indexExact : ∀ (i : Nat) (hi : i < names.length),
      names.idxOf names[i] = i := by
    intro i hi
    have sourceBound : i < (names.map Level.param).length := by simpa
    obtain ⟨_targetBound, relation⟩ :=
      forall₂_getElem aligned i sourceBound
    simp only [List.getElem_map] at relation
    have nameMem : names[i] ∈ names := List.getElem_mem hi
    have inBounds : names.idxOf names[i] < names.length :=
      List.idxOf_lt_length_iff.mpr nameMem
    simpa [VLevel.ofLevel, inBounds, VLevel.params] using relation
  change List.Pairwise (· ≠ ·) names
  rw [List.pairwise_iff_getElem]
  intro i j hi hj hij equal
  have indicesEqual : i = j := by
    rw [← indexExact i hi, ← indexExact j hj, equal]
  exact (Nat.ne_of_lt hij) indicesEqual

open private Lean.Kernel.Environment.add from Lean.Environment

/-- The public inductive runner's duplicate-universe gate is exactly the
name-list invariant needed by positional Theory universe translation. -/
theorem _root_.Lean.Kernel.Environment.checkDuplicatedUnivParams_eq_ok_iff_nodup
    (names : List Name) :
    Environment.checkDuplicatedUnivParams names = .ok () ↔ names.Nodup := by
  induction names with
  | nil => simp [Environment.checkDuplicatedUnivParams, Pure.pure,
      Except.pure]
  | cons name names ih =>
      rw [Environment.checkDuplicatedUnivParams]
      by_cases member : name ∈ names
      · simp [member, throw, throwThe, MonadExceptOf.throw, Bind.bind,
          Except.bind]
      · simp [member, ih]

/-- Distinct source universe names translate against their own inventory to
Theory's positional identity substitution. -/
theorem VLevel.mapM_ofLevel_map_param_eq_params_of_nodup
    (names : List Name) (nodup : names.Nodup) :
    (names.map Level.param).mapM (VLevel.ofLevel names) =
      some (VLevel.params names.length) := by
  rw [List.mapM_eq_some]
  apply forall₂_of_getElem
  · simp [VLevel.params]
  · intro i sourceBound targetBound
    have nameBound : i < names.length := by simpa using sourceBound
    have indexExact := nodup.idxOf_getElem i nameBound
    simp [VLevel.ofLevel, VLevel.params, indexExact, nameBound]

/-- Distinct numeric suffixes produce distinct elimination-universe names. -/
theorem AddInductive.getElimParamName_injective :
    Function.Injective AddInductive.getElimParamName := by
  intro i j equal
  simp [AddInductive.getElimParamName, Nat.repr_inj] at equal
  exact equal

/-- No indexed elimination-universe name is the unsuffixed initial `u`. -/
theorem AddInductive.getElimParamName_ne_u (i : Nat) :
    AddInductive.getElimParamName i ≠ `u := by
  intro equal
  have stringEq : "u_" ++ Nat.repr i = "u" := by
    simpa only [AddInductive.getElimParamName, Name.str.injEq, true_and]
      using equal
  have sizes := congrArg String.utf8ByteSize stringEq
  simp only [String.utf8ByteSize_append] at sizes
  have prefixSize : "u_".utf8ByteSize = 2 := by native_decide
  have baseSize : "u".utf8ByteSize = 1 := by native_decide
  rw [prefixSize, baseSize] at sizes
  omega

/-- Exact candidate inventory inspected by the bounded fresh-eliminator-name
search, including its final totality fallback. -/
private def elimParamCandidates (u : Name) (i : Nat) : Nat → List Name
  | 0 => [u]
  | fuel + 1 =>
      u :: elimParamCandidates (AddInductive.getElimParamName i) (i + 1) fuel

private theorem elimParamCandidates_length (u : Name) (i fuel : Nat) :
    (elimParamCandidates u i fuel).length = fuel + 1 := by
  induction fuel generalizing u i with
  | zero => rfl
  | succ fuel ih => simp [elimParamCandidates, ih]

private theorem elimParamCandidates_canonical (i fuel : Nat) :
    elimParamCandidates (AddInductive.getElimParamName i) (i + 1) fuel =
      (List.range' i (fuel + 1)).map AddInductive.getElimParamName := by
  induction fuel generalizing i with
  | zero => simp [elimParamCandidates]
  | succ fuel ih =>
      rw [elimParamCandidates, List.range'_succ]
      simp only [List.map_cons, List.cons.injEq, true_and]
      simpa only [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
        ih (i + 1)

private theorem elimParamCandidates_initial (fuel : Nat) :
    elimParamCandidates `u 1 fuel =
      `u :: (List.range' 1 fuel).map AddInductive.getElimParamName := by
  cases fuel with
  | zero => rfl
  | succ fuel =>
      simp only [elimParamCandidates]
      rw [elimParamCandidates_canonical]

private theorem elimParamCandidates_initial_nodup (fuel : Nat) :
    (elimParamCandidates `u 1 fuel).Nodup := by
  rw [elimParamCandidates_initial, List.nodup_cons]
  constructor
  · intro member
    obtain ⟨i, _iMem, equal⟩ := List.mem_map.mp member
    exact AddInductive.getElimParamName_ne_u i equal
  · change List.Pairwise (fun left right => left ≠ right)
      ((List.range' 1 fuel).map AddInductive.getElimParamName)
    rw [List.pairwise_map]
    exact (List.nodup_range' (s := 1) (n := fuel)).imp fun ne equal =>
      ne (AddInductive.getElimParamName_injective equal)

private theorem elimParamCandidates_subset_of_loop_mem
    (returnedMem :
      AddInductive.getFreshElimParam.loop lparams u i fuel ∈ lparams) :
    elimParamCandidates u i fuel ⊆ lparams := by
  induction fuel generalizing u i with
  | zero =>
      intro value member
      simp only [elimParamCandidates, List.mem_singleton] at member
      subst value
      simpa only [AddInductive.getFreshElimParam.loop] using returnedMem
  | succ fuel ih =>
      by_cases currentMem : u ∈ lparams
      · have recursiveMem :
            AddInductive.getFreshElimParam.loop lparams
                (AddInductive.getElimParamName i) (i + 1) fuel ∈ lparams := by
          simpa [AddInductive.getFreshElimParam.loop, currentMem] using
            returnedMem
        intro value member
        rcases List.mem_cons.mp member with rfl | member
        · exact currentMem
        · exact ih recursiveMem member
      · have impossible : u ∈ lparams := by
          simpa [AddInductive.getFreshElimParam.loop, currentMem] using
            returnedMem
        exact (currentMem impossible).elim

private theorem getFreshElimParam_loop_not_mem_of_candidates
    (nodup : (elimParamCandidates u i fuel).Nodup)
    (tooLong : lparams.length < (elimParamCandidates u i fuel).length) :
    AddInductive.getFreshElimParam.loop lparams u i fuel ∉ lparams := by
  intro returnedMem
  have subset := elimParamCandidates_subset_of_loop_mem returnedMem
  have lengthLe := nodup.length_le_of_subset subset
  omega

/-- The bounded kernel-name search always returns a universe name absent from
the declaration inventory. -/
theorem AddInductive.getFreshElimParam_not_mem (lparams : List Name) :
    AddInductive.getFreshElimParam lparams ∉ lparams := by
  change AddInductive.getFreshElimParam.loop lparams `u 1
      (lparams.length + 1) ∉ lparams
  apply getFreshElimParam_loop_not_mem_of_candidates
  · exact elimParamCandidates_initial_nodup _
  · rw [elimParamCandidates_length]
    omega

/-- A resolved projector preserves absence of one block-family constant in
every well-formed local context.  This is the precise semantic provenance
needed by projection-aware positivity: it says nothing about uniqueness of
the source projection and does not require the family itself to be absent
from the post-family environment. -/
def ResolvedProjectionConstSafe (env : VEnv) (name : Name) : Prop :=
  ∀ {U : Nat} {context : List VExpr} {structName : Name} {index : Nat}
      {major result : VExpr},
    OnCtx context (env.IsType U) →
      ResolvedTrProj env U context structName index major result →
      major.hasConst name = false → result.hasConst name = false

/-- Pointwise projector safety for a complete family-name inventory. -/
def ResolvedProjectionNamesSafe (env : VEnv) (names : List Name) : Prop :=
  ∀ name, name ∈ names → ResolvedProjectionConstSafe env name

/-- Fresh constants are a sufficient, but deliberately nonessential, way to
obtain resolved-projector safety.  Later accepted-execution producers can
instead retain the stronger pre-staging provenance of each selected
projection artifact. -/
theorem ResolvedProjectionConstSafe.of_absent
    {env : VEnv} {name : Name} (henv : env.WF)
    (absent : env.constants name = none) :
    ResolvedProjectionConstSafe env name := by
  intro U context structName index major result contextWF projection majorFree
  rcases projection with ⟨view, levels, params, ⟨viewName, projected⟩⟩
  obtain ⟨code, codeAt, resultEq, projectorType⟩ := projected.program
  have projectorFree := projectorType.hasConst_false_of_absent
    henv.ordered contextWF absent
  rw [resultEq]
  simp only [VExpr.hasConst, projectorFree, majorFree, Bool.false_or]

theorem ResolvedProjectionNamesSafe.of_absent
    {env : VEnv} {names : List Name} (henv : env.WF)
    (absent : ∀ name, name ∈ names → env.constants name = none) :
    ResolvedProjectionNamesSafe env names := by
  intro name member
  exact ResolvedProjectionConstSafe.of_absent henv (absent name member)

namespace AddInductive

/-- One executable step of the shared-parameter comparison loop in
`isValidIndAppIdx`. -/
private def isValidIndAppIdxParameterStep (bad : Nat → Bool) (i : Nat)
    (_ : Option Bool × Unit) :
    Id (ForInStep (Option Bool × Unit)) :=
  if bad i then pure (.done (some false, ()))
  else pure (.yield (none, ()))

/-- Closed form of the shared-parameter comparison loop. -/
private theorem bindList_isValidIndAppIdxParameterStep
    (bad : Nat → Bool) (indices : List Nat) :
    (ForInStep.yield (none, ())).bindList
        (isValidIndAppIdxParameterStep bad) indices =
      if indices.any bad then .done (some false, ())
      else .yield (none, ()) := by
  induction indices with
  | nil => rfl
  | cons head tail ih =>
      simp only [ForInStep.bindList_cons, ForInStep.bind_yield,
        isValidIndAppIdxParameterStep, List.any_cons]
      split
      · simp_all [Bind.bind, Pure.pure]
      · simp_all [Bind.bind, Pure.pure]

/-- Acceptance of an inductive terminal application means that every shared
parameter argument is expression-equivalent to the corresponding parameter
stored in the validator statistics. -/
theorem isValidIndAppIdx_parameter_eqv
    {stats : InductiveStats} {source : Expr} {familyIdx i : Nat}
    (valid : isValidIndAppIdx stats source familyIdx = true)
    (hi : i < stats.params.size) :
    (stats.params[i]! == source.getAppArgs[i]!) = true := by
  unfold isValidIndAppIdx at valid
  rw [Expr.withApp_eq] at valid
  simp only [Id.run] at valid
  split at valid
  · simp only [Std.Legacy.Range.forIn_eq_forIn_range'] at valid
    rw [List.forIn_eq_bindList] at valid
    let bad := fun (i : Nat) =>
      stats.params[i]! != source.getAppArgs[i]!
    have stepEq :
        (fun i (_ : Option Bool × Unit) =>
          if bad i then pure (.done (some false, ()))
          else pure (.yield (none, ()))) =
          isValidIndAppIdxParameterStep bad := rfl
    rw [stepEq] at valid
    rw [bindList_isValidIndAppIdxParameterStep] at valid
    split at valid
    · change false = true at valid
      simp at valid
    · rename_i allGood
      have badFalse : bad i = false := by
        have allGood' : ∀ x, x < stats.params.size → bad x = false := by
          simpa [List.any_eq_false] using allGood
        exact allGood' i hi
      simpa [bad, bne] using badFalse
  · simp at valid

/-- Every post-parameter argument of an accepted inductive application is
free of every inductive constant in the validator's block inventory. -/
theorem isValidIndAppIdx_index_hasIndOcc_false
    {stats : InductiveStats} {source : Expr} {familyIdx i : Nat}
    (valid : isValidIndAppIdx stats source familyIdx = true)
    (lower : stats.params.size ≤ i)
    (upper : i < source.getAppArgs.size) :
    hasIndOcc stats.indConsts source.getAppArgs[i]! = false := by
  unfold isValidIndAppIdx at valid
  rw [Expr.withApp_eq] at valid
  simp only [Id.run] at valid
  split at valid
  · simp only [Std.Legacy.Range.forIn_eq_forIn_range'] at valid
    rw [List.forIn_eq_bindList] at valid
    let parameterBad := fun (i : Nat) =>
      stats.params[i]! != source.getAppArgs[i]!
    have parameterStepEq :
        (fun i (_ : Option Bool × Unit) =>
          if parameterBad i then pure (.done (some false, ()))
          else pure (.yield (none, ()))) =
            isValidIndAppIdxParameterStep parameterBad := rfl
    rw [parameterStepEq,
      bindList_isValidIndAppIdxParameterStep] at valid
    split at valid
    · change false = true at valid
      simp at valid
    · rw [List.forIn_eq_bindList] at valid
      let indexBad := fun (i : Nat) =>
        hasIndOcc stats.indConsts source.getAppArgs[i]!
      have indexStepEq :
          (fun i (_ : Option Bool × Unit) =>
            if indexBad i then pure (.done (some false, ()))
            else pure (.yield (none, ()))) =
              isValidIndAppIdxParameterStep indexBad := rfl
      rw [indexStepEq,
        bindList_isValidIndAppIdxParameterStep] at valid
      split at valid
      · change false = true at valid
        simp at valid
      · rename_i allGood
        have allGood' : ∀ x,
            x ∈ List.range' stats.params.size
                ([stats.params.size:source.getAppArgs.size]).size →
              indexBad x = false := by
          simpa [List.any_eq_false] using allGood
        apply allGood' i
        have argsBound : stats.params.size ≤ source.getAppArgs.size :=
          Nat.le_trans lower (Nat.le_of_lt upper)
        simpa [Std.Legacy.Range.size, argsBound, lower] using upper
  · simp at valid

/-- List form of the accepted index-argument occurrence check. -/
theorem isValidIndAppIdx_indexArgs_hasIndOcc_false
    {stats : InductiveStats} {source : Expr} {familyIdx : Nat}
    (valid : isValidIndAppIdx stats source familyIdx = true) :
    ∀ argument ∈ source.getAppArgsList.drop stats.params.size,
      hasIndOcc stats.indConsts argument = false := by
  intro argument member
  obtain ⟨offset, argumentAt⟩ := List.mem_iff_getElem?.1 member
  have originalAt :
      source.getAppArgsList[stats.params.size + offset]? =
        some argument := by
    rw [← List.getElem?_drop]
    exact argumentAt
  have originalAtArray :
      source.getAppArgs[stats.params.size + offset]? = some argument := by
    rw [← Array.getElem?_toList, Expr.getAppArgs_toList]
    exact originalAt
  have upperList : stats.params.size + offset <
      source.getAppArgsList.length :=
    (List.getElem?_eq_some_iff.1 originalAt).1
  have upper :
      stats.params.size + offset < source.getAppArgs.size := by
    simpa only [← Expr.getAppArgs_toList, Array.length_toList]
      using upperList
  have argumentGet :
      source.getAppArgs[stats.params.size + offset]! = argument := by
    rw [Array.getElem?_eq_getElem upper] at originalAtArray
    injection originalAtArray with originalAtArray
    simpa [getElem!_def, upper] using originalAtArray
  simpa only [argumentGet] using
    isValidIndAppIdx_index_hasIndOcc_false valid
      (Nat.le_add_right _ _) upper

/-- Construct a pointwise list relation from equal lengths and exact optional
lookups. -/
private theorem forall₂_of_getElem?
    {R : α → β → Prop} {left : List α} {right : List β}
    (length : left.length = right.length)
    (point : ∀ (i : Nat) x y,
      left[i]? = some x → right[i]? = some y → R x y) :
    List.Forall₂ R left right := by
  induction left generalizing right with
  | nil =>
      cases right
      · exact .nil
      · simp at length
  | cons head tail ih =>
      cases right with
      | nil => simp at length
      | cons rightHead rightTail =>
          exact .cons
            (point 0 head rightHead (by simp) (by simp))
            (ih (Nat.succ.inj length) (fun i x y leftAt rightAt =>
              point (i + 1) x y (by simpa using leftAt)
                (by simpa using rightAt)))

/-- The accepted shared-parameter prefix is pointwise expression-equivalent
to the exact parameter array retained in the validator statistics. -/
theorem isValidIndAppIdx_parameter_eqvs
    {stats : InductiveStats} {source : Expr} {familyIdx : Nat}
    (valid : isValidIndAppIdx stats source familyIdx = true) :
    List.Forall₂ (fun parameter argument =>
      (parameter == argument) = true)
      stats.params.toList
      (source.getAppArgsList.take stats.params.size) := by
  apply forall₂_of_getElem?
  · have shape :=
      ConstructorValidation.isValidIndAppIdx_shape valid
    rw [← Expr.getAppArgs_toList]
    simp only [Array.length_toList, List.length_take]
    rw [shape.2]
    omega
  · intro i parameter argument parameterAt argumentAt
    have iLt : i < stats.params.size := by
      have listLt := (List.getElem?_eq_some_iff.1 parameterAt).1
      simpa using listLt
    have argsLt : i < source.getAppArgs.size := by
      have shape :=
        ConstructorValidation.isValidIndAppIdx_shape valid
      rw [shape.2]
      omega
    have parameterGet : stats.params[i]! = parameter := by
      rw [Array.getElem?_toList] at parameterAt
      rw [Array.getElem?_eq_getElem iLt] at parameterAt
      injection parameterAt with parameterAt
      simpa [getElem!_def, iLt] using parameterAt
    have argumentAt' : source.getAppArgsList[i]? = some argument := by
      rw [List.getElem?_take] at argumentAt
      simp only [if_pos iLt] at argumentAt
      exact argumentAt
    have argumentGet : source.getAppArgs[i]! = argument := by
      rw [← Expr.getAppArgs_toList,
        Array.getElem?_toList] at argumentAt'
      rw [Array.getElem?_eq_getElem argsLt] at argumentAt'
      injection argumentAt' with argumentAt'
      simpa [getElem!_def, argsLt] using argumentAt'
    simpa only [parameterGet, argumentGet] using
      isValidIndAppIdx_parameter_eqv valid iLt

private theorem forall₂_take
    (run : List.Forall₂ R left right) (count : Nat) :
    List.Forall₂ R (left.take count) (right.take count) := by
  induction run generalizing count with
  | nil => simp
  | cons head tail ih =>
      cases count with
      | zero => exact .nil
      | succ count => exact .cons head (ih count)

private theorem forall₂_length
    (run : List.Forall₂ R left right) :
    left.length = right.length := by
  induction run with
  | nil => rfl
  | cons head tail ih => exact congrArg Nat.succ ih

/-- Transport the translated side of a pointwise list relation across exact
kernel expression equivalence on its source side. -/
private theorem forall₂_tr_of_eqv
    {env : VEnv} {Us : List Name} {context : VLCtx}
    (translations : List.Forall₂ (TrExprS env Us context)
      expected expectedTargets)
    (equal : List.Forall₂ (fun left right =>
      (left == right) = true) expected actual) :
    List.Forall₂ (TrExprS env Us context) actual expectedTargets := by
  induction translations generalizing actual with
  | nil => cases equal; exact .nil
  | cons head tail ih =>
      cases equal with
      | cons equality equalities =>
          exact .cons (head.eqv equality) (ih equalities)

/-- A list pointwise equivalent to free variables remains inside the strict
translation uniqueness fragment.  This is the only uniqueness needed to
identify the translated shared-parameter prefix of a family application;
projection-bearing index arguments are deliberately not covered. -/
private theorem forall₂_eqv_unique_of_fvars
    {parameters arguments : List Expr}
    (equal : List.Forall₂ (fun parameter argument =>
      (parameter == argument) = true) parameters arguments)
    (parametersFVar : ∀ parameter ∈ parameters,
      ∃ fv, parameter = .fvar fv) :
    ∀ argument ∈ arguments, TrExprS.IsUnique argument := by
  induction equal with
  | nil => simp
  | @cons parameter argument parameters arguments head tail ih =>
      have parameterFVar := parametersFVar parameter (by simp)
      obtain ⟨fv, rfl⟩ := parameterFVar
      have argumentUnique : TrExprS.IsUnique argument := by
        cases argument <;>
          simp_all [(· == ·), Expr.eqv_eq, Expr.eqv', TrExprS.IsUnique]
      intro candidate member
      simp only [List.mem_cons] at member
      rcases member with rfl | member
      · exact argumentUnique
      · exact ih
          (fun parameter member =>
            parametersFVar parameter (by simp [member]))
          candidate member

/-- Exact Theory application components selected by one accepted kernel
family application.  Shared parameters are identified through the
validator's expression-equivalence loop and strict-translation uniqueness;
the remaining argument relation is retained for block-family occurrence
transport. -/
theorem isValidIndAppIdx_translation_components
    {env : VEnv} {Us : List Name} {context : VLCtx}
    {stats : InductiveStats} {source : Expr} {target : VExpr}
    {familyIdx U np ni j : Nat} {familyName : Name}
    (run : TrExprS env Us context source target)
    (unique : TrExprS.IsUnique source)
    (valid : isValidIndAppIdx stats source familyIdx = true)
    (paramsSize : stats.params.size = np)
    (indicesCount : stats.nindices[familyIdx]! = ni)
    (familyConst : stats.indConsts[familyIdx]! =
      .const familyName stats.levels)
    (levelsTr : stats.levels.mapM (VLevel.ofLevel Us) =
      some (VLevel.params U))
    (parameterTranslations : List.Forall₂ (TrExprS env Us context)
      stats.params.toList (VExpr.bvarRevRange j np)) :
    target.appHead = .const familyName (VLevel.params U) ∧
      (target.appArgs []).length = np + ni ∧
      (target.appArgs []).take np = VExpr.bvarRevRange j np ∧
      List.Forall₂ (TrExprS env Us context)
        (source.getAppArgsList.drop np)
        ((target.appArgs []).drop np) := by
  have shape :=
    ConstructorValidation.isValidIndAppIdx_shape valid
  have sourceHead : source.getAppFn =
      .const familyName stats.levels := by
    rw [familyConst] at shape
    change source.getAppFn.eqv
        (.const familyName stats.levels) = true ∧ _ at shape
    rw [Expr.eqv_eq] at shape
    generalize headEq : source.getAppFn = head at shape
    cases head <;> simp_all [Expr.eqv']
  obtain ⟨targetLevels, targetLevelsTr, targetHead, argumentsTr⟩ :=
    ConstructorValidation.TrExprS.constApp_components_with_levels
      run sourceHead
  have targetLevelsEq : targetLevels = VLevel.params U := by
    rw [levelsTr] at targetLevelsTr
    exact Option.some.inj targetLevelsTr.symm
  subst targetLevels
  refine ⟨targetHead, ?_, ?_, ?_⟩
  · have argumentLengths := forall₂_length argumentsTr
    rw [← Expr.getAppArgs_toList] at argumentLengths
    simp only [Array.length_toList] at argumentLengths
    rw [shape.2, paramsSize, indicesCount] at argumentLengths
    exact argumentLengths.symm
  · have parameterEqvs := isValidIndAppIdx_parameter_eqvs valid
    have actualExpected := forall₂_tr_of_eqv
      parameterTranslations parameterEqvs
    have actualTargets := forall₂_take argumentsTr stats.params.size
    have parameterUnique : ∀ argument ∈
        source.getAppArgsList.take stats.params.size,
        TrExprS.IsUnique argument := by
      intro argument member
      exact ConstructorValidation.TrExprS.IsUnique.getAppArgsList
        unique argument (List.mem_of_mem_take member)
    have targetsEq :=
      ConstructorValidation.forall₂_translation_unique
        actualTargets actualExpected parameterUnique
    simpa only [paramsSize] using targetsEq
  · simpa only [paramsSize] using
      ConstructorValidation.forall₂_drop argumentsTr stats.params.size

/-- Projection-aware family-application decomposition.  Only the shared
parameter prefix is compared syntactically, and the validator already proves
that prefix pointwise equivalent to its free-variable parameter inventory.
Index arguments may contain projections; their exact strict translations are
retained without a whole-expression uniqueness premise. -/
theorem isValidIndAppIdx_translation_components_resolved
    {env : VEnv} {Us : List Name} {context : VLCtx}
    {stats : InductiveStats} {source : Expr} {target : VExpr}
    {familyIdx U np ni j : Nat} {familyName : Name}
    (run : TrExprS env Us context source target)
    (valid : isValidIndAppIdx stats source familyIdx = true)
    (paramsSize : stats.params.size = np)
    (indicesCount : stats.nindices[familyIdx]! = ni)
    (familyConst : stats.indConsts[familyIdx]! =
      .const familyName stats.levels)
    (levelsTr : stats.levels.mapM (VLevel.ofLevel Us) =
      some (VLevel.params U))
    (parameterTranslations : List.Forall₂ (TrExprS env Us context)
      stats.params.toList (VExpr.bvarRevRange j np))
    (parametersFVar : ∀ parameter ∈ stats.params.toList,
      ∃ fv, parameter = .fvar fv) :
    target.appHead = .const familyName (VLevel.params U) ∧
      (target.appArgs []).length = np + ni ∧
      (target.appArgs []).take np = VExpr.bvarRevRange j np ∧
      List.Forall₂ (TrExprS env Us context)
        (source.getAppArgsList.drop np)
        ((target.appArgs []).drop np) := by
  have shape := ConstructorValidation.isValidIndAppIdx_shape valid
  have sourceHead : source.getAppFn =
      .const familyName stats.levels := by
    rw [familyConst] at shape
    change source.getAppFn.eqv
        (.const familyName stats.levels) = true ∧ _ at shape
    rw [Expr.eqv_eq] at shape
    generalize headEq : source.getAppFn = head at shape
    cases head <;> simp_all [Expr.eqv']
  obtain ⟨targetLevels, targetLevelsTr, targetHead, argumentsTr⟩ :=
    ConstructorValidation.TrExprS.constApp_components_with_levels
      run sourceHead
  have targetLevelsEq : targetLevels = VLevel.params U := by
    rw [levelsTr] at targetLevelsTr
    exact Option.some.inj targetLevelsTr.symm
  subst targetLevels
  refine ⟨targetHead, ?_, ?_, ?_⟩
  · have argumentLengths := forall₂_length argumentsTr
    rw [← Expr.getAppArgs_toList] at argumentLengths
    simp only [Array.length_toList] at argumentLengths
    rw [shape.2, paramsSize, indicesCount] at argumentLengths
    exact argumentLengths.symm
  · have parameterEqvs := isValidIndAppIdx_parameter_eqvs valid
    have actualExpected := forall₂_tr_of_eqv
      parameterTranslations parameterEqvs
    have actualTargets := forall₂_take argumentsTr stats.params.size
    have parameterUnique := forall₂_eqv_unique_of_fvars
      parameterEqvs parametersFVar
    have targetsEq :=
      ConstructorValidation.forall₂_translation_unique
        actualTargets actualExpected parameterUnique
    simpa only [paramsSize] using targetsEq
  · simpa only [paramsSize] using
      ConstructorValidation.forall₂_drop argumentsTr stats.params.size

/-- One executable step of the block-family target search in
`isValidIndApp?`. -/
private def isValidIndAppSearchStep (valid : Nat → Bool) (i : Nat)
    (_ : Option Nat × Unit) :
    Option (ForInStep (Option Nat × Unit)) :=
  if valid i then pure (.done (some i, ()))
  else pure (.yield (none, ()))

/-- A successful result of the transparent list search names an element of
the searched range and that element satisfies the search predicate. -/
private theorem bindList_isValidIndAppSearchStep_selected
    (valid : Nat → Bool) (indices : List Nat) (i : Nat)
    (run : ForInStep.run <$>
      (ForInStep.yield (none, ())).bindList
        (isValidIndAppSearchStep valid) indices = some (some i, ())) :
    i ∈ indices ∧ valid i = true := by
  induction indices with
  | nil => simp at run
  | cons head tail ih =>
      simp only [ForInStep.bindList_cons, ForInStep.bind_yield,
        isValidIndAppSearchStep] at run
      split at run
      · rename_i h
        simp at run
        subst i
        exact ⟨by simp, h⟩
      · obtain ⟨member, good⟩ := ih run
        exact ⟨by simp [member], good⟩

/-- Invert the exact first-success search used by `isValidIndApp?`.
The returned family ordinal is in the statistics array and its individual
application check succeeded. -/
private theorem isValidIndApp?_selected
    {stats : InductiveStats} {source : Expr} {familyIdx : Nat}
    (selected : isValidIndApp? stats source = some familyIdx) :
    familyIdx < stats.indConsts.size ∧
      isValidIndAppIdx stats source familyIdx = true := by
  unfold isValidIndApp? at selected
  simp only [Std.Legacy.Range.forIn_eq_forIn_range'] at selected
  rw [List.forIn_eq_bindList] at selected
  let valid := fun (i : Nat) => isValidIndAppIdx stats source i
  have stepEq :
      (fun i (_ : Option Nat × Unit) =>
        if valid i then pure (.done (some i, ()))
        else pure (.yield (none, ()))) =
          isValidIndAppSearchStep valid := rfl
  rw [stepEq] at selected
  simp only [Bind.bind, Option.bind_eq_some_iff] at selected
  obtain ⟨state, run, result⟩ := selected
  cases state with
  | mk found _ =>
      cases found with
      | none => simp at result
      | some i =>
          simp only [pure, Option.some.injEq] at result
          subst i
          have found := bindList_isValidIndAppSearchStep_selected
            valid _ familyIdx run
          exact ⟨by simpa using found.1, found.2⟩

/-- A family ordinal selected by `isValidIndApp?` satisfies the exact
family-indexed application checker. -/
theorem isValidIndApp?_valid
    {stats : InductiveStats} {source : Expr} {familyIdx : Nat}
    (selected : isValidIndApp? stats source = some familyIdx) :
    isValidIndAppIdx stats source familyIdx = true :=
  (isValidIndApp?_selected selected).2

/-- A family ordinal selected by `isValidIndApp?` is a valid slot of the
block-family constant array. -/
theorem isValidIndApp?_lt
    {stats : InductiveStats} {source : Expr} {familyIdx : Nat}
    (selected : isValidIndApp? stats source = some familyIdx) :
    familyIdx < stats.indConsts.size :=
  (isValidIndApp?_selected selected).1

/-- Executable audit of the universe metadata consumed by a generated block
recursor.  The checker chooses the level-parameter names operationally; this
gate records that translating its exact recursive-call levels in that exact
name context yields Theory's positional identity substitution. -/
def checkBlockRecursorUniverseSemantics
    (sourceUvars : Nat)
    {nparams : Nat} {types : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool} {candidateContext : Context}
    (execution : NormalizationEliminationExecution nparams types numNested
      isUnsafe candidateContext) : Except Exception Unit :=
  let recUvars := sourceUvars +
    if execution.elimination.large.result then 1 else 0
  if execution.recLevelParams.length = recUvars then
    if execution.recLevels.mapM
        (VLevel.ofLevel execution.recLevelParams) =
          some (VLevel.params recUvars) then
      .ok ()
    else
      .error (.other
        "generated recursor levels do not translate positionally")
  else
    .error (.other
      "generated recursor universe arity disagrees with elimination mode")

/-- Success of the recursor-universe audit retains both exact equations. -/
theorem checkBlockRecursorUniverseSemantics_of_run
    {nparams : Nat} {types : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool} {candidateContext : Context}
    {execution : NormalizationEliminationExecution nparams types numNested
      isUnsafe candidateContext}
    (run : checkBlockRecursorUniverseSemantics sourceUvars execution =
      .ok ()) :
    execution.recLevelParams.length = sourceUvars +
        (if execution.elimination.large.result then 1 else 0) ∧
      execution.recLevels.mapM
          (VLevel.ofLevel execution.recLevelParams) =
        some (VLevel.params (sourceUvars +
          if execution.elimination.large.result then 1 else 0)) := by
  unfold checkBlockRecursorUniverseSemantics at run
  cases large : execution.elimination.large.result with
  | false =>
      simp only [large, Bool.false_eq_true, if_false, Nat.add_zero] at run ⊢
      split at run
      · rename_i arity
        split at run
        · rename_i levels
          exact ⟨arity, levels⟩
        · contradiction
      · contradiction
  | true =>
      simp only [large, if_true] at run ⊢
      split at run
      · rename_i arity
        split at run
        · rename_i levels
          exact ⟨arity, levels⟩
        · contradiction
      · contradiction

/-- Every successful nonempty retained recursor execution passes the
recursor-universe audit once the Theory source records the declaration's
exact universe arity. -/
theorem NormalizationRecursorExecution.checkBlockRecursorUniverseSemantics_eq_ok
    {nparams : Nat} {types : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (execution : AddInductive.NormalizationRecursorExecution nparams types
      numNested isUnsafe context)
    (produced : AddInductive.NormalizationRecursorExecution.buildExecution
      nparams types numNested isUnsafe context = .ok execution)
    (nonempty : types.isEmpty = false)
    (sourceUvars_eq : sourceUvars = context.lparams.length) :
    AddInductive.checkBlockRecursorUniverseSemantics sourceUvars
      execution.eliminationExecution = .ok () := by
  let elimination := execution.eliminationExecution
  let normalization := elimination.normalization
  have normalizationProduced := execution.normalization_run produced
  have familyRun := normalization.familyValidationResult_run
    normalizationProduced
  have validationParams : normalization.validationContext.lparams =
      context.lparams :=
    normalization.validationContext_lparams_all normalizationProduced
  have statsLevels : normalization.stats.levels =
      context.lparams.map Level.param := by
    simpa only [normalization,
      AddInductive.NormalizationCandidateExecution.familyValidationResult]
      using normalization.familyValidationResult.stats_levels_of_run
        nonempty familyRun
  have sourceNodup : context.lparams.Nodup :=
    (Lean.Kernel.Environment.checkDuplicatedUnivParams_eq_ok_iff_nodup
      context.lparams).mp execution.duplicatedUnivParamsRun
  cases large : elimination.elimination.large.result with
  | false =>
      have largeExecution :
          execution.eliminationExecution.elimination.large.result = false := by
        simpa only [elimination] using large
      have recParamsEq : elimination.recLevelParams = context.lparams := by
        unfold AddInductive.NormalizationEliminationExecution.recLevelParams
        rw [elimination.elimination.recLevelParams_eq_small large,
          validationParams]
      have recLevelsEq : elimination.recLevels =
          context.lparams.map Level.param := by
        unfold AddInductive.NormalizationEliminationExecution.recLevels
        rw [elimination.elimination.recLevels_eq_small large, statsLevels]
      have translated :=
        VLevel.mapM_ofLevel_map_param_eq_params_of_nodup
          context.lparams sourceNodup
      unfold AddInductive.checkBlockRecursorUniverseSemantics
      rw [recParamsEq, recLevelsEq, sourceUvars_eq, translated]
      simp [largeExecution]

  | true =>
      have largeExecution :
          execution.eliminationExecution.elimination.large.result = true := by
        simpa only [elimination] using large
      let fresh := AddInductive.getFreshElimParam context.lparams
      have freshAbsent : fresh ∉ context.lparams :=
        AddInductive.getFreshElimParam_not_mem context.lparams
      have recParamsEq : elimination.recLevelParams =
          fresh :: context.lparams := by
        unfold AddInductive.NormalizationEliminationExecution.recLevelParams
        rw [elimination.elimination.recLevelParams_eq_large large,
          validationParams]
      have recLevelsEq : elimination.recLevels =
          (fresh :: context.lparams).map Level.param := by
        unfold AddInductive.NormalizationEliminationExecution.recLevels
        rw [elimination.elimination.recLevels_eq_large large, statsLevels,
          validationParams]
        rfl
      have recNodup : (fresh :: context.lparams).Nodup :=
        List.nodup_cons.mpr ⟨freshAbsent, sourceNodup⟩
      have translated :=
        VLevel.mapM_ofLevel_map_param_eq_params_of_nodup
          (fresh :: context.lparams) recNodup
      unfold AddInductive.checkBlockRecursorUniverseSemantics
      rw [recParamsEq, recLevelsEq, sourceUvars_eq, translated]
      simp [largeExecution]

/-- The source universe inventory retained by normalization translates
positionally for the constructor Stage-3 audits as well.  This is the common
prefix of both the projection-free and projection-aware audit variants. -/
theorem NormalizationRecursorExecution.stage3LevelsTranslation
    {nparams : Nat} {types : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (execution : AddInductive.NormalizationRecursorExecution nparams types
      numNested isUnsafe context)
    (produced : AddInductive.NormalizationRecursorExecution.buildExecution
      nparams types numNested isUnsafe context = .ok execution)
    (nonempty : types.isEmpty = false) :
    execution.eliminationExecution.normalization.stats.levels.mapM
        (VLevel.ofLevel context.lparams) =
      some (VLevel.params context.lparams.length) := by
  let normalization := execution.eliminationExecution.normalization
  have normalizationProduced := execution.normalization_run produced
  have familyRun := normalization.familyValidationResult_run
    normalizationProduced
  have statsLevels : normalization.stats.levels =
      context.lparams.map Level.param := by
    simpa only [normalization,
      AddInductive.NormalizationCandidateExecution.familyValidationResult]
      using normalization.familyValidationResult.stats_levels_of_run
        nonempty familyRun
  have sourceNodup : context.lparams.Nodup :=
    (Lean.Kernel.Environment.checkDuplicatedUnivParams_eq_ok_iff_nodup
      context.lparams).mp execution.duplicatedUnivParamsRun
  rw [statsLevels]
  exact VLevel.mapM_ofLevel_map_param_eq_params_of_nodup
    context.lparams sourceNodup

/-- Exact alignment between the post-constructor elimination decisions of the
ordinary kernel execution and the corresponding fields of a Theory mutual
generation.  This is the block analogue of `CheckerEliminationRun`. -/
structure CheckerBlockEliminationRun
    {source : VInductDecl}
    (generation : VInductDecl.BlockGenerationChecked source)
    {nparams : Nat} {types : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool} {candidateContext : Context}
    (execution : NormalizationEliminationExecution nparams types numNested
      isUnsafe candidateContext) : Type where
  nparams_eq : nparams = source.nparams
  sourceUvars_eq : source.uvars =
    execution.normalization.validationContext.lparams.length
  mode_eq : generation.elimination =
    VInductDecl.ElimMode.ofBool execution.elimination.large.result
  kTarget_eq : generation.kTarget = execution.kTarget.result
  recUvars_eq : generation.recUvars = execution.recLevelParams.length
  recLevels_eq : execution.recLevels.mapM
    (VLevel.ofLevel execution.recLevelParams) = some generation.recLevels

namespace CheckerBlockEliminationRun

/-- Decide every block-elimination alignment field from the retained ordinary
execution. -/
def build?
    {source : VInductDecl}
    (generation : VInductDecl.BlockGenerationChecked source)
    {nparams : Nat} {types : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool} {candidateContext : Context}
    (execution : NormalizationEliminationExecution nparams types numNested
      isUnsafe candidateContext) :
    Option (CheckerBlockEliminationRun generation execution) := do
  if hparams : nparams = source.nparams then
    if huvars : source.uvars =
        execution.normalization.validationContext.lparams.length then
      if hmode : generation.elimination =
          VInductDecl.ElimMode.ofBool execution.elimination.large.result then
        if hkTarget : generation.kTarget = execution.kTarget.result then
          if hrecUvars : generation.recUvars =
              execution.recLevelParams.length then
            if hlevels : execution.recLevels.mapM
                (VLevel.ofLevel execution.recLevelParams) =
                  some generation.recLevels then
              some {
                nparams_eq := hparams
                sourceUvars_eq := huvars
                mode_eq := hmode
                kTarget_eq := hkTarget
                recUvars_eq := hrecUvars
                recLevels_eq := hlevels }
            else none
          else none
        else none
      else none
    else none
  else none

theorem large_result_iff
    (run : CheckerBlockEliminationRun generation execution) :
    execution.elimination.large.result = true ↔
      generation.elimination = VInductDecl.ElimMode.large := by
  cases hresult : execution.elimination.large.result with
  | false =>
      have hmode : generation.elimination = VInductDecl.ElimMode.small := by
        simpa [hresult] using run.mode_eq
      simp [hmode]
  | true =>
      have hmode : generation.elimination = VInductDecl.ElimMode.large := by
        simpa [hresult] using run.mode_eq
      simp [hmode]

theorem kTarget_result_iff
    (run : CheckerBlockEliminationRun generation execution) :
    execution.kTarget.result = true ↔ generation.kTarget = true := by
  rw [run.kTarget_eq]

end CheckerBlockEliminationRun

/-- Family-indexed alignment between every constructor-validation trace in a
mutual block and the analyzer-owned constructor candidates at the same source
positions.  Both lists remain dependent indices, so neither a family nor a
constructor alignment can be reordered, duplicated, or dropped. -/
inductive ConstructorBlockCandidateAlignmentTrace
    (stats : InductiveStats) (isUnsafe : Bool) (context : Context) :
    {familyIdx : Nat} → {sources : List InductiveType} →
    ConstructorBlockValidationTraces stats isUnsafe context familyIdx sources →
    CandidateList CandidateFamily sources → Type where
  | nil : ConstructorBlockCandidateAlignmentTrace stats isUnsafe context
      .nil .nil
  | cons
      (head : ConstructorCandidateAlignmentTrace stats isUnsafe familyIdx
        context validationHead candidate.constructors)
      (tail : ConstructorBlockCandidateAlignmentTrace stats isUnsafe context
        validationTail candidates) :
      ConstructorBlockCandidateAlignmentTrace stats isUnsafe context
        (.cons validationHead validationTail) (.cons candidate candidates)

namespace ConstructorBlockCandidateAlignmentTrace

/-- Execute the supplemental constructor-view audit in exact family and
constructor source order.  The ordinary validator trace remains the authority
for acceptance; this pass only connects its positions to retained views. -/
def build :
    (validation : ConstructorBlockValidationTraces stats isUnsafe context
      familyIdx sources) →
    (candidates : CandidateList CandidateFamily sources) →
      Except Exception
        (ConstructorBlockCandidateAlignmentTrace stats isUnsafe context
          validation candidates)
  | .nil, .nil => .ok .nil
  | .cons validationHead validationTail, .cons candidate candidates => do
      let head ← ConstructorCandidateAlignmentTrace.build validationHead
        candidate.constructors
      let tail ← build validationTail candidates
      pure (.cons head tail)

/-- Erased executable audit for the complete dependent block alignment. -/
def check
    (validation : ConstructorBlockValidationTraces stats isUnsafe context
      familyIdx sources)
    (candidates : CandidateList CandidateFamily sources) : Except Exception Unit :=
  (build validation candidates).map fun _ => ()

/-- A successful block audit retains the exact dependent alignment selected
by the builder. -/
theorem nonempty_of_check
    {validation : ConstructorBlockValidationTraces stats isUnsafe context
      familyIdx sources}
    {candidates : CandidateList CandidateFamily sources}
    (success : check validation candidates = .ok ()) :
    Nonempty (ConstructorBlockCandidateAlignmentTrace stats isUnsafe context
      validation candidates) := by
  unfold check at success
  cases h : build validation candidates with
  | error error =>
      rw [h] at success
      contradiction
  | ok alignment => exact ⟨alignment⟩

end ConstructorBlockCandidateAlignmentTrace

/-- Block-wide structural alignment forced by the retained validator and
candidate producer.  Unlike `ConstructorBlockCandidateAlignmentTrace`, this
contains no supplemental rechecking of normalized constructor views. -/
inductive ConstructorBlockCandidateSpineAlignment
    (stats : InductiveStats) (isUnsafe : Bool) (context : Context) :
    {familyIdx : Nat} → {sources : List InductiveType} →
    ConstructorBlockValidationTraces stats isUnsafe context familyIdx sources →
    CandidateList CandidateFamily sources → Prop where
  | nil : ConstructorBlockCandidateSpineAlignment stats isUnsafe context
      .nil .nil
  | cons
      (head : ConstructorCandidateSpineAlignment stats isUnsafe familyIdx
        context validationHead candidate.constructors)
      (tail : ConstructorBlockCandidateSpineAlignment stats isUnsafe context
        validationTail candidates) :
      ConstructorBlockCandidateSpineAlignment stats isUnsafe context
        (.cons validationHead validationTail) (.cons candidate candidates)

/-- Exact generation spines align every constructor telescope in every
family with the retained ordinary validation trace. -/
theorem ConstructorBlockCandidateSpineAlignment.ofGeneration
    (validation : ConstructorBlockValidationTraces stats isUnsafe context
      familyIdx sources)
    (candidates : CandidateList CandidateFamily sources)
    (produced : CandidateBlockConstructorListProduced candidateContext
      candidates)
    (generation : CandidateFamilyGenerationSpineList candidates)
    (localState : TypeChecker.FamilyParameterLocalState stats context) :
    ConstructorBlockCandidateSpineAlignment stats isUnsafe context validation
      candidates := by
  induction validation with
  | nil =>
      cases candidates
      exact .nil
  | cons validationHead validationTail ih =>
      cases candidates with
      | cons candidate candidates =>
        cases produced with
        | cons headProduced tailProduced =>
          cases generation with
          | cons familyGeneration constructorGeneration tailGeneration =>
            exact .cons
              (ConstructorCandidateSpineAlignment.ofGeneration validationHead
                candidate.constructors headProduced constructorGeneration
                localState)
              (ih candidates tailProduced tailGeneration)

/-- Recompose a retained outer inductive execution through the public
`addDecl` dispatcher.  Primitive recognition is retained as an explicit
equation because it selects the `allowPrimitive` input of the execution. -/
theorem EnvironmentInductiveExecution.addDeclRun
    (execution : EnvironmentInductiveExecution env lparams nparams types
      isUnsafe allowPrimitive fuel finalEnv)
    (primitiveRun : Environment.checkPrimitiveInductive env lparams nparams
      types isUnsafe = .ok allowPrimitive) :
    addDecl env (.inductDecl lparams nparams types isUnsafe)
      (check := true) (fuel := fuel) = .ok finalEnv := by
  change (do
    let actualAllowPrimitive ← Environment.checkPrimitiveInductive env
      lparams nparams types isUnsafe
    Environment.addInductive env lparams nparams types isUnsafe
      actualAllowPrimitive fuel) = .ok finalEnv
  rw [primitiveRun]
  exact execution.addInductiveRun

/-- A successful retained build therefore certifies the matching public
`addDecl` result once the primitive-recognizer branch is fixed. -/
theorem EnvironmentInductiveExecution.buildExecution_addDeclRun
    {produced : Σ finalEnv, EnvironmentInductiveExecution env lparams
      nparams types isUnsafe allowPrimitive fuel finalEnv}
    (_run : EnvironmentInductiveExecution.buildExecution env lparams nparams
      types isUnsafe allowPrimitive fuel = .ok produced)
    (primitiveRun : Environment.checkPrimitiveInductive env lparams nparams
      types isUnsafe = .ok allowPrimitive) :
    addDecl env (.inductDecl lparams nparams types isUnsafe)
      (check := true) (fuel := fuel) = .ok produced.1 :=
  produced.2.addDeclRun primitiveRun

/-- Exact semantic transaction aligned with the final branch of one retained
outer execution.  An ordinary execution is interpreted by the mutual-block
transaction; a genuinely nested execution is interpreted by the restored
nested transaction. -/
inductive EnvironmentInductiveExecution.ExactSemanticTransaction
    {env : Environment} {lparams : List Name} {nparams : Nat}
    {types : List InductiveType} {isUnsafe allowPrimitive : Bool}
    {fuel : FuelConfig} {finalEnv : Environment}
    (execution : EnvironmentInductiveExecution env lparams nparams types
      isUnsafe allowPrimitive fuel finalEnv)
    (source : VInductDecl) (input output : VEnv) : Prop where
  | ordinary
      (numNested_eq : execution.nested.aux2nested.size = 0)
      (transaction : AddInductBlock env.constants input source
        finalEnv.constants output) :
      execution.ExactSemanticTransaction source input output
  | nested
      (numNested_ne : execution.nested.aux2nested.size ≠ 0)
      (transaction : AddInductNested env.constants input source
        finalEnv.constants output) :
      execution.ExactSemanticTransaction source input output

namespace EnvironmentInductiveExecution.ExactSemanticTransaction

/-- Replay an exact transaction after any translated input history. -/
theorem trEnv
    {env : Environment} {lparams : List Name} {nparams : Nat}
    {types : List InductiveType} {isUnsafe allowPrimitive : Bool}
    {fuel : FuelConfig} {finalEnv : Environment}
    {execution : EnvironmentInductiveExecution env lparams nparams types
      isUnsafe allowPrimitive fuel finalEnv}
    {source : VInductDecl} {input output : VEnv}
    (transaction : EnvironmentInductiveExecution.ExactSemanticTransaction
      execution source input output)
    (pre : TrEnv' safety env.constants env.quotInit input) :
    TrEnv' safety finalEnv.constants finalEnv.quotInit output := by
  rw [execution.quotInit_eq]
  cases transaction with
  | ordinary _ block => exact .inductBlock block pre
  | nested _ restored => exact .inductNested restored pre

/-- Every exact block or nested transaction monotonically extends its input
Theory environment. -/
theorem le
    {env : Environment} {lparams : List Name} {nparams : Nat}
    {types : List InductiveType} {isUnsafe allowPrimitive : Bool}
    {fuel : FuelConfig} {finalEnv : Environment}
    {execution : EnvironmentInductiveExecution env lparams nparams types
      isUnsafe allowPrimitive fuel finalEnv}
    {source : VInductDecl} {input output : VEnv}
    (transaction : EnvironmentInductiveExecution.ExactSemanticTransaction
      execution source input output) :
    input ≤ output := by
  cases transaction with
  | ordinary _ block => exact block.le
  | nested _ restored => exact restored.le

end EnvironmentInductiveExecution.ExactSemanticTransaction

end AddInductive

/-! ## Block-family occurrence transport -/

/-- Kernel-expression support relevant to reduction.  Projection syntax
stores a structure annotation, but `whnf` selects a constructor only from the
major expression, so the annotation is deliberately not classified as a
constant occurrence here.  Binder types and let payloads remain visible
because reduction can reach them after substitution. -/
def _root_.Lean.Expr.ReductionConstFree (name : Name) : Expr → Prop
  | .const constant _ => constant ≠ name
  | .app function argument =>
      function.ReductionConstFree name ∧ argument.ReductionConstFree name
  | .lam _ domain body _ | .forallE _ domain body _ =>
      domain.ReductionConstFree name ∧ body.ReductionConstFree name
  | .letE _ type value body _ =>
      type.ReductionConstFree name ∧ value.ReductionConstFree name ∧
        body.ReductionConstFree name
  | .mdata _ expression | .proj _ _ expression =>
      expression.ReductionConstFree name
  | _ => True

/-- A strictly translated source cannot mention, at any reduction-relevant
position, a constant absent from the Theory environment.  This is a
source-side support fact: unlike target occurrence transport it needs no
uniqueness, typing, primitive, or projection-readiness premise. -/
theorem TrExprS.source_reductionConstFree_of_absent
    {env : VEnv} {Us : List Name} {context : VLCtx}
    {source : Expr} {target : VExpr}
    (run : TrExprS env Us context source target)
    {name : Name} (absent : env.constants name = none) :
    source.ReductionConstFree name := by
  induction source generalizing context target with
  | bvar => trivial
  | fvar => trivial
  | mvar => cases run
  | sort => trivial
  | const constant levels =>
      cases run with
      | const found levelsTr levelsLength =>
          simp only [Lean.Expr.ReductionConstFree]
          intro equality
          subst constant
          rw [absent] at found
          contradiction
  | app function argument functionIH argumentIH =>
      cases run with
      | app functionType argumentType functionTr argumentTr =>
          exact ⟨functionIH functionTr, argumentIH argumentTr⟩
  | lam binder domain body binderInfo domainIH bodyIH =>
      cases run with
      | lam domainType domainTr bodyTr =>
          exact ⟨domainIH domainTr, bodyIH bodyTr⟩
  | forallE binder domain body binderInfo domainIH bodyIH =>
      cases run with
      | forallE domainType bodyType domainTr bodyTr =>
          exact ⟨domainIH domainTr, bodyIH bodyTr⟩
  | letE binder type value body nondep typeIH valueIH bodyIH =>
      cases run with
      | letE valueType typeTr valueTr bodyTr =>
          exact ⟨typeIH typeTr, valueIH valueTr, bodyIH bodyTr⟩
  | lit => trivial
  | mdata data expression expressionIH =>
      cases run with
      | mdata expressionTr => exact expressionIH expressionTr
  | proj structName index major majorIH =>
      cases run with
      | proj majorTr projection => exact majorIH majorTr

/-- A literal accepted by strict translation cannot introduce a constant
which is absent from the translated environment.  `ContainsLits` and the
primitive contract reconstruct the canonical typed Theory literal; ordinary
typing support then rules out the absent name.  This is the local semantic
replacement for the overly strong global literal-name collision audit. -/
theorem VEnv.ContainsLits.trLiteral_hasConst_false_of_absent
    {env : VEnv} {literal : Literal} {name : Name}
    (contains : env.ContainsLits literal)
    (henv : env.WF) (primitives : env.HasPrimitives)
    (absent : env.constants name = none) :
    (VExpr.trLiteral literal).hasConst name = false := by
  have typed : env.HasType 0 [] (VExpr.trLiteral literal)
      (.const literal.typeName []) :=
    (TrExprS.trLiteral (env := env) (Us := []) (Δ := []) henv.ordered
      primitives literal contains).2
  exact typed.hasConst_false_of_absent henv.ordered (by trivial) absent

/-- A constant present after staging only fresh family types was already
present before staging when none of the staged families owns its name. -/
theorem VEnv.contains_of_stageInductiveTypes_of_name_ne :
    ∀ {env blockEnv : VEnv} {types : List VInductiveType} {name : Name},
      env.stageInductiveTypes types = some blockEnv →
      blockEnv.contains name →
      (∀ type ∈ types, type.name ≠ name) →
      env.contains name
  | env, blockEnv, [], name, stage, contains, _ => by
      change some env = some blockEnv at stage
      cases stage
      exact contains
  | env, blockEnv, head :: tail, name, stage, contains, nameNe => by
      change (env.addConst head.name head.toVConstant).bind
        (fun next => next.stageInductiveTypes tail) = some blockEnv at stage
      obtain ⟨next, added, stagedTail⟩ := Option.bind_eq_some_iff.mp stage
      have nextContains := VEnv.contains_of_stageInductiveTypes_of_name_ne
        stagedTail contains (fun type member =>
          nameNe type (List.mem_cons_of_mem head member))
      obtain ⟨constant, found⟩ := nextContains
      have headNe := nameNe head (List.mem_cons_self)
      unfold VEnv.addConst at added
      split at added
      · contradiction
      · simp only [Option.some.injEq] at added
        subst next
        simp only [headNe, if_false] at found
        exact ⟨constant, found⟩

/-- Every value returned by a strict-translation context lookup is free of a
given constant.  Types are deliberately irrelevant: translating a variable
selects the declaration value. -/
def VLCtx.ValuesConstFree (context : VLCtx) (name : Name) : Prop :=
  ∀ key value inferred,
    context.find? key = some (value, inferred) →
      value.hasConst name = false

/-- Extending a lookup-safe context by a declaration whose value is safe
preserves lookup safety.  Recursive lookups are lifted, which does not change
their constant inventory. -/
theorem VLCtx.ValuesConstFree.cons
    (safe : VLCtx.ValuesConstFree context name)
    (headSafe : declaration.value.hasConst name = false) :
    VLCtx.ValuesConstFree
      ((metadata, declaration) :: context : VLCtx) name := by
  intro key value inferred found
  simp only [VLCtx.find?] at found
  split at found
  · have valueEq := congrArg Prod.fst (Option.some.inj found)
    change declaration.value = value at valueEq
    rw [← valueEq]
    exact headSafe
  · rename_i next nextEq
    simp only [Option.bind_eq_bind, Option.bind_eq_some_iff,
      Option.some.injEq, Prod.mk.injEq] at found
    obtain ⟨⟨innerValue, innerType⟩, innerFound,
      valueEq, typeEq⟩ := found
    subst value
    rw [← VExpr.lift'_consN_skipN, VExpr.hasConst_lift']
    exact safe next innerValue innerType innerFound

/-- A context made only of producer free-variable assumptions returns bound
variables from every lookup and is therefore free of every constant. -/
theorem VLCtx.FVarLamOnly.valuesConstFree
    (shape : VLCtx.FVarLamOnly context) (name : Name) :
    VLCtx.ValuesConstFree context name := by
  induction shape with
  | nil => intro key value inferred found; simp [VLCtx.find?] at found
  | cons shape ih =>
      exact VLCtx.ValuesConstFree.cons ih
        (by simp [VLocalDecl.value, VExpr.hasConst])

/-- Every value returned by a context lookup is free of every name in a
block-family inventory. -/
def VLCtx.ValuesAnyConstFree (context : VLCtx)
    (names : List Name) : Prop :=
  ∀ name, name ∈ names → context.ValuesConstFree name

/-- Lookup safety for a whole family inventory survives any declaration whose
translated value is family-free.  In particular, ordinary bound-variable
extensions satisfy this premise. -/
theorem VLCtx.ValuesAnyConstFree.cons
    (safe : VLCtx.ValuesAnyConstFree context names)
    (headSafe : declaration.value.hasAnyConst names = false) :
    VLCtx.ValuesAnyConstFree
      ((metadata, declaration) :: context : VLCtx) names := by
  intro name member
  apply VLCtx.ValuesConstFree.cons (safe name member)
  simp only [VExpr.hasAnyConst, List.any_eq_false] at headSafe
  simpa [Bool.not_eq_true'] using headSafe name member

/-- A producer free-assumption context is lookup-safe for every block-family
inventory. -/
theorem VLCtx.FVarLamOnly.valuesAnyConstFree
    (shape : VLCtx.FVarLamOnly context) (names : List Name) :
    VLCtx.ValuesAnyConstFree context names := by
  intro name _
  exact shape.valuesConstFree name

/-- Strict translation cannot introduce a covered inductive-family name from
an occurrence-free source.  The context premise handles variable resolution;
the literal premise isolates the kernel's deliberate treatment of literals
as atomic syntax.  Binders and lets preserve the invariant internally. -/
theorem TrExprS.hasConst_false_of_hasIndOcc_false
    {env : VEnv} {Us : List Name} {context : VLCtx}
    {source : Expr} {target : VExpr}
    (run : TrExprS env Us context source target)
    (unique : TrExprS.IsUnique source)
    {indConsts : Array Expr} {name : Name}
    (covered : indConsts.any (fun constant =>
      constant.constName! == name) = true)
    (contextSafe : VLCtx.ValuesConstFree context name)
    (literalSafe : ∀ literal,
      (VExpr.trLiteral literal).hasConst name = false)
    (sourceSafe : AddInductive.hasIndOcc indConsts source = false) :
    target.hasConst name = false := by
  induction source generalizing context target with
  | bvar index =>
      cases run with
      | bvar found => exact contextSafe _ _ _ found
  | fvar fv =>
      cases run with
      | fvar found => exact contextSafe _ _ _ found
  | mvar => cases run
  | sort level => cases run; rfl
  | const constant levels =>
      cases run
      simp only [AddInductive.hasIndOcc] at sourceSafe
      simp only [VExpr.hasConst]
      cases equal : (constant == name) with
      | false => rfl
      | true =>
          rw [beq_iff_eq] at equal
          subst constant
          rw [covered] at sourceSafe
          contradiction
  | app function argument functionIH argumentIH =>
      cases run with
      | app functionType argumentType functionTr argumentTr =>
          simp only [AddInductive.hasIndOcc,
            Bool.or_eq_false_iff] at sourceSafe
          simp only [TrExprS.IsUnique] at unique
          simp only [VExpr.hasConst, Bool.or_eq_false_iff]
          exact ⟨functionIH functionTr unique.1 contextSafe sourceSafe.1,
            argumentIH argumentTr unique.2 contextSafe sourceSafe.2⟩
  | lam binder sourceType body binderInfo typeIH bodyIH =>
      cases run with
      | lam targetTypeType typeTr bodyTr =>
          simp only [AddInductive.hasIndOcc,
            Bool.or_eq_false_iff] at sourceSafe
          simp only [TrExprS.IsUnique] at unique
          simp only [VExpr.hasConst, Bool.or_eq_false_iff]
          have typeFree := typeIH typeTr unique.1 contextSafe sourceSafe.1
          refine ⟨typeFree, bodyIH bodyTr unique.2 ?_ sourceSafe.2⟩
          exact VLCtx.ValuesConstFree.cons contextSafe
            (by simp [VLocalDecl.value, VExpr.hasConst])
  | forallE binder sourceType body binderInfo typeIH bodyIH =>
      cases run with
      | forallE targetTypeType targetBodyType typeTr bodyTr =>
          simp only [AddInductive.hasIndOcc,
            Bool.or_eq_false_iff] at sourceSafe
          simp only [TrExprS.IsUnique] at unique
          simp only [VExpr.hasConst, Bool.or_eq_false_iff]
          have typeFree := typeIH typeTr unique.1 contextSafe sourceSafe.1
          refine ⟨typeFree, bodyIH bodyTr unique.2 ?_ sourceSafe.2⟩
          exact VLCtx.ValuesConstFree.cons contextSafe
            (by simp [VLocalDecl.value, VExpr.hasConst])
  | letE binder sourceType value body nondep typeIH valueIH bodyIH =>
      cases run with
      | letE valueType typeTr valueTr bodyTr =>
          simp only [AddInductive.hasIndOcc,
            Bool.or_eq_false_iff] at sourceSafe
          simp only [TrExprS.IsUnique] at unique
          have valueFree :=
            valueIH valueTr unique.1 contextSafe sourceSafe.1.2
          exact bodyIH bodyTr unique.2
            (VLCtx.ValuesConstFree.cons contextSafe
              (by simpa [VLocalDecl.value] using valueFree))
            sourceSafe.2
  | lit literal =>
      cases run with
      | lit contains innerTr =>
          cases innerTr.toConstructor_eq
          exact literalSafe literal
  | mdata data inner innerIH =>
      cases run with
      | mdata innerTr => exact innerIH innerTr unique contextSafe sourceSafe
  | proj => cases unique

/-- Pointwise block-family form of
`TrExprS.hasConst_false_of_hasIndOcc_false`. -/
theorem TrExprS.hasAnyConst_false_of_hasIndOcc_false
    {env : VEnv} {Us : List Name} {context : VLCtx}
    {source : Expr} {target : VExpr}
    (run : TrExprS env Us context source target)
    (unique : TrExprS.IsUnique source)
    {indConsts : Array Expr} {names : List Name}
    (covered : ∀ name, name ∈ names →
      indConsts.any (fun constant =>
        constant.constName! == name) = true)
    (contextSafe : VLCtx.ValuesAnyConstFree context names)
    (literalSafe : ∀ literal name, name ∈ names →
      (VExpr.trLiteral literal).hasConst name = false)
    (sourceSafe : AddInductive.hasIndOcc indConsts source = false) :
    target.hasAnyConst names = false := by
  simp only [VExpr.hasAnyConst, List.any_eq_false]
  intro name member
  simpa [Bool.not_eq_true'] using
    run.hasConst_false_of_hasIndOcc_false unique
      (covered name member) (contextSafe name member)
      (fun literal => literalSafe literal name member) sourceSafe

/-- Projection-aware occurrence transport for one block-family name.

Unlike `hasConst_false_of_hasIndOcc_false`, this theorem does not claim that
strict translations of projection syntax are globally unique.  In the
projection branch it follows the exact `ResolvedTrProj` witness carried by
`run`: its result is the application of a projector already typed in `env`.
Freshness of the family name therefore makes both that projector and the
recursively translated major family-free. -/
theorem TrExprS.hasConst_false_of_hasIndOcc_false_resolved
    {env : VEnv} {Us : List Name} {context : VLCtx}
    {source : Expr} {target : VExpr}
    (run : TrExprS env Us context source target)
    (henv : VEnv.WF env)
    (contextWF : VLCtx.WF env Us.length context)
    {indConsts : Array Expr} {name : Name}
    (covered : indConsts.any (fun constant =>
      constant.constName! == name) = true)
    (projectionSafe : ResolvedProjectionConstSafe env name)
    (contextSafe : VLCtx.ValuesConstFree context name)
    (literalSafe : ∀ literal, env.ContainsLits literal →
      (VExpr.trLiteral literal).hasConst name = false)
    (sourceSafe : AddInductive.hasIndOcc indConsts source = false) :
    target.hasConst name = false := by
  induction source generalizing context target with
  | bvar index =>
      cases run with
      | bvar found => exact contextSafe _ _ _ found
  | fvar fv =>
      cases run with
      | fvar found => exact contextSafe _ _ _ found
  | mvar => cases run
  | sort level => cases run; rfl
  | const constant levels =>
      cases run
      simp only [AddInductive.hasIndOcc] at sourceSafe
      simp only [VExpr.hasConst]
      cases equal : (constant == name) with
      | false => rfl
      | true =>
          rw [beq_iff_eq] at equal
          subst constant
          rw [covered] at sourceSafe
          contradiction
  | app function argument functionIH argumentIH =>
      cases run with
      | app functionType argumentType functionTr argumentTr =>
          simp only [AddInductive.hasIndOcc,
            Bool.or_eq_false_iff] at sourceSafe
          simp only [VExpr.hasConst, Bool.or_eq_false_iff]
          exact ⟨functionIH functionTr contextWF contextSafe sourceSafe.1,
            argumentIH argumentTr contextWF contextSafe sourceSafe.2⟩
  | lam binder sourceType body binderInfo typeIH bodyIH =>
      cases run with
      | lam targetTypeType typeTr bodyTr =>
          simp only [AddInductive.hasIndOcc,
            Bool.or_eq_false_iff] at sourceSafe
          simp only [VExpr.hasConst, Bool.or_eq_false_iff]
          have typeFree := typeIH typeTr contextWF contextSafe
            sourceSafe.1
          refine ⟨typeFree, bodyIH bodyTr ?_ ?_ sourceSafe.2⟩
          · exact ⟨contextWF, nofun, targetTypeType⟩
          · exact VLCtx.ValuesConstFree.cons contextSafe
              (by simp [VLocalDecl.value, VExpr.hasConst])
  | forallE binder sourceType body binderInfo typeIH bodyIH =>
      cases run with
      | forallE targetTypeType targetBodyType typeTr bodyTr =>
          simp only [AddInductive.hasIndOcc,
            Bool.or_eq_false_iff] at sourceSafe
          simp only [VExpr.hasConst, Bool.or_eq_false_iff]
          have typeFree := typeIH typeTr contextWF contextSafe
            sourceSafe.1
          refine ⟨typeFree, bodyIH bodyTr ?_ ?_ sourceSafe.2⟩
          · exact ⟨contextWF, nofun, targetTypeType⟩
          · exact VLCtx.ValuesConstFree.cons contextSafe
              (by simp [VLocalDecl.value, VExpr.hasConst])
  | letE binder sourceType value body nondep typeIH valueIH bodyIH =>
      cases run with
      | letE valueType typeTr valueTr bodyTr =>
          simp only [AddInductive.hasIndOcc,
            Bool.or_eq_false_iff] at sourceSafe
          have valueFree := valueIH valueTr contextWF contextSafe
            sourceSafe.1.2
          refine bodyIH bodyTr ?_ ?_ sourceSafe.2
          · exact ⟨contextWF, nofun, valueType⟩
          · exact VLCtx.ValuesConstFree.cons contextSafe
              (by simpa [VLocalDecl.value] using valueFree)
  | lit literal =>
      cases run with
      | lit contains innerTr =>
          cases innerTr.toConstructor_eq
          exact literalSafe literal contains
  | mdata data inner innerIH =>
      cases run with
      | mdata innerTr =>
          exact innerIH innerTr contextWF contextSafe sourceSafe
  | proj structName index major majorIH =>
      cases run with
      | proj majorTr projection =>
          simp only [AddInductive.hasIndOcc] at sourceSafe
          have majorFree := majorIH majorTr contextWF contextSafe
            sourceSafe
          exact projectionSafe contextWF.toCtx projection majorFree

/-- Pointwise projection-aware occurrence transport for a complete family
name inventory. -/
theorem TrExprS.hasAnyConst_false_of_hasIndOcc_false_resolved
    {env : VEnv} {Us : List Name} {context : VLCtx}
    {source : Expr} {target : VExpr}
    (run : TrExprS env Us context source target)
    (henv : VEnv.WF env)
    (contextWF : VLCtx.WF env Us.length context)
    {indConsts : Array Expr} {names : List Name}
    (covered : ∀ name, name ∈ names →
      indConsts.any (fun constant =>
        constant.constName! == name) = true)
    (projectionSafe : ResolvedProjectionNamesSafe env names)
    (contextSafe : VLCtx.ValuesAnyConstFree context names)
    (literalSafe : ∀ literal, env.ContainsLits literal →
      ∀ name, name ∈ names →
      (VExpr.trLiteral literal).hasConst name = false)
    (sourceSafe : AddInductive.hasIndOcc indConsts source = false) :
    target.hasAnyConst names = false := by
  simp only [VExpr.hasAnyConst, List.any_eq_false]
  intro name member
  simpa [Bool.not_eq_true'] using
    run.hasConst_false_of_hasIndOcc_false_resolved henv contextWF
      (covered name member) (projectionSafe name member)
      (contextSafe name member)
      (fun literal contains => literalSafe literal contains name member)
      sourceSafe

/-- A pointwise strict translation carries a source list certified free by
the kernel occurrence test to a Theory list free of every block-family name. -/
theorem List.Forall₂.translated_hasAnyConst_false
    {env : VEnv} {Us : List Name} {context : VLCtx}
    {sources : List Expr} {targets : List VExpr}
    (run : List.Forall₂ (TrExprS env Us context) sources targets)
    {indConsts : Array Expr} {names : List Name}
    (unique : ∀ source ∈ sources, TrExprS.IsUnique source)
    (sourceSafe : ∀ source ∈ sources,
      AddInductive.hasIndOcc indConsts source = false)
    (covered : ∀ name, name ∈ names →
      indConsts.any (fun constant =>
        constant.constName! == name) = true)
    (contextSafe : VLCtx.ValuesAnyConstFree context names)
    (literalSafe : ∀ literal name, name ∈ names →
      (VExpr.trLiteral literal).hasConst name = false) :
    targets.all (fun target => !target.hasAnyConst names) = true := by
  induction run with
  | nil => rfl
  | @cons source target sources targets head tail ih =>
      simp only [List.all_cons, Bool.and_eq_true]
      have headSafe := head.hasAnyConst_false_of_hasIndOcc_false
        (unique source (by simp)) covered contextSafe literalSafe
        (sourceSafe source (by simp))
      refine ⟨by simp [headSafe], ?_⟩
      exact ih
        (fun candidate member => unique candidate (by simp [member]))
        (fun candidate member => sourceSafe candidate (by simp [member]))

/-- Projection-aware list form of occurrence transport. -/
theorem List.Forall₂.translated_hasAnyConst_false_resolved
    {env : VEnv} {Us : List Name} {context : VLCtx}
    {sources : List Expr} {targets : List VExpr}
    (run : List.Forall₂ (TrExprS env Us context) sources targets)
    (henv : VEnv.WF env)
    (contextWF : VLCtx.WF env Us.length context)
    {indConsts : Array Expr} {names : List Name}
    (sourceSafe : ∀ source ∈ sources,
      AddInductive.hasIndOcc indConsts source = false)
    (covered : ∀ name, name ∈ names →
      indConsts.any (fun constant =>
        constant.constName! == name) = true)
    (projectionSafe : ResolvedProjectionNamesSafe env names)
    (contextSafe : VLCtx.ValuesAnyConstFree context names)
    (literalSafe : ∀ literal, env.ContainsLits literal →
      ∀ name, name ∈ names →
      (VExpr.trLiteral literal).hasConst name = false) :
    targets.all (fun target => !target.hasAnyConst names) = true := by
  induction run with
  | nil => rfl
  | @cons source target sources targets head tail ih =>
      simp only [List.all_cons, Bool.and_eq_true]
      have headSafe := head.hasAnyConst_false_of_hasIndOcc_false_resolved
        henv contextWF covered projectionSafe contextSafe literalSafe
        (sourceSafe source (by simp))
      refine ⟨by simp [headSafe], ?_⟩
      exact ih
        (fun candidate member => sourceSafe candidate (by simp [member]))

namespace VInductDecl

/-- Distinct positions in a duplicate-free source inventory contain distinct
values.  The optional-lookup form composes directly with dependent family
header inventories. -/
private theorem getElem?_ne_of_nodup
    {values : List α} {i j : Nat} {left right : α}
    (nodup : values.Nodup) (before : i < j)
    (leftAt : values[i]? = some left)
    (rightAt : values[j]? = some right) :
    left ≠ right := by
  induction values generalizing i j left right with
  | nil => simp at leftAt
  | cons head tail ih =>
      simp only [List.nodup_cons] at nodup
      cases i with
      | zero =>
          cases j with
          | zero => omega
          | succ j =>
              simp only [List.getElem?_cons_zero, Option.some.injEq] at leftAt
              subst left
              simp only [List.getElem?_cons_succ] at rightAt
              intro equal
              subst right
              exact nodup.1 (List.mem_iff_getElem?.2 ⟨j, rightAt⟩)
      | succ i =>
          cases j with
          | zero => omega
          | succ j =>
              simp only [List.getElem?_cons_succ] at leftAt rightAt
              exact ih nodup.2 (by omega) leftAt rightAt

/-- Duplicate-free family names make the executable header search
unambiguous: an earlier header cannot have the selected target's name. -/
theorem familyHeaders_name_ne_of_lt
    {types : List VInductiveType} {np i j : Nat}
    {left right : FamilyHeader}
    (nodup : (familyNames types).Nodup)
    (before : i < j)
    (leftAt : (familyHeaders np types)[i]? = some left)
    (rightAt : (familyHeaders np types)[j]? = some right) :
    left.name ≠ right.name := by
  have leftNameAt : (familyNames types)[i]? = some left.name := by
    have mapped := congrArg (Option.map FamilyHeader.name) leftAt
    simpa [familyHeaders, familyNames, List.getElem?_map,
      Function.comp_def] using mapped
  have rightNameAt : (familyNames types)[j]? = some right.name := by
    have mapped := congrArg (Option.map FamilyHeader.name) rightAt
    simpa [familyHeaders, familyNames, List.getElem?_map,
      Function.comp_def] using mapped
  exact getElem?_ne_of_nodup nodup before leftNameAt rightNameAt

/-- A positional family-header lookup projects to membership in the source
family-name inventory at the same position. -/
theorem familyHeaders_name_mem
    {types : List VInductiveType} {np i : Nat} {header : FamilyHeader}
    (headerAt : (familyHeaders np types)[i]? = some header) :
    header.name ∈ familyNames types := by
  apply List.mem_iff_getElem?.2
  refine ⟨i, ?_⟩
  have mapped := congrArg (Option.map FamilyHeader.name) headerAt
  simpa [familyHeaders, familyNames, List.getElem?_map,
    Function.comp_def] using mapped

/-- Duplicate-free family names make the positional family-header map
injective. -/
theorem familyHeaders_index_eq_of_name_eq
    {types : List VInductiveType} {np i j : Nat}
    {left right : FamilyHeader}
    (nodup : (familyNames types).Nodup)
    (leftAt : (familyHeaders np types)[i]? = some left)
    (rightAt : (familyHeaders np types)[j]? = some right)
    (namesEq : left.name = right.name) :
    i = j := by
  by_contra indicesNe
  rcases Nat.lt_or_gt_of_ne indicesNe with before | before
  · exact (familyHeaders_name_ne_of_lt nodup before leftAt rightAt
      namesEq).elim
  · exact (familyHeaders_name_ne_of_lt nodup before rightAt leftAt
      namesEq.symm).elim

/-- An exact positional family-constant inventory covers every family name
for the occurrence test used by constructor validation. -/
theorem indConsts_covers_names
    {stats : AddInductive.InductiveStats} {names : List Name}
    (inventory : ∀ (i : Nat) (name : Name),
      names[i]? = some name →
        stats.indConsts[i]? = some (.const name stats.levels)) :
    ∀ name, name ∈ names →
      stats.indConsts.any (fun constant =>
        constant.constName! == name) = true := by
  intro name member
  obtain ⟨i, nameAt⟩ := List.mem_iff_getElem?.1 member
  have constantAt := inventory i name nameAt
  have upper : i < stats.indConsts.size :=
    (Array.getElem?_eq_some_iff.1 constantAt).1
  rw [Array.any_eq_true]
  refine ⟨i, upper, ?_⟩
  rw [Array.getElem?_eq_getElem upper] at constantAt
  injection constantAt with constantAt
  rw [constantAt]
  simp [Expr.constName!]

private theorem array_getBang_eq_of_getElem?_eq_some
    [Inhabited α] {values : Array α} {index : Nat} {value : α}
    (found : values[index]? = some value) :
    values[index]! = value := by
  have bound := (Array.getElem?_eq_some_iff.1 found).1
  rw [Array.getElem?_eq_getElem bound] at found
  injection found with equality
  simpa [getElem!_def, bound] using equality

/-- The checked dependent family spine and the validator's canonical count
inventory agree at every exact source position. -/
theorem CanonicalFamilyIndexCountList.checkedIndices_length
    {stats : AddInductive.InductiveStats} {nparams ordinal : Nat}
    {types : List VInductiveType} {source : VInductDecl}
    {params : List VExpr}
    (counts : CanonicalFamilyIndexCountList stats nparams ordinal types)
    (checked : CheckedFamilies source params ordinal types)
    (sourceNparams : source.nparams = nparams)
    {offset : Nat} {indices : List VExpr}
    (found : checked.indices[offset]? = some indices) :
    indices.length = stats.nindices[ordinal + offset]! := by
  induction counts generalizing offset indices with
  | nil selectedOrdinal =>
      cases checked
      simp [CheckedFamilies.indices] at found
  | @cons selectedOrdinal family families head tail ih =>
      cases checked with
      | cons checkedHead checkedTail =>
          cases offset with
          | zero =>
              simp only [CheckedFamilies.indices, List.getElem?_cons_zero,
                Option.some.injEq] at found
              subst indices
              calc
                checkedHead.indices.length =
                    (ctorFields
                      (VExpr.dropN source.nparams family.type)).length :=
                  congrArg List.length checkedHead.indices_eq
                _ = (ctorFields
                      (VExpr.dropN nparams family.type)).length := by
                  rw [sourceNparams]
                _ = stats.nindices[selectedOrdinal]! :=
                  (array_getBang_eq_of_getElem?_eq_some head).symm
                _ = stats.nindices[selectedOrdinal + 0]! := by simp
          | succ offset =>
              simp only [CheckedFamilies.indices,
                List.getElem?_cons_succ] at found
              simpa only [Nat.add_assoc, Nat.add_left_comm,
                Nat.add_comm] using ih checkedTail found

/-- The dependent checked-family index projection has exactly the length of
the source type list indexing it. -/
theorem CheckedFamilies.indices_length
    {source : VInductDecl} {params : List VExpr}
    {ordinal : Nat} {types : List VInductiveType}
    (checked : CheckedFamilies source params ordinal types) :
    checked.indices.length = types.length := by
  induction checked with
  | nil => rfl
  | cons head tail ih =>
      simp only [CheckedFamilies.indices, List.length_cons,
        Nat.succ.injEq]
      exact ih

/-- Canonical index counts and an exact raw family-constant inventory produce
the complete positional block data consumed by the constructor translation
bridge. -/
theorem CanonicalFamilyIndexCountList.familyData
    {stats : AddInductive.InductiveStats} {nparams : Nat}
    {rawTypes canonicalTypes : List VInductiveType}
    (counts : CanonicalFamilyIndexCountList stats nparams 0 canonicalTypes)
    (length : canonicalTypes.length = stats.indConsts.size)
    (headersEq : familyHeaders nparams rawTypes =
      familyHeaders nparams canonicalTypes)
    (constants : ∀ (i : Nat) (family : VInductiveType),
      rawTypes[i]? = some family →
        stats.indConsts[i]? =
          some (.const family.name stats.levels)) :
    ∀ familyIdx, familyIdx < stats.indConsts.size →
      ∃ header,
        (familyHeaders nparams rawTypes)[familyIdx]? = some header ∧
        stats.nindices[familyIdx]! = header.indices ∧
        stats.indConsts[familyIdx]! =
          .const header.name stats.levels := by
  intro familyIdx familyIdxLt
  have rawHeaderBound : familyIdx < (familyHeaders nparams rawTypes).length := by
    rw [headersEq]
    simp only [familyHeaders, List.length_map, length]
    exact familyIdxLt
  let header := (familyHeaders nparams rawTypes)[familyIdx]
  have headerAt : (familyHeaders nparams rawTypes)[familyIdx]? =
      some header := by
    simp only [header, List.getElem?_eq_getElem rawHeaderBound]
  have canonicalHeaderAt :
      (familyHeaders nparams canonicalTypes)[familyIdx]? = some header := by
    rw [← headersEq]
    exact headerAt
  have selectedAt := headerAt
  simp only [familyHeaders, List.getElem?_map] at headerAt canonicalHeaderAt
  cases rawAt : rawTypes[familyIdx]? with
  | none => simp [rawAt] at headerAt
  | some rawFamily =>
      simp only [rawAt, Option.map_some, Option.some.injEq] at headerAt
      cases canonicalAt : canonicalTypes[familyIdx]? with
      | none => simp [canonicalAt] at canonicalHeaderAt
      | some canonicalFamily =>
          simp only [canonicalAt, Option.map_some, Option.some.injEq]
            at canonicalHeaderAt
          have countAt := counts.getElem? canonicalAt
          simp only [Nat.zero_add] at countAt
          have constantAt := constants familyIdx rawFamily rawAt
          have canonicalIndices :=
            congrArg FamilyHeader.indices canonicalHeaderAt
          have rawName := congrArg FamilyHeader.name headerAt
          exact ⟨header, selectedAt,
            (array_getBang_eq_of_getElem?_eq_some countAt).trans
              canonicalIndices,
            (array_getBang_eq_of_getElem?_eq_some constantAt).trans
              (congrArg (fun name => Expr.const name stats.levels) rawName)⟩

/-- The same positional raw-family inventory covers every source family name
for the block occurrence predicate. -/
theorem indConsts_covers_familyNames
    {stats : AddInductive.InductiveStats}
    {rawTypes : List VInductiveType}
    (constants : ∀ (i : Nat) (family : VInductiveType),
      rawTypes[i]? = some family →
        stats.indConsts[i]? =
          some (.const family.name stats.levels)) :
    ∀ name, name ∈ familyNames rawTypes →
      stats.indConsts.any (fun constant =>
        constant.constName! == name) = true := by
  apply indConsts_covers_names
  intro i name nameAt
  simp only [familyNames, List.getElem?_map] at nameAt
  cases rawAt : rawTypes[i]? with
  | none => simp [rawAt] at nameAt
  | some family =>
      simp only [rawAt, Option.map_some, Option.some.injEq] at nameAt
      subst name
      exact constants i family rawAt

/-- The family validator's exact constant array can be reindexed from kernel
sources onto the raw Theory family list owned by the same semantic candidate
spine.  Only the already-proved source-order name equality is used. -/
theorem CandidateBlockFamilySemanticListRun.rawFamilyConstantInventory
    {env blockEnv : VEnv} {Us : List Name}
    {nparams : Nat} {kernelSources : List InductiveType}
    {candidates : AddInductive.CandidateList AddInductive.CandidateFamily
      kernelSources}
    {raws : List VInductiveType}
    (semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws)
    {context : AddInductive.Context}
    {result : AddInductive.FamilyValidationBlockResult}
    (nonempty : kernelSources.isEmpty = false)
    (run : AddInductive.observeFamilyValidationBlock nparams kernelSources
      context = .ok result) :
    ∀ (i : Nat) (family : VInductiveType),
      raws[i]? = some family →
        result.stats.indConsts[i]? =
          some (.const family.name result.stats.levels) := by
  intro i family familyAt
  have nameLists := semantics.rawHeaderNames.1
  have lengthEq : raws.length = kernelSources.length := by
    have mappedLength := congrArg List.length nameLists
    simpa using mappedLength
  have familyLt : i < raws.length :=
    (List.getElem?_eq_some_iff.1 familyAt).1
  have sourceLt : i < kernelSources.length := by omega
  let kernelSource := kernelSources[i]
  have sourceAt : kernelSources[i]? = some kernelSource := by
    simp only [kernelSource, List.getElem?_eq_getElem sourceLt]
  have familyNameAt : (raws.map (fun family => family.name))[i]? =
      some family.name := by
    simp only [List.getElem?_map, familyAt, Option.map_some]
  have sourceNameAt :
      (kernelSources.map (fun source => source.name))[i]? =
        some family.name := by
    rw [← nameLists]
    exact familyNameAt
  simp only [List.getElem?_map, sourceAt, Option.map_some,
    Option.some.injEq] at sourceNameAt
  have constantAt := result.indConsts_getElem?_of_run nonempty run sourceLt
  have kernelGetBang : kernelSources[i]! = kernelSource := by
    simp [kernelSource, sourceLt]
  rw [kernelGetBang, sourceNameAt] at constantAt
  exact constantAt

/-- Recognize the exact Theory block target translated from one accepted
kernel family application.  This is the central D2-to-Stage-3 bridge: the
validator supplies the family ordinal, parameter/index checks, and block-name
inventory; strict translation supplies the literal Theory application. -/
theorem blockTarget?_of_isValidIndAppIdx_translation
    {env : VEnv} {Us : List Name} {context : VLCtx}
    {stats : AddInductive.InductiveStats} {source : Expr}
    {target : VExpr} {familyIdx U np j : Nat}
    {headers : List FamilyHeader} {names : List Name}
    {header : FamilyHeader}
    (run : TrExprS env Us context source target)
    (unique : TrExprS.IsUnique source)
    (valid : AddInductive.isValidIndAppIdx stats source familyIdx = true)
    (paramsSize : stats.params.size = np)
    (headerAt : headers[familyIdx]? = some header)
    (indicesCount : stats.nindices[familyIdx]! = header.indices)
    (familyConst : stats.indConsts[familyIdx]! =
      .const header.name stats.levels)
    (levelsTr : stats.levels.mapM (VLevel.ofLevel Us) =
      some (VLevel.params U))
    (parameterTranslations : List.Forall₂ (TrExprS env Us context)
      stats.params.toList (VExpr.bvarRevRange j np))
    (before : ∀ k, k < familyIdx → ∀ earlier,
      headers[k]? = some earlier → earlier.name ≠ header.name)
    (covered : ∀ name, name ∈ names →
      stats.indConsts.any (fun constant =>
        constant.constName! == name) = true)
    (contextSafe : VLCtx.ValuesAnyConstFree context names)
    (literalSafe : ∀ literal name, name ∈ names →
      (VExpr.trLiteral literal).hasConst name = false) :
    blockTarget? U np j headers names target =
      some (familyIdx, (target.appArgs []).drop np) := by
  obtain ⟨targetHead, argumentLength, parameterPrefix, indexTr⟩ :=
    AddInductive.isValidIndAppIdx_translation_components run unique valid
      paramsSize indicesCount familyConst levelsTr parameterTranslations
  have indexUnique : ∀ argument ∈ source.getAppArgsList.drop np,
      TrExprS.IsUnique argument := by
    intro argument member
    exact ConstructorValidation.TrExprS.IsUnique.getAppArgsList
      unique argument (List.mem_of_mem_drop member)
  have sourceIndexSafe : ∀ argument ∈
      source.getAppArgsList.drop np,
      AddInductive.hasIndOcc stats.indConsts argument = false := by
    simpa only [paramsSize] using
      AddInductive.isValidIndAppIdx_indexArgs_hasIndOcc_false valid
  have translatedIndexSafe :=
    Lean4Lean.List.Forall₂.translated_hasAnyConst_false indexTr
      indexUnique sourceIndexSafe covered contextSafe literalSafe
  exact blockTarget?_eq_some_of_getElem? headerAt before targetHead
    argumentLength parameterPrefix rfl translatedIndexSafe

/-- Projection-aware target recognition for an accepted family application.
Shared parameters are exact because they are validator-owned free variables;
projection-bearing indices are shown family-free through their retained
resolved projector programs and freshness in the pre-family environment. -/
theorem blockTarget?_of_isValidIndAppIdx_translation_resolved
    {env : VEnv} {Us : List Name} {context : VLCtx}
    {stats : AddInductive.InductiveStats} {source : Expr}
    {target : VExpr} {familyIdx U np j : Nat}
    {headers : List FamilyHeader} {names : List Name}
    {header : FamilyHeader}
    (run : TrExprS env Us context source target)
    (henv : VEnv.WF env)
    (contextWF : VLCtx.WF env Us.length context)
    (valid : AddInductive.isValidIndAppIdx stats source familyIdx = true)
    (paramsSize : stats.params.size = np)
    (headerAt : headers[familyIdx]? = some header)
    (indicesCount : stats.nindices[familyIdx]! = header.indices)
    (familyConst : stats.indConsts[familyIdx]! =
      .const header.name stats.levels)
    (levelsTr : stats.levels.mapM (VLevel.ofLevel Us) =
      some (VLevel.params U))
    (parameterTranslations : List.Forall₂ (TrExprS env Us context)
      stats.params.toList (VExpr.bvarRevRange j np))
    (parametersFVar : ∀ parameter ∈ stats.params.toList,
      ∃ fv, parameter = .fvar fv)
    (before : ∀ k, k < familyIdx → ∀ earlier,
      headers[k]? = some earlier → earlier.name ≠ header.name)
    (covered : ∀ name, name ∈ names →
      stats.indConsts.any (fun constant =>
        constant.constName! == name) = true)
    (projectionSafe : ResolvedProjectionNamesSafe env names)
    (contextSafe : VLCtx.ValuesAnyConstFree context names)
    (literalSafe : ∀ literal, env.ContainsLits literal →
      ∀ name, name ∈ names →
      (VExpr.trLiteral literal).hasConst name = false) :
    blockTarget? U np j headers names target =
      some (familyIdx, (target.appArgs []).drop np) := by
  obtain ⟨targetHead, argumentLength, parameterPrefix, indexTr⟩ :=
    AddInductive.isValidIndAppIdx_translation_components_resolved run valid
      paramsSize indicesCount familyConst levelsTr parameterTranslations
      parametersFVar
  have sourceIndexSafe : ∀ argument ∈
      source.getAppArgsList.drop np,
      AddInductive.hasIndOcc stats.indConsts argument = false := by
    simpa only [paramsSize] using
      AddInductive.isValidIndAppIdx_indexArgs_hasIndOcc_false valid
  have translatedIndexSafe :=
    Lean4Lean.List.Forall₂.translated_hasAnyConst_false_resolved indexTr
      henv contextWF sourceIndexSafe covered projectionSafe contextSafe
      literalSafe
  exact blockTarget?_eq_some_of_getElem? headerAt before targetHead
    argumentLength parameterPrefix rfl translatedIndexSafe

end VInductDecl

/-- Pointwise strict translations of free variables survive one Theory
bound-variable extension, with their targets lifted by one. -/
private theorem forall₂_tr_under_binder
    {env : VEnv} {Us : List Name} {context : VLCtx}
    {sources : List Expr} {targets : List VExpr} {domain : VExpr}
    (henv : VEnv.Ordered env)
    (allFVars : ∀ source ∈ sources, ∃ fv, source = .fvar fv)
    (run : List.Forall₂ (TrExprS env Us context) sources targets) :
    List.Forall₂
      (TrExprS env Us ((none, .vlam domain) :: context)) sources
      (targets.map fun target => target.liftN 1 0) := by
  induction run with
  | nil => exact .nil
  | @cons source target sources targets head tail ih =>
      obtain ⟨fv, rfl⟩ := allFVars source (by simp)
      exact .cons
        (by simpa [Expr.liftLooseBVars', VLocalDecl.depth] using
          head.weakBV henv (VLCtx.BVLift.skip (.vlam domain) .refl))
        (ih (fun candidate member => allFVars candidate (by simp [member])))

/-- The canonical shared-parameter range advances by one below a new Theory
binder. -/
private theorem forall₂_parameterTranslations_under_binder
    {env : VEnv} {Us : List Name} {context : VLCtx}
    {parameters : List Expr} {j np : Nat} {domain : VExpr}
    (henv : VEnv.Ordered env)
    (allFVars : ∀ source ∈ parameters, ∃ fv, source = .fvar fv)
    (run : List.Forall₂ (TrExprS env Us context) parameters
      (VExpr.bvarRevRange j np)) :
    List.Forall₂
      (TrExprS env Us ((none, .vlam domain) :: context)) parameters
      (VExpr.bvarRevRange (j + 1) np) := by
  have lifted := forall₂_tr_under_binder (domain := domain) henv allFVars run
  simpa only [VExpr.bvarRevRange_liftN_low, Nat.add_comm] using lifted

namespace AddInductive.ConstructorBlockRecursiveViewTrace

/-- A successful normalized recursive-field audit plus strict translation
reconstructs a family-free Theory Pi telescope ending in an exact recognized
mutual target. -/
theorem translated_shape
    {env : VEnv} {Us : List Name} {context : VLCtx}
    {stats : AddInductive.InductiveStats} {source : Expr} {target : VExpr}
    (trace : AddInductive.ConstructorBlockRecursiveViewTrace stats source)
    (run : TrExprS env Us context source target)
    (unique : TrExprS.IsUnique source)
    {U np j : Nat} {headers : List VInductDecl.FamilyHeader}
    {names : List Name}
    (henv : VEnv.Ordered env)
    (paramsSize : stats.params.size = np)
    (familyData : ∀ familyIdx, familyIdx < stats.indConsts.size →
      ∃ header,
        headers[familyIdx]? = some header ∧
        stats.nindices[familyIdx]! = header.indices ∧
        stats.indConsts[familyIdx]! =
          .const header.name stats.levels)
    (levelsTr : stats.levels.mapM (VLevel.ofLevel Us) =
      some (VLevel.params U))
    (parameterTranslations : List.Forall₂ (TrExprS env Us context)
      stats.params.toList (VExpr.bvarRevRange j np))
    (parametersFVar : ∀ source ∈ stats.params.toList,
      ∃ fv, source = .fvar fv)
    (before : ∀ (familyIdx : Nat) (header : VInductDecl.FamilyHeader),
      headers[familyIdx]? = some header →
      ∀ (k : Nat), k < familyIdx →
        ∀ (earlier : VInductDecl.FamilyHeader),
        headers[k]? = some earlier → earlier.name ≠ header.name)
    (covered : ∀ name, name ∈ names →
      stats.indConsts.any (fun constant =>
        constant.constName! == name) = true)
    (contextSafe : VLCtx.ValuesAnyConstFree context names)
    (literalSafe : ∀ literal name, name ∈ names →
      (VExpr.trLiteral literal).hasConst name = false) :
    ∃ binders terminal targetIdx indices,
      target = VExpr.forallN binders terminal ∧
      (∀ binder ∈ binders, binder.hasAnyConst names = false) ∧
      (∀ domain body, terminal ≠ .forallE domain body) ∧
      VInductDecl.blockTarget? U np (j + binders.length)
        headers names terminal = some (targetIdx, indices) := by
  induction trace generalizing context target j with
  | @forallE name domain body binderInfo domainFree tail ih =>
      cases run with
      | forallE targetTypeType targetBodyType typeTr bodyTr =>
          rename_i targetDomain targetBody
          have targetDomainFree :=
            typeTr.hasAnyConst_false_of_hasIndOcc_false unique.1 covered
              contextSafe literalSafe domainFree
          have nextParameterTranslations :=
            forall₂_parameterTranslations_under_binder
              (domain := targetDomain) henv parametersFVar
              parameterTranslations
          have nextContextSafe : VLCtx.ValuesAnyConstFree
              ((none, .vlam targetDomain) :: context) names :=
            contextSafe.cons (by
              simp [VLocalDecl.value, VExpr.hasAnyConst, VExpr.hasConst])
          obtain ⟨binders, terminal, targetIdx, indices, targetEq,
              bindersFree, terminalNotForall, targetFound⟩ :=
            ih bodyTr unique.2 (j := j + 1) nextParameterTranslations
              nextContextSafe
          refine ⟨targetDomain :: binders, terminal, targetIdx, indices,
            ?_, ?_, terminalNotForall, ?_⟩
          · simp only [VExpr.forallN, VExpr.forallE.injEq, true_and]
            exact targetEq
          · intro binder member
            simp only [List.mem_cons] at member
            rcases member with rfl | member
            · exact targetDomainFree
            · exact bindersFree binder member
          · simpa only [List.length_cons, Nat.add_assoc,
              Nat.add_left_comm, Nat.add_comm] using targetFound
  | @target source targetIdx terminal valid =>
      have validIdx := AddInductive.isValidIndApp?_valid valid
      have targetLt := AddInductive.isValidIndApp?_lt valid
      obtain ⟨header, headerAt, indicesCount, familyConst⟩ :=
        familyData targetIdx targetLt
      have targetFound :=
        VInductDecl.blockTarget?_of_isValidIndAppIdx_translation
          run unique validIdx paramsSize headerAt indicesCount familyConst
          levelsTr parameterTranslations (before targetIdx header headerAt)
          covered contextSafe literalSafe
      have targetNotForall : ∀ domain body,
          target ≠ .forallE domain body := by
        obtain ⟨targetHeader, targetHeaderAt, targetShape⟩ :=
          VInductDecl.blockTarget?_eq_some targetFound
        intro domain body equality
        rw [equality] at targetShape
        have headEq := congrArg VExpr.appHead targetShape
        simp only [VExpr.appHead, VExpr.appHead_appN] at headEq
        exact VExpr.noConfusion headEq
      exact ⟨[], target, targetIdx, (target.appArgs []).drop np,
        rfl, by simp, targetNotForall, by simpa using targetFound⟩

/-- Strengthened recursive-field reconstruction retaining the exact target
ordinal stored by the executable structural trace. -/
theorem translated_shape_exactTarget
    {env : VEnv} {Us : List Name} {context : VLCtx}
    {stats : AddInductive.InductiveStats} {source : Expr} {target : VExpr}
    (trace : AddInductive.ConstructorBlockRecursiveViewTrace stats source)
    (run : TrExprS env Us context source target)
    (unique : TrExprS.IsUnique source)
    {U np j : Nat} {headers : List VInductDecl.FamilyHeader}
    {names : List Name}
    (henv : VEnv.Ordered env)
    (paramsSize : stats.params.size = np)
    (familyData : ∀ familyIdx, familyIdx < stats.indConsts.size →
      ∃ header,
        headers[familyIdx]? = some header ∧
        stats.nindices[familyIdx]! = header.indices ∧
        stats.indConsts[familyIdx]! =
          .const header.name stats.levels)
    (levelsTr : stats.levels.mapM (VLevel.ofLevel Us) =
      some (VLevel.params U))
    (parameterTranslations : List.Forall₂ (TrExprS env Us context)
      stats.params.toList (VExpr.bvarRevRange j np))
    (parametersFVar : ∀ source ∈ stats.params.toList,
      ∃ fv, source = .fvar fv)
    (before : ∀ (familyIdx : Nat) (header : VInductDecl.FamilyHeader),
      headers[familyIdx]? = some header →
      ∀ (k : Nat), k < familyIdx →
        ∀ (earlier : VInductDecl.FamilyHeader),
        headers[k]? = some earlier → earlier.name ≠ header.name)
    (covered : ∀ name, name ∈ names →
      stats.indConsts.any (fun constant =>
        constant.constName! == name) = true)
    (contextSafe : VLCtx.ValuesAnyConstFree context names)
    (literalSafe : ∀ literal name, name ∈ names →
