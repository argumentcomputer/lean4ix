#print axioms ProducedBlockRecursorShapeCandidate.semanticCommonResultLevel

/-- The exact Theory universe translated from the producer's computed common
kernel result level.  Existence is supplied by the retained first-family
semantic run, so no caller chooses this value. -/
noncomputable def ProducedBlockRecursorShapeCandidate.canonicalResultLevel
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    {env blockEnv : VEnv} {Us : List Name}
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source)
    (context_lctx_eq : context.lctx = {}) : VLevel :=
  Classical.choose
    (produced.semanticCommonResultLevel semantic context_lctx_eq)

/-- The canonical common result level is exactly the translation of the
producer's computed kernel level. -/
theorem ProducedBlockRecursorShapeCandidate.canonicalResultLevel_eq
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    {env blockEnv : VEnv} {Us : List Name}
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source)
    (context_lctx_eq : context.lctx = {}) :
    VLevel.ofLevel Us
        produced.execution.eliminationExecution.normalization.stats.resultLevel =
      some (produced.canonicalResultLevel semantic context_lctx_eq) :=
  Classical.choose_spec
    (produced.semanticCommonResultLevel semantic context_lctx_eq)

/-- The canonical Theory result universe makes exactly the same syntactic
nonzero decision as the final kernel family statistics.  This combines strict
level translation with the retained first-family state invariant; no semantic
approximation of `isNeverZero` is used. -/
theorem ProducedBlockRecursorShapeCandidate.canonicalResultLevel_isNeverZero_eq
    {source : VInductDecl} {kernelSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    (produced : ProducedBlockRecursorShapeCandidate source kernelSources
      numNested isUnsafe context)
    {env blockEnv : VEnv} {Us : List Name}
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source)
    (context_lctx_eq : context.lctx = {}) :
    (produced.canonicalResultLevel semantic context_lctx_eq).isNeverZero =
      produced.execution.eliminationExecution.normalization.stats.isNotZero := by
  have normalizationProduced := produced.execution.normalization_run
    produced.producedExecution
  obtain ⟨kernelSource, remainingSources, sources_eq⟩ :=
    list_eq_cons_of_isEmpty_false kernelSources
      produced.kernelSources_nonempty
  subst kernelSources
  have terminals := produced.execution.eliminationExecution.normalization
    |>.familyTerminalSorts
  obtain ⟨kernelLevel, _resultLevel, terminal, _levelTr⟩ :=
    semantic.families.headResultLevel terminals
  have state := produced.execution.eliminationExecution.normalization
    |>.firstFamily_resultState_eq normalizationProduced context_lctx_eq
      kernelLevel terminal
  have translated := VLevel.ofLevel_isNeverZero_eq
    (produced.canonicalResultLevel_eq semantic context_lctx_eq)
  rw [state.1] at translated
  exact translated.trans state.2.symm

/-- Specialize the complete family result-universe inventory to the exact
canonical level selected from the producer's final family statistics. -/
theorem
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion.canonicalFamilyResultLevelsCanonical
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {staging : produced.SecondFamilyIndexStaging semantic}
    {raw : Option staging.annotation.RawFirstIndexDomain}
    (completion : staging.TerminalIndexDomainCompletion raw)
    (context_lctx_eq : context.lctx = {})
    {params : List VExpr}
    (paramsLength : params.length = source.nparams) :
    List.All (fun family =>
      sortLevel source.nparams family ≈
        produced.canonicalResultLevel semantic context_lctx_eq)
      (canonicalizeFamilyParamsList source.nparams params
        semantic.families.views) :=
  completion.canonicalFamilyResultLevels context_lctx_eq paramsLength
    (produced.canonicalResultLevel_eq semantic context_lctx_eq)

/-- The analyzer-owned dependent family spine records the producer-selected
common result universe at every exact source family position. -/
theorem
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion.canonicalCheckedFamilyResultLevels
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {staging : produced.SecondFamilyIndexStaging semantic}
    {raw : Option staging.annotation.RawFirstIndexDomain}
    (completion : staging.TerminalIndexDomainCompletion raw)
    (context_lctx_eq : context.lctx = {})
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (alignmentRun :
      AddInductive.ConstructorBlockCandidateAlignmentTrace.check
        (produced.execution.eliminationExecution.normalization
          |>.constructorValidation.traces)
        produced.candidate.families = .ok ())
    (stage3Run :
      AddInductive.ConstructorBlockStage3SafetyTraces.check
        produced.execution.eliminationExecution.normalization.stats
        Us source.uvars produced.candidate.families = .ok ()) :
    List.All (fun resultLevel => resultLevel ≈
        produced.canonicalResultLevel semantic context_lctx_eq)
      (completion.canonicalCheckedFamilies context_lctx_eq stagingInput
        alignmentRun stage3Run).resultLevels := by
  have levels := completion.canonicalFamilyResultLevelsCanonical
    context_lctx_eq
    (produced.semanticViewParams_length semantic context_lctx_eq)
  rw [CheckedFamilies.resultLevels_eq_map_sortLevel]
  let rec mapResultLevels (families : List VInductiveType)
      (all : List.All (fun family => sortLevel source.nparams family ≈
        produced.canonicalResultLevel semantic context_lctx_eq) families) :
      List.All (fun resultLevel => resultLevel ≈
        produced.canonicalResultLevel semantic context_lctx_eq)
        (families.map (sortLevel source.nparams)) := by
    cases families with
    | nil => trivial
    | cons _ families =>
        exact ⟨all.1, mapResultLevels families all.2⟩
  simpa only [
    NormalizationCandidateBlockSemanticRun.canonicalNormalization,
    Normalization.canonicalizeSharedParams,
    VInductDecl.canonicalizeSharedParams,
    NormalizationCandidateBlockSemanticRun.normalization,
    NormalizationCandidateBlockSemanticRun.viewDecl] using
      mapResultLevels _ levels

/-- Assemble the exact dependent family semantics once the residual
constructor-only inventory has been produced for this same canonical checked
spine. -/
theorem
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion.canonicalCheckedBlockConstructorRuns
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {staging : produced.SecondFamilyIndexStaging semantic}
    {raw : Option staging.annotation.RawFirstIndexDomain}
    (completion : staging.TerminalIndexDomainCompletion raw)
    (context_lctx_eq : context.lctx = {})
    (stagingInput : NormalizationCandidateBlockStagingInput context
      produced.execution.eliminationExecution.normalization env blockEnv Us
      source)
    (alignmentRun :
      AddInductive.ConstructorBlockCandidateAlignmentTrace.check
        (produced.execution.eliminationExecution.normalization
          |>.constructorValidation.traces)
        produced.candidate.families = .ok ())
    (stage3Run :
      AddInductive.ConstructorBlockStage3SafetyTraces.check
        produced.execution.eliminationExecution.normalization.stats
        Us source.uvars produced.candidate.families = .ok ())
    (preFamilyRun :
      AddInductive.checkConstructorMutualBlockPreFamilySafety
        produced.execution.eliminationExecution.normalization.stats
        produced.execution.eliminationExecution.normalization.validationContext
        produced.candidate.families = .ok ())
    (universeRun :
      AddInductive.checkConstructorBlockUniverseSemantics
        produced.execution.eliminationExecution.normalization.stats
        (firstSource :: secondSource :: remainingSources)
        { produced.execution.eliminationExecution.normalization.validationContext
          with env :=
            produced.execution.eliminationExecution.normalization.familyEnv } =
          .ok ()) :
    let validation :=
      produced.execution.eliminationExecution.normalization
        |>.constructorValidation.traces
    let fieldSorts? := validation.fieldSorts? Us
    Nonempty (CheckedBlockConstructorRunList env
        (produced.canonicalResultLevel semantic context_lctx_eq)
        (completion.canonicalCheckedFamilies context_lctx_eq stagingInput
          alignmentRun stage3Run).indices
        (completion.canonicalCheckedFamilies context_lctx_eq stagingInput
          alignmentRun stage3Run)) ∧
      fieldSorts?.isSome ∧
      ∀ success : fieldSorts?.isSome,
        CheckedBlockFieldSortTelescopes blockEnv Us.length
          (blockParams source.nparams semantic.families.views)
          (completion.canonicalCheckedFamilies context_lctx_eq stagingInput
            alignmentRun stage3Run)
          (fieldSorts?.get success) := by
  let normalization :=
    produced.execution.eliminationExecution.normalization
  let params := blockParams source.nparams semantic.families.views
  obtain ⟨inventory⟩ :=
    completion.constructorValidationSemanticState context_lctx_eq stagingInput
      alignmentRun
  obtain ⟨translationState⟩ :=
    completion.canonicalMutualPreFamilyTranslationState context_lctx_eq
      stagingInput alignmentRun stage3Run preFamilyRun
  obtain ⟨stage⟩ :=
    AddInductive.ConstructorBlockStage3SafetyTraces.nonempty_of_check
      stage3Run
  have henv : VEnv.WF env := by
    simpa only [staging.annotation.firstSemantic.type.venv_eq] using
      staging.annotation.firstSemantic.type.contextRun.context.Ewf
  have hblockEnv : VEnv.WF blockEnv := by
    simpa only [inventory.semantic.contextRun.venv_eq] using
      inventory.semantic.contextRun.candidate.context.Ewf
  have addType : env ≤ blockEnv :=
    VEnv.stageInductiveTypes_le stagingInput.stage
  have storedConstructors := inventory.storedParameterDefEqLists
    completion.firstParameterContext
  have firstStoredView :=
    staging.firstStoredViewParameterTelescopeDefEq context_lctx_eq
  have firstViewStored :=
    (firstStoredView.symm henv trivial).mono addType
  have constructorParameters :=
    storedConstructors.precompose firstViewStored hblockEnv
  have params_eq : params = VExpr.telN source.nparams
      staging.annotation.firstSemantic.type.view := by
    unfold params
    rw [staging.annotation.semantic_views_eq]
    rfl
  rw [← params_eq] at constructorParameters
  have canonicalStage := completion.canonicalConstructorStage3List
    context_lctx_eq stagingInput alignmentRun stage3Run
  have paramsLength : params.length = source.nparams :=
    produced.semanticViewParams_length semantic context_lctx_eq
  have counts := completion.canonicalFamilyIndexCounts context_lctx_eq
    paramsLength
  have shapes := semantic.generationShapes produced.shape
  have headersEq := semantic.families.familyHeaders_canonicalize shapes
    normalization.familyParameterSpines normalization.familyTerminalSorts
    paramsLength
  have normalizationProduced :=
    produced.execution.normalization_run produced.producedExecution
  have familyRun := normalization.familyValidationResult_run
    normalizationProduced
  have constants := semantic.families.rawFamilyConstantInventory
    produced.kernelSources_nonempty familyRun
  have indConstsSize : normalization.stats.indConsts.size =
      (firstSource :: secondSource :: remainingSources).length := by
    have sizes := normalization.familyValidationResult.sizes_of_run
      produced.kernelSources_nonempty familyRun
    simpa only [normalization,
      AddInductive.NormalizationCandidateExecution.familyValidationResult]
      using sizes.2.2
  have viewLength : semantic.families.views.length =
      (firstSource :: secondSource :: remainingSources).length := by
    have namesLength := congrArg List.length
      semantic.families.viewHeaderNames.1
    simpa using namesLength
  have canonicalLength :
      (canonicalizeFamilyParamsList source.nparams params
        semantic.families.views).length = normalization.stats.indConsts.size := by
    calc
      _ = semantic.families.views.length := by
        simp only [canonicalizeFamilyParamsList, List.length_map]
      _ = (firstSource :: secondSource :: remainingSources).length :=
        viewLength
      _ = normalization.stats.indConsts.size := indConstsSize.symm
  have rawFamilyData := counts.familyData canonicalLength headersEq constants
  have canonicalHeadersEq :
      familyHeaders semantic.canonicalNormalization.view.nparams
          semantic.canonicalNormalization.view.types =
        familyHeaders source.nparams source.types := by
    simpa only [NormalizationCandidateBlockSemanticRun.canonicalNormalization,
      Normalization.canonicalizeSharedParams,
      VInductDecl.canonicalizeSharedParams,
      NormalizationCandidateBlockSemanticRun.normalization,
      NormalizationCandidateBlockSemanticRun.viewDecl, params] using
      headersEq.symm
  have familyData : ∀ familyIdx,
      familyIdx < normalization.stats.indConsts.size →
      ∃ header,
        (familyHeaders semantic.canonicalNormalization.view.nparams
          semantic.canonicalNormalization.view.types)[familyIdx]? =
            some header ∧
        normalization.stats.indConsts[familyIdx]! =
          .const header.name normalization.stats.levels := by
    intro familyIdx familyIdxLt
    obtain ⟨header, headerAt, _indices, constant⟩ :=
      rawFamilyData familyIdx familyIdxLt
    exact ⟨header, by rw [canonicalHeadersEq]; exact headerAt, constant⟩
  have targets : ConstructorValidation.MutualFamilyTargetState env blockEnv
      Us normalization.stats
      (familyHeaders semantic.canonicalNormalization.view.nparams
        semantic.canonicalNormalization.view.types)
      translationState.preFamily.trace.suffixes.values
      (completion.canonicalCheckedFamilies context_lctx_eq stagingInput
        alignmentRun stage3Run).indices
      translationState.parameterΔ translationState.parameterΔ 0 :=
    translationState.targetState addType rfl counts canonicalLength familyData
  have sourceUvars : semantic.canonicalNormalization.view.uvars = Us.length := by
    simpa only [NormalizationCandidateBlockSemanticRun.canonicalNormalization,
      Normalization.canonicalizeSharedParams,
      VInductDecl.canonicalizeSharedParams,
      NormalizationCandidateBlockSemanticRun.normalization,
      NormalizationCandidateBlockSemanticRun.viewDecl] using
      semantic.uvars_eq
  have sourceNparams : semantic.canonicalNormalization.view.nparams =
      normalization.stats.params.size := by
    simpa only [NormalizationCandidateBlockSemanticRun.canonicalNormalization,
      Normalization.canonicalizeSharedParams,
      VInductDecl.canonicalizeSharedParams,
      NormalizationCandidateBlockSemanticRun.normalization,
      NormalizationCandidateBlockSemanticRun.viewDecl] using
      inventory.params_size.symm
  have resultLevelTr :=
    produced.canonicalResultLevel_eq semantic context_lctx_eq
  have familyFresh : ∀ name,
      name ∈ familyNames semantic.canonicalNormalization.view.types →
      env.constants name = none :=
    semantic.canonicalFamilyNames_fresh
  let checkedBlock := completion.canonicalCheckedBlock context_lctx_eq
    stagingInput alignmentRun stage3Run
  have generatedNodup :
      (blockGeneratedNames
        semantic.canonicalNormalization.view.types).Nodup := by
    rw [← checkedBlock.names_eq]
    exact checkedBlock.names_nodup
  rw [blockGeneratedNames, List.nodup_append] at generatedNodup
  rw [List.nodup_append] at generatedNodup
  have familyNodup :
      (familyNames semantic.canonicalNormalization.view.types).Nodup := by
    simpa only [familyNames] using generatedNodup.1.1
  have universeSemantics :
      normalization.constructorValidation.traces.universeSemantics = true :=
    normalization.constructorValidation.traces.universeSemantics_of_run
      universeRun
  have runs :=
    CandidateBlockMutualPreFamilyTranslationState.checkedBlockConstructorRuns
    (source := semantic.canonicalNormalization.view) translationState
    inventory stage constructorParameters canonicalStage henv hblockEnv
    addType targets sourceUvars sourceNparams resultLevelTr familyFresh
    familyNodup universeSemantics
  have computed :=
    CandidateBlockConstructorPostFamilySemanticRuns.fieldSorts?_eq
      inventory.semantic.constructors
  have fieldSortsSome :
      normalization.constructorValidation.traces.fieldSorts? Us |>.isSome := by
    rw [computed]
    rfl
  refine ⟨runs.1, fieldSortsSome, ?_⟩
  intro success
  have fieldSortsEq :
      (normalization.constructorValidation.traces.fieldSorts? Us).get success =
        inventory.semantic.constructors.fieldSorts := by
    exact Option.some.inj ((Option.some_get success).trans computed)
  exact fieldSortsEq.symm ▸ runs.2

