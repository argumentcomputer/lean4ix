        familyData owner ownerLt
      have targetFound :=
        VInductDecl.blockTarget?_of_isValidIndAppIdx_translation_resolved
          run henv contextWF valid paramsSize headerAt indicesCount
          familyConst levelsTr parameterTranslations parametersFVar
          (before owner header headerAt) covered projectionSafe contextSafe
          literalSafe
      have targetNotForall : ∀ domain body,
          target ≠ .forallE domain body := by
        obtain ⟨targetHeader, targetHeaderAt, targetShape⟩ :=
          VInductDecl.blockTarget?_eq_some targetFound
        intro domain body equality
        rw [equality] at targetShape
        have headEq := congrArg VExpr.appHead targetShape
        simp only [VExpr.appHead, VExpr.appHead_appN] at headEq
        exact VExpr.noConfusion headEq
      cases target with
      | forallE domain body => exact (targetNotForall domain body rfl).elim
      | bvar | sort | const | app | lam =>
          simp only [VInductDecl.blockStage3Ctor]
          rw [targetFound]
          simp

/-- Strict translation preserves the exact number of constructor fields
traversed by the normalized stage-3 trace.  The terminal family application
is proved non-Π by the same exact block-target translation used by the
stage-3 Boolean theorem. -/
theorem fieldCount_eq_ctorFields_length_of_translation
    {env : VEnv} {Us : List Name} {context : VLCtx}
    {stats : AddInductive.InductiveStats} {owner j : Nat}
    {source : Expr} {target : VExpr}
    (trace : AddInductive.ConstructorBlockStage3ViewTrace stats owner j source)
    (run : TrExprS env Us context source target)
    (unique : TrExprS.IsUnique source)
    {U np : Nat} {headers : List VInductDecl.FamilyHeader}
    {names : List Name}
    (henv : VEnv.Ordered env)
    (paramsSize : stats.params.size = np)
    (ownerLt : owner < stats.indConsts.size)
    (familyData : ∀ familyIdx, familyIdx < stats.indConsts.size →
      ∃ header,
        headers[familyIdx]? = some header ∧
        stats.nindices[familyIdx]! = header.indices ∧
        stats.indConsts[familyIdx]! =
          .const header.name stats.levels)
    (levelsTr : stats.levels.mapM (VLevel.ofLevel Us) =
      some (VLevel.params U))
    (parameterTranslations : List.Forall₂ (TrExprS env Us context)
      stats.params.toList (VExpr.bvarRevRange j np))
    (parametersFVar : ∀ source ∈ stats.params.toList,
      ∃ fv, source = .fvar fv)
    (before : ∀ (familyIdx : Nat) (header : VInductDecl.FamilyHeader),
      headers[familyIdx]? = some header →
      ∀ (k : Nat), k < familyIdx →
        ∀ (earlier : VInductDecl.FamilyHeader),
        headers[k]? = some earlier → earlier.name ≠ header.name)
    (covered : ∀ name, name ∈ names →
      stats.indConsts.any (fun constant =>
        constant.constName! == name) = true)
    (contextSafe : VLCtx.ValuesAnyConstFree context names)
    (literalSafe : ∀ literal name, name ∈ names →
      (VExpr.trLiteral literal).hasConst name = false) :
    trace.fieldCount = (VInductDecl.ctorFields target).length := by
  induction trace generalizing context target with
  | @ordinary fieldIndex name domain body binderInfo domainFree tail ih =>
      cases run with
      | forallE targetTypeType targetBodyType domainTr bodyTr =>
          rename_i targetDomain targetBody
          have nextParameterTranslations :=
            forall₂_parameterTranslations_under_binder
              (domain := targetDomain) henv parametersFVar
              parameterTranslations
          have nextContextSafe : VLCtx.ValuesAnyConstFree
              ((none, .vlam targetDomain) :: context) names :=
            contextSafe.cons (by
              simp [VLocalDecl.value, VExpr.hasAnyConst, VExpr.hasConst])
          have tailCount := ih bodyTr unique.2 nextParameterTranslations
            nextContextSafe
          simpa only [AddInductive.ConstructorBlockStage3ViewTrace.fieldCount,
            VInductDecl.ctorFields, List.length_cons] using
            congrArg (· + 1) tailCount
  | @recursive fieldIndex name domain body binderInfo domainOccurs field tail ih =>
      cases run with
      | forallE targetTypeType targetBodyType domainTr bodyTr =>
          rename_i targetDomain targetBody
          have nextParameterTranslations :=
            forall₂_parameterTranslations_under_binder
              (domain := targetDomain) henv parametersFVar
              parameterTranslations
          have nextContextSafe : VLCtx.ValuesAnyConstFree
              ((none, .vlam targetDomain) :: context) names :=
            contextSafe.cons (by
              simp [VLocalDecl.value, VExpr.hasAnyConst, VExpr.hasConst])
          have tailCount := ih bodyTr unique.2 nextParameterTranslations
            nextContextSafe
          simpa only [AddInductive.ConstructorBlockStage3ViewTrace.fieldCount,
            VInductDecl.ctorFields, List.length_cons] using
            congrArg (· + 1) tailCount
  | @terminal fieldIndex source terminal valid =>
      obtain ⟨header, headerAt, indicesCount, familyConst⟩ :=
        familyData owner ownerLt
      have targetFound :=
        VInductDecl.blockTarget?_of_isValidIndAppIdx_translation
          run unique valid paramsSize headerAt indicesCount familyConst
          levelsTr parameterTranslations (before owner header headerAt)
          covered contextSafe literalSafe
      have targetNotForall : ∀ domain body,
          target ≠ .forallE domain body := by
        obtain ⟨targetHeader, targetHeaderAt, targetShape⟩ :=
          VInductDecl.blockTarget?_eq_some targetFound
        intro domain body equality
        rw [equality] at targetShape
        have headEq := congrArg VExpr.appHead targetShape
        simp only [VExpr.appHead, VExpr.appHead_appN] at headEq
        exact VExpr.noConfusion headEq
      cases target with
      | forallE domain body => exact (targetNotForall domain body rfl).elim
      | bvar | sort | const | app | lam =>
          rfl

/-- Projection-aware field-count preservation for the exact semantic
endpoint. -/
theorem fieldCount_eq_ctorFields_length_of_translation_resolved
    {env : VEnv} {Us : List Name} {context : VLCtx}
    {stats : AddInductive.InductiveStats} {owner j : Nat}
    {source : Expr} {target : VExpr}
    (trace : AddInductive.ConstructorBlockStage3ViewTrace stats owner j source)
    (run : TrExprS env Us context source target)
    {U np : Nat} {headers : List VInductDecl.FamilyHeader}
    {names : List Name}
    (henv : VEnv.WF env)
    (contextWF : VLCtx.WF env Us.length context)
    (paramsSize : stats.params.size = np)
    (ownerLt : owner < stats.indConsts.size)
    (familyData : ∀ familyIdx, familyIdx < stats.indConsts.size →
      ∃ header,
        headers[familyIdx]? = some header ∧
        stats.nindices[familyIdx]! = header.indices ∧
        stats.indConsts[familyIdx]! =
          .const header.name stats.levels)
    (levelsTr : stats.levels.mapM (VLevel.ofLevel Us) =
      some (VLevel.params U))
    (parameterTranslations : List.Forall₂ (TrExprS env Us context)
      stats.params.toList (VExpr.bvarRevRange j np))
    (parametersFVar : ∀ source ∈ stats.params.toList,
      ∃ fv, source = .fvar fv)
    (before : ∀ (familyIdx : Nat) (header : VInductDecl.FamilyHeader),
      headers[familyIdx]? = some header →
      ∀ (k : Nat), k < familyIdx →
        ∀ (earlier : VInductDecl.FamilyHeader),
        headers[k]? = some earlier → earlier.name ≠ header.name)
    (covered : ∀ name, name ∈ names →
      stats.indConsts.any (fun constant =>
        constant.constName! == name) = true)
    (projectionSafe : ResolvedProjectionNamesSafe env names)
    (contextSafe : VLCtx.ValuesAnyConstFree context names)
    (literalSafe : ∀ literal, env.ContainsLits literal →
      ∀ name, name ∈ names →
      (VExpr.trLiteral literal).hasConst name = false) :
    trace.fieldCount = (VInductDecl.ctorFields target).length := by
  induction trace generalizing context target with
  | @ordinary fieldIndex name domain body binderInfo domainFree tail ih =>
      cases run with
      | forallE targetTypeType targetBodyType domainTr bodyTr =>
          rename_i targetDomain targetBody
          have nextParameterTranslations :=
            forall₂_parameterTranslations_under_binder
              (domain := targetDomain) henv.ordered parametersFVar
              parameterTranslations
          have nextContextWF : VLCtx.WF env Us.length
              ((none, .vlam targetDomain) :: context) :=
            ⟨contextWF, nofun, targetTypeType⟩
          have nextContextSafe : VLCtx.ValuesAnyConstFree
              ((none, .vlam targetDomain) :: context) names :=
            contextSafe.cons (by
              simp [VLocalDecl.value, VExpr.hasAnyConst, VExpr.hasConst])
          have tailCount := ih bodyTr nextContextWF
            nextParameterTranslations nextContextSafe
          simpa only [AddInductive.ConstructorBlockStage3ViewTrace.fieldCount,
            VInductDecl.ctorFields, List.length_cons] using
            congrArg (· + 1) tailCount
  | @recursive fieldIndex name domain body binderInfo domainOccurs field tail ih =>
      cases run with
      | forallE targetTypeType targetBodyType domainTr bodyTr =>
          rename_i targetDomain targetBody
          have nextParameterTranslations :=
            forall₂_parameterTranslations_under_binder
              (domain := targetDomain) henv.ordered parametersFVar
              parameterTranslations
          have nextContextWF : VLCtx.WF env Us.length
              ((none, .vlam targetDomain) :: context) :=
            ⟨contextWF, nofun, targetTypeType⟩
          have nextContextSafe : VLCtx.ValuesAnyConstFree
              ((none, .vlam targetDomain) :: context) names :=
            contextSafe.cons (by
              simp [VLocalDecl.value, VExpr.hasAnyConst, VExpr.hasConst])
          have tailCount := ih bodyTr nextContextWF
            nextParameterTranslations nextContextSafe
          simpa only [AddInductive.ConstructorBlockStage3ViewTrace.fieldCount,
            VInductDecl.ctorFields, List.length_cons] using
            congrArg (· + 1) tailCount
  | @terminal fieldIndex source terminal valid =>
      obtain ⟨header, headerAt, indicesCount, familyConst⟩ :=
        familyData owner ownerLt
      have targetFound :=
        VInductDecl.blockTarget?_of_isValidIndAppIdx_translation_resolved
          run henv contextWF valid paramsSize headerAt indicesCount
          familyConst levelsTr parameterTranslations parametersFVar
          (before owner header headerAt) covered projectionSafe contextSafe
          literalSafe
      have targetNotForall : ∀ domain body,
          target ≠ .forallE domain body := by
        obtain ⟨targetHeader, targetHeaderAt, targetShape⟩ :=
          VInductDecl.blockTarget?_eq_some targetFound
        intro domain body equality
        rw [equality] at targetShape
        have headEq := congrArg VExpr.appHead targetShape
        simp only [VExpr.appHead, VExpr.appHead_appN] at headEq
        exact VExpr.noConfusion headEq
      cases target with
      | forallE domain body => exact (targetNotForall domain body rfl).elim
      | bvar | sort | const | app | lam => rfl

end AddInductive.ConstructorBlockStage3ViewTrace

namespace VInductDecl

/-- Interpret the arbitrary-target pre-family audit against the exact family
semantic hierarchy owned by the same normalization candidate. -/
theorem NormalizationCandidateBlockSemanticRun.mutualPreFamilySemanticState
    {env blockEnv : VEnv} {Us : List Name}
    {kernelSources : List InductiveType}
    {candidate : AddInductive.NormalizationCandidate kernelSources}
    {source : VInductDecl}
    (semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      candidate source)
    {stats : AddInductive.InductiveStats}
    {context : AddInductive.Context}
    (contextRun : AddInductive.ConstructorContextRun env Us context)
    (success : AddInductive.checkConstructorMutualBlockPreFamilySafety stats
      context candidate.families = .ok ()) :
    Nonempty (AddInductive.ConstructorMutualBlockPreFamilySemanticState env
      blockEnv Us stats semantic.families) :=
  AddInductive.ConstructorMutualBlockPreFamilySemanticState.nonempty_of_check
    semantic.families contextRun success

/-- Verified post-family constructor semantics for every family in an exact
mutual block.  The retained validation trace, candidate alignment, and
normalization semantic hierarchy are all dependent indices, preserving the
family ordinal and every constructor source position. -/
inductive CandidateBlockConstructorPostFamilySemanticRuns
    (env blockEnv : VEnv) (Us : List Name)
    (stats : AddInductive.InductiveStats) (isUnsafe : Bool)
    (context : AddInductive.Context)
    (contextRun : AddInductive.ConstructorContextRun blockEnv Us context) :
    {familyIdx : Nat} → {sources : List InductiveType} →
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources} →
    {raws : List VInductiveType} →
    (validation : AddInductive.ConstructorBlockValidationTraces stats
      isUnsafe context familyIdx sources) →
    (alignment : AddInductive.ConstructorBlockCandidateAlignmentTrace stats
      isUnsafe context validation candidates) →
    CandidateBlockFamilySemanticListRun env blockEnv Us candidates raws →
      Type where
  | nil : CandidateBlockConstructorPostFamilySemanticRuns env blockEnv Us
      stats isUnsafe context contextRun .nil .nil .nil
  | cons
      {familyIdx : Nat} {source : InductiveType}
      {sources : List InductiveType}
      {validationHead : AddInductive.ConstructorListValidationTrace stats
        isUnsafe familyIdx context {} source.ctors}
      {validationTail : AddInductive.ConstructorBlockValidationTraces stats
        isUnsafe context (familyIdx + 1) sources}
      {candidate : AddInductive.CandidateFamily source}
      {candidates : AddInductive.CandidateList
        AddInductive.CandidateFamily sources}
      {raw : VInductiveType} {raws : List VInductiveType}
      {alignmentHead : AddInductive.ConstructorCandidateAlignmentTrace stats
        isUnsafe familyIdx context validationHead candidate.constructors}
      {alignmentTail : AddInductive.ConstructorBlockCandidateAlignmentTrace
        stats isUnsafe context validationTail candidates}
      {semanticHead : CandidateBlockFamilySemanticRun env blockEnv Us
        candidate raw}
      {semanticTail : CandidateBlockFamilySemanticListRun env blockEnv Us
        candidates raws}
      (head : AddInductive.ConstructorPostFamilySemanticListRun blockEnv Us
        stats isUnsafe familyIdx context contextRun validationHead
        candidate.constructors alignmentHead semanticHead.constructors)
      (tail : CandidateBlockConstructorPostFamilySemanticRuns env blockEnv Us
        stats isUnsafe context contextRun validationTail alignmentTail
        semanticTail) :
      CandidateBlockConstructorPostFamilySemanticRuns env blockEnv Us stats
        isUnsafe context contextRun
        (.cons validationHead validationTail)
        (.cons alignmentHead alignmentTail)
        (.cons semanticHead semanticTail)

namespace CandidateBlockConstructorPostFamilySemanticRuns

/-- Family-major universe inventory retained by the complete post-family
constructor semantics. -/
def fieldSorts
    {validation : AddInductive.ConstructorBlockValidationTraces stats
      isUnsafe context familyIdx sources}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    {alignment : AddInductive.ConstructorBlockCandidateAlignmentTrace stats
      isUnsafe context validation candidates}
    {semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws}
    (run : CandidateBlockConstructorPostFamilySemanticRuns env blockEnv Us
      stats isUnsafe context contextRun validation alignment semantics) :
    List (List (List VLevel)) :=
  match run with
  | .nil => []
  | .cons head tail => head.fieldSorts :: tail.fieldSorts

/-- The executable block trace computes exactly the universe inventory stored
by its semantic interpretation. -/
theorem fieldSorts?_eq
    {validation : AddInductive.ConstructorBlockValidationTraces stats
      isUnsafe context familyIdx sources}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    {alignment : AddInductive.ConstructorBlockCandidateAlignmentTrace stats
      isUnsafe context validation candidates}
    {semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws}
    (run : CandidateBlockConstructorPostFamilySemanticRuns env blockEnv Us
      stats isUnsafe context contextRun validation alignment semantics) :
    validation.fieldSorts? Us = some run.fieldSorts := by
  induction run with
  | nil => rfl
  | cons head tail ih =>
      simp [AddInductive.ConstructorBlockValidationTraces.fieldSorts?,
        fieldSorts,
        AddInductive.ConstructorPostFamilySemanticListRun.fieldSorts?_eq head,
        ih]

/-- Interpret a complete block alignment in the one verified staged context
shared by `checkConstructors`.  Each family delegates to the established
constructor-list interpreter at its exact natural-number family index. -/
theorem nonempty_of_alignment
    (contextRun : AddInductive.ConstructorContextRun blockEnv Us context)
    {validation : AddInductive.ConstructorBlockValidationTraces stats
      isUnsafe context familyIdx sources}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    (alignment : AddInductive.ConstructorBlockCandidateAlignmentTrace stats
      isUnsafe context validation candidates)
    (semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws) :
    Nonempty (CandidateBlockConstructorPostFamilySemanticRuns env blockEnv Us
      stats isUnsafe context contextRun validation alignment semantics) := by
  induction alignment generalizing raws with
  | nil =>
      cases semantics
      exact ⟨.nil⟩
  | cons headAlignment tailAlignment ih =>
      cases semantics with
      | cons headSemantic tailSemantic =>
          obtain ⟨head⟩ :=
            AddInductive.ConstructorPostFamilySemanticListRun.nonempty_of_alignment
              contextRun headAlignment headSemantic.constructors
          obtain ⟨tail⟩ := ih tailSemantic
          exact ⟨.cons head tail⟩

/-- Run the block alignment audit and immediately interpret the retained
result in a verified staged context.  The existential alignment is the exact
dependent value returned by the executable builder. -/
theorem nonempty_of_check
    (contextRun : AddInductive.ConstructorContextRun blockEnv Us context)
    {validation : AddInductive.ConstructorBlockValidationTraces stats
      isUnsafe context familyIdx sources}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    (success : AddInductive.ConstructorBlockCandidateAlignmentTrace.check
      validation candidates = .ok ())
    (semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws) :
    ∃ alignment : AddInductive.ConstructorBlockCandidateAlignmentTrace stats
        isUnsafe context validation candidates,
      Nonempty (CandidateBlockConstructorPostFamilySemanticRuns env blockEnv
        Us stats isUnsafe context contextRun validation alignment semantics) := by
  obtain ⟨alignment⟩ :=
    AddInductive.ConstructorBlockCandidateAlignmentTrace.nonempty_of_check
      success
  exact ⟨alignment,
    nonempty_of_alignment contextRun alignment semantics⟩

end CandidateBlockConstructorPostFamilySemanticRuns

/-- Existentially owned block-wide constructor semantics at one staged
validation context.  The context run, exact executable alignment, and its
semantic interpretation are packaged together so no dependent witness is
caller-selectable downstream. -/
structure CandidateBlockConstructorPostFamilySemanticState
    (env blockEnv : VEnv) (Us : List Name)
    (stats : AddInductive.InductiveStats) (isUnsafe : Bool)
    (context : AddInductive.Context)
    {familyIdx : Nat} {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    (validation : AddInductive.ConstructorBlockValidationTraces stats
      isUnsafe context familyIdx sources)
    (semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws) where
  contextRun : AddInductive.ConstructorContextRun blockEnv Us context
  parameterLocalState : TypeChecker.FamilyParameterLocalState stats context
  alignment : AddInductive.ConstructorBlockCandidateAlignmentTrace stats
    isUnsafe context validation candidates
  constructors : CandidateBlockConstructorPostFamilySemanticRuns env blockEnv
    Us stats isUnsafe context contextRun validation alignment semantics

/-- The exact constructor-validation context viewed as an extension of the
shared first-family parameter context.  The intermediate reference absorbs
all family-index locals and their definitional rewrites while the root lift
retains the literal parameter declarations used for telescope relocation. -/
structure ConstructorSharedParameterContextAlignment
    (env : VEnv) (Us : List Name) (base : VLCtx)
    {context : AddInductive.Context}
    (contextRun : AddInductive.ConstructorContextRun env Us context) where
  reference : VLCtx
  rootLift : Lift
  root_reference_lift : VLCtx.FVLift' base reference 0 rootLift 0
  current_reference : VLCtx.IsDefEq env Us.length
    contextRun.candidate.context.vlctx reference
  current_unique : TrExprS.IsUniqueCtx
    contextRun.candidate.context.vlctx reference

/-- Block-wide constructor semantics bundled with the exact shared-parameter
inventory and prefix-context alignment consumed by those same retained
validation traces.  The statistics and context-run indices are shared with
`semantic`, so none of these witnesses can come from a parallel execution. -/
structure CandidateBlockConstructorPostFamilySemanticInventoryState
    (env blockEnv : VEnv) (Us : List Name)
    (stats : AddInductive.InductiveStats) (isUnsafe : Bool)
    (context : AddInductive.Context) (base : VLCtx) (nparams : Nat)
    (parameterSources : List Expr)
    {familyIdx : Nat} {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    (validation : AddInductive.ConstructorBlockValidationTraces stats
      isUnsafe context familyIdx sources)
    (semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws) where
  semantic : CandidateBlockConstructorPostFamilySemanticState env blockEnv Us
    stats isUnsafe context validation semantics
  parameterContext : ConstructorSharedParameterContextAlignment blockEnv Us
    base semantic.contextRun
  parameterSources_eq : stats.params.toList = parameterSources
  params_size : stats.params.size = nparams

/-- Producer-owned annotation spines for every constructor in one exact
semantic family.  The generation-shape index fixes the complete stored
telescope, while the dependent semantic list fixes every source position. -/
inductive CandidateConstructorAnnotationSpineList
    (source : VInductDecl) (env : VEnv) (Us : List Name) :
    {kernelSources : List Constructor} →
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateConstructor kernelSources} →
    {raws : List VConstVal} →
    (semantics : CandidateConstructorSemanticListRun env Us candidates raws) →
    CandidateConstructorSemanticGenerationShapeList source env Us semantics →
      Type where
  | nil : CandidateConstructorAnnotationSpineList source env Us .nil .nil
  | cons
      (head : CandidateConstructorAnnotationSpine source env Us semantic shape)
      (tail : CandidateConstructorAnnotationSpineList source env Us
        semantics shapes) :
      CandidateConstructorAnnotationSpineList source env Us
        (.cons semantic semantics) (.cons shape shapes)

namespace CandidateConstructorAnnotationSpineList

/-- Construct every annotation spine from the exact retained constructor
producer equations.  No annotation or normalized-view checker is rerun. -/
theorem nonempty
    {source : VInductDecl} {env : VEnv} {Us : List Name}
    {kernelSources : List Constructor}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateConstructor kernelSources}
    {raws : List VConstVal}
    (semantics : CandidateConstructorSemanticListRun env Us candidates raws)
    (shapes : CandidateConstructorSemanticGenerationShapeList source env Us
      semantics)
    {candidateContext : AddInductive.Context}
    (produced : AddInductive.CandidateConstructorListProduced candidateContext
      candidates) :
    Nonempty (CandidateConstructorAnnotationSpineList source env Us semantics
      shapes) := by
  induction semantics with
  | nil =>
      cases shapes
      cases produced
      exact ⟨.nil⟩
  | cons head tail ih =>
      rename_i kernelSource candidate raw kernelSources candidates raws
      cases shapes with
      | cons headShape tailShapes =>
          cases produced with
          | cons headProduced tailProduced =>
              have headProduced' :
                  AddInductive.normalizeCandidateConstructor kernelSource
                      candidate.type.context = .ok candidate := by
                rw [AddInductive.CandidateConstructor.context_eq_of_normalize
                  headProduced]
                exact headProduced
              obtain ⟨headAnnotation⟩ :=
                CandidateConstructorAnnotationSpine.exists head headShape
                  headProduced'
              obtain ⟨tailAnnotations⟩ := ih tailShapes tailProduced
              exact ⟨.cons headAnnotation tailAnnotations⟩

end CandidateConstructorAnnotationSpineList

/-- Family-major producer-owned annotation-spine inventory. -/
inductive CandidateBlockConstructorAnnotationSpineLists
    (source : VInductDecl) (env blockEnv : VEnv) (Us : List Name) :
    {kernelSources : List InductiveType} →
    {candidates : AddInductive.CandidateList AddInductive.CandidateFamily
      kernelSources} →
    {raws : List VInductiveType} →
    (semantics : CandidateBlockFamilySemanticListRun env blockEnv Us candidates
      raws) →
    CandidateBlockFamilySemanticGenerationShapeList source env blockEnv Us
      semantics → Type where
  | nil : CandidateBlockConstructorAnnotationSpineLists source env blockEnv Us
      .nil .nil
  | cons
      (head : CandidateConstructorAnnotationSpineList source blockEnv Us
        semantic.constructors shape.constructors)
      (tail : CandidateBlockConstructorAnnotationSpineLists source env blockEnv Us
        semantics shapes) :
      CandidateBlockConstructorAnnotationSpineLists source env blockEnv Us
        (.cons semantic semantics) (.cons shape shapes)

namespace CandidateBlockConstructorAnnotationSpineLists

/-- Construct the family-major annotation inventory from the producer's
exact block traversal. -/
theorem nonempty
    {source : VInductDecl} {env blockEnv : VEnv} {Us : List Name}
    {kernelSources : List InductiveType}
    {candidates : AddInductive.CandidateList AddInductive.CandidateFamily
      kernelSources}
    {raws : List VInductiveType}
    (semantics : CandidateBlockFamilySemanticListRun env blockEnv Us candidates
      raws)
    (shapes : CandidateBlockFamilySemanticGenerationShapeList source env blockEnv
      Us semantics)
    {candidateContext : AddInductive.Context}
    (produced : AddInductive.CandidateBlockConstructorListProduced
      candidateContext candidates) :
    Nonempty (CandidateBlockConstructorAnnotationSpineLists source env blockEnv Us
      semantics shapes) := by
  induction semantics with
  | nil =>
      cases shapes
      cases produced
      exact ⟨.nil⟩
  | cons head tail ih =>
      cases shapes with
      | cons headShape tailShapes =>
          cases produced with
          | cons headProduced tailProduced =>
              obtain ⟨headAnnotations⟩ :=
                CandidateConstructorAnnotationSpineList.nonempty
                  head.constructors headShape.constructors headProduced
              obtain ⟨tailAnnotations⟩ := ih tailShapes tailProduced
              exact ⟨.cons headAnnotations tailAnnotations⟩

end CandidateBlockConstructorAnnotationSpineLists

/-- Alignment-audit-free constructor inventory.  The ordinary validator,
candidate producer, and retained semantic hierarchy determine the structural
spine alignment and the shared parameter telescope directly; no normalized
view is rechecked by the supplemental alignment executable. -/
structure CandidateBlockConstructorSpineSemanticInventoryState
    (source : VInductDecl) (env blockEnv : VEnv) (Us : List Name)
    (stats : AddInductive.InductiveStats) (isUnsafe : Bool)
    (context : AddInductive.Context) (base : VLCtx) (nparams : Nat)
    (parameterSources : List Expr) (storedTypes : List VExpr)
    (params : TypeChecker.CandidateParameterContext [] parameterSources
      storedTypes base)
    {familyIdx : Nat} {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    (validation : AddInductive.ConstructorBlockValidationTraces stats
      isUnsafe context familyIdx sources)
    (semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws) where
  contextRun : AddInductive.ConstructorContextRun blockEnv Us context
  parameterLocalState : TypeChecker.FamilyParameterLocalState stats context
  spineAlignment : AddInductive.ConstructorBlockCandidateSpineAlignment stats
    isUnsafe context validation candidates
  parameterContext : ConstructorSharedParameterContextAlignment blockEnv Us
    base contextRun
  parameterSources_eq : stats.params.toList = parameterSources
  params_size : stats.params.size = nparams
  constructorParameters : CandidateBlockConstructorViewParameterDefEqLists
    env blockEnv Us nparams storedTypes semantics
  generationShapes : CandidateBlockFamilySemanticGenerationShapeList source
    env blockEnv Us semantics
  annotationSpines : CandidateBlockConstructorAnnotationSpineLists source
    env blockEnv Us semantics generationShapes

namespace TypeChecker.CandidateParameterContext

/-- Extend a source-ordered parameter context by one final parameter while
the verified `VLCtx` stores that newest declaration at its head. -/
theorem snoc
    {base final : VLCtx} {parameters : List Expr} {types : List VExpr}
    {fv : FVarId} {deps : List FVarId} {type : VExpr}
    (run : TypeChecker.CandidateParameterContext base parameters types final) :
    TypeChecker.CandidateParameterContext base
      (parameters ++ [.fvar fv]) (types ++ [type])
      ((some (fv, deps), .vlam type) :: final) := by
  induction run with
  | nil => exact .cons .nil
  | cons tail ih => exact .cons ih

/-- Reconstruct the source-ordered parameter-context witness from the exact
free-assumption shape plus its reversed source/type inventories. -/
theorem of_fvarLamOnly
    {Δ : VLCtx} {parameters : List Expr} {types : List VExpr}
    (shape : Δ.FVarLamOnly)
    (context_eq : Δ.toCtx = types.reverse)
    (parameters_eq : Δ.fvars.map Expr.fvar = parameters.reverse) :
    TypeChecker.CandidateParameterContext [] parameters types Δ := by
  induction shape generalizing parameters types with
  | nil =>
      have types_eq : types = [] := by
        have reversed := congrArg List.reverse context_eq
        simpa [VLCtx.toCtx] using reversed.symm
      have parameters_eq' : parameters = [] := by
        have reversed := congrArg List.reverse parameters_eq
        simpa using reversed.symm
      subst types
      subst parameters
      exact .nil
  | @cons tail fv deps type shape ih =>
      let tailTypes : List VExpr := tail.toCtx.reverse
      let tailParameters : List Expr :=
        (tail.fvars.map Expr.fvar).reverse
      have tailContext : tail.toCtx = tailTypes.reverse := by
        simp only [tailTypes, List.reverse_reverse]
      have tailSources : tail.fvars.map Expr.fvar =
          tailParameters.reverse := by
        simp only [tailParameters, List.reverse_reverse]
      have tailRun := ih tailContext tailSources
      have types_eq : types = tailTypes ++ [type] := by
        have reversed := congrArg List.reverse context_eq
        simpa only [VLCtx.toCtx, List.reverse_cons, List.reverse_reverse,
          tailTypes] using reversed.symm
      have parameters_eq' : parameters =
          tailParameters ++ [.fvar fv] := by
        have reversed := congrArg List.reverse parameters_eq
        simpa only [VLCtx.fvars_cons_some, List.map_cons,
          List.reverse_cons, List.reverse_reverse, tailParameters] using
          reversed.symm
      rw [types_eq, parameters_eq']
      exact TypeChecker.CandidateParameterContext.snoc tailRun

/-- Every source-ordered parameter-context witness is a literal
free-variable extension of its starting context.  The accumulated `Lift`
records precisely the binders skipped between the current parameter prefix
and the terminal shared-parameter context. -/
theorem extension
    {base final : VLCtx} {parameters : List Expr} {types : List VExpr}
    (run : TypeChecker.CandidateParameterContext base parameters types final) :
    ∃ lift, VLCtx.FVLift' base final 0 lift 0 := by
  induction run with
  | nil => exact ⟨.refl, .refl⟩
  | @cons fv deps type base parameters types final tail ih =>
      obtain ⟨tailLift, tailExtension⟩ := ih
      let headExtension : VLCtx.FVLift' base
          ((some (fv, deps), .vlam type) :: base) 0
            (Lift.skipN Lift.refl 1) 0 :=
        .skip_fvar _ _ .refl
      exact ⟨(Lift.skipN Lift.refl 1).comp tailLift,
        headExtension.comp tailExtension⟩

/-- Exact-count form of `extension`: a parameter-context run inserts one
free assumption per translated target and does not alter any older binder. -/
theorem skipExtension
    {base final : VLCtx} {parameters : List Expr} {types : List VExpr}
    (run : TypeChecker.CandidateParameterContext base parameters types final) :
    VLCtx.FVLift' base final 0 (.skipN .refl types.length) 0 := by
  induction run with
  | nil => exact .refl
  | @cons fv deps type base parameters types final tail ih =>
      have head : VLCtx.FVLift' base
          ((some (fv, deps), .vlam type) :: base) 0
          (.skipN .refl 1) 0 :=
        .skip_fvar _ _ .refl
      simpa only [List.length_cons, Lift.comp_skipN, Lift.comp,
        Lift.skipN_skipN, Nat.add_comm] using head.comp ih

/-- Exact free-variable inventory accumulated by a source-ordered parameter
context.  The verified context stores newest declarations first. -/
theorem fvars
    {base final : VLCtx} {parameters : List Expr} {types : List VExpr}
    (run : TypeChecker.CandidateParameterContext base parameters types final) :
    final.fvars.map Expr.fvar =
      parameters.reverse ++ base.fvars.map Expr.fvar := by
  induction run with
  | nil => simp
  | @cons fv deps type base parameters types final tail ih =>
      simpa only [VLCtx.fvars_cons_some, List.map_cons,
        List.reverse_cons, List.singleton_append, List.append_assoc] using ih

/-- Exact Theory-context inventory accumulated by a source-ordered parameter
context. -/
theorem toCtx
    {base final : VLCtx} {parameters : List Expr} {types : List VExpr}
    (run : TypeChecker.CandidateParameterContext base parameters types final) :
    final.toCtx = types.reverse ++ base.toCtx := by
  induction run with
  | nil => simp
  | @cons fv deps type base parameters types final tail ih =>
      simpa only [VLCtx.toCtx, List.reverse_cons,
        List.singleton_append, List.append_assoc] using ih

/-- A parameter context extending a free-assumption context contains only
free assumptions itself. -/
theorem fvarLamOnly
    {base final : VLCtx} {parameters : List Expr} {types : List VExpr}
    (run : TypeChecker.CandidateParameterContext base parameters types final)
    (baseShape : base.FVarLamOnly) : final.FVarLamOnly := by
  induction run with
  | nil => exact baseShape
  | cons tail ih => exact ih (.cons baseShape)

/-- The kernel parameter FVars selected by validation translate pointwise to
the canonical reverse de Bruijn parameter range in their terminal context. -/
theorem sourceTranslations
    {env : VEnv} {Us : List Name}
    {parameters : List Expr} {types : List VExpr} {final : VLCtx}
    (run : TypeChecker.CandidateParameterContext [] parameters types final)
    (henv : VEnv.WF env) (finalWF : VLCtx.WF env Us.length final) :
    List.Forall₂ (TrExprS env Us final) parameters
      (VExpr.bvarRevRange 0 types.length) := by
  have translated := (fvarLamOnly run .nil).sourceTranslations henv finalWF
  have sourceEq : final.fvars.reverse.map Expr.fvar = parameters := by
    have inventory := fvars run
    simp only [VLCtx.fvars_nil, List.map_nil, List.append_nil] at inventory
    rw [List.map_reverse, inventory, List.reverse_reverse]
  have lengthEq : final.toCtx.length = types.length := by
    rw [toCtx run]
    simp [VLCtx.toCtx]
  simpa only [sourceEq, lengthEq] using translated

/-- The variables appended by a parameter-context run translate to the
low reverse de Bruijn range even when the run starts above an existing
free-assumption context.  The older base variables occupy the high prefix
of the complete canonical range and can therefore be dropped uniformly. -/
theorem sourceTranslations_fromBase
    {env : VEnv} {Us : List Name}
    {base final : VLCtx} {parameters : List Expr} {types : List VExpr}
    (run : TypeChecker.CandidateParameterContext base parameters types final)
    (baseShape : base.FVarLamOnly) (henv : VEnv.WF env)
    (finalWF : VLCtx.WF env Us.length final) :
    List.Forall₂ (TrExprS env Us final) parameters
      (VExpr.bvarRevRange 0 types.length) := by
  have finalShape : final.FVarLamOnly := fvarLamOnly run baseShape
  have translated := finalShape.sourceTranslations henv finalWF
  have sourceInventory := fvars run
  have sourcesEq : final.fvars.reverse.map Expr.fvar =
      base.fvars.reverse.map Expr.fvar ++ parameters := by
    have reversed := congrArg List.reverse sourceInventory
    simpa only [List.map_reverse, List.reverse_append,
      List.reverse_reverse] using reversed
  have contextInventory := toCtx run
  have contextLength : final.toCtx.length =
      types.length + base.toCtx.length := by
    rw [contextInventory, List.length_append, List.length_reverse]
  have fvarContextLength : ∀ {Δ : VLCtx}, Δ.FVarLamOnly →
      Δ.fvars.length = Δ.toCtx.length := by
    intro Δ shape
    induction shape with
    | nil => rfl
    | cons tail ih =>
        simpa only [VLCtx.fvars_cons_some, VLCtx.toCtx,
          List.length_cons] using congrArg Nat.succ ih
  have baseLength := fvarContextLength baseShape
  rw [sourcesEq, contextLength, ← VExpr.bvarRevRange_append] at translated
  have prefixLength :
      (base.fvars.reverse.map Expr.fvar).length =
        (VExpr.bvarRevRange types.length base.toCtx.length).length := by
    simp only [List.length_map, List.length_reverse,
      VExpr.bvarRevRange_length, baseLength]
  have trailing := Lean4Lean.List.Forall₂.drop translated
    (base.fvars.reverse.map Expr.fvar).length
  rw [List.drop_append_length] at trailing
  rw [prefixLength, List.drop_append_length] at trailing
  exact trailing

end TypeChecker.CandidateParameterContext

/-- Retype a source-ordered parameter context along a checker-produced
telescope equality.  Free-variable identifiers and dependency metadata stay
fixed; only the Theory declaration types change. -/
theorem _root_.Lean4Lean.TypeChecker.CandidateParameterContext.retypeAux
    {env : VEnv} {U : Nat}
    {base final viewBase : VLCtx}
    {parameters : List Expr} {types viewTypes : List VExpr}
    (run : TypeChecker.CandidateParameterContext base parameters types final)
    (henv : VEnv.WF env)
    (baseRelation : VLCtx.IsDefEqFVars env U base viewBase)
    (viewBaseWF : VLCtx.WF env U viewBase)
    (evidence : TypeChecker.TelDefEqEvidence env U base.toCtx types viewTypes)
    (finalWF : VLCtx.WF env U final) :
    ∃ viewFinal,
      TypeChecker.CandidateParameterContext viewBase parameters viewTypes
          viewFinal ∧
        VLCtx.IsDefEqFVars env U final viewFinal ∧
        VLCtx.WF env U viewFinal := by
  induction run generalizing viewBase viewTypes with
  | nil =>
      cases evidence
      exact ⟨viewBase, .nil, baseRelation, viewBaseWF⟩
  | @cons fv deps A base parameters types final tail ih =>
      cases evidence with
      | cons head tailEvidence =>
          rename_i A' u viewTypes
          have viewAType : env.IsType U viewBase.toCtx A' :=
            ⟨_, head.isDefEq.hasType.2.defeqDFC henv.ordered
              baseRelation.defeqCtx⟩
          have rawPushedWF : VLCtx.WF env U
              ((some (fv, deps), .vlam A) :: base) :=
            tail.initialWF finalWF
          have viewMetadata : fv ∉ viewBase.fvars ∧
              deps ⊆ viewBase.fvars := by
            rw [← baseRelation.fvars]
            exact rawPushedWF.2.1 fv deps rfl
          have viewPushedWF : VLCtx.WF env U
              ((some (fv, deps), .vlam A') :: viewBase) :=
            ⟨viewBaseWF, by
              intro fv' deps' equality
              have pairEq : (fv, deps) = (fv', deps') :=
                Option.some.inj equality
              cases pairEq
              exact viewMetadata,
              viewAType⟩
          have pushedRelation : VLCtx.IsDefEqFVars env U
              ((some (fv, deps), .vlam A) :: base)
              ((some (fv, deps), .vlam A') :: viewBase) :=
            .cons_fvar baseRelation (.vlam head.isDefEq)
          obtain ⟨viewFinal, viewTail, finalRelation, viewFinalWF⟩ :=
            ih pushedRelation viewPushedWF tailEvidence finalWF
          exact ⟨viewFinal, .cons viewTail, finalRelation, viewFinalWF⟩

/-- Empty-base specialization used by constructor candidates. -/
theorem _root_.Lean4Lean.TypeChecker.CandidateParameterContext.retype
    {env : VEnv} {U : Nat} {final : VLCtx}
    {parameters : List Expr} {types viewTypes : List VExpr}
    (run : TypeChecker.CandidateParameterContext [] parameters types final)
    (henv : VEnv.WF env)
    (evidence : TypeChecker.TelDefEqEvidence env U [] types viewTypes)
    (finalWF : VLCtx.WF env U final) :
    ∃ viewFinal,
      TypeChecker.CandidateParameterContext [] parameters viewTypes
          viewFinal ∧
        VLCtx.IsDefEqFVars env U final viewFinal ∧
        VLCtx.WF env U viewFinal :=
  TypeChecker.CandidateParameterContext.retypeAux run henv .nil trivial
    evidence finalWF

/-- Retype a source-ordered parameter context while retaining the two exact
context relations needed by strict-translation replay.  `IsDefEq` transports
semantic derivations; `IsUniqueCtx` records that every free-variable lookup
has the same translated value, so a unique source keeps its literal Theory
endpoint after transport. -/
theorem _root_.Lean4Lean.TypeChecker.CandidateParameterContext.retypeAuxExact
    {env : VEnv} {U : Nat}
    {base final viewBase : VLCtx}
    {parameters : List Expr} {types viewTypes : List VExpr}
    (run : TypeChecker.CandidateParameterContext base parameters types final)
    (henv : VEnv.WF env)
    (baseRelation : VLCtx.IsDefEq env U base viewBase)
    (baseUnique : TrExprS.IsUniqueCtx base viewBase)
    (viewBaseWF : VLCtx.WF env U viewBase)
    (evidence : TypeChecker.TelDefEqEvidence env U base.toCtx types viewTypes)
    (finalWF : VLCtx.WF env U final) :
    ∃ viewFinal,
      TypeChecker.CandidateParameterContext viewBase parameters viewTypes
          viewFinal ∧
        VLCtx.IsDefEq env U final viewFinal ∧
        TrExprS.IsUniqueCtx final viewFinal ∧
        VLCtx.WF env U viewFinal := by
  induction run generalizing viewBase viewTypes with
  | nil =>
      cases evidence
      exact ⟨viewBase, .nil, baseRelation, baseUnique, viewBaseWF⟩
  | @cons fv deps A base parameters types final tail ih =>
      cases evidence with
      | cons head tailEvidence =>
          rename_i A' u viewTypes
          have viewAType : env.IsType U viewBase.toCtx A' :=
            ⟨_, head.isDefEq.hasType.2.defeqDFC henv.ordered
              baseRelation.defeqCtx⟩
          have rawPushedWF : VLCtx.WF env U
              ((some (fv, deps), .vlam A) :: base) :=
            tail.initialWF finalWF
          have viewMetadata : fv ∉ viewBase.fvars ∧
              deps ⊆ viewBase.fvars := by
            rw [← baseRelation.fvars]
            exact rawPushedWF.2.1 fv deps rfl
          have viewPushedWF : VLCtx.WF env U
              ((some (fv, deps), .vlam A') :: viewBase) :=
            ⟨viewBaseWF, by
              intro fv' deps' equality
              have pairEq : (fv, deps) = (fv', deps') :=
                Option.some.inj equality
              cases pairEq
              exact viewMetadata,
              viewAType⟩
          have pushedRelation : VLCtx.IsDefEq env U
              ((some (fv, deps), .vlam A) :: base)
              ((some (fv, deps), .vlam A') :: viewBase) :=
            .cons baseRelation rawPushedWF.2.1 (.vlam head.isDefEq)
          have pushedUnique : TrExprS.IsUniqueCtx
              ((some (fv, deps), .vlam A) :: base)
              ((some (fv, deps), .vlam A') :: viewBase) :=
            .cons baseUnique .vlam
          obtain ⟨viewFinal, viewTail, finalRelation, finalUnique,
              viewFinalWF⟩ :=
            ih pushedRelation pushedUnique viewPushedWF tailEvidence finalWF
          exact ⟨viewFinal, .cons viewTail, finalRelation, finalUnique,
            viewFinalWF⟩

/-- Empty-base specialization of `retypeAuxExact`. -/
theorem _root_.Lean4Lean.TypeChecker.CandidateParameterContext.retypeExact
    {env : VEnv} {U : Nat} {final : VLCtx}
    {parameters : List Expr} {types viewTypes : List VExpr}
    (run : TypeChecker.CandidateParameterContext [] parameters types final)
    (henv : VEnv.WF env)
    (evidence : TypeChecker.TelDefEqEvidence env U [] types viewTypes)
    (finalWF : VLCtx.WF env U final) :
    ∃ viewFinal,
      TypeChecker.CandidateParameterContext [] parameters viewTypes
          viewFinal ∧
        VLCtx.IsDefEq env U final viewFinal ∧
        TrExprS.IsUniqueCtx final viewFinal ∧
        VLCtx.WF env U viewFinal :=
  TypeChecker.CandidateParameterContext.retypeAuxExact run henv .nil .base
    trivial evidence finalWF

/-- Compose local-declaration equality after transporting the second edge
back to the first edge's context. -/
theorem _root_.Lean4Lean.VLocalDecl.IsDefEq.trans'
    {env : VEnv} {U : Nat} {context : List VExpr}
    (henv : VEnv.WF env) (contextWF : OnCtx context (env.IsType U))
    (left : VLocalDecl.IsDefEq env U context first middle)
    (right : VLocalDecl.IsDefEq env U context middle last) :
    VLocalDecl.IsDefEq env U context first last := by
  cases left with
  | vlam leftType =>
      cases right with
      | vlam rightType =>
          exact .vlam (leftType.trans_l henv contextWF rightType)
  | vlet leftValue leftType =>
      cases right with
      | vlet rightValue rightType =>
          exact .vlet
            (leftValue.trans_l henv contextWF rightValue)
            (leftType.trans_l henv contextWF rightType)

/-- Ordinary verified-context equality is transitive without changing any
free-variable metadata slot. -/
theorem _root_.Lean4Lean.VLCtx.IsDefEq.trans'
    {env : VEnv} {U : Nat} {first middle last : VLCtx}
    (henv : VEnv.WF env)
    (left : VLCtx.IsDefEq env U first middle)
    (right : VLCtx.IsDefEq env U middle last) :
    VLCtx.IsDefEq env U first last := by
  induction left generalizing last with
  | nil => cases right; exact .nil
  | @cons ofv firstDeclaration middleDeclaration firstTail middleTail
      leftTail metadata leftDeclaration ih =>
      cases right with
      | @cons rightOfv rightMiddleDeclaration lastDeclaration
          rightMiddleTail lastTail rightTail rightMetadata rightDeclaration =>
          have rightAtFirst : VLocalDecl.IsDefEq env U firstTail.toCtx
              middleDeclaration lastDeclaration :=
            rightDeclaration.defeqDFC henv.ordered
              (leftTail.defeqCtx.symm henv.ordered)
          exact .cons (ih rightTail) metadata
            (leftDeclaration.trans' henv leftTail.wf.toCtx rightAtFirst)

/-- Every exact verified-context equality has the positional declaration
shape required by strict-translation endpoint uniqueness. -/
theorem _root_.Lean4Lean.VLCtx.IsDefEq.isUniqueCtx
    (relation : VLCtx.IsDefEq env U first second)
    (shape : first.FVarLamOnly) :
    TrExprS.IsUniqueCtx first second := by
  induction shape generalizing second with
  | nil => cases relation; exact .base
  | cons shape ih =>
      cases relation with
      | cons tail metadata declaration =>
          cases declaration with
          | vlam typeRelation => exact .cons (ih tail) .vlam

theorem _root_.Lean4Lean.TrExprS.IsUniqueDecl.trans'
    (left : TrExprS.IsUniqueDecl first middle)
    (right : TrExprS.IsUniqueDecl middle last) :
    TrExprS.IsUniqueDecl first last := by
  cases left with
  | vlam => cases right; exact .vlam
  | vlet => cases right; exact .vlet

/-- Positional strict-translation declaration uniqueness is symmetric. -/
theorem _root_.Lean4Lean.TrExprS.IsUniqueDecl.symm
    (relation : TrExprS.IsUniqueDecl first second) :
    TrExprS.IsUniqueDecl second first := by
  cases relation with
  | vlam => exact .vlam
  | vlet => exact .vlet

/-- Positional strict-translation context uniqueness is transitive. -/
theorem _root_.Lean4Lean.TrExprS.IsUniqueCtx.trans'
    (left : TrExprS.IsUniqueCtx first middle)
    (right : TrExprS.IsUniqueCtx middle last) :
    TrExprS.IsUniqueCtx first last := by
  induction left generalizing last with
  | base => exact right
  | cons leftTail leftDeclaration ih =>
      cases right with
      | base => exact .cons leftTail leftDeclaration
      | cons rightTail rightDeclaration =>
          exact .cons (ih rightTail)
            (leftDeclaration.trans' rightDeclaration)

/-- Positional strict-translation context uniqueness is symmetric. -/
theorem _root_.Lean4Lean.TrExprS.IsUniqueCtx.symm
    (relation : TrExprS.IsUniqueCtx first second) :
    TrExprS.IsUniqueCtx second first := by
  induction relation with
  | base => exact .base
  | cons tail declaration ih => exact .cons ih declaration.symm

/-- A context made exclusively from free lambda assumptions has no bound
variable slots. -/
theorem _root_.Lean4Lean.VLCtx.FVarLamOnly.noBV
    {context : VLCtx} (shape : VLCtx.FVarLamOnly context) :
    VLCtx.NoBV context := by
  induction shape with
  | nil => rfl
  | cons shape ih => exact ih

/-- Free-variable-preserving context equality is transitive when the first
context is verified.  Dependency metadata is allowed to differ on both
edges, while declaration equality is transported through the middle
context. -/
theorem _root_.Lean4Lean.VLCtx.IsDefEqFVars.trans'
    {env : VEnv} {U : Nat} {first middle last : VLCtx}
    (henv : VEnv.WF env) (firstWF : VLCtx.WF env U first)
    (left : VLCtx.IsDefEqFVars env U first middle)
    (right : VLCtx.IsDefEqFVars env U middle last) :
    VLCtx.IsDefEqFVars env U first last := by
  induction left generalizing last with
  | nil => cases right; exact .nil
  | cons_bvar leftTail leftDeclaration ih =>
      cases right with
      | cons_bvar rightTail rightDeclaration =>
          have rightAtFirst : VLocalDecl.IsDefEq env U _ _ _ :=
            rightDeclaration.defeqDFC henv.ordered
              (leftTail.defeqCtx.symm henv.ordered)
          exact .cons_bvar (ih firstWF.1 rightTail)
            (leftDeclaration.trans' henv firstWF.1.toCtx rightAtFirst)
  | cons_fvar leftTail leftDeclaration ih =>
      cases right with
      | cons_fvar rightTail rightDeclaration =>
          have rightAtFirst : VLocalDecl.IsDefEq env U _ _ _ :=
            rightDeclaration.defeqDFC henv.ordered
              (leftTail.defeqCtx.symm henv.ordered)
          exact .cons_fvar (ih firstWF.1 rightTail)
            (leftDeclaration.trans' henv firstWF.1.toCtx rightAtFirst)

/-- Retype the source of a free-variable extension while preserving the
exact metadata and lift selected by the producer.  The target context is
rebuilt position-for-position, so the original and rebuilt targets retain
both ordinary definitional equality and strict-translation uniqueness. -/
theorem _root_.Lean4Lean.VLCtx.FVLift'.retypeSourceExact
    {env : VEnv} {U : Nat}
    {base full viewBase : VLCtx} {dk k : Nat} {lift : Lift}
    (extension : VLCtx.FVLift' base full dk lift k)
    (henv : VEnv.WF env)
    (fullWF : VLCtx.WF env U full)
    (baseRelation : VLCtx.IsDefEq env U base viewBase)
    (baseUnique : TrExprS.IsUniqueCtx base viewBase)
    (viewBaseWF : VLCtx.WF env U viewBase) :
    ∃ viewFull,
      VLCtx.FVLift' viewBase viewFull dk lift k ∧
        VLCtx.IsDefEq env U full viewFull ∧
        TrExprS.IsUniqueCtx full viewFull ∧
        VLCtx.WF env U viewFull := by
  induction extension generalizing viewBase with
  | refl =>
      exact ⟨viewBase, .refl, baseRelation, baseUnique, viewBaseWF⟩
  | @skip_fvar base tail lift fv declaration extension ih =>
      obtain ⟨viewTail, viewExtension, tailRelation, tailUnique,
          viewTailWF⟩ :=
        ih fullWF.1 baseRelation baseUnique viewBaseWF
      have viewDeclarationWF : VLocalDecl.WF env U viewTail.toCtx declaration := by
        cases declaration <;>
          exact fullWF.2.2.defeqDFC henv.ordered tailRelation.defeqCtx
      have viewMetadata : ∀ currentFv currentDeps,
          some fv = some (currentFv, currentDeps) →
            currentFv ∉ viewTail.fvars ∧ currentDeps ⊆ viewTail.fvars := by
        intro currentFv currentDeps equality
        have pairEq : fv = (currentFv, currentDeps) := Option.some.inj equality
        subst fv
        simpa only [← tailRelation.fvars] using
          fullWF.2.1 currentFv currentDeps rfl
      have declarationRelation : VLocalDecl.IsDefEq env U tail.toCtx
          declaration declaration :=
        VLocalDecl.IsDefEq.refl henv.ordered fullWF.1.toCtx fullWF.2.2
      exact ⟨(some fv, declaration) :: viewTail,
        viewExtension.skip_fvar fv declaration,
        .cons tailRelation fullWF.2.1 declarationRelation,
        tailUnique.cons (by cases declaration <;> constructor),
        ⟨viewTailWF, viewMetadata, viewDeclarationWF⟩⟩
  | @cons_fvar tail fullTail lift fv declaration depsSubset extension ih =>
      cases baseRelation with
      | @cons ofv sourceDeclaration viewDeclaration sourceTail viewTail
          relation metadata declarationRelation =>
          cases baseUnique with
          | base =>
              exact ⟨_, extension.cons_fvar fv declaration depsSubset,
                .refl henv.ordered fullWF, .base, fullWF⟩
          | cons tailUnique declarationUnique =>
              obtain ⟨viewFullTail, viewExtension, fullRelation,
                  fullUnique, viewFullTailWF⟩ :=
                ih fullWF.1 relation tailUnique viewBaseWF.1
              have viewMetadata : ∀ currentFv currentDeps,
                  some fv = some (currentFv, currentDeps) →
                    currentFv ∉ viewFullTail.fvars ∧
                      currentDeps ⊆ viewFullTail.fvars := by
                intro currentFv currentDeps equality
                have pairEq : fv = (currentFv, currentDeps) :=
                  Option.some.inj equality
                subst fv
                refine ⟨?_, ?_⟩
                · simpa only [← fullRelation.fvars] using
                    fullWF.2.1 currentFv currentDeps rfl |>.1
                · intro member present
                  exact viewExtension.fvars_sublist.subset
                    ((viewBaseWF.2.1 currentFv currentDeps rfl).2 present)
              have viewDeclarationWF : VLocalDecl.WF env U
                  viewFullTail.toCtx
                    (VLocalDecl.lift' viewDeclaration lift) :=
                (VLocalDecl.weak'_iff henv viewFullTailWF.toCtx
                  viewExtension.toCtx).2 viewBaseWF.2.2
              have liftedRelation : VLocalDecl.IsDefEq env U fullTail.toCtx
                  (VLocalDecl.lift' declaration lift)
                  (VLocalDecl.lift' viewDeclaration lift) := by
                cases declarationRelation with
                | vlam relation =>
                    exact .vlam (relation.weak' henv.ordered extension.toCtx)
                | vlet valueRelation typeRelation =>
                    exact .vlet
                      (valueRelation.weak' henv.ordered extension.toCtx)
                      (typeRelation.weak' henv.ordered extension.toCtx)
              have depthEq : viewDeclaration.depth = declaration.depth := by
                cases declarationRelation <;> rfl
              have liftedUnique : TrExprS.IsUniqueDecl
                  (VLocalDecl.lift' declaration lift)
                  (VLocalDecl.lift' viewDeclaration lift) := by
                cases declarationUnique
                · exact .vlam
                · exact .vlet
              refine ⟨(some fv, VLocalDecl.lift' viewDeclaration lift) ::
                    viewFullTail,
                ?_,
                .cons fullRelation fullWF.2.1 liftedRelation,
                fullUnique.cons liftedUnique,
                ⟨viewFullTailWF, viewMetadata, viewDeclarationWF⟩⟩
              simpa only [depthEq] using
                viewExtension.cons_fvar fv viewDeclaration
                  (viewBaseWF.2.1 _ _ rfl).2
  | @cons_bvar tail fullTail dk lift k declaration extension ih =>
      cases baseRelation with
      | @cons ofv sourceDeclaration viewDeclaration sourceTail viewTail
          relation metadata declarationRelation =>
          cases baseUnique with
          | base =>
              exact ⟨_, extension.cons_bvar declaration,
                .refl henv.ordered fullWF, .base, fullWF⟩
          | cons tailUnique declarationUnique =>
              obtain ⟨viewFullTail, viewExtension, fullRelation,
                  fullUnique, viewFullTailWF⟩ :=
                ih fullWF.1 relation tailUnique viewBaseWF.1
              have viewDeclarationWF : VLocalDecl.WF env U
                  viewFullTail.toCtx
                  (VLocalDecl.lift' viewDeclaration (lift.consN k)) :=
                (VLocalDecl.weak'_iff henv viewFullTailWF.toCtx
                  viewExtension.toCtx).2 viewBaseWF.2.2
              have liftedRelation : VLocalDecl.IsDefEq env U fullTail.toCtx
                  (VLocalDecl.lift' declaration (lift.consN k))
                  (VLocalDecl.lift' viewDeclaration (lift.consN k)) := by
                cases declarationRelation with
                | vlam relation =>
                    exact .vlam (relation.weak' henv.ordered extension.toCtx)
                | vlet valueRelation typeRelation =>
                    exact .vlet
                      (valueRelation.weak' henv.ordered extension.toCtx)
                      (typeRelation.weak' henv.ordered extension.toCtx)
              have depthEq : viewDeclaration.depth = declaration.depth := by
                cases declarationRelation <;> rfl
              have liftedUnique : TrExprS.IsUniqueDecl
                  (VLocalDecl.lift' declaration (lift.consN k))
                  (VLocalDecl.lift' viewDeclaration (lift.consN k)) := by
                cases declarationUnique
                · exact .vlam
                · exact .vlet
              refine ⟨(none, VLocalDecl.lift' viewDeclaration
                    (lift.consN k)) :: viewFullTail,
                ?_,
                .cons fullRelation nofun liftedRelation,
                fullUnique.cons liftedUnique,
                ⟨viewFullTailWF, nofun, viewDeclarationWF⟩⟩
              simpa only [depthEq] using
                viewExtension.cons_bvar viewDeclaration

/-- Metadata-tolerant counterpart of `retypeSourceExact`.  This is the form
used to relocate the shared post-family validation context, whose dependency
lists may have been normalized independently of a family's candidate view. -/
theorem _root_.Lean4Lean.VLCtx.FVLift'.retypeSourceFVars
    {env : VEnv} {U : Nat}
    {base full viewBase : VLCtx} {dk k : Nat} {lift : Lift}
    (extension : VLCtx.FVLift' base full dk lift k)
    (henv : VEnv.WF env)
    (fullWF : VLCtx.WF env U full)
    (baseRelation : VLCtx.IsDefEqFVars env U base viewBase)
    (viewBaseWF : VLCtx.WF env U viewBase) :
    ∃ viewFull,
      VLCtx.FVLift' viewBase viewFull dk lift k ∧
        VLCtx.IsDefEqFVars env U full viewFull ∧
        VLCtx.WF env U viewFull := by
  induction extension generalizing viewBase with
  | refl => exact ⟨viewBase, .refl, baseRelation, viewBaseWF⟩
  | @skip_fvar base tail lift fv declaration extension ih =>
      obtain ⟨viewTail, viewExtension, tailRelation, viewTailWF⟩ :=
        ih fullWF.1 baseRelation viewBaseWF
      have viewDeclarationWF : VLocalDecl.WF env U viewTail.toCtx declaration := by
        cases declaration <;>
          exact fullWF.2.2.defeqDFC henv.ordered tailRelation.defeqCtx
      have viewMetadata : ∀ currentFv currentDeps,
          some fv = some (currentFv, currentDeps) →
            currentFv ∉ viewTail.fvars ∧ currentDeps ⊆ viewTail.fvars := by
        intro currentFv currentDeps equality
        have pairEq : fv = (currentFv, currentDeps) := Option.some.inj equality
        subst fv
        simpa only [← tailRelation.fvars] using
          fullWF.2.1 currentFv currentDeps rfl
      have declarationRelation : VLocalDecl.IsDefEq env U tail.toCtx
          declaration declaration :=
        VLocalDecl.IsDefEq.refl henv.ordered fullWF.1.toCtx fullWF.2.2
      exact ⟨(some fv, declaration) :: viewTail,
        viewExtension.skip_fvar fv declaration,
        .cons_fvar tailRelation declarationRelation,
        ⟨viewTailWF, viewMetadata, viewDeclarationWF⟩⟩
  | @cons_fvar tail fullTail lift fv declaration depsSubset extension ih =>
      cases baseRelation with
      | @cons_fvar sourceTail viewTail sourceDeclaration viewDeclaration
          fvar sourceDeps viewDeps relation declarationRelation =>
          obtain ⟨viewFullTail, viewExtension, fullRelation,
              viewFullTailWF⟩ := ih fullWF.1 relation viewBaseWF.1
          have viewMetadata : ∀ currentFv currentDeps,
              some (fvar, viewDeps) = some (currentFv, currentDeps) →
                currentFv ∉ viewFullTail.fvars ∧
                  currentDeps ⊆ viewFullTail.fvars := by
            intro currentFv currentDeps equality
            have pairEq := Option.some.inj equality
            rcases pairEq with ⟨rfl, rfl⟩
            refine ⟨?_, ?_⟩
            · simpa only [← fullRelation.fvars] using
                fullWF.2.1 fvar sourceDeps rfl |>.1
            · intro member present
              exact viewExtension.fvars_sublist.subset
                ((viewBaseWF.2.1 fvar viewDeps rfl).2 present)
          have viewDeclarationWF : VLocalDecl.WF env U
              viewFullTail.toCtx
                (VLocalDecl.lift' viewDeclaration lift) :=
            (VLocalDecl.weak'_iff henv viewFullTailWF.toCtx
              viewExtension.toCtx).2 viewBaseWF.2.2
          have liftedRelation : VLocalDecl.IsDefEq env U fullTail.toCtx
              (VLocalDecl.lift' declaration lift)
              (VLocalDecl.lift' viewDeclaration lift) := by
            cases declarationRelation with
            | vlam relation =>
                exact .vlam (relation.weak' henv.ordered extension.toCtx)
            | vlet valueRelation typeRelation =>
                exact .vlet
                  (valueRelation.weak' henv.ordered extension.toCtx)
                  (typeRelation.weak' henv.ordered extension.toCtx)
          have depthEq : viewDeclaration.depth = declaration.depth := by
            cases declarationRelation <;> rfl
          refine ⟨(some (fvar, viewDeps),
                VLocalDecl.lift' viewDeclaration lift) ::
                viewFullTail,
            ?_,
            .cons_fvar fullRelation liftedRelation,
            ⟨viewFullTailWF, viewMetadata, viewDeclarationWF⟩⟩
          simpa only [depthEq] using
            viewExtension.cons_fvar (fvar, viewDeps) viewDeclaration
              (viewBaseWF.2.1 _ _ rfl).2
  | @cons_bvar tail fullTail dk lift k declaration extension ih =>
      cases baseRelation with
      | @cons_bvar sourceTail viewTail sourceDeclaration viewDeclaration
          relation declarationRelation =>
          obtain ⟨viewFullTail, viewExtension, fullRelation,
              viewFullTailWF⟩ := ih fullWF.1 relation viewBaseWF.1
          have viewDeclarationWF : VLocalDecl.WF env U
              viewFullTail.toCtx
              (VLocalDecl.lift' viewDeclaration (lift.consN k)) :=
            (VLocalDecl.weak'_iff henv viewFullTailWF.toCtx
              viewExtension.toCtx).2 viewBaseWF.2.2
          have liftedRelation : VLocalDecl.IsDefEq env U fullTail.toCtx
              (VLocalDecl.lift' declaration (lift.consN k))
              (VLocalDecl.lift' viewDeclaration (lift.consN k)) := by
            cases declarationRelation with
            | vlam relation =>
                exact .vlam (relation.weak' henv.ordered extension.toCtx)
            | vlet valueRelation typeRelation =>
                exact .vlet
                  (valueRelation.weak' henv.ordered extension.toCtx)
                  (typeRelation.weak' henv.ordered extension.toCtx)
          have depthEq : viewDeclaration.depth = declaration.depth := by
            cases declarationRelation <;> rfl
          refine ⟨(none, VLocalDecl.lift' viewDeclaration
                (lift.consN k)) :: viewFullTail,
            ?_,
            .cons_bvar fullRelation liftedRelation,
            ⟨viewFullTailWF, nofun, viewDeclarationWF⟩⟩
          simpa only [depthEq] using
            viewExtension.cons_bvar viewDeclaration

/-- Instantiate a family parameter prefix after retyping it to another
definitionally equal telescope, then replay the exact strict endpoint back in
the original shared-parameter context. -/
theorem _root_.Lean4Lean.TypeChecker.CandidateParameterContext.instantiateForallRetyped
    {env : VEnv} {Us : List Name}
    {parameters : List Expr} {types viewTypes : List VExpr}
    {final : VLCtx} {source rest : Expr} {result : VExpr}
    (params : TypeChecker.CandidateParameterContext [] parameters types final)
    (henv : VEnv.WF env)
    (finalWF : VLCtx.WF env Us.length final)
    (evidence : TypeChecker.TelDefEqEvidence env Us.length [] types viewTypes)
    (instantiation : AddInductive.instantiateFamilyParameters source
      parameters = .ok rest)
    (tr : TrExprS env Us [] source (VExpr.forallN viewTypes result))
    (unique : TrExprS.IsUnique rest) :
    TrExprS env Us final rest result := by
  obtain ⟨viewFinal, viewParams, relation, uniqueContext, viewFinalWF⟩ :=
    params.retypeExact henv evidence finalWF
  have viewRun : TrExprS env Us viewFinal rest result :=
    viewParams.instantiateForall henv.ordered viewFinalWF instantiation tr
  obtain ⟨commonResult, commonRun⟩ :=
    viewRun.defeqDFC henv (relation.symm henv.ordered)
  have resultEq : commonResult = result :=
    commonRun.unique' uniqueContext unique viewRun
  cases resultEq
  exact commonRun

/-- Projection-aware counterpart of `instantiateForallRetyped`.  The
retyped parameter contexts preserve every variable value, so the strict
translation can be moved back with its original resolved projection
programs and literal endpoint. -/
theorem _root_.Lean4Lean.TypeChecker.CandidateParameterContext.instantiateForallRetypedResolved
    {env : VEnv} {Us : List Name}
    {parameters : List Expr} {types viewTypes : List VExpr}
    {final : VLCtx} {source rest : Expr} {result : VExpr}
    (params : TypeChecker.CandidateParameterContext [] parameters types final)
    (henv : VEnv.WF env)
    (finalWF : VLCtx.WF env Us.length final)
    (evidence : TypeChecker.TelDefEqEvidence env Us.length [] types viewTypes)
    (instantiation : AddInductive.instantiateFamilyParameters source
      parameters = .ok rest)
    (tr : TrExprS env Us [] source (VExpr.forallN viewTypes result)) :
    TrExprS env Us final rest result := by
  obtain ⟨viewFinal, viewParams, relation, uniqueContext, viewFinalWF⟩ :=
    params.retypeExact henv evidence finalWF
  have viewRun : TrExprS env Us viewFinal rest result :=
    viewParams.instantiateForall henv.ordered viewFinalWF instantiation tr
  exact viewRun.defeqDFC_same henv (relation.symm henv.ordered)
    uniqueContext.symm

/-- Replace the endpoint of an instantiated parameter prefix and rebuild the
exact strict translation of the original full Pi expression.

This is the converse staging operation to `instantiateForall`: the original
derivation supplies the parameter-domain translations, while `selected`
supplies the construction-owned terminal derivation.  No uniqueness premise
is used, so resolved projector programs in the selected endpoint are retained
literally. -/
theorem _root_.Lean4Lean.TypeChecker.CandidateParameterContext.rebuildForall
    {env : VEnv} {Us : List Name}
    {base final : VLCtx} {parameters : List Expr} {types : List VExpr}
    {source rest : Expr} {originalResult selectedResult : VExpr}
    (params : TypeChecker.CandidateParameterContext base parameters types
      final)
    (henv : VEnv.WF env)
    (finalWF : VLCtx.WF env Us.length final)
    (instantiation : AddInductive.instantiateFamilyParameters source
      parameters = .ok rest)
    (original : TrExprS env Us base source
      (VExpr.forallN types originalResult))
    (selected : TrExprS env Us final rest selectedResult) :
    TrExprS env Us base source (VExpr.forallN types selectedResult) := by
  induction params generalizing source rest originalResult selectedResult with
  | nil =>
      have source_eq : source = rest := Except.ok.inj instantiation
      subst rest
      simpa only [VExpr.forallN] using selected
  | @cons fv deps A base parameters types final tail ih =>
      cases source <;>
        simp only [AddInductive.instantiateFamilyParameters] at instantiation
      case forallE name domain body binderInfo =>
        cases original with
        | forallE domainType bodyType domainTr bodyTr =>
            have nextWF : VLCtx.WF env Us.length
                ((some (fv, deps), .vlam A) :: base) :=
              tail.initialWF finalWF
            have bodyOpened : TrExprS env Us
                ((some (fv, deps), .vlam A) :: base)
                (body.instantiate1 (.fvar fv))
                (VExpr.forallN types originalResult) := by
              simpa only [Expr.instantiate1_eq] using
                bodyTr.inst_fvar henv.ordered nextWF
            have selectedOpened : TrExprS env Us
                ((some (fv, deps), .vlam A) :: base)
                (body.instantiate1 (.fvar fv))
                (VExpr.forallN types selectedResult) :=
              ih finalWF instantiation bodyOpened selected
            have fresh : fv ∉ VLCtx.fvars base :=
              (nextWF.2.1 fv deps rfl).1
            have bodyAvoid : body.FVarsIn (· ≠ fv) :=
              bodyTr.fvarsIn.mono (fun current member equality => by
                subst current
                exact fresh (by simpa [VLCtx.fvars] using member))
            have selectedOpened' : TrExprS env Us
                ((some (fv, deps), .vlam A) :: base)
                (body.instantiate1' (.fvar fv))
                (VExpr.forallN types selectedResult) := by
              simpa only [Expr.instantiate1_eq] using selectedOpened
            have selectedBody : TrExprS env Us
                ((none, .vlam A) :: base) body
                (VExpr.forallN types selectedResult) := by
              exact selectedOpened'.uninstantiate (deps := deps) bodyAvoid
            have binderWF : VLCtx.WF env Us.length
                ((none, .vlam A) :: base) :=
              ⟨nextWF.1, nofun, domainType⟩
            have bodyEq : env.IsDefEqU Us.length (A :: VLCtx.toCtx base)
                (VExpr.forallN types originalResult)
                (VExpr.forallN types selectedResult) :=
              bodyTr.uniq henv (.refl henv binderWF) selectedBody
            have selectedBodyType : env.IsType Us.length
                (A :: VLCtx.toCtx base)
                (VExpr.forallN types selectedResult) :=
              bodyType.defeqU_l henv binderWF.toCtx bodyEq
            exact .forallE domainType selectedBodyType domainTr selectedBody
      all_goals exact nomatch instantiation

/-- Exact source-ordered family-suffix translations in one shared parameter
context.  Every entry is simultaneously indexed by the kernel candidate, its
semantic family root, the executable suffix inventory, the canonical checked
family, and the corresponding parameter-telescope equality. -/
inductive CandidateBlockFamilySuffixTranslationList
    (env blockEnv : VEnv) (Us : List Name)
    (stats : AddInductive.InductiveStats) (nparams : Nat)
    (firstView : VExpr) (params : List VExpr) (source : VInductDecl)
    (parameterΔ : VLCtx) :
    {sources : List InductiveType} →
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources} →
    {raws : List VInductiveType} →
    (semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws) →
    AddInductive.ConstructorBlockFamilyParameterSuffixes stats candidates →
    {ordinal : Nat} →
    (checked : CheckedFamilies source params ordinal
      (canonicalizeFamilyParamsList nparams params semantics.views)) →
    CandidateBlockFamilyViewParameterDefEqList env blockEnv Us nparams
      firstView semantics → Type where
  | nil {ordinal : Nat} :
      CandidateBlockFamilySuffixTranslationList env blockEnv Us stats
        nparams firstView params source parameterΔ
        CandidateBlockFamilySemanticListRun.nil
        AddInductive.ConstructorBlockFamilyParameterSuffixes.nil
        (CheckedFamilies.nil (ordinal := ordinal))
        CandidateBlockFamilyViewParameterDefEqList.nil
  | cons
      {ordinal : Nat}
      {kernelSource : InductiveType} {kernelSources : List InductiveType}
      {candidate : AddInductive.CandidateFamily kernelSource}
      {candidates : AddInductive.CandidateList AddInductive.CandidateFamily
        kernelSources}
      {raw : VInductiveType} {raws : List VInductiveType}
      {semantic : CandidateBlockFamilySemanticRun env blockEnv Us candidate raw}
      {semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
        candidates raws}
      {translationUnique : AddInductive.theoryTranslationUnique
        candidate.familyType.type.view = true}
      {suffix : Expr}
      {parameters : AddInductive.instantiateFamilyParameters
        candidate.familyType.type.view stats.params.toList = .ok suffix}
      {suffixTail : AddInductive.ConstructorBlockFamilyParameterSuffixes
        stats candidates}
      {checkedHead : CheckedFamily source params ordinal
        (canonicalizeFamilyParams nparams params semantic.view)}
      {checkedTail : CheckedFamilies source params (ordinal + 1)
        (canonicalizeFamilyParamsList nparams params semantics.views)}
      {headDefEq : TypeChecker.TelDefEqEvidence env Us.length []
        (VExpr.telN nparams firstView)
        (VExpr.telN nparams semantic.type.view)}
      {tailDefEq : CandidateBlockFamilyViewParameterDefEqList env blockEnv Us
        nparams firstView semantics}
      (unique : TrExprS.IsUnique suffix)
      (head : TrExprS env Us parameterΔ suffix
        (VExpr.forallN checkedHead.indices (.sort checkedHead.resultLevel)))
      (tail : CandidateBlockFamilySuffixTranslationList env blockEnv Us stats
        nparams firstView params source parameterΔ semantics suffixTail
        checkedTail tailDefEq) :
      CandidateBlockFamilySuffixTranslationList env blockEnv Us stats
        nparams firstView params source parameterΔ
        (.cons semantic semantics)
        (.cons translationUnique suffix parameters suffixTail)
        (.cons checkedHead checkedTail)
        (.cons headDefEq tailDefEq)

namespace CandidateBlockFamilySuffixTranslationList

/-- Construct the exact suffix-translation inventory from the producer's
shared parameter context and per-family telescope comparisons. -/
theorem nonempty
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {nparams : Nat}
    {firstView : VExpr} {params : List VExpr} {source : VInductDecl}
    {parameterΔ : VLCtx}
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    (semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws)
    (suffixes : AddInductive.ConstructorBlockFamilyParameterSuffixes stats
      candidates)
    {ordinal : Nat}
    (checked : CheckedFamilies source params ordinal
      (canonicalizeFamilyParamsList nparams params semantics.views))
    (parameterDefEqs : CandidateBlockFamilyViewParameterDefEqList env blockEnv
      Us nparams firstView semantics)
    (parameterContext : TypeChecker.CandidateParameterContext []
      stats.params.toList (VExpr.telN nparams firstView) parameterΔ)
    (henv : VEnv.WF env)
    (parameterWF : VLCtx.WF env Us.length parameterΔ)
    (paramsLength : params.length = nparams) :
    Nonempty (CandidateBlockFamilySuffixTranslationList env blockEnv Us stats
      nparams firstView params source parameterΔ semantics suffixes checked
      parameterDefEqs) := by
  induction suffixes generalizing raws ordinal with
  | nil =>
      cases semantics
      cases checked
      cases parameterDefEqs
      exact ⟨.nil⟩
  | @cons kernelSource kernelSources candidate candidates translationUnique
      suffix parameters suffixTail ih =>
      cases semantics with
      | cons semantic semantics =>
          cases checked with
          | cons checkedHead checkedTail =>
              cases parameterDefEqs with
              | cons headDefEq tailDefEq =>
                  have familyUnique : TrExprS.IsUnique
                      candidate.familyType.type.view :=
                    AddInductive.theoryTranslationUnique_sound
                      translationUnique
                  have traceUnique :
                      TypeChecker.CandidateExprTraceViewIsUnique
                        candidate.familyType.type.trace := by
                    apply candidate.familyType.type.trace
                      |>.viewTranslationUnique_sound
                    rw [candidate.familyType.type.trace
                      |>.viewTranslationUnique_eq]
                    exact translationUnique
                  obtain ⟨_, familyRecursive⟩ := semantic.type.recursive
                  have familyTr : TrExprS env Us []
                      candidate.familyType.type.view semantic.type.view :=
                    familyRecursive.view_tr_strict traceUnique
                  have familyTr' : TrExprS env Us []
                      candidate.familyType.type.view
                      (VExpr.forallN
                        (VExpr.telN nparams semantic.type.view)
                        (VExpr.dropN nparams semantic.type.view)) := by
                    rw [VExpr.forallN_telN_dropN]
                    exact familyTr
                  have suffixUnique : TrExprS.IsUnique suffix :=
                    ConstructorValidation.instantiateFamilyParameters_unique
                      familyUnique
                      (ConstructorValidation.CandidateParameterContext.parametersUnique
                        parameterContext)
                      parameters
                  have suffixTr : TrExprS env Us parameterΔ suffix
                      (VExpr.dropN nparams semantic.type.view) :=
                    parameterContext.instantiateForallRetyped henv parameterWF
                      headDefEq parameters familyTr' suffixUnique
                  have suffixEq : VExpr.dropN nparams semantic.type.view =
                      VExpr.forallN checkedHead.indices
                        (.sort checkedHead.resultLevel) := by
                    calc
                      VExpr.dropN nparams semantic.type.view =
                          VExpr.dropN nparams
                            (canonicalizeFamilyParams nparams params
                              semantic.view).type := by
                        symm
                        simpa only [CandidateBlockFamilySemanticRun.view] using
                          canonicalizeFamilyParams_dropN paramsLength
                      _ = VExpr.dropN nparams
                          (VExpr.forallN params
                            (VExpr.forallN checkedHead.indices
                              (.sort checkedHead.resultLevel))) :=
                        congrArg (VExpr.dropN nparams) checkedHead.type_eq
                      _ = VExpr.forallN checkedHead.indices
                          (.sort checkedHead.resultLevel) := by
                        let result := VExpr.forallN checkedHead.indices
                          (.sort checkedHead.resultLevel)
                        change VExpr.dropN nparams
                          (VExpr.forallN params result) = result
                        calc
                          _ = VExpr.dropN params.length
                              (VExpr.forallN params result) := by
                            rw [paramsLength]
                          _ = result := VExpr.dropN_forallN_length params result
                  rw [suffixEq] at suffixTr
                  obtain ⟨tail⟩ := ih semantics checkedTail tailDefEq
                  exact ⟨CandidateBlockFamilySuffixTranslationList.cons
                    (translationUnique := translationUnique)
                    (parameters := parameters)
                    (headDefEq := headDefEq) suffixUnique suffixTr tail⟩

/-- Ordinal lookup in the executable suffix list recovers the exact checked
family index telescope, its result universe, and the strict translation tying
the selected kernel suffix to both. -/
theorem getElem?
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {nparams : Nat}
    {firstView : VExpr} {params : List VExpr} {source : VInductDecl}
    {parameterΔ : VLCtx}
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    {semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws}
    {suffixes : AddInductive.ConstructorBlockFamilyParameterSuffixes stats
      candidates}
    {ordinal : Nat}
    {checked : CheckedFamilies source params ordinal
      (canonicalizeFamilyParamsList nparams params semantics.views)}
    {parameterDefEqs : CandidateBlockFamilyViewParameterDefEqList env blockEnv
      Us nparams firstView semantics}
    (runs : CandidateBlockFamilySuffixTranslationList env blockEnv Us stats
      nparams firstView params source parameterΔ semantics suffixes checked
      parameterDefEqs)
    {offset : Nat} {suffix : Expr}
    (found : suffixes.values[offset]? = some suffix) :
    ∃ indices resultLevel,
      checked.indices[offset]? = some indices ∧
        checked.resultLevels[offset]? = some resultLevel ∧
        TrExprS env Us parameterΔ suffix
          (VExpr.forallN indices (.sort resultLevel)) ∧
        TrExprS.IsUnique suffix := by
  induction runs generalizing offset suffix with
  | nil => simp [AddInductive.ConstructorBlockFamilyParameterSuffixes.values]
      at found
  | @cons ordinal kernelSource kernelSources candidate candidates raw raws
      semantic semantics translationUnique storedSuffix parameters suffixTail
      checkedHead checkedTail headDefEq tailDefEq unique head tail ih =>
      cases offset with
      | zero =>
          simp only [AddInductive.ConstructorBlockFamilyParameterSuffixes.values,
            List.getElem?_cons_zero] at found
          have suffixEq : storedSuffix = suffix := Option.some.inj found
          subst suffix
          exact ⟨checkedHead.indices, checkedHead.resultLevel, rfl, rfl,
            head, unique⟩
      | succ offset =>
          simp only [AddInductive.ConstructorBlockFamilyParameterSuffixes.values,
            List.getElem?_cons_succ] at found
          obtain ⟨indices, resultLevel, indicesAt, levelAt, translation,
              suffixUnique⟩ :=
            ih found
          exact ⟨indices, resultLevel, indicesAt, levelAt, translation,
            suffixUnique⟩

/-- At the start of constructor-field replay, the exact suffix inventory is
already the complete mutual target state.  The only additional input is the
producer's positional family header/count inventory; all translations and
source uniqueness facts remain tied to the same executable suffix lookup. -/
theorem mutualTargetState
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {nparams : Nat}
    {firstView : VExpr} {params : List VExpr} {source : VInductDecl}
    {parameterΔ : VLCtx}
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    {semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws}
    {suffixes : AddInductive.ConstructorBlockFamilyParameterSuffixes stats
      candidates}
    {ordinal : Nat}
    {checked : CheckedFamilies source params ordinal
      (canonicalizeFamilyParamsList nparams params semantics.views)}
    {parameterDefEqs : CandidateBlockFamilyViewParameterDefEqList env blockEnv
      Us nparams firstView semantics}
    (runs : CandidateBlockFamilySuffixTranslationList env blockEnv Us stats
      nparams firstView params source parameterΔ semantics suffixes checked
      parameterDefEqs)
    (addType : env ≤ blockEnv)
    (familyDataAt : ∀ {i : Nat} {indices : List VExpr},
      checked.indices[i]? = some indices →
        ∃ header,
          (familyHeaders source.nparams source.types)[i]? = some header ∧
          stats.indConsts[i]! = .const header.name stats.levels ∧
          indices.length = stats.nindices[i]!) :
    ConstructorValidation.MutualFamilyTargetState env blockEnv Us stats
      (familyHeaders source.nparams source.types) suffixes.values
      checked.indices parameterΔ parameterΔ 0 := by
  intro targetIdx targetSuffix targetAt
  obtain ⟨indices, resultLevel, indicesAt, _resultLevelAt, translation,
      suffixUnique⟩ := runs.getElem? targetAt
  obtain ⟨header, headerAt, familyHead, indexLength⟩ :=
    familyDataAt indicesAt
  exact ⟨indices, indices, resultLevel,
    VExpr.forallN indices (.sort resultLevel), header,
    indicesAt, headerAt, familyHead, suffixUnique, indexLength,
    translation, translation.mono addType, by simp⟩

end CandidateBlockFamilySuffixTranslationList

/-- Projection-aware counterpart of
`CandidateBlockFamilySuffixTranslationList`.  Each family suffix is tied to
the literal endpoint selected by its retained semantic run, without claiming
that an independently resolved projection must have the same syntax. -/
inductive CandidateBlockResolvedFamilySuffixTranslationList
    (env blockEnv : VEnv) (Us : List Name)
    (stats : AddInductive.InductiveStats) (nparams : Nat)
    (firstView : VExpr) (params : List VExpr) (source : VInductDecl)
    (parameterΔ : VLCtx) :
    {sources : List InductiveType} →
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources} →
    {raws : List VInductiveType} →
    (semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws) →
    AddInductive.ConstructorBlockResolvedFamilyParameterSuffixes stats
      candidates →
    {ordinal : Nat} →
    (checked : CheckedFamilies source params ordinal
      (canonicalizeFamilyParamsList nparams params semantics.views)) →
    CandidateBlockFamilyViewParameterDefEqList env blockEnv Us nparams
      firstView semantics → Type where
  | nil {ordinal : Nat} :
      CandidateBlockResolvedFamilySuffixTranslationList env blockEnv Us stats
        nparams firstView params source parameterΔ
        CandidateBlockFamilySemanticListRun.nil
        AddInductive.ConstructorBlockResolvedFamilyParameterSuffixes.nil
        (CheckedFamilies.nil (ordinal := ordinal))
        CandidateBlockFamilyViewParameterDefEqList.nil
  | cons
      {ordinal : Nat}
      {kernelSource : InductiveType} {kernelSources : List InductiveType}
      {candidate : AddInductive.CandidateFamily kernelSource}
      {candidates : AddInductive.CandidateList AddInductive.CandidateFamily
        kernelSources}
      {raw : VInductiveType} {raws : List VInductiveType}
      {semantic : CandidateBlockFamilySemanticRun env blockEnv Us candidate raw}
      {semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
        candidates raws}
      {suffix : Expr}
      {parameters : AddInductive.instantiateFamilyParameters
        candidate.familyType.type.view stats.params.toList = .ok suffix}
      {suffixTail :
        AddInductive.ConstructorBlockResolvedFamilyParameterSuffixes stats
          candidates}
      {checkedHead : CheckedFamily source params ordinal
        (canonicalizeFamilyParams nparams params semantic.view)}
      {checkedTail : CheckedFamilies source params (ordinal + 1)
        (canonicalizeFamilyParamsList nparams params semantics.views)}
      {headDefEq : TypeChecker.TelDefEqEvidence env Us.length []
        (VExpr.telN nparams firstView)
        (VExpr.telN nparams semantic.type.view)}
      {tailDefEq : CandidateBlockFamilyViewParameterDefEqList env blockEnv Us
        nparams firstView semantics}
      (head : TrExprS env Us parameterΔ suffix
        (VExpr.forallN checkedHead.indices (.sort checkedHead.resultLevel)))
      (tail : CandidateBlockResolvedFamilySuffixTranslationList env blockEnv
        Us stats nparams firstView params source parameterΔ semantics
        suffixTail checkedTail tailDefEq) :
      CandidateBlockResolvedFamilySuffixTranslationList env blockEnv Us stats
        nparams firstView params source parameterΔ
        (.cons semantic semantics)
        (.cons suffix parameters suffixTail)
        (.cons checkedHead checkedTail)
        (.cons headDefEq tailDefEq)

namespace CandidateBlockResolvedFamilySuffixTranslationList

theorem nonempty
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {nparams : Nat}
    {firstView : VExpr} {params : List VExpr} {source : VInductDecl}
    {parameterΔ : VLCtx}
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    (semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws)
    (suffixes : AddInductive.ConstructorBlockResolvedFamilyParameterSuffixes
      stats candidates)
    {ordinal : Nat}
    (checked : CheckedFamilies source params ordinal
      (canonicalizeFamilyParamsList nparams params semantics.views))
    (parameterDefEqs : CandidateBlockFamilyViewParameterDefEqList env blockEnv
      Us nparams firstView semantics)
    (parameterContext : TypeChecker.CandidateParameterContext []
      stats.params.toList (VExpr.telN nparams firstView) parameterΔ)
    (henv : VEnv.WF env)
    (parameterWF : VLCtx.WF env Us.length parameterΔ)
    (paramsLength : params.length = nparams) :
    Nonempty (CandidateBlockResolvedFamilySuffixTranslationList env blockEnv
      Us stats nparams firstView params source parameterΔ semantics suffixes
      checked parameterDefEqs) := by
  induction suffixes generalizing raws ordinal with
  | nil =>
      cases semantics
      cases checked
      cases parameterDefEqs
      exact ⟨.nil⟩
  | @cons kernelSource kernelSources candidate candidates suffix parameters
      suffixTail ih =>
      cases semantics with
      | cons semantic semantics =>
          cases checked with
          | cons checkedHead checkedTail =>
              cases parameterDefEqs with
              | cons headDefEq tailDefEq =>
                  obtain ⟨_, familyRecursive⟩ := semantic.type.recursive
                  have familyTr : TrExprS env Us []
                      candidate.familyType.type.view semantic.type.view :=
                    familyRecursive.view_tr_resolved
                  have familyTr' : TrExprS env Us []
                      candidate.familyType.type.view
                      (VExpr.forallN
                        (VExpr.telN nparams semantic.type.view)
                        (VExpr.dropN nparams semantic.type.view)) := by
                    rw [VExpr.forallN_telN_dropN]
                    exact familyTr
                  have suffixTr : TrExprS env Us parameterΔ suffix
                      (VExpr.dropN nparams semantic.type.view) :=
                    parameterContext.instantiateForallRetypedResolved henv
                      parameterWF headDefEq parameters familyTr'
                  have suffixEq : VExpr.dropN nparams semantic.type.view =
                      VExpr.forallN checkedHead.indices
                        (.sort checkedHead.resultLevel) := by
                    calc
                      VExpr.dropN nparams semantic.type.view =
                          VExpr.dropN nparams
                            (canonicalizeFamilyParams nparams params
                              semantic.view).type := by
                        symm
                        simpa only [CandidateBlockFamilySemanticRun.view] using
                          canonicalizeFamilyParams_dropN paramsLength
                      _ = VExpr.dropN nparams
                          (VExpr.forallN params
                            (VExpr.forallN checkedHead.indices
                              (.sort checkedHead.resultLevel))) :=
                        congrArg (VExpr.dropN nparams) checkedHead.type_eq
                      _ = VExpr.forallN checkedHead.indices
                          (.sort checkedHead.resultLevel) := by
                        let result := VExpr.forallN checkedHead.indices
                          (.sort checkedHead.resultLevel)
                        change VExpr.dropN nparams
                          (VExpr.forallN params result) = result
                        calc
                          _ = VExpr.dropN params.length
                              (VExpr.forallN params result) := by
                            rw [paramsLength]
                          _ = result :=
                            VExpr.dropN_forallN_length params result
                  rw [suffixEq] at suffixTr
                  obtain ⟨tail⟩ := ih semantics checkedTail tailDefEq
                  exact ⟨.cons (parameters := parameters)
                    (headDefEq := headDefEq) suffixTr tail⟩

theorem getElem?
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {nparams : Nat}
    {firstView : VExpr} {params : List VExpr} {source : VInductDecl}
    {parameterΔ : VLCtx}
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    {semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws}
    {suffixes : AddInductive.ConstructorBlockResolvedFamilyParameterSuffixes
      stats candidates}
    {ordinal : Nat}
    {checked : CheckedFamilies source params ordinal
      (canonicalizeFamilyParamsList nparams params semantics.views)}
    {parameterDefEqs : CandidateBlockFamilyViewParameterDefEqList env blockEnv
      Us nparams firstView semantics}
    (runs : CandidateBlockResolvedFamilySuffixTranslationList env blockEnv Us
      stats nparams firstView params source parameterΔ semantics suffixes
      checked parameterDefEqs)
    {offset : Nat} {suffix : Expr}
    (found : suffixes.values[offset]? = some suffix) :
    ∃ indices resultLevel,
      checked.indices[offset]? = some indices ∧
        checked.resultLevels[offset]? = some resultLevel ∧
        TrExprS env Us parameterΔ suffix
          (VExpr.forallN indices (.sort resultLevel)) := by
  induction runs generalizing offset suffix with
  | nil =>
      simp [AddInductive.ConstructorBlockResolvedFamilyParameterSuffixes.values]
        at found
  | @cons ordinal kernelSource kernelSources candidate candidates raw raws
      semantic semantics storedSuffix parameters suffixTail checkedHead
      checkedTail headDefEq tailDefEq head tail ih =>
      cases offset with
      | zero =>
          simp only [
            AddInductive.ConstructorBlockResolvedFamilyParameterSuffixes.values,
            List.getElem?_cons_zero] at found
          have suffixEq : storedSuffix = suffix := Option.some.inj found
          subst suffix
          exact ⟨checkedHead.indices, checkedHead.resultLevel, rfl, rfl,
            head⟩
      | succ offset =>
          simp only [
            AddInductive.ConstructorBlockResolvedFamilyParameterSuffixes.values,
            List.getElem?_cons_succ] at found
          exact ih found

theorem mutualTargetState
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {nparams : Nat}
    {firstView : VExpr} {params : List VExpr} {source : VInductDecl}
    {parameterΔ : VLCtx}
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    {semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws}
    {suffixes : AddInductive.ConstructorBlockResolvedFamilyParameterSuffixes
      stats candidates}
    {ordinal : Nat}
    {checked : CheckedFamilies source params ordinal
      (canonicalizeFamilyParamsList nparams params semantics.views)}
    {parameterDefEqs : CandidateBlockFamilyViewParameterDefEqList env blockEnv
      Us nparams firstView semantics}
    (runs : CandidateBlockResolvedFamilySuffixTranslationList env blockEnv Us
      stats nparams firstView params source parameterΔ semantics suffixes
      checked parameterDefEqs)
    (addType : env ≤ blockEnv)
    (familyDataAt : ∀ {i : Nat} {indices : List VExpr},
      checked.indices[i]? = some indices →
        ∃ header,
          (familyHeaders source.nparams source.types)[i]? = some header ∧
          stats.indConsts[i]! = .const header.name stats.levels ∧
          stats.nindices[i]! = header.indices ∧
          indices.length = stats.nindices[i]!) :
    ConstructorValidation.ResolvedMutualFamilyTargetState env blockEnv Us
      stats (familyHeaders source.nparams source.types) suffixes.values
      checked.indices parameterΔ parameterΔ 0 .refl := by
  intro targetIdx targetSuffix targetAt
  obtain ⟨indices, resultLevel, indicesAt, _resultLevelAt, translation⟩ :=
    runs.getElem? targetAt
  obtain ⟨header, headerAt, familyHead, headerIndices, indexLength⟩ :=
    familyDataAt indicesAt
  exact ⟨indices, indices, resultLevel,
    VExpr.forallN indices (.sort resultLevel), header,
    indicesAt, headerAt, familyHead, headerIndices, indexLength,
    translation, translation.mono addType, by simp, by simp⟩

end CandidateBlockResolvedFamilySuffixTranslationList

/-- Canonical family index telescopes without any constructor-acceptance
payload.  This projection is available before a `CheckedFamilies` value is
constructed. -/
def canonicalFamilyIndexLists (nparams : Nat) (params : List VExpr)
    (families : List VInductiveType) : List (List VExpr) :=
  (canonicalizeFamilyParamsList nparams params families).map fun family =>
    ctorFields (VExpr.dropN nparams family.type)

/-- Shape-neutral translations of all resolved family suffixes.  Unlike the
older dependent list, this state is indexed only by semantic families and
therefore does not presuppose constructor Stage-3 acceptance. -/
def ResolvedFamilyTargetTranslationState
    (env : VEnv) (Us : List Name) (nparams : Nat) (params : List VExpr)
    (parameterΔ : VLCtx)
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    (semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws)
    (suffixes : AddInductive.ConstructorBlockResolvedFamilyParameterSuffixes
      stats candidates) : Prop :=
  ∀ {offset : Nat} {suffix : Expr},
    suffixes.values[offset]? = some suffix →
      ∃ family indices resultLevel,
        (canonicalizeFamilyParamsList nparams params semantics.views)[offset]? =
            some family ∧
          (canonicalFamilyIndexLists nparams params semantics.views)[offset]? =
            some indices ∧
          indices = ctorFields (VExpr.dropN nparams family.type) ∧
          VExpr.resultOf (VExpr.dropN nparams family.type) =
            .sort resultLevel ∧
          TrExprS env Us parameterΔ suffix
            (VExpr.forallN indices (.sort resultLevel))

/-- Semantic normalization, terminal sorts, and generation spines construct
the family target state without consulting any constructor classifier. -/
theorem ResolvedFamilyTargetTranslationState.ofSemantics
    {env : VEnv} {Us : List Name} {stats : AddInductive.InductiveStats}
    {nparams : Nat} {firstView : VExpr} {params : List VExpr}
    {parameterΔ : VLCtx}
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    (semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws)
    (suffixes : AddInductive.ConstructorBlockResolvedFamilyParameterSuffixes
      stats candidates)
    (parameterDefEqs : CandidateBlockFamilyViewParameterDefEqList env blockEnv
      Us nparams firstView semantics)
    (parameterContext : TypeChecker.CandidateParameterContext []
      stats.params.toList (VExpr.telN nparams firstView) parameterΔ)
    (henv : VEnv.WF env)
    (parameterWF : VLCtx.WF env Us.length parameterΔ)
    (paramsLength : params.length = nparams)
    (terminals : CandidateBlockFamilyTerminalSortList candidates)
    (spines : AddInductive.CandidateFamilyGenerationSpineList candidates) :
    ResolvedFamilyTargetTranslationState env Us nparams params parameterΔ
      semantics suffixes := by
  induction suffixes generalizing raws with
  | nil =>
      cases semantics
      cases parameterDefEqs
      intro offset suffix found
      simp [AddInductive.ConstructorBlockResolvedFamilyParameterSuffixes.values]
        at found
  | @cons kernelSource kernelSources candidate candidates suffix parameters
      suffixTail ih =>
      cases semantics with
      | cons semantic semanticTail =>
        cases parameterDefEqs with
        | cons headDefEq tailDefEq =>
          intro offset selectedSuffix found
          cases offset with
          | zero =>
              simp only [
                AddInductive.ConstructorBlockResolvedFamilyParameterSuffixes.values,
                List.getElem?_cons_zero] at found
              have suffixEq : suffix = selectedSuffix := Option.some.inj found
              subst selectedSuffix
              obtain ⟨kernelLevel, terminal⟩ := terminals.head
              obtain ⟨viewLevel, resultEq, _resultWF⟩ :=
                semantic.canonicalResultSort terminal spines.familyHead
                  paramsLength
              let family := canonicalizeFamilyParams nparams params
                semantic.view
              let indices := ctorFields (VExpr.dropN nparams family.type)
              obtain ⟨_inferred, familyRecursive⟩ := semantic.type.recursive
              have familyTr : TrExprS env Us []
                  candidate.familyType.type.view semantic.type.view :=
                familyRecursive.view_tr_resolved
              have familyTr' : TrExprS env Us []
                  candidate.familyType.type.view
                  (VExpr.forallN (VExpr.telN nparams semantic.type.view)
                    (VExpr.dropN nparams semantic.type.view)) := by
                rw [VExpr.forallN_telN_dropN]
                exact familyTr
              have suffixTr : TrExprS env Us parameterΔ suffix
                  (VExpr.dropN nparams semantic.type.view) :=
                parameterContext.instantiateForallRetypedResolved henv
                  parameterWF headDefEq parameters familyTr'
              have endpointEq : VExpr.dropN nparams semantic.type.view =
                  VExpr.forallN indices (.sort viewLevel) := by
                calc
                  VExpr.dropN nparams semantic.type.view =
                      VExpr.dropN nparams family.type := by
                    symm
                    simpa only [family,
                      CandidateBlockFamilySemanticRun.view] using
                      canonicalizeFamilyParams_dropN
                        (family := semantic.view) paramsLength
                  _ = VExpr.forallN indices (.sort viewLevel) := by
                    rw [← forallN_ctorFields_resultOf
                      (VExpr.dropN nparams family.type), resultEq]
              rw [endpointEq] at suffixTr
              exact ⟨family, indices, viewLevel, rfl, rfl, rfl,
                by simpa only [family] using resultEq, suffixTr⟩
          | succ offset =>
              simp only [
                AddInductive.ConstructorBlockResolvedFamilyParameterSuffixes.values,
                List.getElem?_cons_succ] at found
              exact ih semanticTail tailDefEq terminals.tail
                spines.tailExact found

namespace ResolvedFamilyTargetTranslationState

/-- The family-only translation state and positional count/header inventories
form the exact initial target state consumed by resolved constructor replay. -/
theorem mutualTargetState
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {nparams : Nat}
    {params : List VExpr} {source : VInductDecl} {parameterΔ : VLCtx}
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    {semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws}
    {suffixes : AddInductive.ConstructorBlockResolvedFamilyParameterSuffixes
      stats candidates}
    (state : ResolvedFamilyTargetTranslationState env Us nparams params
      parameterΔ semantics suffixes)
    (addType : env ≤ blockEnv)
    (counts : CanonicalFamilyIndexCountList stats nparams 0
      (canonicalizeFamilyParamsList nparams params semantics.views))
    (canonicalLength :
      (canonicalizeFamilyParamsList nparams params semantics.views).length =
        stats.indConsts.size)
    (familyData : ∀ familyIdx, familyIdx < stats.indConsts.size →
      ∃ header,
        (familyHeaders source.nparams source.types)[familyIdx]? = some header ∧
        stats.indConsts[familyIdx]! = .const header.name stats.levels ∧
        stats.nindices[familyIdx]! = header.indices) :
    ConstructorValidation.ResolvedMutualFamilyTargetState env blockEnv Us
      stats (familyHeaders source.nparams source.types) suffixes.values
      (canonicalFamilyIndexLists nparams params semantics.views)
      parameterΔ parameterΔ 0 .refl := by
  intro targetIdx targetSuffix targetAt
  obtain ⟨family, indices, resultLevel, familyAt, indicesAt, indicesEq,
      resultEq, translation⟩ := state targetAt
  have targetLt : targetIdx < stats.indConsts.size := by
    have bound := (List.getElem?_eq_some_iff.1 familyAt).1
    rw [canonicalLength] at bound
    exact bound
  obtain ⟨header, headerAt, familyHead, headerIndices⟩ :=
    familyData targetIdx targetLt
  have countAt := counts.getElem? familyAt
  simp only [Nat.zero_add] at countAt
  have indexLength : indices.length = stats.nindices[targetIdx]! := by
    rw [indicesEq]
    exact (array_getBang_eq_of_getElem?_eq_some countAt).symm
  exact ⟨indices, indices, resultLevel,
    VExpr.forallN indices (.sort resultLevel), header, indicesAt, headerAt,
    familyHead, headerIndices, indexLength, translation,
    translation.mono addType, by simp, by simp⟩

end ResolvedFamilyTargetTranslationState

/-- One exact mutual constructor position, synchronized across the
arbitrary-target D3 replay, post-family D2 validation, normalized stage-3
trace, and canonical checked constructor.  The conclusion is already in the
field-positioned form consumed by `CheckedBlockConstructorRunList`. -/
theorem CandidateConstructorSemanticRun.checkedBlockConstructorWF
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {source : VInductDecl} {params : List VExpr}
    {familyIndices : List (List VExpr)} {resultLevel : VLevel}
    {kernelCtor : Constructor}
    {candidate : AddInductive.CandidateConstructor kernelCtor}
    {rawCtor : VConstVal}
    (semantic : CandidateConstructorSemanticRun blockEnv Us candidate rawCtor)
    {owner : Nat}
    (stage : AddInductive.ConstructorStage3CandidateTrace stats owner
      candidate)
    {ownerSuffix : Expr} {familySuffixes : List Expr}
    {d3Context d2Context : AddInductive.Context}
    {d3ContextRun : AddInductive.ConstructorContextRun env Us d3Context}
    {d2ContextRun : AddInductive.ConstructorContextRun blockEnv Us d2Context}
    {d3Trace : AddInductive.ConstructorMutualPreFamilyViewTrace stats owner
      ownerSuffix familySuffixes d3Context candidate.type.view 0 [] false}
    (d3 : AddInductive.ConstructorMutualPreFamilyViewSemanticRun env Us stats
      owner ownerSuffix familySuffixes d3ContextRun d3Trace)
    {isUnsafe : Bool} {ctorName : Name} {rawSource : Expr}
    {d2Fuel : Nat}
    {d2Trace : AddInductive.ConstructorTypeValidationTrace stats isUnsafe
      owner ctorName d2Context rawSource 0 d2Fuel}
    (d2Alignment : AddInductive.ConstructorViewAlignmentTrace d2Trace
      candidate.type.view)
    (d2 : AddInductive.ConstructorViewSemanticRun blockEnv Us
      semantic.type.whnfFuel d2ContextRun d2Trace candidate.type.view)
    (henv : VEnv.WF env) (hblockEnv : VEnv.WF blockEnv)
    (addType : env ≤ blockEnv)
    {parameterΔ d3ViewContext analyzerViewContext : VLCtx}
    {d3ViewLift analyzerViewLift : Lift}
    (parameterContext : TypeChecker.CandidateParameterContext []
      stats.params.toList params parameterΔ)
    (parameterWF : VLCtx.WF env Us.length parameterΔ)
    (headParameters : TypeChecker.TelDefEqEvidence blockEnv Us.length []
      params (VExpr.telN source.nparams semantic.type.view))
    (d3State : ConstructorValidation.D3FullContextState env blockEnv Us
      d3Context parameterΔ parameterΔ
      d3ContextRun.candidate.context.vlctx d3ViewContext .refl d3ViewLift)
    (analyzerState : ConstructorValidation.AnalyzerPostContextState blockEnv Us
      parameterΔ d2ContextRun.candidate.context.vlctx analyzerViewContext
      analyzerViewLift)
    (ngenEq : d3Context.ngen = d2Context.ngen)
    (targets : ConstructorValidation.MutualFamilyTargetState env blockEnv Us
      stats (familyHeaders source.nparams source.types) familySuffixes
      familyIndices parameterΔ parameterΔ 0)
    (ownerAt : familySuffixes[owner]? = some ownerSuffix)
    {ownerIndices : List VExpr}
    (ownerIndicesAt : familyIndices[owner]? = some ownerIndices)
    (sourceUvars : source.uvars = Us.length)
    (sourceNparams : source.nparams = stats.params.size)
    (resultLevelTr : VLevel.ofLevel Us stats.resultLevel = some resultLevel)
    (familyFresh : ∀ name, name ∈ familyNames source.types →
      env.constants name = none)
    (familyNodup : (familyNames source.types).Nodup)
    (universeSemantics : d2Trace.universeSemantics = true)
    (stageAccepted : blockStage3Ctor source.uvars source.nparams
      (familyHeaders source.nparams source.types)
      (familyNames source.types) owner 0
      (VExpr.dropN source.nparams semantic.type.view) = true) :
    let constructor := CheckedCtor.ofBlock source
      (canonicalizeConstructorParams source.nparams params semantic.root.view)
    (checkedBlockFieldsWF env source.uvars resultLevel familyIndices
          constructor.fields constructor.recursiveAt params.reverse 0 ∧
        env.SpineWF source.uvars
          (constructor.fields.reverse ++ params.reverse)
          (VExpr.forallN
            (VExpr.liftTelN constructor.fields.length ownerIndices 0)
            (.sort resultLevel))
          constructor.resultIndices (.sort resultLevel)) ∧
      blockEnv.OnSortTel Us.length params.reverse constructor.fields
        d2.fieldSorts := by
  have paramsLength : params.length = source.nparams := by
    rw [← parameterContext.length_eq]
    simpa using sourceNparams.symm
  have sourceUnique : TrExprS.IsUnique stage.suffix :=
    ConstructorValidation.instantiateFamilyParameters_unique
      stage.viewTranslationUnique
      (ConstructorValidation.CandidateParameterContext.parametersUnique
        parameterContext)
      stage.parameters
  have traceUnique : TypeChecker.CandidateExprTraceViewIsUnique
      candidate.type.trace :=
    candidate.type.trace.viewTranslationUnique_sound (by
      rw [AddInductive.CandidateExprTrace.viewTranslationUnique_eq]
      exact stage.translationUnique)
  obtain ⟨_inferred, recursive⟩ := semantic.type.recursive
  have wholeStrict : TrExprS blockEnv Us [] candidate.type.view
      semantic.type.view :=
    recursive.view_tr_strict traceUnique
  have wholeStrict' : TrExprS blockEnv Us [] candidate.type.view
      (VExpr.forallN (VExpr.telN source.nparams semantic.type.view)
        (VExpr.dropN source.nparams semantic.type.view)) := by
    rw [VExpr.forallN_telN_dropN]
    exact wholeStrict
  have suffixTr : TrExprS blockEnv Us parameterΔ stage.suffix
      (VExpr.dropN source.nparams semantic.type.view) :=
    parameterContext.instantiateForallRetyped hblockEnv
      (parameterWF.mono addType) headParameters stage.parameters wholeStrict'
      sourceUnique
  obtain ⟨_baseIndices, _currentIndices, _level, _familyTarget, header,
      _baseAt, _headerAt, familyHead, _familyUnique, _indexLength,
      _commonTr, _fullTr, _familyTargetEq⟩ := targets ownerAt
  obtain ⟨d3Suffix⟩ := d3.afterParameters familyHead (by simp) (by
    simpa only [List.drop_zero] using stage.parameters)
  obtain ⟨d2Suffix, suffixUniverse, suffixFieldSorts, _suffixSpine⟩ :=
    d2.afterParameters d2Alignment (by omega) stage.parameters
  have suffixUniverseSemantics :
      d2Suffix.trace.universeSemantics = true :=
    suffixUniverse.trans universeSemantics
  have sourceClosed : Closed stage.suffix := by
    have closed := suffixTr.closed
    rw [show parameterΔ.bvars = 0 from by
      simpa only [VLCtx.NoBV] using d3State.commonNoBV] at closed
    exact closed
  let endpoint := VExpr.dropN source.nparams semantic.type.view
  have wholeTr : TrExprS blockEnv Us parameterΔ stage.suffix
      (VExpr.forallN (ctorFields endpoint) endpoint.resultOf) := by
    rw [forallN_ctorFields_resultOf]
    exact suffixTr
  have result := ConstructorValidation.constructorBlockFields_exactAnalyzer
    (d3 := d3Suffix.semantic)
    (d2Alignment := d2Suffix.alignment) (d2 := d2Suffix.semantic)
    henv hblockEnv addType d3State analyzerState
    (by
      intro fv member _
      exact member)
    ngenEq targets ownerAt ownerIndicesAt sourceUvars sourceNparams
    (resultOf_ne_forall endpoint) resultLevelTr familyFresh
    (fun headerAt => familyHeaders_name_mem headerAt)
    (fun leftAt rightAt namesEq =>
      familyHeaders_index_eq_of_name_eq familyNodup leftAt rightAt namesEq)
    sourceUnique sourceClosed wholeTr (by simp) suffixUniverseSemantics
    (by
      intro q field found
      simpa only [sourceUvars, sourceNparams] using
        blockStage3Ctor_field source.uvars source.nparams
        (familyHeaders source.nparams source.types)
        (familyNames source.types) owner stageAccepted found)
  have parameterCtx : parameterΔ.toCtx = params.reverse := by
    simpa only [VLCtx.toCtx, List.append_nil] using
      VInductDecl.TypeChecker.CandidateParameterContext.toCtx parameterContext
  unfold ConstructorValidation.ConstructorBlockFieldsRunResult at result
  rw [parameterCtx, suffixFieldSorts] at result
  let constructor := CheckedCtor.ofBlock source
    (canonicalizeConstructorParams source.nparams params semantic.root.view)
  have canonicalDrop :
      VExpr.dropN source.nparams
          (canonicalizeConstructorParams source.nparams params
            semantic.root.view).type = endpoint := by
    have drop := canonicalizeConstructorParams_dropN
      (constructor := semantic.root.view) paramsLength
    simpa only [endpoint, CandidateConstructorSemanticRun.root,
      CandidateConstructorRun.view] using drop
  have checkedFields : checkedBlockFieldsWF env source.uvars resultLevel
      familyIndices (ctorFields endpoint)
      (blockRecArgsAt source.uvars source.nparams
        (familyHeaders source.nparams source.types)
        (familyNames source.types) (ctorFields endpoint) 0)
      params.reverse 0 :=
    checkedBlockFieldsWF_blockRecArgsAt_iff.mpr result.1.1
  change (checkedBlockFieldsWF env source.uvars resultLevel familyIndices
      (ctorFields (VExpr.dropN source.nparams
        (canonicalizeConstructorParams source.nparams params
          semantic.root.view).type))
      (blockRecArgsAt source.uvars source.nparams
        (familyHeaders source.nparams source.types)
        (familyNames source.types)
        (ctorFields (VExpr.dropN source.nparams
          (canonicalizeConstructorParams source.nparams params
            semantic.root.view).type)) 0)
      params.reverse 0 ∧
    env.SpineWF source.uvars
      ((ctorFields (VExpr.dropN source.nparams
        (canonicalizeConstructorParams source.nparams params
          semantic.root.view).type)).reverse ++ params.reverse)
      (VExpr.forallN
        (VExpr.liftTelN
          (ctorFields (VExpr.dropN source.nparams
            (canonicalizeConstructorParams source.nparams params
              semantic.root.view).type)).length ownerIndices 0)
        (.sort resultLevel))
      (recFieldIdxs source.nparams
        (VExpr.resultOf (VExpr.dropN source.nparams
          (canonicalizeConstructorParams source.nparams params
            semantic.root.view).type)))
      (.sort resultLevel)) ∧
    blockEnv.OnSortTel Us.length params.reverse
      (ctorFields (VExpr.dropN source.nparams
        (canonicalizeConstructorParams source.nparams params
          semantic.root.view).type)) d2.fieldSorts
  rw [canonicalDrop]
  exact ⟨⟨checkedFields, by simpa only [Nat.zero_add] using result.1.2⟩,
    result.2⟩

/-- Projection-aware constructor replay returns the literal endpoint selected
by the pre-family construction itself.  In particular, neither the fields nor
the result are identified with the independently translated analyzer view. -/
theorem CandidateConstructorSemanticRun.resolvedBlockConstructorWF
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {source : VInductDecl} {params : List VExpr}
    {familyIndices : List (List VExpr)} {resultLevel : VLevel}
    {kernelCtor : Constructor}
    {candidate : AddInductive.CandidateConstructor kernelCtor}
    {rawCtor : VConstVal}
    (semantic : CandidateConstructorSemanticRun blockEnv Us candidate rawCtor)
    {owner : Nat}
    {suffix : Expr}
    (instantiation : AddInductive.instantiateFamilyParameters
      candidate.type.view stats.params.toList = .ok suffix)
    {ownerSuffix : Expr} {familySuffixes : List Expr}
    {d3Context d2Context : AddInductive.Context}
    {d3ContextRun : AddInductive.ConstructorContextRun env Us d3Context}
    {d2ContextRun : AddInductive.ConstructorContextRun blockEnv Us d2Context}
    {d3Trace : AddInductive.ConstructorMutualPreFamilyViewTrace stats owner
      ownerSuffix familySuffixes d3Context candidate.type.view 0 [] false}
    (d3 : AddInductive.ConstructorMutualPreFamilyViewSemanticRun env Us stats
      owner ownerSuffix familySuffixes d3ContextRun d3Trace)
    {isUnsafe : Bool} {ctorName : Name} {rawSource : Expr}
    {d2Fuel : Nat}
    {d2Trace : AddInductive.ConstructorTypeValidationTrace stats isUnsafe
      owner ctorName d2Context rawSource 0 d2Fuel}
    (d2Alignment : AddInductive.ConstructorViewAlignmentTrace d2Trace
      candidate.type.view)
    (d2 : AddInductive.ConstructorViewSemanticRun blockEnv Us
      semantic.type.whnfFuel d2ContextRun d2Trace candidate.type.view)
    (henv : VEnv.WF env) (hblockEnv : VEnv.WF blockEnv)
    (addType : env ≤ blockEnv)
    {parameterΔ d3ViewContext analyzerViewContext : VLCtx}
    {d3ViewLift analyzerViewLift : Lift}
    (parameterContext : TypeChecker.CandidateParameterContext []
      stats.params.toList params parameterΔ)
    (parameterWF : VLCtx.WF env Us.length parameterΔ)
    (headParameters : TypeChecker.TelDefEqEvidence blockEnv Us.length []
      params (VExpr.telN source.nparams semantic.type.view))
    (d3State : ConstructorValidation.D3FullContextState env blockEnv Us
      d3Context parameterΔ parameterΔ
      d3ContextRun.candidate.context.vlctx d3ViewContext .refl d3ViewLift)
    (analyzerState : ConstructorValidation.AnalyzerPostContextState blockEnv Us
      parameterΔ d2ContextRun.candidate.context.vlctx analyzerViewContext
      analyzerViewLift)
    (ngenEq : d3Context.ngen = d2Context.ngen)
    (targets : ConstructorValidation.ResolvedMutualFamilyTargetState env
      blockEnv Us stats (familyHeaders source.nparams source.types)
      familySuffixes familyIndices parameterΔ parameterΔ 0 .refl)
    (ownerAt : familySuffixes[owner]? = some ownerSuffix)
    {ownerIndices : List VExpr}
    (ownerIndicesAt : familyIndices[owner]? = some ownerIndices)
    (sourceUvars : source.uvars = Us.length)
    (sourceNparams : source.nparams = stats.params.size)
    (resultLevelTr : VLevel.ofLevel Us stats.resultLevel = some resultLevel)
    (levelsTr : stats.levels.mapM (VLevel.ofLevel Us) =
      some (VLevel.params Us.length))
    (familyFresh : ∀ name, name ∈ familyNames source.types →
      env.constants name = none)
    (familyNodup : (familyNames source.types).Nodup)
    (universeSemantics : d2Trace.universeSemantics = true) :
    ∃ fields resultTarget,
      TrExprS blockEnv Us parameterΔ suffix
          (VExpr.forallN fields resultTarget) ∧
        TrExprS blockEnv Us [] candidate.type.view
          (VExpr.forallN
            (VExpr.telN source.nparams semantic.type.view)
            (VExpr.forallN fields resultTarget)) ∧
        (checkedBlockFieldsWF env source.uvars resultLevel familyIndices
              fields
              (blockRecArgsAt source.uvars source.nparams
                (familyHeaders source.nparams source.types)
                (familyNames source.types) fields 0)
              params.reverse 0 ∧
          env.SpineWF source.uvars (fields.reverse ++ params.reverse)
            (VExpr.forallN
              (VExpr.liftTelN fields.length ownerIndices 0)
              (.sort resultLevel))
            (recFieldIdxs source.nparams resultTarget)
            (.sort resultLevel)) ∧
        blockStage3Ctor source.uvars source.nparams
          (familyHeaders source.nparams source.types)
          (familyNames source.types) owner 0
          (VExpr.forallN fields resultTarget) = true ∧
        (∀ domain body, resultTarget ≠ .forallE domain body) ∧
        blockEnv.OnSortTel Us.length params.reverse fields
          d2.fieldSorts := by
  have paramsLength : params.length = source.nparams := by
    rw [← parameterContext.length_eq]
    simpa using sourceNparams.symm
  obtain ⟨_inferred, recursive⟩ := semantic.type.recursive
  have wholeStrict : TrExprS blockEnv Us [] candidate.type.view
      semantic.type.view :=
    recursive.view_tr_resolved
  have wholeStrict' : TrExprS blockEnv Us [] candidate.type.view
      (VExpr.forallN (VExpr.telN source.nparams semantic.type.view)
        (VExpr.dropN source.nparams semantic.type.view)) := by
    rw [VExpr.forallN_telN_dropN]
    exact wholeStrict
  have suffixTr : TrExprS blockEnv Us parameterΔ suffix
      (VExpr.dropN source.nparams semantic.type.view) :=
    parameterContext.instantiateForallRetypedResolved hblockEnv
      (parameterWF.mono addType) headParameters instantiation wholeStrict'
  obtain ⟨_baseIndices, _currentIndices, _level, _familyTarget, header,
      _baseAt, _headerAt, familyHead, _headerIndices, _indexLength,
      _commonTr, _fullTr, _familyTargetEq, _familyLiftEq⟩ := targets ownerAt
  obtain ⟨d3Suffix⟩ := d3.afterParameters familyHead (by simp) (by
    simpa only [List.drop_zero] using instantiation)
  obtain ⟨d2Suffix, suffixUniverse, suffixFieldSorts, _suffixSpine⟩ :=
    d2.afterParameters d2Alignment (by omega) instantiation
  have suffixUniverseSemantics :
      d2Suffix.trace.universeSemantics = true :=
    suffixUniverse.trans universeSemantics
  have sourceClosed : Closed suffix := by
    have closed := suffixTr.closed
    rw [show parameterΔ.bvars = 0 from by
      exact
        (VInductDecl.TypeChecker.CandidateParameterContext.fvarLamOnly
          parameterContext .nil).noBV] at closed
    exact closed
  have parameterTranslations : List.Forall₂
      (TrExprS blockEnv Us parameterΔ) stats.params.toList
      (VExpr.bvarRevRange 0 stats.params.size) := by
    have translated := TypeChecker.CandidateParameterContext.sourceTranslations
      parameterContext henv parameterWF
    have translated' := ConstructorValidation.forall₂_tr_mono addType
      translated
    have lengthEq : params.length = stats.params.size := by
      rw [← parameterContext.length_eq]
      simp
    simpa only [lengthEq] using translated'
  have result := ConstructorValidation.constructorBlockFields_resolved
    (d3 := d3Suffix.semantic)
    (d2Alignment := d2Suffix.alignment) (d2 := d2Suffix.semantic)
    henv hblockEnv addType d3State analyzerState
    (by
      intro fv member _
      exact member)
    ngenEq targets ownerAt ownerIndicesAt sourceUvars sourceNparams
    resultLevelTr levelsTr familyFresh
    (fun headerAt => familyHeaders_name_mem headerAt)
    (fun leftAt rightAt namesEq =>
      familyHeaders_index_eq_of_name_eq familyNodup leftAt rightAt namesEq)
    sourceClosed suffixTr parameterTranslations (by simp)
    suffixUniverseSemantics
  obtain ⟨fields, resultTarget, selectedTr, selectedRun, selectedStage,
      resultNotForall, fieldSorts⟩ := result
  obtain ⟨selectedParameterΔ, selectedParameterContext,
      parameterRelation, parameterUnique, selectedParameterWF⟩ :=
    parameterContext.retypeExact hblockEnv headParameters
      (parameterWF.mono addType)
  have selectedTrAtView : TrExprS blockEnv Us selectedParameterΔ
      suffix (VExpr.forallN fields resultTarget) :=
    selectedTr.defeqDFC_same hblockEnv parameterRelation parameterUnique
  have selectedWhole : TrExprS blockEnv Us [] candidate.type.view
    (VExpr.forallN (VExpr.telN source.nparams semantic.type.view)
      (VExpr.forallN fields resultTarget)) :=
    selectedParameterContext.rebuildForall hblockEnv selectedParameterWF
      instantiation wholeStrict' selectedTrAtView
  have parameterCtx : parameterΔ.toCtx = params.reverse := by
    simpa only [VLCtx.toCtx, List.append_nil] using
      VInductDecl.TypeChecker.CandidateParameterContext.toCtx parameterContext
  unfold ConstructorValidation.ConstructorBlockFieldsRunResult at selectedRun
  rw [parameterCtx] at selectedRun fieldSorts
  rw [suffixFieldSorts] at fieldSorts
  have checkedFields : checkedBlockFieldsWF env source.uvars resultLevel
      familyIndices fields
      (blockRecArgsAt source.uvars source.nparams
        (familyHeaders source.nparams source.types)
        (familyNames source.types) fields 0)
      params.reverse 0 :=
    checkedBlockFieldsWF_blockRecArgsAt_iff.mpr selectedRun.1
  exact ⟨fields, resultTarget, selectedTr, selectedWhole,
    ⟨checkedFields, by simpa only [Nat.zero_add] using selectedRun.2⟩,
    selectedStage, resultNotForall, fieldSorts⟩

/-- Traverse one family's exact constructor lists in lockstep.  No erased
list lookup is used: every head proof is indexed by the same candidate,
semantic root, validation trace, stage-3 trace, and canonical parameter
equality. -/
theorem CandidateConstructorSemanticListRun.checkedBlockConstructorsWF
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {source : VInductDecl} {params : List VExpr}
    {familyIndices : List (List VExpr)} {resultLevel : VLevel}
    {owner : Nat} {ownerSuffix : Expr} {familySuffixes : List Expr}
    {kernelCtors : List Constructor}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateConstructor kernelCtors}
    {d3Context d2Context : AddInductive.Context}
    {d3ContextRun : AddInductive.ConstructorContextRun env Us d3Context}
    {d2ContextRun : AddInductive.ConstructorContextRun blockEnv Us d2Context}
    {d3Trace : AddInductive.ConstructorMutualPreFamilyListTrace stats owner
      ownerSuffix familySuffixes d3Context candidates}
    (d3 : AddInductive.ConstructorMutualPreFamilyListSemanticRun env Us stats
      owner ownerSuffix familySuffixes d3Context d3ContextRun d3Trace)
    (stage : AddInductive.ConstructorStage3CandidateListTrace stats owner
      candidates)
    {isUnsafe : Bool} {seen : NameSet}
    {validation : AddInductive.ConstructorListValidationTrace stats isUnsafe
      owner d2Context seen kernelCtors}
    {alignment : AddInductive.ConstructorCandidateAlignmentTrace stats
      isUnsafe owner d2Context validation candidates}
    {raws : List VConstVal}
    {semantics : CandidateConstructorSemanticListRun blockEnv Us candidates
      raws}
    (d2 : AddInductive.ConstructorPostFamilySemanticListRun blockEnv Us stats
      isUnsafe owner d2Context d2ContextRun validation candidates alignment
      semantics)
    (parameters : CandidateConstructorViewParameterDefEqList blockEnv Us
      source.nparams params semantics)
    (henv : VEnv.WF env) (hblockEnv : VEnv.WF blockEnv)
    (addType : env ≤ blockEnv)
    {parameterΔ d3ViewContext analyzerViewContext : VLCtx}
    {d3ViewLift analyzerViewLift : Lift}
    (parameterContext : TypeChecker.CandidateParameterContext []
      stats.params.toList params parameterΔ)
    (parameterWF : VLCtx.WF env Us.length parameterΔ)
    (d3State : ConstructorValidation.D3FullContextState env blockEnv Us
      d3Context parameterΔ parameterΔ
      d3ContextRun.candidate.context.vlctx d3ViewContext .refl d3ViewLift)
    (analyzerState : ConstructorValidation.AnalyzerPostContextState blockEnv Us
      parameterΔ d2ContextRun.candidate.context.vlctx analyzerViewContext
      analyzerViewLift)
    (ngenEq : d3Context.ngen = d2Context.ngen)
    (targets : ConstructorValidation.MutualFamilyTargetState env blockEnv Us
      stats (familyHeaders source.nparams source.types) familySuffixes
      familyIndices parameterΔ parameterΔ 0)
    (ownerAt : familySuffixes[owner]? = some ownerSuffix)
    {ownerIndices : List VExpr}
    (ownerIndicesAt : familyIndices[owner]? = some ownerIndices)
    (sourceUvars : source.uvars = Us.length)
    (sourceNparams : source.nparams = stats.params.size)
    (resultLevelTr : VLevel.ofLevel Us stats.resultLevel = some resultLevel)
    (familyFresh : ∀ name, name ∈ familyNames source.types →
      env.constants name = none)
    (familyNodup : (familyNames source.types).Nodup)
    (universeSemantics : validation.universeSemantics = true)
    (stageAccepted : List.All (fun constructor =>
      blockStage3Ctor source.uvars source.nparams
        (familyHeaders source.nparams source.types)
        (familyNames source.types) owner 0
        (VExpr.dropN source.nparams constructor.type) = true)
      (semantics.roots.views.map
        (canonicalizeConstructorParams source.nparams params))) :
    (List.All (fun constructor =>
        checkedBlockFieldsWF env source.uvars resultLevel familyIndices
            constructor.fields constructor.recursiveAt params.reverse 0 ∧
          env.SpineWF source.uvars
            (constructor.fields.reverse ++ params.reverse)
            (VExpr.forallN
              (VExpr.liftTelN constructor.fields.length ownerIndices 0)
              (.sort resultLevel))
            constructor.resultIndices (.sort resultLevel))
        ((semantics.roots.views.map
          (canonicalizeConstructorParams source.nparams params)).map
            (CheckedCtor.ofBlock source))) ∧
      List.Forall₂ (fun constructor fieldSorts =>
        blockEnv.OnSortTel Us.length params.reverse constructor.fields
          fieldSorts)
        ((semantics.roots.views.map
          (canonicalizeConstructorParams source.nparams params)).map
            (CheckedCtor.ofBlock source)) d2.fieldSorts := by
  induction d3 generalizing seen raws with
  | nil =>
      cases stage
      cases d2
      cases parameters
      exact ⟨trivial, .nil⟩
  | cons d3Head d3Tail ih =>
      cases stage with
      | cons stageHead stageTail =>
          cases d2 with
          | @cons seen constructor constructors freshName closed rootCheck
              typeTrace tailTrace candidate candidates raw raws rootScope
              storedSpine spineLength candidateDepth headAlignment
              tailAlignment headSemantic tailSemantic root d2Head spine
              d2Tail =>
              cases parameters with
              | cons headBound headParameters tailParameters =>
                  simp only [
                    AddInductive.ConstructorListValidationTrace.universeSemantics,
                    Bool.and_eq_true] at universeSemantics
                  simp only [CandidateConstructorSemanticListRun.roots,
                    CandidateConstructorListRun.views, List.map_cons]
                    at stageAccepted
                  simp only [CandidateConstructorSemanticListRun.roots,
                    CandidateConstructorListRun.views, List.map_cons]
                  have paramsLength : params.length = source.nparams := by
                    rw [← parameterContext.length_eq]
                    simpa using sourceNparams.symm
                  have headStage := stageAccepted.1
                  change blockStage3Ctor source.uvars source.nparams
                    (familyHeaders source.nparams source.types)
                    (familyNames source.types) owner 0
                    (VExpr.dropN source.nparams
                      (canonicalizeConstructorParams source.nparams params
                        headSemantic.root.view).type) = true at headStage
                  rw [canonicalizeConstructorParams_dropN
                    (constructor := headSemantic.root.view) paramsLength]
                    at headStage
                  have headStage' : blockStage3Ctor source.uvars
                      source.nparams
                      (familyHeaders source.nparams source.types)
                      (familyNames source.types) owner 0
                      (VExpr.dropN source.nparams
                        headSemantic.type.view) = true := by
                    simpa only [CandidateConstructorSemanticRun.root,
                      CandidateConstructorRun.view] using headStage
                  have headResult :=
                    headSemantic.checkedBlockConstructorWF stageHead
                    d3Head headAlignment d2Head henv hblockEnv addType
                    parameterContext parameterWF headParameters d3State
                    analyzerState ngenEq targets ownerAt ownerIndicesAt
                    sourceUvars sourceNparams resultLevelTr familyFresh
                    familyNodup universeSemantics.1 headStage'
                  have tailResult :=
                    ih stageTail d2Tail tailParameters universeSemantics.2
                      stageAccepted.2
                  exact ⟨⟨headResult.1, tailResult.1⟩,
                    .cons headResult.2 tailResult.2⟩

/-- Erase a resolved structural constructor trace only as far as its exact
parameter-instantiated source suffixes. -/
def _root_.Lean4Lean.AddInductive.ConstructorStage3ResolvedCandidateListTrace.suffixes
    {stats : AddInductive.InductiveStats} {owner : Nat}
    {kernelCtors : List Constructor}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateConstructor kernelCtors} :
    AddInductive.ConstructorStage3ResolvedCandidateListTrace stats owner
        candidates →
      List Expr
  | .nil => []
  | .cons head tail => head.suffix :: tail.suffixes

/-- Checked-block and sort-telescope payload for one construction-owned
constructor suffix endpoint. -/
def ResolvedBlockConstructorEndpointWF
    (source : VInductDecl) (env blockEnv : VEnv) (Us : List Name)
    (resultLevel : VLevel) (familyIndices : List (List VExpr))
    (owner : Nat) (params ownerIndices : List VExpr) (endpoint : VExpr)
    (fieldSorts : List VLevel) : Prop :=
  ∃ fields resultTarget,
    endpoint = VExpr.forallN fields resultTarget ∧
      blockStage3Ctor source.uvars source.nparams
        (familyHeaders source.nparams source.types)
        (familyNames source.types) owner 0 endpoint = true ∧
      (checkedBlockFieldsWF env source.uvars resultLevel familyIndices
            fields
            (blockRecArgsAt source.uvars source.nparams
              (familyHeaders source.nparams source.types)
              (familyNames source.types) fields 0)
            params.reverse 0 ∧
        env.SpineWF source.uvars (fields.reverse ++ params.reverse)
          (VExpr.forallN
            (VExpr.liftTelN fields.length ownerIndices 0)
            (.sort resultLevel))
          (recFieldIdxs source.nparams resultTarget) (.sort resultLevel)) ∧
      (∀ domain body, resultTarget ≠ .forallE domain body) ∧
      blockEnv.OnSortTel Us.length params.reverse fields fieldSorts

/-- Endpoint well-formedness depends on a source declaration only through
its universe arity, parameter count, and family header/name inventories. -/
private theorem resolvedBlockConstructorEndpointWF_of_source_shape_eq
    {source target : VInductDecl} {env blockEnv : VEnv} {Us : List Name}
    {resultLevel : VLevel} {familyIndices : List (List VExpr)}
    {owner : Nat} {params ownerIndices : List VExpr} {endpoint : VExpr}
    {fieldSorts : List VLevel}
    (endpointWF : ResolvedBlockConstructorEndpointWF source env blockEnv Us
      resultLevel familyIndices owner params ownerIndices endpoint fieldSorts)
    (uvarsEq : source.uvars = target.uvars)
    (nparamsEq : source.nparams = target.nparams)
    (headersEq : familyHeaders source.nparams source.types =
      familyHeaders target.nparams target.types)
    (namesEq : familyNames source.types = familyNames target.types) :
    ResolvedBlockConstructorEndpointWF target env blockEnv Us resultLevel
      familyIndices owner params ownerIndices endpoint fieldSorts := by
  unfold ResolvedBlockConstructorEndpointWF at endpointWF ⊢
  rw [← headersEq, ← namesEq, ← uvarsEq, ← nparamsEq]
  exact endpointWF

/-- A producer-selected terminal target contributes no hidden constructor
field after the explicitly reconstructed field telescope. -/
private theorem ctorFields_forallN_of_not_forall :
    ∀ (fields : List VExpr) (target : VExpr),
      (∀ domain body, target ≠ .forallE domain body) →
      ctorFields (VExpr.forallN fields target) = fields
  | [], target, terminal => by
      change ctorFields target = []
      cases target with
      | forallE domain body => exact (terminal domain body rfl).elim
      | bvar | sort | const | app | lam => rfl
  | _ :: fields, target, terminal => by
      simp only [VExpr.forallN, ctorFields, List.cons.injEq, true_and]
      exact ctorFields_forallN_of_not_forall fields target terminal

private theorem resultOf_eq_of_not_forall
    (target : VExpr)
    (terminal : ∀ domain body, target ≠ .forallE domain body) :
    target.resultOf = target := by
  cases target with
  | forallE domain body => exact (terminal domain body rfl).elim
  | bvar | sort | const | app | lam => rfl

/-- Pointwise consequences of a construction-selected endpoint list.  The
same positional fold supplies structural Stage-3, checked constructor
semantics, and the validator's exact field-sort telescope. -/
private theorem resolvedBlockConstructorEndpointListConsequences
    {source : VInductDecl} {env blockEnv : VEnv} {Us : List Name}
    {resultLevel : VLevel} {familyIndices : List (List VExpr)}
    {owner : Nat} {params ownerIndices : List VExpr}
    {constructors : List VConstVal} {endpoints : List VExpr}
    {fieldSorts : List (List VLevel)}
    (paramsLength : params.length = source.nparams)
    (alignment : List.Forall₂ (fun constructor endpoint =>
      constructor.type = VExpr.forallN params endpoint)
      constructors endpoints)
    (runs : List.Forall₂
      (ResolvedBlockConstructorEndpointWF source env blockEnv Us resultLevel
        familyIndices owner params ownerIndices)
      endpoints fieldSorts) :
    List.All (fun constructor =>
      blockStage3Ctor source.uvars source.nparams
        (familyHeaders source.nparams source.types)
        (familyNames source.types) owner 0
        (VExpr.dropN source.nparams constructor.type) = true)
      constructors ∧
    List.All (fun constructor =>
      checkedBlockFieldsWF env source.uvars resultLevel familyIndices
          constructor.fields constructor.recursiveAt params.reverse 0 ∧
        env.SpineWF source.uvars
          (constructor.fields.reverse ++ params.reverse)
          (VExpr.forallN
            (VExpr.liftTelN constructor.fields.length ownerIndices 0)
            (.sort resultLevel))
          constructor.resultIndices (.sort resultLevel))
      (constructors.map (CheckedCtor.ofBlock source)) ∧
    List.Forall₂ (fun constructor sorts =>
      blockEnv.OnSortTel Us.length params.reverse constructor.fields sorts)
      (constructors.map (CheckedCtor.ofBlock source)) fieldSorts := by
  induction alignment generalizing fieldSorts with
  | nil =>
      cases runs
      exact ⟨trivial, trivial, .nil⟩
  | @cons constructor endpoint constructors endpoints typeEq tailAlignment ih =>
      cases runs with
      | cons endpointRun tailRuns =>
          obtain ⟨fields, target, endpointShape, endpointStage, endpointWF,
              targetTerminal, endpointSorts⟩ := endpointRun
          have constructorDrop :
              VExpr.dropN source.nparams constructor.type = endpoint := by
            rw [typeEq, ← paramsLength, VExpr.dropN_forallN_length]
          have endpointFields : ctorFields endpoint = fields := by
            rw [endpointShape]
            exact ctorFields_forallN_of_not_forall fields target targetTerminal
          have endpointResult : endpoint.resultOf = target := by
            rw [endpointShape, VExpr.resultOf_forallN]
            exact resultOf_eq_of_not_forall target targetTerminal
          have checkedFields :
              (CheckedCtor.ofBlock source constructor).fields = fields := by
            simp only [CheckedCtor.ofBlock, constructorDrop, endpointFields]
          have checkedRecursiveAt :
              (CheckedCtor.ofBlock source constructor).recursiveAt =
                blockRecArgsAt source.uvars source.nparams
                  (familyHeaders source.nparams source.types)
                  (familyNames source.types) fields 0 := by
            simp only [CheckedCtor.ofBlock, constructorDrop, endpointFields]
          have checkedResult :
              (CheckedCtor.ofBlock source constructor).resultIndices =
                recFieldIdxs source.nparams target := by
            simp only [CheckedCtor.ofBlock, constructorDrop, endpointResult]
          have checkedWF :
              checkedBlockFieldsWF env source.uvars resultLevel familyIndices
                    (CheckedCtor.ofBlock source constructor).fields
                    (CheckedCtor.ofBlock source constructor).recursiveAt
                    params.reverse 0 ∧
                env.SpineWF source.uvars
                  ((CheckedCtor.ofBlock source constructor).fields.reverse ++
                    params.reverse)
                  (VExpr.forallN
                    (VExpr.liftTelN
                      (CheckedCtor.ofBlock source constructor).fields.length
                      ownerIndices 0)
                    (.sort resultLevel))
                  (CheckedCtor.ofBlock source constructor).resultIndices
                  (.sort resultLevel) := by
            simpa only [checkedFields, checkedRecursiveAt, checkedResult] using
              endpointWF
          have checkedSorts := endpointSorts
          rw [← checkedFields] at checkedSorts
          obtain ⟨tailStage, tailWF, tailSorts⟩ := ih tailRuns
          exact ⟨⟨by simpa only [constructorDrop] using endpointStage,
              tailStage⟩,
            ⟨checkedWF, tailWF⟩, .cons checkedSorts tailSorts⟩

/-- Once D2 has consumed the complete parameter array, every remaining
validation node is either an ordinary field or the terminal result.  Its
retained universe inventory therefore has exactly the residual spine length. -/
theorem _root_.Lean4Lean.AddInductive.ConstructorViewSemanticRun.fieldSorts_length_eq_spineLength_of_params_exhausted
    {env : VEnv} {Us : List Name} {whnfFuel : Nat}
    {stats : AddInductive.InductiveStats} {isUnsafe : Bool}
    {familyIdx : Nat} {ctor : Name} {context : AddInductive.Context}
    {source view : Expr} {argIdx fuel : Nat}
    {contextRun : AddInductive.ConstructorContextRun env Us context}
    {trace : AddInductive.ConstructorTypeValidationTrace stats isUnsafe
      familyIdx ctor context source argIdx fuel}
    (semantic : AddInductive.ConstructorViewSemanticRun env Us whnfFuel
      contextRun trace view)
    (exhausted : stats.params.size ≤ argIdx) :
    semantic.fieldSorts.length = trace.spineLength := by
  induction semantic with
  | @parameter stats' isUnsafe' familyIdx' ctor' context' fuel' argIdx'
      name' domain' body' binderInfo' param' parameterType' parameterAt'
      parameterTypeGet' validationDefEq' tailTrace' viewName' viewDomain'
      viewBody' viewBinderInfo' domainCheck' viewDomainCheck'
      parameterTypeCheck' contextRun' domainRun viewDomainRun
      parameterTypeSemantic validationRun tail ih =>
      rw [Array.getElem?_eq_none exhausted] at parameterAt'
      contradiction
  | ordinary domainRun viewDomainRun viewEqualityRun consumedRun ensureTypeRun
      positivity annotationsRun consumedType tail ih =>
      simp only [AddInductive.ConstructorViewSemanticRun.fieldSorts,
        AddInductive.ConstructorTypeValidationTrace.spineLength,
        List.length_cons]
      exact congrArg (fun length => length + 1) (ih (by omega))
  | terminal => rfl

/-- Traverse a resolved constructor list while retaining every endpoint
chosen by the construction-owned replay.  The first `Forall₂` ties those
endpoints to the exact executable suffix list; the second ties them to D2's
field-sort inventory. -/
theorem CandidateConstructorSemanticListRun.resolvedBlockConstructorsWF
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats}
    {source : VInductDecl} {params : List VExpr}
    {familyIndices : List (List VExpr)} {resultLevel : VLevel}
    {owner : Nat} {ownerSuffix : Expr} {familySuffixes : List Expr}
    {kernelCtors : List Constructor}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateConstructor kernelCtors}
    {d3Context d2Context : AddInductive.Context}
    {d3ContextRun : AddInductive.ConstructorContextRun env Us d3Context}
    {d2ContextRun : AddInductive.ConstructorContextRun blockEnv Us d2Context}
    {d3Trace : AddInductive.ConstructorMutualPreFamilyListTrace stats owner
      ownerSuffix familySuffixes d3Context candidates}
    (d3 : AddInductive.ConstructorMutualPreFamilyListSemanticRun env Us stats
      owner ownerSuffix familySuffixes d3Context d3ContextRun d3Trace)
    (suffixes : AddInductive.ConstructorCandidateParameterSuffixes stats
      candidates)
    {isUnsafe : Bool} {seen : NameSet}
    {validation : AddInductive.ConstructorListValidationTrace stats isUnsafe
      owner d2Context seen kernelCtors}
    {alignment : AddInductive.ConstructorCandidateAlignmentTrace stats
      isUnsafe owner d2Context validation candidates}
    {raws : List VConstVal}
    {semantics : CandidateConstructorSemanticListRun blockEnv Us candidates
      raws}
    (d2 : AddInductive.ConstructorPostFamilySemanticListRun blockEnv Us stats
      isUnsafe owner d2Context d2ContextRun validation candidates alignment
      semantics)
    (parameters : CandidateConstructorViewParameterDefEqList blockEnv Us
      source.nparams params semantics)
    (henv : VEnv.WF env) (hblockEnv : VEnv.WF blockEnv)
    (addType : env ≤ blockEnv)
    {parameterΔ d3ViewContext analyzerViewContext : VLCtx}
    {d3ViewLift analyzerViewLift : Lift}
    (parameterContext : TypeChecker.CandidateParameterContext []
      stats.params.toList params parameterΔ)
    (parameterWF : VLCtx.WF env Us.length parameterΔ)
    (d3State : ConstructorValidation.D3FullContextState env blockEnv Us
      d3Context parameterΔ parameterΔ
      d3ContextRun.candidate.context.vlctx d3ViewContext .refl d3ViewLift)
    (analyzerState : ConstructorValidation.AnalyzerPostContextState blockEnv Us
      parameterΔ d2ContextRun.candidate.context.vlctx analyzerViewContext
      analyzerViewLift)
    (ngenEq : d3Context.ngen = d2Context.ngen)
    (targets : ConstructorValidation.ResolvedMutualFamilyTargetState env
      blockEnv Us stats (familyHeaders source.nparams source.types)
      familySuffixes familyIndices parameterΔ parameterΔ 0 .refl)
    (ownerAt : familySuffixes[owner]? = some ownerSuffix)
    {ownerIndices : List VExpr}
    (ownerIndicesAt : familyIndices[owner]? = some ownerIndices)
    (sourceUvars : source.uvars = Us.length)
    (sourceNparams : source.nparams = stats.params.size)
    (resultLevelTr : VLevel.ofLevel Us stats.resultLevel = some resultLevel)
    (levelsTr : stats.levels.mapM (VLevel.ofLevel Us) =
      some (VLevel.params Us.length))
    (familyFresh : ∀ name, name ∈ familyNames source.types →
      env.constants name = none)
    (familyNodup : (familyNames source.types).Nodup)
    (universeSemantics : validation.universeSemantics = true) :
    ∃ endpoints,
      ∃ selected : CandidateConstructorSemanticListRun blockEnv Us
          candidates raws,
        List.Forall₂ (TrExprS blockEnv Us parameterΔ) suffixes.values
            endpoints ∧
          List.Forall₂
            (ResolvedBlockConstructorEndpointWF source env blockEnv Us
              resultLevel familyIndices owner params ownerIndices)
            endpoints d2.fieldSorts ∧
          List.Forall₂ (fun constructor endpoint =>
            constructor.type = VExpr.forallN params endpoint)
            (selected.roots.views.map
              (canonicalizeConstructorParams source.nparams params))
            endpoints ∧
          CandidateConstructorViewParameterDefEqList blockEnv Us
            source.nparams params selected ∧
          CandidateConstructorCanonicalFieldCountList source.nparams
            selected := by
  induction d3 generalizing seen raws with
  | nil =>
      cases suffixes
      cases d2
      cases parameters
      exact ⟨[], .nil, .nil, .nil, .nil, .nil, .nil⟩
  | cons d3Head d3Tail ih =>
      cases suffixes with
      | cons suffix instantiation suffixTail =>
          cases d2 with
          | @cons seen constructor constructors freshName closed rootCheck
              typeTrace tailTrace candidate candidates raw raws rootScope
              storedSpine spineLength candidateDepth headAlignment
              tailAlignment headSemantic tailSemantic root d2Head spine
              d2Tail =>
              cases parameters with
              | cons headBound headParameters tailParameters =>
                  simp only [
                    AddInductive.ConstructorListValidationTrace.universeSemantics,
                    Bool.and_eq_true] at universeSemantics
                  obtain ⟨headFields, headTarget, headTr, headWhole,
                      headWF, headStage, headNotForall, headSorts⟩ :=
                    headSemantic.resolvedBlockConstructorWF instantiation
                      d3Head headAlignment d2Head henv hblockEnv addType
                      parameterContext parameterWF headParameters d3State
                      analyzerState ngenEq targets ownerAt ownerIndicesAt
                      sourceUvars sourceNparams resultLevelTr levelsTr
                      familyFresh familyNodup universeSemantics.1
                  obtain ⟨selectedHead, selectedHeadEq⟩ :=
                    headSemantic.existsAtView headWhole
                  obtain ⟨tailEndpoints, selectedTail, tailTr, tailWF,
                      tailTypes, tailSelectedParameters, tailCounts⟩ :=
                    ih suffixTail d2Tail tailParameters universeSemantics.2
                  refine ⟨VExpr.forallN headFields headTarget :: tailEndpoints,
                    .cons selectedHead selectedTail, .cons headTr tailTr,
                    .cons ?_ tailWF, .cons ?_ tailTypes,
                    .cons headBound ?_ tailSelectedParameters,
                    .cons headBound ?_ tailCounts⟩
                  · exact ⟨headFields, headTarget, rfl, headStage, headWF,
                      headNotForall, headSorts⟩
                  · have paramsLength : params.length = source.nparams := by
                      rw [← parameterContext.length_eq]
                      simpa using sourceNparams.symm
                    have viewParamsLength :
                        (VExpr.telN source.nparams
                          headSemantic.type.view).length = source.nparams :=
                      headParameters.length_eq.symm.trans paramsLength
                    change (canonicalizeConstructorParams source.nparams params
                      selectedHead.root.view).type =
                        VExpr.forallN params
                          (VExpr.forallN headFields headTarget)
                    simp only [canonicalizeConstructorParams,
                      CandidateConstructorSemanticRun.root,
                      CandidateConstructorRun.view]
                    have selectedDrop : VExpr.dropN source.nparams
                        (VExpr.forallN
                          (VExpr.telN source.nparams headSemantic.type.view)
                          (VExpr.forallN headFields headTarget)) =
                          VExpr.forallN headFields headTarget := by
                      calc
                        _ = VExpr.dropN
                            (VExpr.telN source.nparams
                              headSemantic.type.view).length
                            (VExpr.forallN
                              (VExpr.telN source.nparams
                                headSemantic.type.view)
                              (VExpr.forallN headFields headTarget)) :=
                          congrArg
                            (fun count => VExpr.dropN count
                              (VExpr.forallN
                                (VExpr.telN source.nparams
                                  headSemantic.type.view)
                                (VExpr.forallN headFields headTarget)))
                            viewParamsLength.symm
                        _ = _ := VExpr.dropN_forallN_length _ _
                    rw [selectedHeadEq, selectedDrop]
                  · have paramsLength : params.length = source.nparams := by
                      rw [← parameterContext.length_eq]
                      simpa using sourceNparams.symm
                    have viewParamsLength :
                        (VExpr.telN source.nparams
                          headSemantic.type.view).length = source.nparams :=
                      headParameters.length_eq.symm.trans paramsLength
                    have selectedParameterTypes :
                        VExpr.telN source.nparams selectedHead.type.view =
                          VExpr.telN source.nparams
                            headSemantic.type.view := by
                      calc
                        _ = VExpr.telN source.nparams
                            (VExpr.forallN
                              (VExpr.telN source.nparams
                                headSemantic.type.view)
                              (VExpr.forallN headFields headTarget)) :=
                          congrArg (VExpr.telN source.nparams) selectedHeadEq
                        _ = VExpr.telN
                            (VExpr.telN source.nparams
                              headSemantic.type.view).length
                            (VExpr.forallN
                              (VExpr.telN source.nparams
                                headSemantic.type.view)
                              (VExpr.forallN headFields headTarget)) := by
                          rw [viewParamsLength]
                        _ = _ := VExpr.telN_forallN_length _ _
                    rw [selectedParameterTypes]
                    exact headParameters
                  · obtain ⟨d2Suffix, _suffixUniverse,
                        suffixFieldSorts, suffixSpine⟩ :=
                      d2Head.afterParameters headAlignment (by omega)
                        instantiation
                    have suffixLength :
                        d2Suffix.semantic.fieldSorts.length =
                          d2Suffix.trace.spineLength :=
                      d2Suffix.semantic
                        |>.fieldSorts_length_eq_spineLength_of_params_exhausted
                          (Nat.le_refl _)
                    have selectedFieldsLength :
                        headFields.length =
                          typeTrace.spineLength -
                            source.nparams := by
                      calc
                        headFields.length = d2Head.fieldSorts.length :=
                          headSorts.length_eq
                        _ = d2Suffix.semantic.fieldSorts.length :=
                          congrArg List.length suffixFieldSorts.symm
                        _ = d2Suffix.trace.spineLength := suffixLength
                        _ = typeTrace.spineLength - source.nparams := by
                          rw [sourceNparams]
                          omega
                    have viewParamsLength :
                        (VExpr.telN source.nparams
                          headSemantic.type.view).length = source.nparams :=
                      headParameters.length_eq.symm.trans (by
                        rw [← parameterContext.length_eq]
                        simpa using sourceNparams.symm)
                    have selectedDrop :
                        VExpr.dropN source.nparams selectedHead.type.view =
                          VExpr.forallN headFields headTarget := by
                      rw [selectedHeadEq]
                      calc
                        _ = VExpr.dropN
                            (VExpr.telN source.nparams
                              headSemantic.type.view).length
                            (VExpr.forallN
                              (VExpr.telN source.nparams
                                headSemantic.type.view)
                              (VExpr.forallN headFields headTarget)) := by
                          rw [viewParamsLength]
                        _ = _ := VExpr.dropN_forallN_length _ _
                    rw [selectedDrop,
                      ctorFields_forallN_of_not_forall headFields headTarget
                        headNotForall, spineLength]
                    exact selectedFieldsLength

/-- Coherent producer state for mutual pre-family constructor replay.  The
same executable suffix inventory indexes both the recursive-field traces and
their strict translations into the canonical checked-family spine. -/
structure CandidateBlockMutualPreFamilyTranslationState
    (env blockEnv : VEnv) (Us : List Name)
    (stats : AddInductive.InductiveStats) (nparams : Nat)
    (firstView : VExpr) (params : List VExpr) (source : VInductDecl)
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    (rawParameterΔ : VLCtx)
    (postFamilyContext : AddInductive.Context)
    (semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws)
    {ordinal : Nat}
    (checked : CheckedFamilies source params ordinal
      (canonicalizeFamilyParamsList nparams params semantics.views))
    (parameterDefEqs : CandidateBlockFamilyViewParameterDefEqList env blockEnv
      Us nparams firstView semantics) where
  preFamily : AddInductive.ConstructorMutualBlockPreFamilySemanticState env
    blockEnv Us stats semantics
  parameterΔ : VLCtx
  params_eq : params = VExpr.telN nparams firstView
  parameterContext : TypeChecker.CandidateParameterContext []
    stats.params.toList (VExpr.telN nparams firstView) parameterΔ
  parameterRelation : VLCtx.IsDefEq env Us.length rawParameterΔ parameterΔ
  parameterUnique : TrExprS.IsUniqueCtx rawParameterΔ parameterΔ
  parameterWF : VLCtx.WF env Us.length parameterΔ
  preFamily_ngen_eq : preFamily.context.ngen = postFamilyContext.ngen
  preFamilyAlignment : ConstructorSharedParameterContextAlignment env Us
    rawParameterΔ preFamily.contextRun
  translations : CandidateBlockFamilySuffixTranslationList env blockEnv Us
    stats nparams firstView params source parameterΔ semantics
    preFamily.trace.suffixes checked parameterDefEqs

namespace CandidateBlockMutualPreFamilyTranslationState

/-- Canonical family counts and the positional family header inventory close
the one remaining premise of the initial mutual-target state. -/
theorem targetState
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {nparams : Nat}
    {firstView : VExpr} {params : List VExpr} {source : VInductDecl}
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    {rawParameterΔ : VLCtx}
    {postFamilyContext : AddInductive.Context}
    {semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws}
    {checked : CheckedFamilies source params 0
      (canonicalizeFamilyParamsList nparams params semantics.views)}
    {parameterDefEqs : CandidateBlockFamilyViewParameterDefEqList env blockEnv
      Us nparams firstView semantics}
    (state : CandidateBlockMutualPreFamilyTranslationState env blockEnv Us
      stats nparams firstView params source rawParameterΔ postFamilyContext
      semantics checked parameterDefEqs)
    (addType : env ≤ blockEnv)
    (sourceNparams : source.nparams = nparams)
    (counts : CanonicalFamilyIndexCountList stats nparams 0
      (canonicalizeFamilyParamsList nparams params semantics.views))
    (canonicalLength :
      (canonicalizeFamilyParamsList nparams params semantics.views).length =
        stats.indConsts.size)
    (familyData : ∀ familyIdx, familyIdx < stats.indConsts.size →
      ∃ header,
        (familyHeaders source.nparams source.types)[familyIdx]? = some header ∧
        stats.indConsts[familyIdx]! = .const header.name stats.levels) :
    ConstructorValidation.MutualFamilyTargetState env blockEnv Us stats
      (familyHeaders source.nparams source.types)
      state.preFamily.trace.suffixes.values checked.indices
      state.parameterΔ state.parameterΔ 0 := by
  apply state.translations.mutualTargetState addType
  intro i indices indicesAt
  have iLt : i < checked.indices.length :=
    (List.getElem?_eq_some_iff.1 indicesAt).1
  have iStats : i < stats.indConsts.size := by
    rw [checked.indices_length, canonicalLength] at iLt
    exact iLt
  obtain ⟨header, headerAt, familyHead⟩ := familyData i iStats
  have indexLength := counts.checkedIndices_length checked sourceNparams
    indicesAt
  have indexLength' : indices.length = stats.nindices[i]! := by
    simpa only [Nat.zero_add] using indexLength
  exact ⟨header, headerAt, familyHead, indexLength'⟩

/-- Retype the shared D3 validation context from the producer's raw
parameter prefix to the canonical parameter view, retaining the exact lift,
context equality, positional uniqueness, and fresh-name invariant consumed
by mutual constructor-field replay. -/
theorem d3FullContextState
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {nparams : Nat}
    {firstView : VExpr} {params : List VExpr} {source : VInductDecl}
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType} {rawParameterΔ : VLCtx}
    {postFamilyContext : AddInductive.Context}
    {semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws}
    {ordinal : Nat}
    {checked : CheckedFamilies source params ordinal
      (canonicalizeFamilyParamsList nparams params semantics.views)}
    {parameterDefEqs : CandidateBlockFamilyViewParameterDefEqList env blockEnv
      Us nparams firstView semantics}
    (state : CandidateBlockMutualPreFamilyTranslationState env blockEnv Us
      stats nparams firstView params source rawParameterΔ postFamilyContext
      semantics checked parameterDefEqs)
    (henv : VEnv.WF env) (addType : env ≤ blockEnv) :
    ∃ viewΔ,
      ConstructorValidation.D3FullContextState env blockEnv Us
        state.preFamily.context state.parameterΔ state.parameterΔ
        state.preFamily.contextRun.candidate.context.vlctx viewΔ .refl
        state.preFamilyAlignment.rootLift := by
  have referenceWF : VLCtx.WF env Us.length
      state.preFamilyAlignment.reference :=
    (state.preFamilyAlignment.current_reference.symm henv.ordered).wf
  obtain ⟨viewΔ, viewExtension, referenceRelation, referenceUnique,
      viewWF⟩ :=
    state.preFamilyAlignment.root_reference_lift.retypeSourceExact henv
      referenceWF state.parameterRelation state.parameterUnique
      state.parameterWF
  have commonNoBV : state.parameterΔ.NoBV := by
    have shape :=
      Lean4Lean.VInductDecl.TypeChecker.CandidateParameterContext.fvarLamOnly
        state.parameterContext VLCtx.FVarLamOnly.nil
    exact shape.noBV
  exact ⟨viewΔ, {
    commonWF := state.parameterWF
    commonNoBV := commonNoBV
    fullWF := state.parameterWF.mono addType
    fullExtension := .refl
    actualWF := state.preFamilyAlignment.current_reference.wf
    viewDefEq := state.preFamilyAlignment.current_reference.trans' henv
      referenceRelation
    viewUnique := state.preFamilyAlignment.current_unique.trans'
      referenceUnique
    viewExtension := viewExtension
    freshInvariant := by
      intro fv present
      exact .inl present }⟩

/-- Retype the staged post-family constructor context to the same canonical
parameter view used by D3.  Dependency metadata is intentionally compared by
`IsDefEqFVars`: the kernel and supplemental audits may normalize dependency
lists independently while preserving every free-variable slot. -/
theorem analyzerPostContextState
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {nparams : Nat}
    {firstView : VExpr} {params : List VExpr} {source : VInductDecl}
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType} {rawParameterΔ : VLCtx}
    {postFamilyContext : AddInductive.Context}
    {semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws}
    {ordinal : Nat}
    {checked : CheckedFamilies source params ordinal
      (canonicalizeFamilyParamsList nparams params semantics.views)}
    {parameterDefEqs : CandidateBlockFamilyViewParameterDefEqList env blockEnv
      Us nparams firstView semantics}
    (state : CandidateBlockMutualPreFamilyTranslationState env blockEnv Us
      stats nparams firstView params source rawParameterΔ postFamilyContext
      semantics checked parameterDefEqs)
    {isUnsafe : Bool} {d2Context : AddInductive.Context}
    {familyIdx : Nat}
    {validation : AddInductive.ConstructorBlockValidationTraces stats
      isUnsafe d2Context familyIdx sources}
    {parameterSources : List Expr}
    (inventory : CandidateBlockConstructorPostFamilySemanticInventoryState
      env blockEnv Us stats isUnsafe d2Context rawParameterΔ nparams
      parameterSources validation semantics)
    (hblockEnv : VEnv.WF blockEnv) (addType : env ≤ blockEnv) :
    ∃ viewΔ,
      ConstructorValidation.AnalyzerPostContextState blockEnv Us
        state.parameterΔ
        inventory.semantic.contextRun.candidate.context.vlctx viewΔ
        inventory.parameterContext.rootLift := by
  have referenceWF : VLCtx.WF blockEnv Us.length
      inventory.parameterContext.reference :=
    (inventory.parameterContext.current_reference.symm hblockEnv.ordered).wf
  have parameterRelation : VLCtx.IsDefEqFVars blockEnv Us.length
      rawParameterΔ state.parameterΔ :=
    (state.parameterRelation.mono addType).toFVars
  obtain ⟨viewΔ, viewExtension, referenceRelation, viewWF⟩ :=
    inventory.parameterContext.root_reference_lift.retypeSourceFVars
      hblockEnv referenceWF parameterRelation
      (state.parameterWF.mono addType)
  have postWF : VLCtx.WF blockEnv Us.length
      inventory.semantic.contextRun.candidate.context.vlctx :=
    inventory.parameterContext.current_reference.wf
  exact ⟨viewΔ, {
    fullWF := state.parameterWF.mono addType
    postWF := postWF
    viewWF := viewWF
    viewDefEq := inventory.parameterContext.current_reference.toFVars.trans'
      hblockEnv postWF referenceRelation
    viewExtension := viewExtension }⟩

end CandidateBlockMutualPreFamilyTranslationState

/-- Projection-aware coherent pre-family state.  Family suffix translations
are the literal endpoints selected by the retained semantic family runs; no
suffix-level `TrExprS.IsUnique` proposition is stored. -/
structure CandidateBlockResolvedMutualPreFamilyTranslationState
    (env blockEnv : VEnv) (Us : List Name)
    (stats : AddInductive.InductiveStats) (nparams : Nat)
    (firstView : VExpr) (params : List VExpr) (source : VInductDecl)
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    (rawParameterΔ : VLCtx)
    (postFamilyContext : AddInductive.Context)
    (semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws)
    {ordinal : Nat}
    (checked : CheckedFamilies source params ordinal
      (canonicalizeFamilyParamsList nparams params semantics.views))
    (parameterDefEqs : CandidateBlockFamilyViewParameterDefEqList env blockEnv
      Us nparams firstView semantics) where
  preFamily :
    AddInductive.ConstructorMutualBlockResolvedPreFamilySemanticState env
      blockEnv Us stats semantics
  parameterΔ : VLCtx
  params_eq : params = VExpr.telN nparams firstView
  parameterContext : TypeChecker.CandidateParameterContext []
    stats.params.toList (VExpr.telN nparams firstView) parameterΔ
  parameterRelation : VLCtx.IsDefEq env Us.length rawParameterΔ parameterΔ
  parameterUnique : TrExprS.IsUniqueCtx rawParameterΔ parameterΔ
  parameterWF : VLCtx.WF env Us.length parameterΔ
  preFamily_ngen_eq : preFamily.context.ngen = postFamilyContext.ngen
  preFamilyAlignment : ConstructorSharedParameterContextAlignment env Us
    rawParameterΔ preFamily.contextRun
  translations : CandidateBlockResolvedFamilySuffixTranslationList env
    blockEnv Us stats nparams firstView params source parameterΔ semantics
    preFamily.trace.suffixes checked parameterDefEqs

namespace CandidateBlockResolvedMutualPreFamilyTranslationState

theorem targetState
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {nparams : Nat}
    {firstView : VExpr} {params : List VExpr} {source : VInductDecl}
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType}
    {rawParameterΔ : VLCtx}
    {postFamilyContext : AddInductive.Context}
    {semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws}
    {checked : CheckedFamilies source params 0
      (canonicalizeFamilyParamsList nparams params semantics.views)}
    {parameterDefEqs : CandidateBlockFamilyViewParameterDefEqList env blockEnv
      Us nparams firstView semantics}
    (state : CandidateBlockResolvedMutualPreFamilyTranslationState env blockEnv
      Us stats nparams firstView params source rawParameterΔ postFamilyContext
      semantics checked parameterDefEqs)
    (addType : env ≤ blockEnv)
    (sourceNparams : source.nparams = nparams)
    (counts : CanonicalFamilyIndexCountList stats nparams 0
      (canonicalizeFamilyParamsList nparams params semantics.views))
    (canonicalLength :
      (canonicalizeFamilyParamsList nparams params semantics.views).length =
        stats.indConsts.size)
    (familyData : ∀ familyIdx, familyIdx < stats.indConsts.size →
      ∃ header,
        (familyHeaders source.nparams source.types)[familyIdx]? = some header ∧
        stats.indConsts[familyIdx]! = .const header.name stats.levels ∧
        stats.nindices[familyIdx]! = header.indices) :
    ConstructorValidation.ResolvedMutualFamilyTargetState env blockEnv Us
      stats (familyHeaders source.nparams source.types)
      state.preFamily.trace.suffixes.values checked.indices
      state.parameterΔ state.parameterΔ 0 .refl := by
  apply state.translations.mutualTargetState addType
  intro i indices indicesAt
  have iLt : i < checked.indices.length :=
    (List.getElem?_eq_some_iff.1 indicesAt).1
  have iStats : i < stats.indConsts.size := by
    rw [checked.indices_length, canonicalLength] at iLt
    exact iLt
  obtain ⟨header, headerAt, familyHead, headerIndices⟩ := familyData i iStats
  have indexLength := counts.checkedIndices_length checked sourceNparams
    indicesAt
  have indexLength' : indices.length = stats.nindices[i]! := by
    simpa only [Nat.zero_add] using indexLength
  exact ⟨header, headerAt, familyHead, headerIndices, indexLength'⟩

/-- Retype the resolved replay's D3 context to the canonical parameter view.
This construction uses only shared-parameter provenance and is therefore
identical to the legacy context construction; suffix uniqueness is not
needed. -/
theorem d3FullContextState
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {nparams : Nat}
    {firstView : VExpr} {params : List VExpr} {source : VInductDecl}
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType} {rawParameterΔ : VLCtx}
    {postFamilyContext : AddInductive.Context}
    {semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws}
    {ordinal : Nat}
    {checked : CheckedFamilies source params ordinal
      (canonicalizeFamilyParamsList nparams params semantics.views)}
    {parameterDefEqs : CandidateBlockFamilyViewParameterDefEqList env blockEnv
      Us nparams firstView semantics}
    (state : CandidateBlockResolvedMutualPreFamilyTranslationState env blockEnv
      Us stats nparams firstView params source rawParameterΔ postFamilyContext
      semantics checked parameterDefEqs)
    (henv : VEnv.WF env) (addType : env ≤ blockEnv) :
    ∃ viewΔ,
      ConstructorValidation.D3FullContextState env blockEnv Us
        state.preFamily.context state.parameterΔ state.parameterΔ
        state.preFamily.contextRun.candidate.context.vlctx viewΔ .refl
        state.preFamilyAlignment.rootLift := by
  have referenceWF : VLCtx.WF env Us.length
      state.preFamilyAlignment.reference :=
    (state.preFamilyAlignment.current_reference.symm henv.ordered).wf
  obtain ⟨viewΔ, viewExtension, referenceRelation, referenceUnique,
      viewWF⟩ :=
    state.preFamilyAlignment.root_reference_lift.retypeSourceExact henv
      referenceWF state.parameterRelation state.parameterUnique
      state.parameterWF
  have commonNoBV : state.parameterΔ.NoBV := by
    have shape :=
      Lean4Lean.VInductDecl.TypeChecker.CandidateParameterContext.fvarLamOnly
        state.parameterContext VLCtx.FVarLamOnly.nil
    exact shape.noBV
  exact ⟨viewΔ, {
    commonWF := state.parameterWF
    commonNoBV := commonNoBV
    fullWF := state.parameterWF.mono addType
    fullExtension := .refl
    actualWF := state.preFamilyAlignment.current_reference.wf
    viewDefEq := state.preFamilyAlignment.current_reference.trans' henv
      referenceRelation
    viewUnique := state.preFamilyAlignment.current_unique.trans'
      referenceUnique
    viewExtension := viewExtension
    freshInvariant := by
      intro fv present
      exact .inl present }⟩

/-- Retype the resolved replay's post-family analyzer context to the same
canonical parameter view.  This step likewise depends only on context and
parameter alignment, not on expression-level translation uniqueness. -/
theorem analyzerPostContextState
    {env blockEnv : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {nparams : Nat}
    {firstView : VExpr} {params : List VExpr} {source : VInductDecl}
    {sources : List InductiveType}
    {candidates : AddInductive.CandidateList
      AddInductive.CandidateFamily sources}
    {raws : List VInductiveType} {rawParameterΔ : VLCtx}
    {postFamilyContext : AddInductive.Context}
    {semantics : CandidateBlockFamilySemanticListRun env blockEnv Us
      candidates raws}
    {ordinal : Nat}
    {checked : CheckedFamilies source params ordinal
      (canonicalizeFamilyParamsList nparams params semantics.views)}
    {parameterDefEqs : CandidateBlockFamilyViewParameterDefEqList env blockEnv
      Us nparams firstView semantics}
    (state : CandidateBlockResolvedMutualPreFamilyTranslationState env blockEnv
      Us stats nparams firstView params source rawParameterΔ postFamilyContext
      semantics checked parameterDefEqs)
    {isUnsafe : Bool} {d2Context : AddInductive.Context}
    {familyIdx : Nat}
    {validation : AddInductive.ConstructorBlockValidationTraces stats
      isUnsafe d2Context familyIdx sources}
    {parameterSources : List Expr}
    (inventory : CandidateBlockConstructorPostFamilySemanticInventoryState
      env blockEnv Us stats isUnsafe d2Context rawParameterΔ nparams
      parameterSources validation semantics)
    (hblockEnv : VEnv.WF blockEnv) (addType : env ≤ blockEnv) :
    ∃ viewΔ,
      ConstructorValidation.AnalyzerPostContextState blockEnv Us
        state.parameterΔ
        inventory.semantic.contextRun.candidate.context.vlctx viewΔ
        inventory.parameterContext.rootLift := by
  have referenceWF : VLCtx.WF blockEnv Us.length
      inventory.parameterContext.reference :=
    (inventory.parameterContext.current_reference.symm hblockEnv.ordered).wf
  have parameterRelation : VLCtx.IsDefEqFVars blockEnv Us.length
      rawParameterΔ state.parameterΔ :=
    (state.parameterRelation.mono addType).toFVars
  obtain ⟨viewΔ, viewExtension, referenceRelation, viewWF⟩ :=
    inventory.parameterContext.root_reference_lift.retypeSourceFVars
      hblockEnv referenceWF parameterRelation
      (state.parameterWF.mono addType)
  have postWF : VLCtx.WF blockEnv Us.length
      inventory.semantic.contextRun.candidate.context.vlctx :=
    inventory.parameterContext.current_reference.wf
  exact ⟨viewΔ, {
    fullWF := state.parameterWF.mono addType
    postWF := postWF
    viewWF := viewWF
    viewDefEq := inventory.parameterContext.current_reference.toFVars.trans'
      hblockEnv postWF referenceRelation
    viewExtension := viewExtension }⟩

end CandidateBlockResolvedMutualPreFamilyTranslationState

/-- A retained normalized constructor suffix translates directly to Theory's
mutual stage-3 predicate.  Parameter-source shape, canonical de Bruijn
translations, suffix uniqueness, and local-context occurrence safety all
come from the same parameter context and executable stage trace. -/
theorem _root_.Lean4Lean.AddInductive.ConstructorStage3CandidateTrace.blockStage3Ctor_of_suffix_translation
    {env : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {owner : Nat}
    {source : Constructor}
    {candidate : AddInductive.CandidateConstructor source}
    (trace : AddInductive.ConstructorStage3CandidateTrace stats owner candidate)
    {parameterTypes : List VExpr} {parameterΔ : VLCtx}
    {target : VExpr}
    (run : TrExprS env Us parameterΔ trace.suffix target)
    (parameterContext : TypeChecker.CandidateParameterContext []
      stats.params.toList parameterTypes parameterΔ)
    (henv : VEnv.WF env)
    (parameterWF : VLCtx.WF env Us.length parameterΔ)
    {U np : Nat} {headers : List VInductDecl.FamilyHeader}
    {names : List Name}
    (paramsSize : stats.params.size = np)
    (ownerLt : owner < stats.indConsts.size)
    (familyData : ∀ familyIdx, familyIdx < stats.indConsts.size →
      ∃ header,
        headers[familyIdx]? = some header ∧
        stats.nindices[familyIdx]! = header.indices ∧
        stats.indConsts[familyIdx]! =
          .const header.name stats.levels)
    (levelsTr : stats.levels.mapM (VLevel.ofLevel Us) =
      some (VLevel.params U))
    (before : ∀ (familyIdx : Nat) (header : VInductDecl.FamilyHeader),
      headers[familyIdx]? = some header →
      ∀ (k : Nat), k < familyIdx →
        ∀ (earlier : VInductDecl.FamilyHeader),
        headers[k]? = some earlier → earlier.name ≠ header.name)
    (covered : ∀ name, name ∈ names →
      stats.indConsts.any (fun constant =>
        constant.constName! == name) = true)
    (literalSafe : ∀ literal name, name ∈ names →
      (VExpr.trLiteral literal).hasConst name = false) :
    VInductDecl.blockStage3Ctor U np headers names owner 0 target = true := by
  have parameterLength : parameterTypes.length = np := by
    rw [← parameterContext.length_eq]
    simpa using paramsSize
  have parameterTranslations :=
    TypeChecker.CandidateParameterContext.sourceTranslations
      parameterContext henv parameterWF
  rw [parameterLength] at parameterTranslations
  have suffixUnique :=
    ConstructorValidation.instantiateFamilyParameters_unique
      trace.viewTranslationUnique
      (ConstructorValidation.CandidateParameterContext.parametersUnique
        parameterContext)
      trace.parameters
  exact trace.stage.blockStage3Ctor_of_translation run
    suffixUnique henv.ordered paramsSize ownerLt familyData
    levelsTr parameterTranslations parameterContext.sources_fvar before
    covered
    (VLCtx.FVarLamOnly.valuesAnyConstFree
      (TypeChecker.CandidateParameterContext.fvarLamOnly
        parameterContext .nil) names) literalSafe

/-- Specialize the suffix bridge to the exact constructor view selected by a
semantic candidate root.  Reconstructing the target as its parameter
telescope plus `dropN` lets the retained instantiation equation select the
canonical post-parameter Theory expression without an endpoint guess. -/
theorem _root_.Lean4Lean.AddInductive.ConstructorStage3CandidateTrace.suffixTranslation_of_semantics
    {env : VEnv} {Us : List Name}
    {stats : AddInductive.InductiveStats} {owner : Nat}
    {source : Constructor}
    {candidate : AddInductive.CandidateConstructor source}
    {raw : VConstVal}
    (trace : AddInductive.ConstructorStage3CandidateTrace stats owner candidate)
    (semantic : VInductDecl.CandidateConstructorSemanticRun env Us candidate raw)
    {parameterΔ : VLCtx} {np : Nat}
    (parameterContext : TypeChecker.CandidateParameterContext []
      stats.params.toList (VExpr.telN np semantic.type.view) parameterΔ)
    (parameterWF : VLCtx.WF env Us.length parameterΔ) :
    TrExprS env Us parameterΔ trace.suffix
      (VExpr.dropN np semantic.type.view) := by
  have unique : TypeChecker.CandidateExprTraceViewIsUnique
      candidate.type.trace :=
    candidate.type.trace.viewTranslationUnique_sound (by
      rw [AddInductive.CandidateExprTrace.viewTranslationUnique_eq]
      exact trace.translationUnique)
  obtain ⟨inferred, recursive⟩ := semantic.type.recursive
  have wholeTr := recursive.view_tr_strict unique
  rw [← VExpr.forallN_telN_dropN np semantic.type.view] at wholeTr
  exact parameterContext.instantiateForall
    (by
      simpa only [semantic.type.venv_eq] using
        semantic.type.contextRun.context.Ewf.ordered)
    parameterWF trace.parameters wholeTr

