/-- The canonical second-family result universe satisfies the validator's
common-universe contract at its exact dependent continuation. -/
theorem
    ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion.canonicalSecondResultLevelEq
    {source : VInductDecl}
    {firstSource secondSource : InductiveType}
    {remainingSources : List InductiveType}
    {numNested : Nat} {isUnsafe : Bool}
    {context : AddInductive.Context}
    {produced : ProducedBlockRecursorShapeCandidate source
      (firstSource :: secondSource :: remainingSources) numNested isUnsafe
      context}
    {env blockEnv : VEnv} {Us : List Name}
    {semantic : NormalizationCandidateBlockSemanticRun env blockEnv Us
      produced.candidate source}
    {staging : produced.SecondFamilyIndexStaging semantic}
    {raw : Option staging.annotation.RawFirstIndexDomain}
    (completion : staging.TerminalIndexDomainCompletion raw)
    (validation : staging.ValidationContinuation)
    {params : List VExpr}
    (paramsLength : params.length = source.nparams)
    (generation :
      staging.annotation.secondCandidate.familyType.type.trace.generationSpine =
        true)
    {commonResultLevel : VLevel}
    (commonTranslation : VLevel.ofLevel Us
      validation.continuation.stats.resultLevel = some commonResultLevel) :
    sortLevel source.nparams
        (canonicalizeFamilyParams source.nparams params
          staging.annotation.secondSemantic.view) ≈ commonResultLevel := by
  have terminalEndpointContextEq : completion.terminalRun.context =
      completion.chain.endpoint.contextRun.context := by
    unfold ProducedBlockRecursorShapeCandidate.SecondFamilyIndexStaging.TerminalIndexDomainCompletion.terminalRun
      TypeChecker.FamilyParameterIndexBoundary.IndexDomainChain.endpointContextRun
    apply TypeChecker.CandidateContextRun.cast_context_context
  have terminalEndpointSort : completion.terminalRun.context.IsDefEqU
      completion.chain.endpoint.boundary.source'
      (.sort completion.alignment.sort) := by
    rw [terminalEndpointContextEq]
    have endpointVenv :
        completion.chain.endpoint.contextRun.context.venv = env := by
      rw [← terminalEndpointContextEq]
      exact completion.terminal_venv
    have endpointLparams :
        completion.chain.endpoint.contextRun.context.lparams = Us := by
      rw [← terminalEndpointContextEq]
      exact completion.terminal_lparams
    simpa only [TypeChecker.VContext.IsDefEqU, endpointVenv,
      endpointLparams] using completion.alignment.endpoint_sort
  have continuationEndpointSort :
      (completion.continuationRun validation).context.IsDefEqU
        completion.chain.endpoint.boundary.source'
        (.sort completion.alignment.sort) := by
    rw [completion.continuationRun_context validation]
    exact terminalEndpointSort
  obtain ⟨validatorLevel, validatorLevel', sortedEq, validatorTr,
      validatorAligned⟩ :=
    AddInductive.FamilyEnsureSortStep.resultLevel_equiv
      ⟨validation.continuation.telescope.result.context,
        validation.continuation.telescope.result.type,
        validation.continuation.sorted⟩
      validation.continuation.ensureSort
      (completion.continuationRun validation)
      completion.chain.endpoint.boundary.source'
      (completion.continuationSourceTranslation validation)
      completion.alignment.sort continuationEndpointSort
  obtain ⟨candidateLevel, terminalEq, candidateLevelTr⟩ :=
    completion.alignment_sort_translation
  obtain ⟨viewLevel, resultEq, viewLevelTr⟩ :=
    staging.annotation.secondSemantic.canonicalResultSortTranslation
      terminalEq generation paramsLength
  have viewLevelEq : viewLevel = completion.alignment.sort :=
    Option.some.inj (viewLevelTr.symm.trans candidateLevelTr)
  have canonicalLevelEq : sortLevel source.nparams
      (canonicalizeFamilyParams source.nparams params
        staging.annotation.secondSemantic.view) = viewLevel := by
    unfold sortLevel
    rw [resultEq]
  obtain ⟨_first, _firstSelected, secondSelected⟩ :=
    AddInductive.FamilyParameterComparisonBlockTrace.exists_predecessor_of_secondContinuation?
      validation.selected
  have later : validation.continuation.stats.indConsts.isEmpty = false := by
    have positionLater := staging.position_later
    rw [← validation.position_eq] at positionLater
    exact positionLater
  have compatible :=
    AddInductive.FamilyParameterComparisonBlockTrace.headContinuation?_resultLevelCompatible
      secondSelected later
  have compatible' : validatorLevel.isEquiv
      validation.continuation.stats.resultLevel = true := by
    change validation.continuation.sorted = .sort validatorLevel at sortedEq
    rw [sortedEq] at compatible
    simpa only [Expr.sortLevel!] using compatible
  have validatorTrUs : VLevel.ofLevel Us validatorLevel =
      some validatorLevel' := by
    simpa only [completion.continuation_lparams validation] using validatorTr
  have validatorCommon : validatorLevel' ≈ commonResultLevel :=
    Lean.Level.isEquiv_wf compatible' validatorTrUs commonTranslation
  rw [canonicalLevelEq, viewLevelEq]
  exact validatorAligned.symm.trans validatorCommon

