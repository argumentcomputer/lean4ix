  params_eq := owner.singletonBlockParams_eq
  parameterDefEqs :=
    owner.singletonViewParameterTelescopeDefEqList context_lctx_eq
  validation_safety := owner.singletonValidationContext_safety context_lctx_eq
  basis := Classical.choice
